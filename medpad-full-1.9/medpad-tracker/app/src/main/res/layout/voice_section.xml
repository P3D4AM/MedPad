<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/voice_bg">

    <ImageButton
        android:id="@+id/btnRec"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_mic"
        android:background="@drawable/voice_btn_bg"
        app:tint="@color/white"
        android:contentDescription="@string/record_voice" />

    <TextView
        android:id="@+id/tvRecState"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textSize="13sp"
        android:textColor="@color/gray_500"
        android:text="@string/record_voice" />

    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_play"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/teal_600"
        android:visibility="gone"
        android:contentDescription="@string/play" />
</LinearLayout>
