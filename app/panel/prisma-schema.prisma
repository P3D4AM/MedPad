generator client {
  provider = "prisma-client-js"
  // v1.9.5 offline bundle: engines for BOTH target platforms are vendored so the
  // pre-built app runs offline on Windows (dll) and Linux (so) with no downloads.
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// MedPad v1.9.3 — Employee Tracking & Check-in System
// Schema rebuilt from project specification
// ─────────────────────────────────────────────

model Employee {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String // sha256 hex
  name      String
  phone     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tokens       AppToken[]
  checkins     Checkin[]
  visits       Visit[]
  assignments  Assignment[]
  notifications AppNotification[]
  plannedVisits PlannedVisit[]
}

model AppToken {
  id         String    @id @default(cuid())
  token      String    @unique
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  // phase 1 / task 2 (G-2): configurable expiry + server-side revocation.
  // NULL expiresAt = token never expires (pre-remediation rows and installs
  // that deliberately disable the TTL — appTokenTtlHours = 0).
  // revokedAt set = token is dead for every subsequent request, immediately.
  expiresAt  DateTime?
  revokedAt  DateTime?
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("doctor") // doctor | pharmacy | clinic | other
  address   String?
  phone     String?
  lat       Float
  lng       Float
  radius    Float    @default(150) // geofence radius (meters)
  updatedAt DateTime @updatedAt // LWW sync field (app <-> panel)
  createdAt DateTime @default(now())

  checkins    Checkin[]
  visits      Visit[]
  assignments Assignment[]
  plannedVisits PlannedVisit[]
}

model Assignment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([employeeId, customerId])
}

model Checkin {
  id         String    @id @default(cuid())
  localId    String?   @unique // idempotency key from app (anti double-submit)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  kind       String    @default("checkin") // checkin | checkout
  note       String?
  voicePath  String? // relative path under uploads/
  lat        Float?
  lng        Float?
  createdAt  DateTime  @default(now())

  // phase 1 / task 2 (G-6) — GPS validation. lat/lng hold ONLY real device
  // coordinates; when no trustworthy fix exists they are NULL and
  // locationMissing=true (the customer's coordinates are NEVER substituted).
  // accuracy = reported GPS accuracy in meters (null when unknown).
  // distanceM = meters between the device and the customer at check-in.
  // outOfRadius = distance exceeded the customer's configured radius.
  accuracy        Float?
  distanceM       Float?
  outOfRadius     Boolean   @default(false)
  locationMissing Boolean   @default(false)

  visitStart Visit?  @relation("VisitCheckin")
  visitEnd   Visit?  @relation("VisitCheckout")
}

model Visit {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  checkinId  String?   @unique
  checkoutId String?   @unique
  startAt    DateTime
  endAt      DateTime?
  open       Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  checkin  Checkin? @relation("VisitCheckin", fields: [checkinId], references: [id])
  checkout Checkin? @relation("VisitCheckout", fields: [checkoutId], references: [id])

  // phase 2 / task 1 — back-relation only (NO column on Visit): the 1:1 link
  // between a plan and the real visit is owned by PlannedVisit.visitId, so
  // existing installs need zero ALTERs on the Visit table.
  plannedVisit PlannedVisit?
}

// phase 2 / task 1 — PLANNED VISITS (the intent layer).
//
// Design decisions (see PHASE2-TASK1-REPORT-fa.md for the full rationale):
//  * `Visit` keeps representing what ACTUALLY happened (created by check-in).
//    PlannedVisit is the INTENT for the future — they are never merged.
//  * The plan-to-visit link is owned HERE (visitId + UNIQUE): one plan can be
//    completed by at most one real visit and one visit completes at most one
//    plan. Owning the FK on the new table means NO migration on Visit at all.
//  * status: 'scheduled' | 'done' | 'cancelled' | 'needs_reschedule'.
//    'done' is set ONLY by the server when a real check-in links to the plan
//    (admins cannot hand-mark done — keeps the done-count honest). Cancelled
//    and rescheduled plans are NEVER counted as done.
//  * Reschedule = same row, new scheduledAt (the plan keeps its identity and
//    any later visit link); cancel = terminal state.
//  * durationMin: estimated visit duration in minutes (5..480, default 30).
//  * priority: 'low' | 'normal' | 'high' — small fixed enum, validated
//    server-side on every write.
//  * createdById: the admin username (Config.adminUser) at creation time —
//    attribution/traceability in line with the AuditLog work from task 2.
//  * Employee/Customer FKs are RESTRICT (default for required): history and
//    plans are never silently destroyed — the delete endpoints guard with a
//    409 instead (see employees/customers routes).
model PlannedVisit {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  scheduledAt DateTime
  durationMin Int      @default(30)
  priority    String   @default("normal") // low | normal | high
  status      String   @default("scheduled") // scheduled | done | cancelled | needs_reschedule
  note        String?
  visitId     String?  @unique
  visit       Visit?   @relation(fields: [visitId], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppNotification {
  id         String    @id @default(cuid())
  eventKey   String?   @unique // package 4: stable event id — retries/replays can never duplicate
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  body       String
  kind       String    @default("assignment") // assignment | proximity | plan | info
  customerId String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

// package 4 (phase 2 / task 3): ADMIN-facing notifications — real app events
// (check-in / check-out / assignment / plan changes) that the panel bell
// reads. Persisted in the DB (survives refresh/restart), deduped by a stable
// eventKey, with an explicit read state. employeeId/customerId are PLAIN
// strings (display context only, no FK) so history survives lifecycle
// changes of the referenced rows.
model PanelNotification {
  id         String    @id @default(cuid())
  eventKey   String    @unique
  kind       String    @default("info") // checkin | checkout | assignment | plan | info
  title      String
  body       String
  employeeId String?
  customerId String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Config {
  key   String @id
  value String
}

// phase 1 / task 2 (G-3): administrative audit trail. Actor is the panel's
// single admin account (Config.adminUser) — actorType leaves room for future
// actor kinds. `detail` carries a short human-readable summary and MUST
// never contain passwords, tokens or other secrets.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   @default("admin")
  actorId    String
  action     String // employee.create | employee.update | employee.deactivate | employee.reactivate | employee.revoke-tokens | employee.password-reset | settings.update | ...
  targetType String?
  targetId   String?
  detail     String?
  outcome    String   @default("success")
  createdAt  DateTime @default(now())
}
