generator client {
  provider = "prisma-client-js"
  // v1.9.5 offline bundle: engines for BOTH target platforms are vendored so the
  // pre-built app runs offline on Windows (dll) and Linux (so) with no downloads.
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// MedPad v1.9.3 — Employee Tracking & Check-in System
// Schema rebuilt from project specification
// ─────────────────────────────────────────────

model Employee {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String // sha256 hex
  name      String
  // mission item 2 (Oct 31): optional split of the display name. ADDITIVE
  // and NULLABLE — existing rows keep `name` untouched and stay NULL here
  // (NO destructive auto-split of historical names; the admin fills the
  // two fields explicitly from the panel). `name` remains the single
  // source for full-name display (notifications, audit rows, history) so
  // every existing consumer keeps working; on every first/last write the
  // API recomputes name = "first last".
  firstName String?
  lastName  String?
  phone     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tokens       AppToken[]
  checkins     Checkin[]
  visits       Visit[]
  assignments  Assignment[]
  notifications AppNotification[]
  plannedVisits PlannedVisit[]
  noteEdits    CheckinNoteVersion[] @relation("NoteEdits")
  locationPings LocationPing[]
  trackStatus  TrackStatus?
}

model AppToken {
  id         String    @id @default(cuid())
  token      String    @unique
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  // phase 1 / task 2 (G-2): configurable expiry + server-side revocation.
  // NULL expiresAt = token never expires (pre-remediation rows and installs
  // that deliberately disable the TTL — appTokenTtlHours = 0).
  // revokedAt set = token is dead for every subsequent request, immediately.
  expiresAt  DateTime?
  revokedAt  DateTime?
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("doctor") // doctor | pharmacy | clinic | other
  address   String?
  phone     String?
  // package 8 — city/province from the OFFLINE Iran cities dataset
  // (src/lib/iran-cities.ts). Nullable & additive: existing rows keep NULL
  // until edited. The (province, city) pair is validated server-side against
  // the dataset on every write (panel AND app paths).
  province  String?
  city      String?
  lat       Float
  lng       Float
  radius    Float    @default(150) // geofence radius (meters)
  updatedAt DateTime @updatedAt // LWW sync field (app <-> panel)
  createdAt DateTime @default(now())

  // ── Customer 360 (phase 1) — all nullable/additive: legacy rows keep NULL
  // and every field is OPTIONAL on the wire, so old app versions and old
  // panels keep syncing exactly as before.
  // person (type='doctor'): family name after the given name
  lastName    String?
  // person: professional title (e.g. «دکتر»، «متخصص قلب»)
  title       String?
  // person: medical specialty
  specialty   String?
  // clinic (type='clinic'): the person responsible for purchasing
  managerName String?
  // second contact number (person OR clinic)
  phone2      String?
  // district / area within the city (free text, nullable)
  district    String?
  postalCode  String?
  // general notes on the customer (the 360 profile's notes tab)
  notes       String?
  // logical delete / deactivation. DEFAULT TRUE so every legacy row is
  // active. Deactivation NEVER cascades history: checkins/visits/voice/
  // purchases/links all survive (they reference the row, not the flag).
  active      Boolean  @default(true)
  // app-side idempotency key for OFFLINE customer creation (pending queue
  // replay). Unique among NON-NULL values; NULL for panel-created rows.
  appLocalId  String?  @unique

  // ── Holoo integration (phase 1) — the ONLY connection point between a
  // MedPad Customer and its Holoo counterpart (ErpCustomer.erpCode).
  // Nullable: every pre-Holoo row keeps NULL. The Holoo sync NEVER writes
  // any other Customer field through this link — operational ownership
  // (assignments, visits, notes, active, …) stays 100% MedPad-side.
  erpCode     String?  @unique

  checkins    Checkin[]
  visits      Visit[]
  assignments Assignment[]
  plannedVisits PlannedVisit[]
  // Customer 360 — physician↔clinic links (typed many-to-many; see
  // CustomerLink) and purchase history (see Purchase)
  clinicLinks     CustomerLink[]     @relation("LinkClinic")
  physicianLinks  CustomerLink[]     @relation("LinkPhysician")
  purchases       Purchase[]
}

// ── Customer 360 (phase 1) — physician↔clinic MANY-TO-MANY link ──
//
// One clinic can have several physicians; one physician can practise at
// several clinics. Each link row carries its own note + active flag.
//
// Design decisions:
//  * TYPED columns (clinicId / physicianId) instead of an untyped pair: the
//    server validates clinic.type='clinic' AND physician.type='doctor' on
//    every write — a link can never silently connect two clinics or two
//    physicians, and the API never has to guess which side is which.
//  * @@unique([clinicId, physicianId]) makes duplicate links a database-level
//    impossibility (a replay races into P2002, not a second row). Re-linking
//    a removed pair reactivates the SAME row (see routes: upsert semantics).
//  * FKs are CASCADE on both sides — deleting a customer cleans its links
//    but NEVER its visits/voice/purchases (those FKs stay as they are).
//  * ACCESS: the link itself grants nothing. App-side profile/link reads
//    only surface counterparts that are ALSO assigned to the requesting rep
//    (see /api/app/customers/[id]/profile) — a link can never be used to
//    bypass the assignment-based access control.
model CustomerLink {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Customer @relation("LinkClinic", fields: [clinicId], references: [id], onDelete: Cascade)
  physicianId String
  physician   Customer @relation("LinkPhysician", fields: [physicianId], references: [id], onDelete: Cascade)
  note        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clinicId, physicianId])
  @@index([physicianId])
}

// ── Customer 360 (phase 1) — purchase history (STRUCTURE ONLY) ──
//
// This phase creates the DATA MODEL + UI + aggregation, ready for a future
// Holoo ERP connection. NO real Holoo API call is made from this codebase —
// data will arrive through a later sync adapter that writes here.
//
// Design decisions:
//  * source marks the ORIGIN of every record ('manual' | 'holoo'). Nothing
//    is ever displayed as a real sale without its source — test/imported
//    data is identifiable by construction.
//  * externalId (Holoo record id) is kept SEPARATE from the internal cuid
//    and UNIQUE among non-null values — the future sync adapter can upsert
//    by it without touching internal ids. invoiceNo is the human-facing
//    external invoice number (not necessarily unique in the source system).
//  * customerId pins EVERY purchase to exactly ONE customer (a clinic OR a
//    physician) — a purchase can never be counted twice in the financial
//    summary. The two-level model question "who bought?" is answered by
//    this column, and the profile UI labels the owner explicitly.
//  * Invoice-level fields (date, paymentStatus, discount, notes) live on
//    Purchase; product lines live on PurchaseItem (CASCADE delete with the
//    invoice). qty/unitPrice/total/discount per line.
//  * The financial summary (total, 30/90/365-day windows, order count,
//    average, last, max) is computed from these tables on read — see
//    /api/customers/[id]/profile. No summary is ever fabricated: an empty
//    table renders an explicit empty state.
model Purchase {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  // origin of the record — 'manual' (entered by a human) | 'holoo' (synced
  // from the Holoo ERP). Displayed with the record; never hidden.
  source        String    @default("manual")
  // Holoo-side stable record id (sync adapter's upsert key). NULL on manual.
  externalId    String?   @unique
  // human-facing external invoice number (NOT guaranteed unique upstream)
  invoiceNo     String?
  date          DateTime
  // paid | unpaid | partial | null(unknown) — free text is rejected
  paymentStatus String?
  discount      Float?
  notes         String?
  // when the (future) Holoo adapter last confirmed this row
  syncedAt      DateTime  @default(now())
  // ── Holoo integration (phase 1): the RAW invoice header as returned by
  // the Holoo API (SumNaghd/Nesiyeh/Check/Levy/Scot/SanadCode/Type/Time …),
  // stored for provenance & future detail rendering. Written ONLY by the
  // sync adapter (source='holoo' rows); NULL on manual rows.
  holooJson     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items PurchaseItem[]

  @@index([customerId, date])
  @@index([externalId])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  // Holoo-side product id (NULL when the source has none)
  productId   String?
  productName String
  productCode String?
  brand       String?
  qty         Float    @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  discount    Float?

  @@index([purchaseId])
}

model Assignment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([employeeId, customerId])
}

model Checkin {
  id         String    @id @default(cuid())
  localId    String?   @unique // idempotency key from app (anti double-submit)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  kind       String    @default("checkin") // checkin | checkout
  note       String?
  voicePath  String? // relative path under uploads/
  lat        Float?
  lng        Float?
  createdAt  DateTime  @default(now())

  // phase 1 / task 2 (G-6) — GPS validation. lat/lng hold ONLY real device
  // coordinates; when no trustworthy fix exists they are NULL and
  // locationMissing=true (the customer's coordinates are NEVER substituted).
  // accuracy = reported GPS accuracy in meters (null when unknown).
  // distanceM = meters between the device and the customer at check-in.
  // outOfRadius = distance exceeded the customer's configured radius.
  accuracy        Float?
  distanceM       Float?
  outOfRadius     Boolean   @default(false)
  locationMissing Boolean   @default(false)

  // mission item 6 (Oct 31) — TRUE when the geofence requirement for this
  // event's operation (check-in OR check-out) was DISABLED at event time:
  // the server recorded the event without enforcing the distance (an
  // auditable "control bypassed" marker — the admin report can count
  // exactly such events; distanceM/outOfRadius still carry the measured
  // facts whenever a valid fix existed). FALSE = the requirement was on
  // (and the event was within radius, or was rejected with 422).
  geoBypassed     Boolean   @default(false)

  visitStart Visit?  @relation("VisitCheckin")
  visitEnd   Visit?  @relation("VisitCheckout")

  // mission 12 / item 9 (Nov 2026) — MULTIPLE voice files per event. The
  // legacy single `voicePath` stays (first file; every existing consumer
  // keeps working) and new multi-file uploads also create VoiceFile rows.
  voiceFiles VoiceFile[]

  // phase 2 / §2 — append-only edit history of the report text
  noteVersions CheckinNoteVersion[]
}

// mission 12 / item 9 — one row per uploaded voice recording. Each file
// keeps its OWN id and creation time; deleting one row never touches the
// others (cascade only with the parent event). `path` is the relative
// path under uploads/ (same namespace as Checkin.voicePath — old files are
// backfilled into rows by instrumentation.ts, never moved on disk).
model VoiceFile {
  id        String   @id @default(cuid())
  checkinId String
  checkin   Checkin  @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  path      String   @unique
  seq       Int      @default(0) // order within the event (0 = first/legacy)
  createdAt DateTime @default(now())
}

// phase 2 / §2 (daily app capabilities): report text version history.
// Every real edit of a report's note creates ONE new row with the previous
// text (oldNote), the new text (newNote), the acting employee (editorId)
// and the timestamp. APPEND-ONLY by design — rows are never updated or
// rewritten, so "ویرایش عادی تاریخچه را بازنویسی نمی‌کند". A brand-new
// report has zero rows; an edited report has >= 1 — that count is how a
// new note stays distinguishable from an edited one (panel badge).
// Deleting a check-in row (admin duplicate cleanup) cascades its history;
// the editor FK is RESTRICT (employees are deactivated, not deleted).
model CheckinNoteVersion {
  id        String   @id @default(cuid())
  checkinId String
  checkin   Checkin  @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  oldNote   String?
  newNote   String?
  editorId  String
  editor    Employee @relation("NoteEdits", fields: [editorId], references: [id])
  createdAt DateTime @default(now())

  @@index([checkinId])
}

model Visit {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  checkinId  String?   @unique
  checkoutId String?   @unique
  startAt    DateTime
  endAt      DateTime?
  open       Boolean   @default(true)
  // mission item 8 (Oct 31) — minutes between the plan's scheduledAt and
  // the real visit's startAt (negative = EARLY, positive = LATE, 0 =
  // exactly on time). Set ONLY when the check-in linked to a plan; NULL =
  // plan-less visit (no deviation is ever invented for a plan that does
  // not exist). The panel reports it without re-deriving anything.
  deviationMin Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  checkin  Checkin? @relation("VisitCheckin", fields: [checkinId], references: [id])
  checkout Checkin? @relation("VisitCheckout", fields: [checkoutId], references: [id])

  // phase 2 / task 1 — back-relation only (NO column on Visit): the 1:1 link
  // between a plan and the real visit is owned by PlannedVisit.visitId, so
  // existing installs need zero ALTERs on the Visit table.
  plannedVisit PlannedVisit?
}

// phase 2 / task 1 — PLANNED VISITS (the intent layer).
//
// Design decisions (see PHASE2-TASK1-REPORT-fa.md for the full rationale):
//  * `Visit` keeps representing what ACTUALLY happened (created by check-in).
//    PlannedVisit is the INTENT for the future — they are never merged.
//  * The plan-to-visit link is owned HERE (visitId + UNIQUE): one plan can be
//    completed by at most one real visit and one visit completes at most one
//    plan. Owning the FK on the new table means NO migration on Visit at all.
//  * status: 'scheduled' | 'done' | 'cancelled' | 'needs_reschedule'.
//    'done' is set ONLY by the server when a real check-in links to the plan
//    (admins cannot hand-mark done — keeps the done-count honest). Cancelled
//    and rescheduled plans are NEVER counted as done.
//  * Reschedule = same row, new scheduledAt (the plan keeps its identity and
//    any later visit link); cancel = terminal state.
//  * durationMin: estimated visit duration in minutes (5..480, default 30).
//  * priority: 'low' | 'normal' | 'high' — small fixed enum, validated
//    server-side on every write.
//  * createdById: the admin username (Config.adminUser) at creation time —
//    attribution/traceability in line with the AuditLog work from task 2.
//  * Employee/Customer FKs are RESTRICT (default for required): history and
//    plans are never silently destroyed — the delete endpoints guard with a
//    409 instead (see employees/customers routes).
model PlannedVisit {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  scheduledAt DateTime
  durationMin Int      @default(30)
  priority    String   @default("normal") // low | normal | high
  status      String   @default("scheduled") // scheduled | done | cancelled | needs_reschedule
  note        String?
  visitId     String?  @unique
  visit       Visit?   @relation(fields: [visitId], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppNotification {
  id         String    @id @default(cuid())
  eventKey   String?   @unique // package 4: stable event id — retries/replays can never duplicate
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  body       String
  kind       String    @default("assignment") // assignment | proximity | plan | info
  customerId String?
  // mission item 3 (Oct 31) — ENTITY-level tap-through routing. kind alone
  // only reached a SCREEN; entityType/entityId name the exact RECORD the
  // notification is about so the app can open it (a specific plan, the
  // customer's marker, the assignment-request dialog). Nullable + additive:
  // historical rows keep NULL and the app falls back to the kind mapping.
  // Allowed values: 'customer' | 'plan' | 'request' (validated at every
  // write site; unknown values degrade to the kind route in the app).
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

// package 4 (phase 2 / task 3): ADMIN-facing notifications — real app events
// (check-in / check-out / assignment / plan changes) that the panel bell
// reads. Persisted in the DB (survives refresh/restart), deduped by a stable
// eventKey, with an explicit read state. employeeId/customerId are PLAIN
// strings (display context only, no FK) so history survives lifecycle
// changes of the referenced rows.
model PanelNotification {
  id         String    @id @default(cuid())
  eventKey   String    @unique
  kind       String    @default("info") // checkin | checkout | assignment | plan | info
  title      String
  body       String
  employeeId String?
  customerId String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

// mission item 10 (Oct 31) — the unified OPERATIONAL event log: one row per
// meaningful operational event, server-observed (check-in/checkout results
// incl. rejections, logins, report edits) AND device-observed (queue
// lifecycle, notification display results, permission changes — uploaded in
// idempotent batches by the app, see POST /api/app/events).
//
// Semantics:
//  - deviceAt = WHEN THE DEVICE SAYS IT HAPPENED (client clock; may skew —
//    serverAt is the reliable reference and is ALWAYS server clock);
//  - status distinguishes outcome (success | failed) — "the client sent it"
//    is NOT success; the server's own business result is;
//  - requestId = the idempotency key (the client event's localId or the
//    server's eventKey): a replayed upload can NEVER create a second
//    logical row (unique index; P2002 is swallowed as a duplicate);
//  - message/errorCode are SAFE for admin eyes — never passwords, tokens,
//    voice content or unnecessary customer data (write sites enforce it);
//  - type is a fixed taxonomy (lib/op-event.ts) — validation rejects
//    unknown types so the filters stay meaningful;
//  - retention: eventRetentionDays (admin setting) prunes OLD rows at boot
//    — pruning is documented, bounded and never touches AuditLog history.
model OpEvent {
  id          String    @id @default(cuid())
  employeeId  String?
  type        String
  status      String    @default("success") // success | failed
  deviceAt    DateTime?
  serverAt    DateTime  @default(now())
  errorCode   String?
  message     String?
  relatedType String?
  relatedId   String?
  requestId   String?
  attempt     Int?
  appVersion  String?

  @@index([employeeId, serverAt])
  @@index([type, serverAt])
  @@index([serverAt])
}

model Config {
  key   String @id
  value String
}

// package 6 (phase 2 / task 4): customer assignment REQUESTS.
//
// The rep (مدرپ) asks the admin to be assigned a customer they know from
// their own plans (the server only ever discloses ids it already showed
// them); the admin approves or rejects from the panel.
//  * employeeId/customerId are PLAIN STRINGS (no FK) — the request history
//    survives employee/customer deletion (display falls back to «حذف‌شده»;
//    approve on a missing row is refused with 409 and the admin can reject).
//  * status: 'pending' | 'approved' | 'rejected' — decisions are terminal.
//  * a PARTIAL unique index (employeeId, customerId WHERE status='pending')
//    is created by instrumentation.ts at boot: at most ONE pending request
//    per (rep, customer) — concurrent submits race into a P2002, not a
//    duplicate. Decided requests never block a fresh request (a rejected
//    rep may ask again later).
//  * approve creates the real Assignment (its own @@unique makes double
//    approval / racing with a manual assignment impossible) and notifies
//    the rep via AppNotification; the admin bell hears about new requests
//    via PanelNotification (kind='request').
model AssignmentRequest {
  id         String    @id @default(cuid())
  employeeId String
  customerId String
  status     String    @default("pending") // pending | approved | rejected
  note       String?   // the rep's note (≤500 chars, server-validated)
  adminNote  String?   // the admin's decision note (visible to the rep)
  decidedAt  DateTime?
  decidedBy  String?   // admin username (Config.adminUser) at decision time
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// phase 1 / task 2 (G-3): administrative audit trail. Actor is the panel's
// single admin account (Config.adminUser) — actorType leaves room for future
// actor kinds. `detail` carries a short human-readable summary and MUST
// never contain passwords, tokens or other secrets.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   @default("admin")
  actorId    String
  action     String // employee.create | employee.update | employee.deactivate | employee.reactivate | employee.revoke-tokens | employee.password-reset | settings.update | ...
  targetType String?
  targetId   String?
  detail     String?
  outcome    String   @default("success")
  createdAt  DateTime @default(now())
}

// ── phase 3: background location tracking ─────────────────────────
//
// LocationPing — ONE row per location fix the app successfully uploaded.
//  * localId (device-generated UUID) is the idempotency key: the app keeps
//    unsent pings locally until the server CONFIRMS them (no silent loss on
//    internet cut), so a replay after a crash mid-upload cannot create a
//    second row — the conflicting insert is counted as a duplicate instead.
//  * recordedAt = device clock when the fix was measured (authoritative for
//    freshness/route order); receivedAt = server clock at insert (device
//    clocks are untrusted for storage decisions like pruning).
//  * retention: rows older than trackRetentionDays are pruned (time-gated,
//    at boot and at most once per 6h on upload) — a documented policy, never
//    a silent loss (only RECEIVED rows are ever pruned).
//  * employeeId FK ON DELETE CASCADE: deactivating is the MedPad lifecycle;
//    truly deleting an employee cleans their track history with them.
model LocationPing {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  localId    String   @unique
  lat        Float
  lng        Float
  accuracy   Float?
  recordedAt DateTime
  receivedAt DateTime  @default(now())

  @@index([employeeId, recordedAt])
}

// TrackStatus — the app's LAST self-reported health snapshot, upserted with
// every successful upload batch (phase 3 §1: "وضعیت مجوز و ردیابی در حدی که
// اپ بتواند گزارش دهد"). One row per employee (1:1). Plain strings as the
// app reports them; the panel renders them as-is with Persian labels.
model TrackStatus {
  employeeId          String   @id
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  locationPermission  String   @default("unknown") // fine | coarse | denied | unknown
  backgroundLocation  String   @default("unknown") // granted | denied | unavailable | unknown
  serviceRunning      Boolean  @default(false)
  batteryUnrestricted Boolean  @default(false)
  appVersion          String?
  lastReportAt        DateTime @default(now())
  // phase 4 — «اعمال‌شده روی دستگاه»: the config the device CONFIRMED it
  // is running (sent with the periodic status report, adopted from the
  // same clamped values the server handed out). NULL = this build of the
  // app has not reported an ack yet. configAckAt = when that report
  // arrived (server clock) — the panel shows saved-vs-applied honestly
  // instead of assuming a save reached the field.
  appliedConfigJson   String?
  configAckAt         DateTime?
}

// ── phase 4: browser Push (Web Push / service worker) ──────────────
// One row per PANEL BROWSER subscription (admin machine — the panel has a
// single admin account, so rows are not user-scoped). endpoint is the
// push service's unique URL (upsert key); p256dh/auth are the client's
// encryption keys. The server NEVER stores notification content — each
// push is encrypted per-subscription at send time and gone.
// Rows are pruned when the push service answers 404/410 (subscription
// gone — browser uninstalled, permission revoked, storage cleared).
model PushSubscription {
  id          String   @id @default(cuid())
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════
// ── Holoo integration (phase 1, Nov 2026) ─────────────────────────
// ═══════════════════════════════════════════════════════════════════
// DATA OWNERSHIP (per the owner's integration instruction):
//  * Holoo owns the ACCOUNTING truth — balances (Mandeh), credit, prices,
//    invoices, payments. Those live HERE, in the Erp* tables, and are
//    ONLY ever written by the sync adapter (lib/holoo-sync.ts).
//  * MedPad owns the OPERATIONAL truth — visits, notes, assignments,
//    check-ins, CRM fields. The sync NEVER writes those.
//  * Customer.erpCode is the single bridge: a Holoo customer linked to a
//    MedPad customer. Linking (or creating an unlinked MedPad row) never
//    assigns the customer to any rep (no auto-assignment, §10).
//
// NO-DELETE POLICY: absence from an API response is NEVER a delete (the
// Holoo API does not report deletions). Rows stay; deactivation is only
// recorded when the API explicitly reports an inactive flag.

/// Holoo-side customer (طرف‌حساب) accounting mirror. erpCode is Holoo's
/// stable external id (base64-ish string) — the sync's idempotency key.
model ErpCustomer {
  id           String   @id @default(cuid())
  erpCode      String   @unique
  code         String?  // human-facing Holoo code (e.g. 00027)
  name         String
  mandeh       Float    @default(0) // مانده حساب (Holoo-owned)
  credit       Float    @default(0) // اعتبار (Holoo-owned)
  nationalId   String?  // کد ملی
  economicId   String?  // کد اقتصادی
  tel          String?
  mobile       String?
  city         String?
  ostan        String?  // استان
  mantagheh    String?  // محدوده/منطقه
  zipCode      String?
  address      String?
  job          String?
  email        String?
  // Holoo-reported inactivity ONLY (absence from a response never flips
  // this — see the no-delete policy above). MedPad's Customer.active is a
  // SEPARATE operational flag the sync never touches.
  active       Boolean  @default(true)
  contentHash  String
  lastSyncedAt DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([active])
}

/// Holoo-side product (کالا) mirror.
model ErpProduct {
  id           String   @id @default(cuid())
  erpCode      String   @unique
  code         String?
  name         String
  few          String?  // واحد شمارش (unit of measure)
  buyPrice     Float?
  sellPrice    Float?
  group        String?  // main/side group name
  active       Boolean  @default(true)
  contentHash  String
  lastSyncedAt DateTime @updatedAt
  createdAt    DateTime @default(now())
}

/// Holoo-side payment (دریافت از مشتری) mirror — from Report/GetCustPay.
model ErpPayment {
  id              String   @id @default(cuid())
  customerErpCode String
  code            String?  // Holoo document code (sync synthesizes one when the API returns none — see holoo-sync)
  name            String?
  price           Float    @default(0)
  date            DateTime
  mandeh          Float?
  contentHash     String
  lastSyncedAt    DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([customerErpCode, code])
  @@index([customerErpCode])
}

/// One row per sync run (initial | incremental | manual) — the panel's
/// «وضعیت سینک» view and the scheduler's watermark. `errors` is a JSON
/// array of SAFE strings (classified error kinds + counts — NEVER
/// credentials, tokens or raw password material).
model HolooSyncLog {
  id          String    @id @default(cuid())
  kind        String
  status      String    // running | success | error
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  checked     Int       @default(0)
  created     Int       @default(0)
  updated     Int       @default(0)
  unchanged   Int       @default(0)
  deactivated Int       @default(0)
  errors      String?
  checkpoint  String?   // JSON watermark (last success time etc.)

  @@index([startedAt])
}
