+                  </span>
+                </div>
+                <div className="mt-1 flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs text-muted-foreground">
+                  {r.errorCode && (
+                    <span className="rounded bg-rose-100 px-1 text-rose-700" data-testid={`event-code-${r.id}`}>
+                      {r.errorCode}
+                    </span>
