+          <Input type="date" dir="ltr" className="text-left" value={fFrom} onChange={(e) => { setFFrom(e.target.value); setPage(1) }} data-testid="events-filter-from" />
+        </div>
+        <div className="space-y-1">
+          <Label className="text-xs">تا تاریخ</Label>
+          <Input type="date" dir="ltr" className="text-left" value={fTo} onChange={(e) => { setFTo(e.target.value); setPage(1) }} data-testid="events-filter-to" />
+        </div>
