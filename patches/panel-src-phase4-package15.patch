diff -ruN a/src/app/api/app/events/route.ts b/src/app/api/app/events/route.ts
--- a/src/app/api/app/events/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/app/events/route.ts	2026-10-31 02:22:34.964990016 +0000
@@ -0,0 +1,124 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { appEmployee } from '@/lib/auth'
+import { writeOpEvent, OP_EVENT_TYPES, type OpEventInput } from '@/lib/op-event'
+
+export const dynamic = 'force-dynamic'
+
+/**
+ * Mission item 10 — the DEVICE-SIDE half of the operational event log.
+ *
+ * The app records meaningful device events locally (Room, mission-item-10
+ * migration) — offline queue lifecycle, notification display results,
+ * permission changes — and uploads them in idempotent batches:
+ *
+ *   POST /api/app/events  { events: [{ localId, type, status, at,
+ *                             errorCode?, message?, relatedType?,
+ *                             relatedId?, attempt?, appVersion? }] }
+ *
+ * Rules (mirrored in the app's EventSync):
+ *  - employee-scoped by the TOKEN — a rep can only log their own events;
+ *  - ≤ 100 events per batch, strict per-field validation (types from the
+ *    fixed taxonomy; unknown types are rejected with the whole batch);
+ *  - requestId = localId → the unique index makes a replayed batch (offline
+ *    flush retried after a crash mid-ack) count as duplicates, NEVER as
+ *    second logical rows;
+ *  - rows are deleted from the device ONLY after the server acknowledged —
+ *    internet cuts never lose events silently;
+ *  - "delivered" here means the SERVER stored the event — success of the
+ *    upload, not of the operation the event describes (status carries that).
+ */
+const MAX_BATCH = 100
+
+interface ClientEvent {
+  localId?: unknown
+  type?: unknown
+  status?: unknown
+  at?: unknown
+  errorCode?: unknown
+  message?: unknown
+  relatedType?: unknown
+  relatedId?: unknown
+  attempt?: unknown
+  appVersion?: unknown
+}
+
+function str(v: unknown, max: number): string | null {
+  if (typeof v !== 'string') return null
+  const t = v.trim()
+  return t.length === 0 ? null : t.slice(0, max)
+}
+
+export async function POST(req: Request) {
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+
+  const body = await req.json().catch(() => null) as { events?: ClientEvent[] } | null
+  const events = body?.events
+  if (!Array.isArray(events) || events.length === 0) {
+    return NextResponse.json({ ok: false, error: 'رویدادی ارسال نشده است' }, { status: 400 })
+  }
+  if (events.length > MAX_BATCH) {
+    return NextResponse.json(
+      { ok: false, error: `حداکثر ${MAX_BATCH} رویداد در هر دسته` },
+      { status: 400 },
+    )
+  }
+
+  const validTypes = new Set<string>(OP_EVENT_TYPES)
+  const rows: OpEventInput[] = []
+  for (const e of events) {
+    const localId = str(e.localId, 100)
+    const type = str(e.type, 40)
+    if (!localId || !type || !validTypes.has(type)) {
+      return NextResponse.json(
+        { ok: false, error: 'رویداد نامعتبر (شناسه یا نوع ناشناخته)' },
+        { status: 400 },
+      )
+    }
+    const status = e.status === 'failed' ? 'failed' : 'success'
+    let deviceAt: Date | null = null
+    if (typeof e.at === 'string' && e.at.trim()) {
+      const d = new Date(e.at)
+      if (!isNaN(d.getTime())) deviceAt = d
+    }
+    const attemptRaw = Number(e.attempt)
+    rows.push({
+      employeeId: emp.id,
+      type: type as OpEventInput['type'],
+      status: status as 'success' | 'failed',
+      deviceAt,
+      errorCode: str(e.errorCode, 60),
+      message: str(e.message, 300),
+      relatedType: str(e.relatedType, 30),
+      relatedId: str(e.relatedId, 100),
+      requestId: localId,
+      attempt: Number.isFinite(attemptRaw) && attemptRaw >= 0 && attemptRaw < 1000
+        ? Math.trunc(attemptRaw)
+        : null,
+      appVersion: str(e.appVersion, 30),
+    })
+  }
+
+  let stored = 0
+  let duplicated = 0
+  for (const r of rows) {
+    const ok = await writeOpEvent(r)
+    if (ok) stored++
+    else duplicated++ // same requestId already stored (a replayed batch)
+  }
+  return NextResponse.json({ ok: true, stored, duplicated })
+}
+
+/** GET — a rep may read ONLY their own recent events (the mission's
+ *  «هر بازاریاب فقط رویدادهای مجاز خودش را در اپ مشاهده کند»). */
+export async function GET(req: Request) {
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  const rows = await db.opEvent.findMany({
+    where: { employeeId: emp.id },
+    orderBy: { serverAt: 'desc' },
+    take: 50,
+  })
+  return NextResponse.json({ ok: true, events: rows })
+}
