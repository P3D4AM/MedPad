+// mission item 10 (Oct 31) — the unified OPERATIONAL event log: one row per
+// meaningful operational event, server-observed (check-in/checkout results
+// incl. rejections, logins, report edits) AND device-observed (queue
+// lifecycle, notification display results, permission changes — uploaded in
+// idempotent batches by the app, see POST /api/app/events).
+//
+// Semantics:
+//  - deviceAt = WHEN THE DEVICE SAYS IT HAPPENED (client clock; may skew —
+//    serverAt is the reliable reference and is ALWAYS server clock);
+//  - status distinguishes outcome (success | failed) — "the client sent it"
+//    is NOT success; the server's own business result is;
+//  - requestId = the idempotency key (the client event's localId or the
+//    server's eventKey): a replayed upload can NEVER create a second
+//    logical row (unique index; P2002 is swallowed as a duplicate);
+//  - message/errorCode are SAFE for admin eyes — never passwords, tokens,
+//    voice content or unnecessary customer data (write sites enforce it);
+//  - type is a fixed taxonomy (lib/op-event.ts) — validation rejects
+//    unknown types so the filters stay meaningful;
+//  - retention: eventRetentionDays (admin setting) prunes OLD rows at boot
+//    — pruning is documented, bounded and never touches AuditLog history.
+model OpEvent {
+  id          String    @id @default(cuid())
+  employeeId  String?
+  type        String
+  status      String    @default("success") // success | failed
+  deviceAt    DateTime?
+  serverAt    DateTime  @default(now())
+  errorCode   String?
+  message     String?
+  relatedType String?
+  relatedId   String?
+  requestId   String?
+  attempt     Int?
+  appVersion  String?
+
+  @@index([employeeId, serverAt])
+  @@index([type, serverAt])
+  @@index([serverAt])
+}
+
 model Config {
   key   String @id
   value String
diff -ruN a/src/app/api/admin/events/route.ts b/src/app/api/admin/events/route.ts
--- a/src/app/api/admin/events/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/admin/events/route.ts	2026-10-31 02:21:39.998796304 +0000
@@ -0,0 +1,115 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+
+export const dynamic = 'force-dynamic'
+
+/**
+ * Mission item 10 — the admin's OPERATIONAL EVENT REPORT.
+ *
+ *   GET /api/admin/events
+ *     employeeId=<id>      one rep (default: all)
+ *     from=YYYY-MM-DD      serverAt ≥ that day's start (server-local)
+ *     to=YYYY-MM-DD        serverAt ≤ that day's end (inclusive)
+ *     kind=<kind>          combinable category filter:
+ *                          visit | sync | account | notif | location
+ *     status=success|failed
+ *     op=checkin|checkout  visit-kind refinement (check-in vs check-out)
+ *     q=<text>             substring match on errorCode / relatedId / message
+ *     page=1..             100 rows per page (bounded responses, always)
+ *
+ * All filters COMBINE (e.g. failed check-outs of one rep on one day).
+ * Admin session only. The response carries the employee list for the
+ * filter dropdown (id + name, no secrets).
+ */
+
+const KIND_PREFIXES: Record<string, string[]> = {
+  visit: ['checkin', 'checkout'],
+  sync: ['queue.'],
+  account: ['login', 'logout'],
+  notif: ['notif.'],
+  location: ['permission.'],
+}
+
+const PAGE_SIZE = 100
+
+export async function GET(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const url = new URL(req.url)
+  const employeeId = url.searchParams.get('employeeId')
+  const from = url.searchParams.get('from')
+  const to = url.searchParams.get('to')
+  const kind = url.searchParams.get('kind')
+  const status = url.searchParams.get('status')
+  const op = url.searchParams.get('op')
+  const q = url.searchParams.get('q')
+  const page = Math.max(1, Number(url.searchParams.get('page')) || 1)
+
+  const where: Record<string, unknown> = {}
+  if (employeeId) where.employeeId = employeeId
+  if (status === 'success' || status === 'failed') where.status = status
+
+  // server-local day range on serverAt (inclusive both ends)
+  if (from || to) {
+    const range: Record<string, unknown> = {}
+    if (from && /^\d{4}-\d{2}-\d{2}$/.test(from)) {
+      const d = new Date(`${from}T00:00:00`)
+      if (!isNaN(d.getTime())) range.gte = d
+    }
+    if (to && /^\d{4}-\d{2}-\d{2}$/.test(to)) {
+      const d = new Date(`${to}T23:59:59.999`)
+      if (!isNaN(d.getTime())) range.lte = d
+    }
+    if (Object.keys(range).length > 0) where.serverAt = range
+  }
+
+  // kind → type prefixes; op refines the visit kind to check-in/check-out
+  const prefixes: string[] = []
+  if (kind && KIND_PREFIXES[kind]) prefixes.push(...KIND_PREFIXES[kind])
+  if (op === 'checkin' || op === 'checkout') {
+    prefixes.length = 0
+    prefixes.push(op)
+  }
+  if (prefixes.length > 0) {
+    where.OR = prefixes.map((p) => ({ type: { startsWith: p } }))
+  }
+
+  // free-text: errorCode / relatedId / message (OR-combined contains)
+  if (q && q.trim()) {
+    const needle = q.trim()
+    const textCond = {
+      OR: [
+        { errorCode: { contains: needle } },
+        { relatedId: { contains: needle } },
+        { message: { contains: needle } },
+      ],
+    }
+    where.AND = [textCond, ...(where.OR ? [{ OR: where.OR }] : [])]
+    delete where.OR
+  }
+
+  const [rows, total, employees] = await Promise.all([
+    db.opEvent.findMany({
+      where,
+      orderBy: { serverAt: 'desc' },
+      take: PAGE_SIZE,
+      skip: (page - 1) * PAGE_SIZE,
+    }),
+    db.opEvent.count({ where }),
+    db.employee.findMany({
+      select: { id: true, name: true },
+      orderBy: { name: 'asc' },
+    }),
+  ])
+  return NextResponse.json({
+    ok: true,
+    events: rows,
+    total,
+    page,
+    pageSize: PAGE_SIZE,
+    pages: Math.max(1, Math.ceil(total / PAGE_SIZE)),
+    employees,
+  })
+}
