+  op: 'same' | 'add' | 'del'
+  text: string
+}
+
+/** word tokens, whitespace-normalized (the verbatim texts stay available
+ *  in the story view's «متن اولیه / متن فعلی» blocks — the diff is a
+ *  visualization, so single-spacing is the honest, noise-free choice:
+ *  a trailing-space difference must not show up as a replaced word) */
+export function tokenizeWords(s: string): string[] {
+  return s.split(/\s+/).filter((w) => w.length > 0)
+}
+
+/** safety cap — beyond this, diffing degrades to a whole-text replace */
+export const DIFF_TOKEN_CAP = 2500
+
+export function diffWords(oldText: string | null | undefined, newText: string | null | undefined): DiffPart[] {
+  const a = tokenizeWords(oldText ?? '')
+  const b = tokenizeWords(newText ?? '')
+  if (a.length === 0 && b.length === 0) return []
+  if (a.length > DIFF_TOKEN_CAP || b.length > DIFF_TOKEN_CAP) {
+    return [
+      ...(a.length ? [{ op: 'del' as const, text: a.join(' ') }] : []),
+      ...(b.length ? [{ op: 'add' as const, text: b.join(' ') }] : []),
+    ]
+  }
+
+  // LCS lengths table: lcs[i][j] = LCS length of a[i..] and b[j..]
+  const n = a.length
+  const m = b.length
+  const lcs: number[][] = Array.from({ length: n + 1 }, () => new Array<number>(m + 1).fill(0))
+  for (let i = n - 1; i >= 0; i--) {
+    for (let j = m - 1; j >= 0; j--) {
+      lcs[i][j] = a[i] === b[j] ? lcs[i + 1][j + 1] + 1 : Math.max(lcs[i + 1][j], lcs[i][j + 1])
+    }
+  }
+
+  // walk forward, emitting ops; a word separator is implied between two
+  // consecutive parts (tokens are whitespace-normalized); then merge
+  // consecutive same-op parts so the renderer produces few spans
+  const parts: DiffPart[] = []
+  let i = 0
+  let j = 0
+  const push = (op: DiffPart['op'], text: string) => {
+    const last = parts[parts.length - 1]
+    if (last && last.op === op) last.text += ' ' + text
+    else parts.push({ op, text })
+  }
+  while (i < n && j < m) {
+    if (a[i] === b[j]) {
+      push('same', a[i])
+      i++
+      j++
+    } else if (lcs[i + 1][j] >= lcs[i][j + 1]) {
+      push('del', a[i])
+      i++
+    } else {
+      push('add', b[j])
+      j++
+    }
+  }
+  while (i < n) push('del', a[i++])
+  while (j < m) push('add', b[j++])
+  return parts
+}
+
+/** Convenience for tests/labels: how many added/removed words a diff has. */
+export function diffStats(parts: DiffPart[]): { added: number; removed: number } {
+  let added = 0
+  let removed = 0
+  for (const p of parts) {
+    if (p.op === 'add') added += p.text.trim() ? p.text.trim().split(/\s+/).length : 0
+    if (p.op === 'del') removed += p.text.trim() ? p.text.trim().split(/\s+/).length : 0
+  }
+  return { added, removed }
+}
