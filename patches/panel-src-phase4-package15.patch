+            <SelectTrigger data-testid="events-filter-kind"><SelectValue /></SelectTrigger>
+            <SelectContent>
+              <SelectItem value="all">همه</SelectItem>
+              <SelectItem value="visit">ویزیت (چک‌این/چک‌اوت)</SelectItem>
+              <SelectItem value="sync">همگام‌سازی و صف</SelectItem>
+              <SelectItem value="account">حساب</SelectItem>
+              <SelectItem value="notif">اعلان‌ها</SelectItem>
+              <SelectItem value="location">مکان‌یابی</SelectItem>
+            </SelectContent>
+          </Select>
+        </div>
+        <div className="space-y-1">
