--- a/src/lib/op-event.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/op-event.ts	2026-10-31 02:19:59.148447478 +0000
@@ -0,0 +1,89 @@
+import { db } from '@/lib/db'
+
+/**
+ * Mission item 10 (Oct 31) — the unified operational event log.
+ *
+ * ONE helper owns the taxonomy and the safe-field rules so every capture
+ * site (server-observed results + the app's idempotent batch upload)
+ * writes the SAME shape and the panel's filters stay meaningful.
+ *
+ * "Operational" is deliberately NARROW: events that matter for supervising
+ * and debugging field work — visit outcomes (incl. every rejection with
+ * its reason), the offline queue's lifecycle as seen from the device,
+ * notification delivery results, permission changes, logins. NOT logged:
+ * page opens, routine polls, or anything carrying secrets (passwords,
+ * tokens, voice content, unnecessary customer data — write sites keep
+ * messages to safe technical Persian/English summaries).
+ *
+ * deviceAt vs serverAt: the device's claim about when it happened vs the
+ * trustworthy server receive time. Success is the SERVER's business
+ * result, never "the client sent something".
+ */
+
+export const OP_EVENT_TYPES = [
+  // ── visit lifecycle (server-observed) ──────────────────────────
+  'checkin', // a check-in was recorded (message carries planned/plan-less + geo summary)
+  'checkout',
+  'checkin.rejected', // errorCode: assignment | geo-radius | open-visit | validation
+  'checkout.rejected', // errorCode: no-open-visit | geo-radius | validation
+  // ── reports (server-observed) ──────────────────────────────────
+  'report.edit',
+  // ── account (server-observed) ──────────────────────────────────
+  'login',
+  // ── sync/queue lifecycle (device-observed, batch-uploaded) ─────
+  'queue.enqueued',
+  'queue.delivered', // the server confirmed the queued item
+  'queue.rejected', // the server permanently rejected it (errorCode = HTTP status family)
+  'queue.retry', // manual retry from the queue screen
+  'queue.dropped', // queue cleared on a server switch (with the user-confirmed reason)
+  // ── notifications (device-observed) ────────────────────────────
+  'notif.shown',
+  'notif.display_failed', // permission/channel blocked → retried next poll
+  // ── permissions (device-observed) ──────────────────────────────
+  'permission.location',
+] as const
+export type OpEventType = (typeof OP_EVENT_TYPES)[number]
+
+export interface OpEventInput {
+  employeeId?: string | null
+  type: OpEventType
+  status?: 'success' | 'failed'
+  deviceAt?: Date | null
+  errorCode?: string | null
+  message?: string | null
+  relatedType?: string | null
+  relatedId?: string | null
+  /** idempotency key — replays never double-log (unique index, P2002 swallowed) */
+  requestId?: string | null
+  attempt?: number | null
+  appVersion?: string | null
+}
+
+/** Write one event. Best-effort BY DESIGN: an event-logging failure must
+ *  never fail or slow the business operation it observes (same contract as
+ *  writeAudit/notify). Returns true when the row landed (false = swallowed
+ *  duplicate or logging failure — both are fine). */
+export async function writeOpEvent(input: OpEventInput): Promise<boolean> {
+  try {
+    await db.opEvent.create({
+      data: {
+        employeeId: input.employeeId ?? null,
+        type: input.type,
+        status: input.status ?? 'success',
+        deviceAt: input.deviceAt ?? null,
+        errorCode: input.errorCode ?? null,
+        message: input.message ? input.message.slice(0, 300) : null,
+        relatedType: input.relatedType ?? null,
+        relatedId: input.relatedId ?? null,
+        requestId: input.requestId ?? null,
+        attempt: input.attempt ?? null,
+        appVersion: input.appVersion ?? null,
+      },
+    })
+    return true
+  } catch (e: unknown) {
+    if ((e as { code?: string })?.code === 'P2002') return false // same requestId already logged
+    console.error('[op-event] failed to write:', input.type, e instanceof Error ? e.message : e)
+    return false
+  }
+}
