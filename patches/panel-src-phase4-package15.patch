@@ -0,0 +1,59 @@
+/**
+ * Mission item 2 (Oct 31) — first/last name split, shared by the create
+ * and edit endpoints so the rules exist in exactly ONE place.
+ *
+ * Contract (additive, backward compatible):
+ *  - `name` alone still works (legacy callers / old panel builds): stored
+ *    verbatim, firstName/lastName untouched.
+ *  - `firstName`/`lastName` present → the two fields are stored as given
+ *    (either may be an empty string = explicitly cleared) and `name` is
+ *    RECOMPUTED as the trimmed join of the non-empty parts. A join that
+ *    would be empty is rejected (name is NOT NULL and must never become
+ *    an empty string).
+ *  - On UPDATE, a missing key keeps the stored value of that part; on
+ *    CREATE a missing key counts as empty.
+ *  - No migration ever splits historical `name` values — only an explicit
+ *    admin write through these fields sets the split (mission rule:
+ *    «migration نباید نام‌ها را بدون بررسی به‌صورت مخرب تقسیم کند»).
+ */
+
+export const NAME_PART_MAX = 60
+
+export interface NameSplitInput {
+  firstName?: unknown
+  lastName?: unknown
+}
+
+export interface NameSplitResult {
+  error?: string
+  /** null = the split fields were NOT provided (legacy `name` path) */
+  firstName?: string | null
+  lastName?: string | null
+  /** recomputed full name (only set when the split path was taken) */
+  name?: string
+}
+
+function cleanPart(v: unknown): { error?: string; value?: string } {
+  if (typeof v !== 'string') return { error: 'نام و نام خانوادگی باید متن باشند' }
+  const t = v.trim()
+  if (t.length > NAME_PART_MAX) {
+    return { error: `نام/نام خانوادگی باید حداکثر ${NAME_PART_MAX} نویسه باشد` }
+  }
+  return { value: t }
+}
+
+export function resolveNameSplit(
+  body: NameSplitInput | null,
+  existing?: { firstName: string | null; lastName: string | null },
+): NameSplitResult {
+  if (!body || (body.firstName === undefined && body.lastName === undefined)) return {}
+  const a = cleanPart(body.firstName ?? (existing?.firstName ?? ''))
+  if (a.error) return { error: a.error }
+  const b = cleanPart(body.lastName ?? (existing?.lastName ?? ''))
+  if (b.error) return { error: b.error }
+  const joined = [a.value, b.value].filter((p) => p && p.length > 0).join(' ').trim()
+  if (!joined) {
+    return { error: 'نام و نام خانوادگی نمی‌توانند هر دو خالی باشند' }
+  }
+  return { firstName: a.value || null, lastName: b.value || null, name: joined }
+}
