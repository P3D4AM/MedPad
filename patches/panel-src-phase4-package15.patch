+                  >
+                    {r.status === 'failed' ? 'ناموفق' : 'موفق'}
+                  </span>
+                  <span className="font-medium">{typeLabel(r.type)}</span>
+                  <span className="text-xs text-muted-foreground">— {empName(r.employeeId)}</span>
