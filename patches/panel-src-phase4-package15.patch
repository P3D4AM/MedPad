+                }`}
+                data-testid={`event-row-${r.id}`}
+              >
+                <div className="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
+                  <span
+                    className={`rounded px-1.5 py-0.5 text-xs font-medium ${
