+} from '@/components/ui/select'
+
+/**
+ * Mission item 10 — «گزارش رویدادها»: the admin's operational event report.
+ *
+ * COMBINABLE filters (the mission's example — «رویدادهای ناموفق چک‌اوت یک
+ * بازاریاب در یک روز مشخص» — is one selection in this UI):
+ *   rep · day range · category (ویزیت/همگام‌سازی/حساب/اعلان/مکان‌یابی) ·
+ *   check-in vs check-out · success/failed · free text (error code,
+ *   related id, message). Paginated (100/page, bounded).
+ *
+ * Every row shows the DEVICE time and the SERVER time separately when the
+ * device reported one, the status, the safe message and the related record
+ * id. No secrets are ever present (write sites enforce it).
+ */
+
+interface OpEventRow {
+  id: string
+  employeeId: string | null
+  type: string
+  status: string
+  deviceAt: string | null
+  serverAt: string
+  errorCode: string | null
+  message: string | null
+  relatedType: string | null
+  relatedId: string | null
+  attempt: number | null
+  appVersion: string | null
+}
+
+interface EmployeeLite {
+  id: string
+  name: string
+}
+
+const TYPE_LABELS: Record<string, string> = {
+  'checkin': 'چک‌این',
+  'checkout': 'چک‌اوت',
+  'checkin.rejected': 'چک‌این ردشد',
+  'checkout.rejected': 'چک‌اوت ردشد',
+  'report.edit': 'ویرایش گزارش',
+  'login': 'ورود',
+  'queue.enqueued': 'ورود به صف',
