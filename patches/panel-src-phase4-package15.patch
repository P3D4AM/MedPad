+'use client'
+
+import { useMemo } from 'react'
+import { diffWords } from '@/lib/diff'
+
+/**
+ * Mission item 5 — the visible word-diff of ONE edit (oldNote → newNote),
+ * RTL-safe: a single dir="rtl" paragraph where removed words render
+ * struck-through red and added words render highlighted green. Whitespace
+ * travels with its word (tokenizeWords) so the concatenation of all parts
+ * is exactly the two texts interleaved — nothing is reordered by the
+ * renderer, the bidi algorithm sees the original flow.
+ */
+export default function NoteDiff({
+  oldText,
+  newText,
+  testId,
+}: {
+  oldText: string | null | undefined
+  newText: string | null | undefined
+  testId?: string
+}) {
+  const parts = useMemo(() => diffWords(oldText, newText), [oldText, newText])
+  if (parts.length === 0) {
+    return <p className="text-sm text-muted-foreground" data-testid={testId}>—</p>
+  }
+  return (
+    <p
+      dir="rtl"
+      className="whitespace-pre-wrap break-words text-sm leading-7"
+      data-testid={testId}
+    >
+      {parts.map((p, i) => {
+        // tokens are whitespace-normalized — the separator between parts is
+        // rendered here (never inside a styled span, so highlight bounds stay
+        // exactly on the changed words)
+        const sep = i > 0 ? ' ' : null
+        if (p.op === 'same') {
+          return (
+            <span key={i}>
+              {sep}
+              {p.text}
+            </span>
+          )
+        }
+        return (
+          <span
+            key={i}
+            data-testid={`${testId}-${p.op}`}
+            className={
+              p.op === 'add'
+                ? 'rounded bg-emerald-100 px-0.5 text-emerald-900'
+                : 'rounded bg-red-100 px-0.5 text-red-800 line-through opacity-80'
+            }
+          >
+            {sep}
+            {p.text}
+          </span>
+        )
+      })}
+    </p>
+  )
+}
