+// ── Task 12.1: robust response extraction ─────────────────────────────
+//
+// The LIVE service (owner's field test, Nov 2026) wraps every list in a
+// business-named envelope — exact observed shapes:
+//     GET Customer        → {"Customer": [ … ]}
+//     GET Product         → {"product":  [ … ]}   (lowercase!)
+//     GET Report/GetCustPay → {"report":  [ … ]}
+// The previous extractor only knew data/list/items/records/result and
+// therefore returned the WHOLE envelope as one bogus "record" — the root
+// cause of the live "zero imported records" report. These wrappers are
+// now first-class, matched case-insensitively, with bounded recursive
+// unwrapping and explicit diagnostics.
+
+/** Known Holoo response wrapper keys (lowercased; matched case-insensitively).
+ *  'code'/'name' are deliberately NOT wrappers — they are record FIELDS. */
+const KNOWN_WRAPPER_KEYS = new Set([
+  'customer', 'customers', 'product', 'products', 'invoice', 'invoices',
+  'report', 'reports', 'data', 'list', 'items', 'records', 'result', 'results',
+])
+
+/** Field-name hints (lowercased) that qualify a standalone object as a
+ *  business record rather than an envelope/status object — drawn from the
+ *  field-mapper candidates of all four record types. */
+const RECORD_FIELD_HINTS = new Set([
+  'erpcode', 'code', 'name', 'mandeh', 'credit', 'price', 'date',
+  'customererpcode', 'custerpcode', 'few', 'unit', 'buyprice', 'sellprice',
+  'sumprice', 'sum', 'total', 'scot', 'discount', 'sanadcode', 'invoiceno',
+  'groupname', 'maingroupname', 'isactive', 'isblacklist', 'nationalid',
+  'economicid', 'mobile', 'tel', 'city', 'ostan', 'address', 'email',
+])
+
+function isPlainObject(v: unknown): v is Record<string, unknown> {
+  return !!v && typeof v === 'object' && !Array.isArray(v)
+}
+
+/** A standalone object counts as ONE business record only when it has
+ *  several keys AND at least one recognized business field — arbitrary
+ *  one-key objects and status/error envelopes must NOT become records
+ *  (Task 12.1 rule 3). */
+function looksLikeSingleRecord(o: Record<string, unknown>): boolean {
+  const keys = Object.keys(o)
+  if (keys.length < 2) return false
+  return keys.some((k) => RECORD_FIELD_HINTS.has(k.toLowerCase()))
+}
+
+export interface HolooExtraction {
+  /** array = direct JSON array · wrapped = business/generic wrapper(s)
+   *  unwrapped · single = a standalone record object · unrecognized =
+   *  no known wrapper and not a qualifying record (INVALID — a valid
+   *  empty business list is 'array'/'wrapped' with count 0, never this) */
+  kind: 'array' | 'wrapped' | 'single' | 'unrecognized'
+  /** the immediate key that carried the extracted payload, as received
+   *  (e.g. "Customer" / "product" / "report" / "CUSTOMERS") */
+  wrapper: string | null
+  /** normalized response shape, e.g. object{Customer:array(3)} */
+  shape: string
+  /** extracted item count */
+  count: number
+  /** first record's FIELD NAMES (≤12) — never values (privacy) */
+  firstRecordKeys: string[]
+  /** top-level response keys (≤8) — diagnostics for unrecognized bodies */
+  responseKeys: string[]
+  /** wrapper levels unwrapped (bounded 0..3) */
+  depth: number
+}
+
+const MAX_UNWRAP_DEPTH = 3
+
+/** Bounded recursive unwrapping with explicit known-wrapper rules.
+ *  Never flattens arbitrary objects; never mistakes an envelope for a
+ *  record (an object that BOTH carries a wrapper-named key and business
+ *  fields is a RECORD containing a wrapper-named field, e.g. a "Customer"
+ *  name string on an invoice row — it is not unwrapped). */
+export function extractHolooItemsDetailed(raw: unknown): {
+  items: Record<string, unknown>[]
+  extraction: HolooExtraction
+} {
+  const shapeOf = (v: unknown): string => {
+    if (Array.isArray(v)) return `array(${v.length})`
+    if (isPlainObject(v)) return `object(${Object.keys(v).length} keys)`
+    if (v === null) return 'null'
+    return typeof v
+  }
+  const topKeys = isPlainObject(raw) ? Object.keys(raw).slice(0, 8) : []
+  let cur: unknown = raw
+  let depth = 0
+  let wrapper: string | null = null
+  let prefix = ''
+
+  const finish = (items: Record<string, unknown>[], kind: HolooExtraction['kind']): { items: Record<string, unknown>[]; extraction: HolooExtraction } => ({
+    items,
+    extraction: {
+      kind,
+      wrapper,
+      shape: prefix + shapeOf(cur) + '}'.repeat(depth),
+      count: items.length,
+      firstRecordKeys: items[0] ? Object.keys(items[0]).slice(0, 12) : [],
+      responseKeys: topKeys,
+      depth,
+    },
+  })
+  const unrecognized = () => finish([], 'unrecognized')
+
+  while (depth < MAX_UNWRAP_DEPTH) {
+    if (Array.isArray(cur)) {
+      const items = cur.filter(isPlainObject)
+      return finish(items, depth ? 'wrapped' : 'array')
+    }
+    if (!isPlainObject(cur)) return unrecognized()
+    const keys = Object.keys(cur)
