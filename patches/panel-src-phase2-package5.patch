@@ -6,18 +6,48 @@
  * package 4 (phase 2 / task 3) — mark PANEL notifications as read.
  *
  * POST /api/panel-notifications/read   body: { ids?: string[] }
- *   ids[]  → mark those rows read
- *   (absent/empty) → mark ALL read
+ *   ids absent/null     -> mark ALL read (the «همه خوانده شد» button)
+ *   ids: ["a","b",...]  -> mark those rows read (idempotent; unknown ids
+ *                          simply match nothing)
  * ADMIN-ONLY. Idempotent by nature (re-marking a read row is a no-op).
+ *
+ * package 5 / phase 5-B hardening — tightened BEFORE the first consumer
+ * (the 5-C bell) exists, so nothing breaks:
+ *   - `ids` present must be a NON-EMPTY array of strings, at most 1000
+ *     entries. Previously `ids: []`, `ids: "str"` and `ids: [1,2]` all
+ *     fell through to the mark-ALL branch — one malformed UI request
+ *     could silently wipe the read state of the whole table — and
+ *     non-string ids made Prisma throw a 500. Both are explicit 400s now
+ *     and mark NOTHING.
+ *   - a body that is not a JSON object (broken JSON, "text", [..]) is a
+ *     400 too (it also used to fall through to mark-ALL).
+ *   - the 1000-entry cap keeps the SQLite bind-parameter count bounded.
+ *   - the response stays `{ ok: true }` ON PURPOSE: no counters here, so
+ *     the bell UI (5-C) must always refetch after marking — the H1
+ *     defensive requirement from phase 5-A.
  */
+const MAX_IDS = 1000
+
 export async function POST(req: Request) {
   if (!(await isAdmin())) {
     return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
   }
   const body = await req.json().catch(() => null) as { ids?: string[] | null } | null
+  if (body === null || typeof body !== 'object' || Array.isArray(body)) {
+    return NextResponse.json({ ok: false, error: 'bad-body' }, { status: 400 })
+  }
   const data = { readAt: new Date() }
-  if (Array.isArray(body?.ids) && body!.ids!.length > 0) {
-    await db.panelNotification.updateMany({ where: { id: { in: body!.ids! } }, data })
+  if (body.ids !== undefined && body.ids !== null) {
+    const ids = body.ids
+    if (
+      !Array.isArray(ids) ||
+      ids.length === 0 ||
+      ids.length > MAX_IDS ||
+      ids.some((i) => typeof i !== 'string')
+    ) {
+      return NextResponse.json({ ok: false, error: 'bad-ids' }, { status: 400 })
+    }
+    await db.panelNotification.updateMany({ where: { id: { in: ids } }, data })
   } else {
     await db.panelNotification.updateMany({ where: { readAt: null }, data })
   }
