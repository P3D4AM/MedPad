  */
 export async function GET() {
   if (!(await isAdmin())) {
     return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
   }
-  const rows = await db.panelNotification.findMany({
-    orderBy: { createdAt: 'desc' },
-    take: 100,
-  })
+  const [rows, totalUnread] = await Promise.all([
+    db.panelNotification.findMany({
+      orderBy: { createdAt: 'desc' },
+      take: 100,
+    }),
+    db.panelNotification.count({ where: { readAt: null } }),
+  ])
   const unread = rows.filter((r) => !r.readAt).length
-  return NextResponse.json({ ok: true, notifications: rows, unread })
+  return NextResponse.json({ ok: true, notifications: rows, unread, totalUnread })
 }
