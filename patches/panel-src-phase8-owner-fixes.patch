--- a/src/lib/jalali.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/jalali.ts	2026-11-07 09:37:12.464034475 +0000
@@ -0,0 +1,144 @@
+/**
+ * owner fix batch (Nov 2026) — Jalali (Persian) calendar math for the
+ * panel's month calendar in the plans tab. Clean port of the SAME
+ * jalaali-js algorithms the Android app uses (JalaliDate.kt) so both
+ * sides agree on month lengths, leap years and weekday indices.
+ * All months/days are 1-based.
+ */
+
+export interface JDate {
+  jy: number
+  jm: number
+  jd: number
+}
+
+const div = (a: number, b: number) => Math.trunc(a / b)
+const mod = (a: number, b: number) => {
+  const r = a % b
+  return r < 0 ? r + b : r
+}
+
+export function isLeapJalali(jy: number): boolean {
+  const m = mod(jy, 33)
+  return [1, 5, 9, 13, 17, 22, 26, 30].includes(m)
+}
+
+function jalCal(jy: number): number[] {
+  const breaks = [
+    -61, 9, 38, 199, 426, 686, 756, 818, 1111, 1181, 1210, 1635, 2060, 2097,
+    2192, 2262, 2324, 2394, 2456, 3178,
+  ]
+  const gy = jy + 621
+  let leapJ = -14
+  let jp = breaks[0]
+  let jump = 0
+  for (let i = 1; i < breaks.length; i++) {
+    const jm = breaks[i]
+    jump = jm - jp
+    if (jy < jm) break
+    leapJ += div(jump, 33) * 8 + div(mod(jump, 33), 4)
+    jp = jm
+  }
+  let n = jy - jp
+  leapJ += div(n, 33) * 8 + div(mod(n, 33) + 3, 4)
+  if (mod(jump, 33) === 4 && jump - n === 4) leapJ += 1
+  const leapG = div(gy, 4) - div((div(gy, 100) + 1) * 3, 4) - 150
+  const march = 20 + leapJ - leapG
+  if (jump - n < 6) n = n - jump + div(jump + 4, 33) * 33
+  let leap = mod(mod(n + 1, 33) - 1, 4)
+  if (leap === -1) leap = 4
+  return [leap, gy, march]
+}
+
+function g2d(gy: number, gm: number, gd: number): number {
+  let d =
+    div((gy + div(gm - 8, 6) + 100100) * 1461, 4) +
+    div(153 * mod(gm + 9, 12) + 2, 5) +
+    gd -
+    34840408
+  d = d - div(div(gy + 100100 + div(gm - 8, 6), 100) * 3, 4) + 752
+  return d
+}
+
+function d2g(jdn: number): number[] {
+  let j = 4 * jdn + 139361631
+  j = j + div(div(4 * jdn + 183187720, 146097) * 3, 4) * 4 - 3908
+  const i = div(mod(j, 1461), 4) * 5 + 308
+  const gd = div(mod(i, 153), 5) + 1
+  const gm = mod(div(i, 153), 12) + 1
+  const gy = div(j, 1461) - 100100 + div(8 - gm, 6)
+  return [gy, gm, gd]
+}
+
+/** Gregorian (UTC civil fields) → Jalali */
+export function toJalali(gy: number, gm: number, gd: number): JDate {
+  const jdn = g2d(gy, gm, gd)
+  const r = jalCal(gy - 621)
+  const jdn1f = g2d(r[1], 3, r[2])
+  let k = jdn - jdn1f
+  let jy = gy - 621
+  if (k >= 0) {
+    if (k <= 185) return { jy, jm: 1 + div(k, 31), jd: mod(k, 31) + 1 }
+    k -= 186
+  } else {
+    jy -= 1
+    k += 179
+    if (r[0] === 1) k += 1
+  }
+  return { jy, jm: 7 + div(k, 30), jd: mod(k, 30) + 1 }
+}
+
+/** Jalali → Gregorian [gy, gm, gd] */
+export function toGregorian(jy: number, jm: number, jd: number): number[] {
+  const r = jalCal(jy)
+  let jdn = g2d(r[1], 3, r[2])
+  jdn += (jm - 1) * 31 - div(jm, 7) * (jm - 7)
+  jdn += jd - 1
+  return d2g(jdn)
+}
+
+/** Jalali month length (29..31). */
+export function jalaliMonthLength(jy: number, jm: number): number {
+  if (jm <= 6) return 31
+  if (jm <= 11) return 30
+  return isLeapJalali(jy) ? 30 : 29
+}
+
+export const JALALI_MONTH_NAMES = [
+  'فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور',
+  'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند',
+]
+
+/** 0-based Persian weekday of a Jalali date: 0 = شنبه … 6 = جمعه */
+export function jalaliWeekDayIndex(jy: number, jm: number, jd: number): number {
+  const g = toGregorian(jy, jm, jd)
+  const cal = new Date(Date.UTC(g[0], g[1] - 1, g[2]))
+  const dow = cal.getUTCDay() // SUNDAY=0 … SATURDAY=6
+  return (dow + 1) % 7 // SATURDAY(6)→0=شنبه, SUNDAY(0)→1, … FRIDAY(5)→6=جمعه
+}
+
+const FA_DIGITS = '۰۱۲۳۴۵۶۷۸۹'
+export function faDigits(n: number | string): string {
+  return String(n).replace(/\d/g, (d) => FA_DIGITS[+d])
+}
+
+/** The Jalali date of a YYYY-MM-DD day key. */
+export function dayKeyToJalali(dayKey: string): JDate | null {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dayKey)
+  if (!m) return null
+  return toJalali(Number(m[1]), Number(m[2]), Number(m[3]))
+}
+
+/** The YYYY-MM-DD day key of a Jalali date. */
+export function jalaliToDayKey(jy: number, jm: number, jd: number): string {
+  const g = toGregorian(jy, jm, jd)
+  return `${String(g[0]).padStart(4, '0')}-${String(g[1]).padStart(2, '0')}-${String(g[2]).padStart(2, '0')}`
+}
+
+/** Inclusive [from, to] YYYY-MM-DD range covering the given Jalali month. */
+export function jalaliMonthDayRange(jy: number, jm: number): { from: string; to: string } {
+  return {
+    from: jalaliToDayKey(jy, jm, 1),
+    to: jalaliToDayKey(jy, jm, jalaliMonthLength(jy, jm)),
+  }
+}
