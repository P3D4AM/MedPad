diff -ruN orig/src/lib/notify.ts b/src/lib/notify.ts
--- orig/src/lib/notify.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/notify.ts	2026-10-27 21:38:10.381556776 +0000
@@ -0,0 +1,77 @@
+import { db } from '@/lib/db'
+
+/**
+ * package 4 (phase 2 / task 3) — notification helpers.
+ *
+ * TWO audiences:
+ *  - notifyEmployee(): the REPS' in-app notifications (AppNotification —
+ *    read by the Android app via /api/app/notifications, already persisted
+ *    and employee-scoped).
+ *  - notifyAdmin(): the PANEL's notifications (PanelNotification — real app
+ *    events like check-ins/check-outs surface to the manager; persisted in
+ *    the DB so they survive refresh/restart, with an explicit read state).
+ *
+ * STABLE EVENT IDS (dedup): both accept an `eventKey`. When present, the
+ * unique index makes a retry/replay of the SAME logical event a no-op —
+ * a unique-constraint violation is swallowed (P2002), anything else
+ * propagates. Emission is best-effort by design: a notification failure
+ * must never fail the business event that triggered it, so callers wrap
+ * where appropriate (or accept the await — the DB write is local & fast).
+ */
+
+type EmpKind = 'assignment' | 'proximity' | 'plan' | 'info'
+
+export async function notifyEmployee(opts: {
+  employeeId: string
+  kind: EmpKind
+  title: string
+  body?: string
+  customerId?: string | null
+  /** stable event id — e.g. `plan-cancel:<planId>`; null = no dedup */
+  eventKey?: string | null
+}): Promise<void> {
+  try {
+    await db.appNotification.create({
+      data: {
+        employeeId: opts.employeeId,
+        kind: opts.kind,
+        title: opts.title,
+        body: opts.body ?? '',
+        customerId: opts.customerId ?? null,
+        eventKey: opts.eventKey ?? null,
+      },
+    })
+  } catch (e: unknown) {
+    if ((e as { code?: string })?.code === 'P2002') return // same event already recorded
+    console.error('[notify] employee notification failed:', e instanceof Error ? e.message : e)
+  }
+}
+
+type AdminKind = 'checkin' | 'checkout' | 'assignment' | 'plan' | 'info'
+
+export async function notifyAdmin(opts: {
+  kind: AdminKind
+  title: string
+  body?: string
+  employeeId?: string | null
+  customerId?: string | null
+  /** stable event id — REQUIRED for admin events so replays/retries of the
+   *  business event (e.g. a localId check-in replay) can never double-notify */
+  eventKey: string
+}): Promise<void> {
+  try {
+    await db.panelNotification.create({
+      data: {
+        eventKey: opts.eventKey,
+        kind: opts.kind,
+        title: opts.title,
+        body: opts.body ?? '',
+        employeeId: opts.employeeId ?? null,
+        customerId: opts.customerId ?? null,
+      },
+    })
+  } catch (e: unknown) {
+    if ((e as { code?: string })?.code === 'P2002') return // same event already recorded
+    console.error('[notify] panel notification failed:', e instanceof Error ? e.message : e)
+  }
+}
