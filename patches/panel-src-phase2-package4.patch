diff -ruN orig/src/app/api/panel-notifications/read/route.ts b/src/app/api/panel-notifications/read/route.ts
--- orig/src/app/api/panel-notifications/read/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/panel-notifications/read/route.ts	2026-10-27 21:38:10.379556771 +0000
@@ -0,0 +1,25 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+
+/**
+ * package 4 (phase 2 / task 3) — mark PANEL notifications as read.
+ *
+ * POST /api/panel-notifications/read   body: { ids?: string[] }
+ *   ids[]  → mark those rows read
+ *   (absent/empty) → mark ALL read
+ * ADMIN-ONLY. Idempotent by nature (re-marking a read row is a no-op).
+ */
+export async function POST(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const body = await req.json().catch(() => null) as { ids?: string[] | null } | null
+  const data = { readAt: new Date() }
+  if (Array.isArray(body?.ids) && body!.ids!.length > 0) {
+    await db.panelNotification.updateMany({ where: { id: { in: body!.ids! } }, data })
+  } else {
+    await db.panelNotification.updateMany({ where: { readAt: null }, data })
+  }
+  return NextResponse.json({ ok: true })
+}
diff -ruN orig/src/app/api/panel-notifications/route.ts b/src/app/api/panel-notifications/route.ts
--- orig/src/app/api/panel-notifications/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/panel-notifications/route.ts	2026-10-27 21:38:10.379556771 +0000
@@ -0,0 +1,24 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+
+/**
+ * package 4 (phase 2 / task 3) — the PANEL's own notifications (the bell).
+ *
+ * GET /api/panel-notifications
+ *   Last 100 admin-facing notifications (check-ins, check-outs,
+ *   assignments, plan changes, info) with the unread count. Persisted in
+ *   the DB — a browser refresh or server restart never loses them.
+ *   ADMIN-ONLY (server-side session check).
+ */
+export async function GET() {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const rows = await db.panelNotification.findMany({
+    orderBy: { createdAt: 'desc' },
+    take: 100,
+  })
+  const unread = rows.filter((r) => !r.readAt).length
+  return NextResponse.json({ ok: true, notifications: rows, unread })
+}
