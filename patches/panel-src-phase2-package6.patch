--- orig/src/app/api/assignment-requests/[id]/approve/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/assignment-requests/[id]/approve/route.ts	2026-10-28 12:16:59.000000000 +0000
@@ -0,0 +1,108 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin, getConfig } from '@/lib/auth'
+import { notifyEmployee } from '@/lib/notify'
+import { writeAudit } from '@/lib/audit'
+import { emitEvent } from '@/lib/emit'
+
+/**
+ * package 6 (phase 2 / task 4) — approve an assignment request (admin).
+ *
+ * POST /api/assignment-requests/:id/approve
+ *   401  admin session required
+ *   404  unknown request id
+ *   409  request already decided (terminal state machine)
+ *   409  employee or customer deleted / employee deactivated — the request
+ *        STAYS pending (nothing is silently auto-decided); the admin sees
+ *        the reason and can reject it explicitly with a note.
+ *   200  approved. If the assignment already exists (a manual assignment
+ *        raced the request, or a previous approve on another pending
+ *        duplicate), the request is approved WITHOUT creating a duplicate —
+ *        Assignment's own @@unique([employeeId, customerId]) is the last
+ *        line of defence against double assignment under concurrency.
+ *   Side effects: the real Assignment row, an AppNotification for the rep
+ *   (stable eventKey ar-approved:<id>), a realtime emit (parity with the
+ *   manual assignment route) and an admin audit row.
+ */
+export async function POST(_req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+
+  const reqRow = await db.assignmentRequest.findUnique({ where: { id } })
+  if (!reqRow) {
+    return NextResponse.json({ ok: false, error: 'درخواست پیدا نشد' }, { status: 404 })
+  }
+  if (reqRow.status !== 'pending') {
+    return NextResponse.json({ ok: false, error: 'این درخواست قبلاً بررسی شده است' }, { status: 409 })
+  }
+
+  const [emp, cus] = await Promise.all([
+    db.employee.findUnique({ where: { id: reqRow.employeeId } }),
+    db.customer.findUnique({ where: { id: reqRow.customerId } }),
+  ])
+  if (!emp || !cus) {
+    return NextResponse.json(
+      { ok: false, error: 'کارمند یا مشتری حذف شده است — درخواست قابل تأیید نیست (می‌توانید رد کنید)' },
+      { status: 409 },
+    )
+  }
+  if (!emp.active) {
+    return NextResponse.json(
+      { ok: false, error: 'این مدرپ غیرفعال است — ابتدا حساب را فعال کنید' },
+      { status: 409 },
+    )
+  }
+
+  // the real assignment — idempotent under the unique constraint
+  let alreadyAssigned = false
+  try {
+    await db.assignment.create({ data: { employeeId: emp.id, customerId: cus.id } })
+  } catch (e) {
+    const err = e as { code?: string; message?: string }
+    if (err?.code === 'P2002' || /unique constraint failed/i.test(err?.message ?? '')) {
+      alreadyAssigned = true // raced with a manual assignment / prior approve
+    } else {
+      throw e
+    }
+  }
+
+  const adminUser = await getConfig('adminUser', 'admin')
+  await db.assignmentRequest.update({
+    where: { id },
+    data: {
+      status: 'approved',
+      decidedAt: new Date(),
+      decidedBy: adminUser,
+      ...(alreadyAssigned && !reqRow.adminNote
+        ? { adminNote: 'این مشتری از قبل به این مدرپ اختصاص یافته بود' }
+        : {}),
+    },
+  })
+
+  // the rep hears the outcome (name is safe to disclose now — it's theirs)
+  await notifyEmployee({
+    employeeId: emp.id,
+    kind: 'assignment',
+    title: 'درخواست تخصیص تأیید شد',
+    body: `«${cus.name}» به شما اختصاص یافت.`,
+    customerId: cus.id,
+    eventKey: `ar-approved:${id}`,
+  })
+  await emitEvent('notification', {
+    employeeId: emp.id,
+    employeeName: emp.name,
+    title: 'درخواست تخصیص تأیید شد',
+    body: `«${cus.name}» به شما اختصاص یافت.`,
+  })
+
+  await writeAudit({
+    action: 'assignment_request.approve',
+    targetType: 'assignment_request',
+    targetId: id,
+    detail: `approved ${emp.name} <- «${cus.name}»${alreadyAssigned ? ' (assignment already existed)' : ''}`,
+  })
+
+  return NextResponse.json({ ok: true, alreadyAssigned })
+}
