+// package 6 (phase 2 / task 4): customer assignment REQUESTS.
+//
+// The rep (مدرپ) asks the admin to be assigned a customer they know from
+// their own plans (the server only ever discloses ids it already showed
+// them); the admin approves or rejects from the panel.
+//  * employeeId/customerId are PLAIN STRINGS (no FK) — the request history
+//    survives employee/customer deletion (display falls back to «حذف‌شده»;
+//    approve on a missing row is refused with 409 and the admin can reject).
+//  * status: 'pending' | 'approved' | 'rejected' — decisions are terminal.
+//  * a PARTIAL unique index (employeeId, customerId WHERE status='pending')
+//    is created by instrumentation.ts at boot: at most ONE pending request
+//    per (rep, customer) — concurrent submits race into a P2002, not a
+//    duplicate. Decided requests never block a fresh request (a rejected
+//    rep may ask again later).
+//  * approve creates the real Assignment (its own @@unique makes double
+//    approval / racing with a manual assignment impossible) and notifies
+//    the rep via AppNotification; the admin bell hears about new requests
+//    via PanelNotification (kind='request').
+model AssignmentRequest {
+  id         String    @id @default(cuid())
+  employeeId String
+  customerId String
+  status     String    @default("pending") // pending | approved | rejected
+  note       String?   // the rep's note (≤500 chars, server-validated)
+  adminNote  String?   // the admin's decision note (visible to the rep)
+  decidedAt  DateTime?
+  decidedBy  String?   // admin username (Config.adminUser) at decision time
+  createdAt  DateTime  @default(now())
+  updatedAt  DateTime  @updatedAt
+}
+
 // phase 1 / task 2 (G-3): administrative audit trail. Actor is the panel's
 // single admin account (Config.adminUser) — actorType leaves room for future
 // actor kinds. `detail` carries a short human-readable summary and MUST
diff -ruN orig/src/app/api/app/assignment-requests/route.ts b/src/app/api/app/assignment-requests/route.ts
--- orig/src/app/api/app/assignment-requests/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/app/assignment-requests/route.ts	2026-10-28 12:16:34.000000000 +0000
@@ -0,0 +1,149 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { appEmployee } from '@/lib/auth'
+import { notifyAdmin } from '@/lib/notify'
+import { writeAudit } from '@/lib/audit'
+
+/**
+ * package 6 (phase 2 / task 4) — the REP'S side of assignment requests.
+ *
+ * POST /api/app/assignment-requests   { customerId, note? }
+ *   The rep asks the admin to be assigned a customer. The customer id can
+ *   only sensibly come from data the server already showed the rep (their
+ *   own planned visits — masked or not), so no customer browse/search
+ *   surface is exposed here. Server-side gates, in order:
+ *     401  invalid/expired/revoked token, deactivated employee
+ *     400  missing customerId / note longer than 500 chars
+ *     404  unknown customer id
+ *     409  customer already assigned to this rep
+ *     409  a PENDING request for the same (rep, customer) already exists
+ *   A new request notifies the ADMIN (bell, kind='request') with a stable
+ *   eventKey (ar:<id> — a retried POST is a new row, never a duplicate
+ *   notification) and writes an employee-actor audit row.
+ *
+ * GET /api/app/assignment-requests
+ *   The rep's own requests, newest first, capped at 100. Customer names
+ *   are disclosed ONLY for customers currently assigned to the rep — a
+ *   pending or rejected request never unmasks a customer the rep is not
+ *   entitled to see (consistent with the planned-visits masking policy).
+ */
+
+const NOTE_MAX = 500
+const LIST_LIMIT = 100
+
+function isUniqueViolation(e: unknown): boolean {
+  const err = e as { code?: string; message?: string }
+  if (err?.code === 'P2002') return true
+  // raw SQLite "UNIQUE constraint failed: ..." — including the partial
+  // AssignmentRequest_pending_key index (defence in depth beside P2002)
+  return /unique constraint failed/i.test(err?.message ?? '')
+}
+
+export async function GET(req: Request) {
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+
+  const rows = await db.assignmentRequest.findMany({
+    where: { employeeId: emp.id },
+    orderBy: { createdAt: 'desc' },
+    take: LIST_LIMIT,
+  })
+
+  // resolve customer names ONLY for customers currently assigned to this rep
+  const assigned = await db.assignment.findMany({
+    where: { employeeId: emp.id },
+    select: { customerId: true },
+  })
+  const assignedIds = new Set(assigned.map((a) => a.customerId))
+  const customers = await db.customer.findMany({
+    where: { id: { in: rows.map((r) => r.customerId) } },
+    select: { id: true, name: true },
+  })
+  const nameById = new Map(customers.map((c) => [c.id, c.name]))
+
+  return NextResponse.json({
+    ok: true,
+    requests: rows.map((r) => {
+      const isAssigned = assignedIds.has(r.customerId)
+      return {
+        id: r.id,
+        customerId: r.customerId,
+        // masking policy: name only once the customer is actually the rep's
+        customerName: isAssigned ? (nameById.get(r.customerId) ?? null) : null,
+        assigned: isAssigned,
+        status: r.status,
+        note: r.note,
+        adminNote: r.adminNote,
+        createdAt: r.createdAt,
+        decidedAt: r.decidedAt,
+      }
+    }),
+    serverTime: new Date().toISOString(),
+  })
+}
+
+export async function POST(req: Request) {
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+
+  const body = await req.json().catch(() => null) as { customerId?: string; note?: string } | null
+  const customerId = typeof body?.customerId === 'string' ? body.customerId.trim() : ''
+  const note = typeof body?.note === 'string' ? body.note.trim() : ''
+  if (!customerId) {
+    return NextResponse.json({ ok: false, error: 'شناسهٔ مشتری لازم است' }, { status: 400 })
+  }
+  if (note.length > NOTE_MAX) {
+    return NextResponse.json({ ok: false, error: `یادداشت حداکثر ${NOTE_MAX} نویسه می‌تواند باشد` }, { status: 400 })
+  }
+
+  const cus = await db.customer.findUnique({ where: { id: customerId }, select: { id: true, name: true } })
+  if (!cus) {
+    return NextResponse.json({ ok: false, error: 'مشتری پیدا نشد' }, { status: 404 })
+  }
+
+  const already = await db.assignment.findFirst({ where: { employeeId: emp.id, customerId } })
+  if (already) {
+    return NextResponse.json({ ok: false, error: 'این مشتری از قبل به شما اختصاص دارد' }, { status: 409 })
+  }
+
+  const pending = await db.assignmentRequest.findFirst({
+    where: { employeeId: emp.id, customerId, status: 'pending' },
+  })
+  if (pending) {
+    return NextResponse.json({ ok: false, error: 'برای این مشتری درخواست در انتظار بررسی دارید' }, { status: 409 })
+  }
+
+  let row
+  try {
+    row = await db.assignmentRequest.create({
+      data: { employeeId: emp.id, customerId, note: note || null },
+    })
+  } catch (e) {
+    // the partial unique index makes a concurrent duplicate a clean 409
+    if (isUniqueViolation(e)) {
+      return NextResponse.json({ ok: false, error: 'برای این مشتری درخواست در انتظار بررسی دارید' }, { status: 409 })
+    }
+    throw e
+  }
+
+  // admin bell notification — stable event key on the request row id
+  await notifyAdmin({
+    kind: 'request',
+    title: 'درخواست تخصیص مشتری',
+    body: `${emp.name} درخواست تخصیص مشتری «${cus.name}» را دارد.`,
+    employeeId: emp.id,
+    customerId,
+    eventKey: `ar:${row.id}`,
+  })
+
+  await writeAudit({
+    action: 'assignment_request.create',
+    actorType: 'employee',
+    actorId: emp.id,
+    targetType: 'customer',
+    targetId: customerId,
+    detail: `rep ${emp.name} (${emp.username}) requested assignment of customer «${cus.name}»`,
+  })
+
+  return NextResponse.json({ ok: true, request: { id: row.id, status: row.status, createdAt: row.createdAt } })
+}
