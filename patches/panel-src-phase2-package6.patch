+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin, getConfig } from '@/lib/auth'
+import { notifyEmployee } from '@/lib/notify'
+import { writeAudit } from '@/lib/audit'
+
+/**
+ * package 6 (phase 2 / task 4) — reject an assignment request (admin).
+ *
+ * POST /api/assignment-requests/:id/reject   { adminNote? }
+ *   401  admin session required
+ *   404  unknown request id
+ *   409  request already decided
+ *   400  adminNote longer than 500 chars
+ *   200  rejected — terminal. The rep is notified in-app (stable eventKey
+ *        ar-rejected:<id>); the customer's NAME is deliberately NOT
+ *        included (it may be another rep's customer — no unmasking on
+ *        rejection). A rejected rep may file a fresh request later (the
+ *        partial unique index only covers pending rows).
+ */
+const NOTE_MAX = 500
+
+export async function POST(req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+
+  const reqRow = await db.assignmentRequest.findUnique({ where: { id } })
+  if (!reqRow) {
+    return NextResponse.json({ ok: false, error: 'درخواست پیدا نشد' }, { status: 404 })
+  }
+  if (reqRow.status !== 'pending') {
+    return NextResponse.json({ ok: false, error: 'این درخواست قبلاً بررسی شده است' }, { status: 409 })
+  }
+
+  const body = await req.json().catch(() => null) as { adminNote?: string } | null
+  const adminNote = typeof body?.adminNote === 'string' ? body.adminNote.trim() : ''
+  if (adminNote.length > NOTE_MAX) {
+    return NextResponse.json({ ok: false, error: `یادداشت حداکثر ${NOTE_MAX} نویسه می‌تواند باشد` }, { status: 400 })
+  }
+
+  const adminUser = await getConfig('adminUser', 'admin')
+  await db.assignmentRequest.update({
+    where: { id },
+    data: {
+      status: 'rejected',
+      adminNote: adminNote || null,
+      decidedAt: new Date(),
+      decidedBy: adminUser,
+    },
+  })
+
+  const emp = await db.employee.findUnique({ where: { id: reqRow.employeeId } })
+  if (emp) {
+    await notifyEmployee({
+      employeeId: emp.id,
+      kind: 'assignment',
+      title: 'درخواست تخصیص رد شد',
+      body: adminNote ? `درخواست تخصیص شما رد شد. ${adminNote}` : 'درخواست تخصیص شما رد شد.',
+      eventKey: `ar-rejected:${id}`,
+    })
+  }
+
+  await writeAudit({
+    action: 'assignment_request.reject',
+    targetType: 'assignment_request',
+    targetId: id,
+    detail: `rejected${adminNote ? ` — ${adminNote}` : ''}`,
+  })
+
+  return NextResponse.json({ ok: true })
+}
diff -ruN orig/src/app/api/assignment-requests/route.ts b/src/app/api/assignment-requests/route.ts
--- orig/src/app/api/assignment-requests/route.ts	1970-01-01 00:00:00.000000000 +0000
