@@ -0,0 +1,71 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+
+/**
+ * package 6 (phase 2 / task 4) — the ADMIN's assignment-request list.
+ *
+ * GET /api/assignment-requests?status=pending|approved|rejected (admin only)
+ *   Newest first, capped at 200. Employee/customer names are resolved with
+ *   bulk lookups and fall back to null for deleted rows (the request ids
+ *   are plain strings with no FK — history survives deletion; the UI shows
+ *   «حذف‌شده»). Decisions happen in the [id]/approve and [id]/reject routes.
+ */
+
+const LIST_LIMIT = 200
+const STATUSES = new Set(['pending', 'approved', 'rejected'])
+
+export async function GET(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const url = new URL(req.url)
+  const status = url.searchParams.get('status')
+  if (status !== null && !STATUSES.has(status)) {
+    return NextResponse.json({ ok: false, error: 'وضعیت نامعتبر است' }, { status: 400 })
+  }
+
+  const rows = await db.assignmentRequest.findMany({
+    where: status ? { status } : undefined,
+    orderBy: { createdAt: 'desc' },
+    take: LIST_LIMIT,
+  })
+
+  const empIds = [...new Set(rows.map((r) => r.employeeId))]
+  const cusIds = [...new Set(rows.map((r) => r.customerId))]
+  const [employees, customers] = await Promise.all([
+    empIds.length
+      ? db.employee.findMany({ where: { id: { in: empIds } }, select: { id: true, name: true, username: true, active: true } })
+      : Promise.resolve([]),
+    cusIds.length
+      ? db.customer.findMany({ where: { id: { in: cusIds } }, select: { id: true, name: true } })
+      : Promise.resolve([]),
+  ])
+  const empById = new Map(employees.map((e) => [e.id, e]))
+  const cusById = new Map(customers.map((c) => [c.id, c]))
+
+  // how many requests are still open (shown as the badge in the panel)
+  const pendingCount = status === 'pending'
+    ? rows.length
+    : await db.assignmentRequest.count({ where: { status: 'pending' } })
+
+  return NextResponse.json({
+    ok: true,
+    pendingCount,
+    requests: rows.map((r) => {
+      const emp = empById.get(r.employeeId)
+      const cus = cusById.get(r.customerId)
+      return {
+        id: r.id,
+        status: r.status,
+        note: r.note,
+        adminNote: r.adminNote,
+        createdAt: r.createdAt,
+        decidedAt: r.decidedAt,
+        decidedBy: r.decidedBy,
+        employee: emp ? { id: emp.id, name: emp.name, username: emp.username, active: emp.active } : null,
+        customer: cus ? { id: cus.id, name: cus.name } : null,
+      }
+    }),
+  })
+}
