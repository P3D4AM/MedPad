+// ── envelope encryption ─────────────────────────────────────────────────────
+
+/** true when the stored value is already an encrypted envelope. */
+export function isEncryptedSecret(value: string): boolean {
+  return value.startsWith(ENVELOPE_PREFIX)
+}
+
+/** Encrypt a secret string into an `enc1:` envelope (random 12-byte IV). */
+export function encryptHolooSecret(plain: string): string {
+  const key = getOrCreateHolooMasterKey()
+  const iv = randomBytes(12)
+  const cipher = createCipheriv('aes-256-gcm', key, iv)
+  const ct = Buffer.concat([cipher.update(plain, 'utf8'), cipher.final()])
+  const tag = cipher.getAuthTag()
+  return `${ENVELOPE_PREFIX}${iv.toString('base64')}:${tag.toString('base64')}:${ct.toString('base64')}`
+}
+
+/**
+ * Decrypt an `enc1:` envelope back into the secret string. Throws
+ * HolooSecretError (classified, Persian, secret-free) when the key is
+ * missing/unreadable or the ciphertext does not authenticate (wrong key or
+ * tampered data) — the caller decides how to surface it, but the STORED
+ * value must never be wiped because of it.
+ */
+export function decryptHolooSecret(envelope: string): string {
+  if (!isEncryptedSecret(envelope)) {
+    throw new HolooSecretError('decrypt-failed', 'مقدار ذخیره‌شده قالب رمزنگاری‌شده ندارد')
+  }
+  const parts = envelope.slice(ENVELOPE_PREFIX.length).split(':')
+  if (parts.length !== 3) {
+    throw new HolooSecretError('decrypt-failed', 'قالب مقدار رمزنگاری‌شدهٔ هلو نامعتبر است')
+  }
+  const keyPath = holooKeyFilePath()
+  const key = readKeyFileOrNull(keyPath)
+  if (!key) {
+    throw new HolooSecretError(
+      'key-missing',
+      'کلید رمزنگاری این نصب یافت نشد (فایل holoo.key در پوشهٔ داده پنل). رمز ذخیره‌شده قابل بازیابی نیست — رمز هلو را دوباره در تنظیمات وارد کنید'
+    )
+  }
+  try {
+    const iv = Buffer.from(parts[0], 'base64')
+    const tag = Buffer.from(parts[1], 'base64')
+    const ct = Buffer.from(parts[2], 'base64')
+    const decipher = createDecipheriv('aes-256-gcm', key, iv)
+    decipher.setAuthTag(tag)
+    const plain = Buffer.concat([decipher.update(ct), decipher.final()])
+    return plain.toString('utf8')
+  } catch {
+    throw new HolooSecretError(
+      'decrypt-failed',
+      'بازیابی رمز هلو ناموفق بود — کلید رمزنگاری با دادهٔ ذخیره‌شده هم‌خوان نیست. تنظیمات حذف نشده‌اند؛ رمز هلو را دوباره در تنظیمات وارد کنید تا با کلید فعلی ذخیره شود'
+    )
+  }
+}
+
+/** Verify a roundtrip (used by the Base64 migration before overwriting). */
+export function verifyHolooSecretRoundtrip(plain: string, envelope: string): boolean {
+  try {
+    return decryptHolooSecret(envelope) === plain
+  } catch {
+    return false
+  }
+}
