@@ -0,0 +1,239 @@
+import { createCipheriv, createDecipheriv, randomBytes } from 'crypto'
+import { readFileSync, writeFileSync, renameSync, linkSync, unlinkSync, chmodSync, mkdirSync } from 'fs'
+import path from 'path'
+
+/**
+ * Holoo integration (Task 67) — AES-256-GCM envelope encryption for the
+ * Holoo credentials at rest.
+ *
+ * BEFORE (phase 1–10): the Holoo password was stored BASE64-encoded in the
+ * Config KV table. Base64 is transport encoding, NOT encryption — anyone
+ * with the SQLite file could read the password. The cached login token was
+ * stored in plain text.
+ *
+ * NOW: both values are stored as authenticated ciphertext envelopes:
+ *
+ *   enc1:<iv:b64>:<tag:b64>:<ct:b64>
+ *
+ * encrypted with a 32-byte AES-256-GCM per-install master key that lives in
+ * a KEY FILE — strictly OUTSIDE the SQLite database and OUTSIDE the repo:
+ *
+ *   <dir of DATABASE_URL's file>/holoo.key     (i.e. panel/db/holoo.key in
+ *                                              a normal install — the SAME
+ *                                              directory the installer
+ *                                              already backs up on every
+ *                                              upgrade and restricts with
+ *                                              chmod 700 / a user-only
+ *                                              inheritable Windows ACL)
+ *   or $MEDPAD_HOLOO_KEY_FILE when set (tests / exotic layouts).
+ *
+ * Key-file rules (owner's Task 67 instruction):
+ *  * generated once per install with the CSPRNG, atomically (tmp + link),
+ *    NEVER regenerated or deleted by the installer — upgrades keep it;
+ *  * Linux: mode 0600 (owner-only), re-applied by the installer on upgrade
+ *    (install.mjs locks panel/db/holoo.key down like custom.db);
+ *  * Windows: the key file INHERITS the restricted ACL of panel/db — the
+ *    installer applies icacls /inheritance:r with an inheritable
+ *    user-only grant ((OI)(CI)(F)) to that directory at install time and
+ *    on every upgrade, exactly the protection custom.db relies on. No
+ *    runtime ACL mutation happens (a half-applied change could lock the
+ *    panel out of its own key; inheritance cannot);
+ *  * never inside the APK, the release ZIP, Git or any log;
+ *  * key material NEVER appears in errors, audit rows, API responses or
+ *    test output (errors carry classified Persian messages only).
+ *
+ * IMPLEMENTATION NOTE — no existsSync(): Turbopack's output-file tracing
+ * flags `existsSync(<dynamic path>)` as "Dynamic filesystem access causes
+ * tracing of the whole project" and then ships the ENTIRE source tree in
+ * the standalone bundle (observed Nov 2026). Every existence check here is
+ * therefore a readFileSync + ENOENT catch, which the tracer handles
+ * cleanly.
+ *
+ * Failure semantics (owner's Task 67 instruction):
+ *  * a MISSING key with an existing encrypted value → explicit Persian
+ *    error, the stored value is NOT wiped and NOT treated as empty;
+ *  * a WRONG/CORRUPT key or corrupt envelope → explicit Persian error,
+ *    settings survive untouched (AES-GCM auth tag makes tampering detect);
+ *  * the legacy Base64 migration only overwrites the old value AFTER the
+ *    new ciphertext was written and verified.
+ */
+
+const ENV_KEY_FILE = 'MEDPAD_HOLOO_KEY_FILE'
+const KEY_FILE_NAME = 'holoo.key'
+const KEY_BYTES = 32
+const ENVELOPE_PREFIX = 'enc1:'
+
+export type HolooSecretErrorKind =
+  | 'key-missing'
+  | 'key-unreadable'
+  | 'key-write-failed'
+  | 'decrypt-failed'
+
+export class HolooSecretError extends Error {
+  kind: HolooSecretErrorKind
+  constructor(kind: HolooSecretErrorKind, message: string) {
+    super(message)
+    this.name = 'HolooSecretError'
+    this.kind = kind
+  }
+}
+
+/** Persian, secret-free message for a secret-box failure. */
+export function holooSecretErrorMessage(e: unknown): string {
+  if (e instanceof HolooSecretError) return e.message
+  return 'خطای ذخیره‌سازی امن اطلاعات اتصال هلو'
+}
+
+// ── key-file location ───────────────────────────────────────────────────────
+
+/** Resolve the per-install key-file path (never logs or returns key bytes). */
+export function holooKeyFilePath(): string {
+  const override = process.env[ENV_KEY_FILE]
+  if (override && override.trim()) return path.resolve(override.trim())
+  const url = process.env.DATABASE_URL || ''
+  const m = url.match(/^file:(.+)$/i)
+  if (m) {
+    const dbPath = m[1].replace(/\?.*$/, '')
+    return path.join(path.dirname(path.resolve(dbPath)), KEY_FILE_NAME)
+  }
+  return path.join(process.cwd(), KEY_FILE_NAME)
+}
+
+// ── key management ──────────────────────────────────────────────────────────
+
+/**
+ * Load the per-install master key, creating it atomically on first use.
+ * The create path is: write a unique temp file → hard-link it into place
+ * (fails with EEXIST if another process won the race → read theirs) →
+ * unlink the temp file. link(2) never overwrites, so an existing key is
+ * NEVER replaced by this code path.
+ */
+export function getOrCreateHolooMasterKey(): Buffer {
+  const keyPath = holooKeyFilePath()
+  const existing = readKeyFileOrNull(keyPath)
+  if (existing) return existing
+  const key = randomBytes(KEY_BYTES)
+  const dir = path.dirname(keyPath)
+  mkdirSync(dir, { recursive: true })
+  const tmp = path.join(dir, `.${KEY_FILE_NAME}.tmp-${process.pid}-${randomBytes(6).toString('hex')}`)
+  writeFileSync(tmp, key, { flag: 'wx' })
+  try {
+    chmodSync(tmp, 0o600)
+    try {
+      linkSync(tmp, keyPath) // atomic create-or-keep-existing
+    } catch (e) {
+      const code = (e as NodeJS.ErrnoException).code
+      if (code === 'EEXIST') {
+        // another process created it first — keep THEIR key
+        const theirs = readKeyFileOrNull(keyPath)
+        if (theirs) return theirs
+        throw new HolooSecretError('key-unreadable', 'فایل کلید رمزنگاری هلو قابل خواندن نیست')
+      }
+      if (code === 'EPERM' || code === 'ENOTSUP' || code === 'EOPNOTSUPP' || code === 'ENOSYS') {
+        // filesystems without hard links (some FAT/exFAT USB sticks)
+        renameSync(tmp, keyPath)
+        chmodSync(keyPath, 0o600)
+        return key
+      }
+      throw new HolooSecretError('key-write-failed', 'کلید رمزنگاری هلو قابل ذخیره‌سازی نیست (دسترسی نوشتن در پوشهٔ داده را بررسی کنید)')
+    }
+    unlinkSync(tmp)
+    return key
+  } catch (e) {
+    if (e instanceof HolooSecretError) throw e
+    try { unlinkSync(tmp) } catch { /* best effort */ }
+    throw new HolooSecretError('key-write-failed', 'کلید رمزنگاری هلو قابل ذخیره‌سازی نیست (دسترسی نوشتن در پوشهٔ داده را بررسی کنید)')
+  }
+}
+
+/**
+ * Read the key file; null when it does not exist (ENOENT). Any other
+ * failure (permissions, I/O) is an explicit error. NOTE: readFileSync with
+ * a dynamic path does NOT trigger Turbopack's whole-project tracing —
+ * existsSync DOES (see the module docstring).
+ */
+function readKeyFileOrNull(keyPath: string): Buffer | null {
+  let raw: Buffer
+  try {
+    raw = readFileSync(keyPath)
+  } catch (e) {
+    if ((e as NodeJS.ErrnoException).code === 'ENOENT') return null
+    throw new HolooSecretError('key-unreadable', 'فایل کلید رمزنگاری هلو قابل خواندن نیست (مجوزهای فایل را بررسی کنید)')
+  }
+  return validateKeyBytes(raw)
+}
+
+function validateKeyBytes(raw: Buffer): Buffer {
+  if (raw.length !== KEY_BYTES) {
+    throw new HolooSecretError(
+      'key-unreadable',
+      `فایل کلید رمزنگاری هلو نامعتبر است (باید دقیقاً ${KEY_BYTES} بایت باشد) — فایل خراب است`
+    )
+  }
+  return raw
+}
