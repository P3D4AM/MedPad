diff -ru orig/src/app/globals.css b/src/app/globals.css
--- orig/src/app/globals.css	2026-10-25 06:58:53.000000000 +0000
+++ b/src/app/globals.css	2026-10-26 16:04:16.000000000 +0000
@@ -127,3 +127,20 @@
 .mp-scroll::-webkit-scrollbar-thumb { background: #c4b5a4; border-radius: 8px; }
 .mp-scroll::-webkit-scrollbar-track { background: transparent; }
 audio { border-radius: 8px; }
+
+/* ── v1.9.13-dev.2 (user report #3): mobile usability ──
+   1) 16px form controls on phones — iOS Safari auto-zooms into any
+      focused input rendered below 16px, which makes the whole page
+      shift/jump when tapping filters (exactly what the owner reported).
+      These rules are intentionally UNLAYERED so they win over Tailwind
+      utilities (e.g. text-sm) in the cascade.
+   2) A hard overflow guard: nothing may push the document wider than
+      the viewport — horizontal scrolling on a phone was the other half
+      of the "elements move around" report. */
+@media (max-width: 640px) {
+  input, select, textarea { font-size: 16px !important; }
+}
+/* hard overflow guard — phones must never horizontal-scroll the dashboard
+   (clip on body only: overflow-x on html breaks position:sticky in some
+   browsers; overflow:clip keeps the viewport as the scroll container) */
+body { overflow-x: clip; }
