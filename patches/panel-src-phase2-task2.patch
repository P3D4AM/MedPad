# Contents — phase 2 / task 2 (employee app + dev packaging):
#   * NEW src/app/api/app/planned-visits/route.ts — the employee app's
#     READ-ONLY own-plans endpoint. Identity comes ONLY from the app token
#     (appEmployee: expired/revoked/deactivated -> 401); employeeId is pinned
#     server-side, a client-sent id is not even read. Customer contact data
