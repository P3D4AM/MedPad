# Applies at panel-src root:  patch -p1 < this.patch
# Base: git commit bd9c80b (medpad-full-1.9/inst-stage/panel-src)
#        WITH patches/panel-src-phase1-task1.patch,
#             patches/panel-src-phase2-remediation.patch AND
#             patches/panel-src-phase2-task1.patch ALREADY applied.
# Full reconstruction chain:
#   bd9c80b -> +phase1-task1 -> +phase2-remediation -> +phase2-task1
#            -> +THIS PATCH = complete source at v1.9.13-dev.1
#
# After applying: npm install && npx prisma generate && npm run build
