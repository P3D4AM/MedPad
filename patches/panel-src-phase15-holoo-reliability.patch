+    } else if (PAG_PAGECOUNT_KEYS.test(k) && num !== null) {
+      out.signals.push(k)
+      out.pageCount = out.pageCount ?? num
+    } else if (PAG_WINDOW_KEYS.test(k) && num !== null) {
+      out.signals.push(k)
