+import { db } from '@/lib/db'
+import { getConfig } from '@/lib/auth'
+import { getAdminSettings } from '@/lib/settings'
+
+/**
+ * phase 4 — Web Push to the PANEL browser (service worker).
+ *
+ * «اعلان‌های مهم پس از دریافت مجوز به‌صورت اعلان سیستمی مرورگر نمایش
+ * داده شوند؛ در زمان بسته‌بودن مرورگر با Push + Service Worker»
+ *
+ * Design points (all from the comprehensive instruction):
+ *  - DEDUP BY CONSTRUCTION: pushes are sent from notifyAdmin() AFTER the
+ *    PanelNotification row is successfully created. That table's unique
+ *    eventKey already collapses business-event replays (a retried
+ *    check-in upload never re-notifies) — so a replay never reaches this
+ *    code either. No separate push-side dedup needed.
+ *  - NO DUPLICATE WITH THE OPEN PAGE: the service worker (public/sw.js)
+ *    suppresses the notification when a visible+focused panel window
+ *    exists (the page already showed the toast via the realtime socket).
+ *    The server cannot know page visibility — the SW can.
+ *  - MASTER SWITCH: pushEnabled=0 stops all sends; PanelNotification
+ *    rows still persist, so the in-panel notification center keeps
+ *    working («بدون مجوز... مرکز اعلان درون پنل همچنان کار می‌کند»).
+ *  - ZERO-CONFIG KEYS: VAPID keys are generated at FIRST BOOT and stored
+ *    in the Config table (vapidPublicKey / vapidPrivateKey). An existing
+ *    install upgrades and push just works; the keys survive restarts and
+ *    are never written to logs.
+ *  - BEST-EFFORT, NEVER FATAL: a push failure must never fail the
+ *    business event that triggered it. Dead subscriptions (404/410) are
+ *    pruned; other errors are logged once per send round.
+ */
+
+let webpush: typeof import('web-push') | null = null
+
+async function getWebPush() {
+  if (webpush) return webpush
+  const mod = (await import('web-push')).default
+  webpush = mod
+  return mod
+}
+
+export interface VapidKeys {
+  publicKey: string
+  privateKey: string
+}
+
+/** Read the install's VAPID keys from Config (or null when not yet
+ *  generated — instrumentation.register() creates them at first boot). */
+export async function getVapidKeys(): Promise<VapidKeys | null> {
+  const pub = await getConfig('vapidPublicKey', '')
+  const priv = await getConfig('vapidPrivateKey', '')
+  if (!pub || !priv) return null
+  return { publicKey: pub, privateKey: priv }
+}
+
+export async function generateAndStoreVapidKeys(): Promise<VapidKeys> {
+  const wp = await getWebPush()
+  const keys = wp.generateVAPIDKeys()
+  await db.config.upsert({
+    where: { key: 'vapidPublicKey' },
+    update: { value: keys.publicKey },
+    create: { key: 'vapidPublicKey', value: keys.publicKey },
+  })
+  await db.config.upsert({
+    where: { key: 'vapidPrivateKey' },
+    update: { value: keys.privateKey },
+    create: { key: 'vapidPrivateKey', value: keys.privateKey },
+  })
+  return keys
+}
+
+/** Which panel tab a notification kind opens (notification click-through).
+ *  Mirrors the Dashboard's tab keys. */
+export function pushUrlForKind(kind: string): string {
+  switch (kind) {
+    case 'checkin':
+    case 'checkout':
+      return '/#tab=checkins'
+    case 'plan':
+      return '/#tab=plans'
+    case 'assignment':
+    case 'request':
+      return '/#tab=customers'
+    case 'info':
+      return '/#tab=overview'
+    default:
+      return '/#tab=overview'
+  }
+}
+
+/** Send one push to every subscribed browser. Fire-and-forget by design —
+ *  callers wrap it in try/catch (or don't await it at all in a
+ *  fire-and-forget context). Dead endpoints are pruned on the fly. */
+export async function sendPushToAll(payload: {
+  title: string
+  body: string
+  url: string
+  eventKey: string
+}): Promise<void> {
+  try {
+    const settings = await getAdminSettings()
+    if (settings.pushEnabled !== 1) return
+    const keys = await getVapidKeys()
+    if (!keys) return // not generated yet (boot will)
+    const subs = await db.pushSubscription.findMany()
+    if (subs.length === 0) return
+    const wp = await getWebPush()
+    wp.setVapidDetails('mailto:admin@medpad.local', keys.publicKey, keys.privateKey)
+    // the payload is ENCRYPTED per subscription by web-push (RFC 8291);
+    // the server stores no message content anywhere
+    const message = JSON.stringify(payload)
+    const gone: string[] = []
+    await Promise.all(
+      subs.map(async (s) => {
+        try {
+          await wp.sendNotification(
+            { endpoint: s.endpoint, keys: { p256dh: s.p256dh, auth: s.auth } },
+            message,
+            { TTL: 3600 },
+          )
+        } catch (e: unknown) {
+          const status = (e as { statusCode?: number })?.statusCode
+          if (status === 404 || status === 410) gone.push(s.id)
+          // other failures (push service hiccup, offline): leave the sub —
+          // it may recover; nothing is silently lost (the notification
+          // center still has the row)
+        }
+      }),
+    )
+    if (gone.length > 0) {
+      await db.pushSubscription.deleteMany({ where: { id: { in: gone } } })
+    }
+  } catch (e) {
+    // never let push break the business event
+    console.error('[push] send failed:', e instanceof Error ? e.message : e)
+  }
+}
