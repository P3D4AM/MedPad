+function parseAuditChanges(detail: string): { key: string; oldV: string; newV: string }[] {
+  const out: { key: string; oldV: string; newV: string }[] = []
+  const body = detail.replace(/^به‌روزرسانی تنظیمات:?(\s*\(بدون تغییر مقدار\))?:?\s*/, '')
