+import { NextResponse } from 'next/server'
+import { isAdmin } from '@/lib/auth'
+import { getVapidKeys } from '@/lib/push'
+
+/**
+ * phase 4 — the browser needs the install's PUBLIC VAPID key to subscribe
+ * to Web Push (it is safe to expose — it only identifies the sender).
+ *
+ * GET /api/push/key (admin session) -> { ok, publicKey }
+ *
+ * The pair is generated at first boot by instrumentation.register() and
+ * stored in the Config table. If it is somehow missing (push bootstrap
+ * failed), the route says so honestly: { ok: true, publicKey: null } and
+ * the settings section shows push as unavailable instead of failing an
+ * opaque subscription attempt later.
+ */
+export async function GET() {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const keys = await getVapidKeys()
+  return NextResponse.json({ ok: true, publicKey: keys ? keys.publicKey : null })
+}
--- a/src/app/api/push/subscribe/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/push/subscribe/route.ts	2026-11-03 11:59:01.217637409 +0000
@@ -0,0 +1,73 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+
+/**
+ * phase 4 — panel-browser Push subscription management (admin session).
+ *
+ *   POST /api/push/subscribe     { endpoint, keys:{p256dh,auth} }
+ *        -> upsert by endpoint (one row per browser; re-subscribing after
+ *           a browser key rotation REPLACES the old row, never duplicates)
+ *   DELETE /api/push/subscribe   { endpoint }
+ *        -> remove this browser's subscription
+ *
+ * Validation is strict: endpoint must be an https URL (the Web Push
+ * protocol only speaks to push services over TLS), keys are non-empty
+ * base64url strings of sane length. The payload carries nothing else —
+ * no message content is ever stored server-side (each push is encrypted
+ * per subscription at send time).
+ */
+
+interface SubBody {
+  endpoint?: unknown
+  keys?: { p256dh?: unknown; auth?: unknown } | unknown
+}
+
+function validEndpoint(v: unknown): v is string {
+  if (typeof v !== 'string' || v.length < 16 || v.length > 2048) return false
+  try {
+    const u = new URL(v)
+    return u.protocol === 'https:'
+  } catch {
+    return false
+  }
+}
+
+function validB64(v: unknown, min: number, max: number): v is string {
+  return typeof v === 'string' && v.length >= min && v.length <= max && /^[A-Za-z0-9_-]+={0,2}$/.test(v)
+}
+
+export async function POST(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const body = (await req.json().catch(() => null)) as SubBody | null
+  if (!body || !validEndpoint(body.endpoint)) {
+    return NextResponse.json({ ok: false, error: 'آدرس اشتراک نامعتبر است' }, { status: 400 })
+  }
+  const keys = body.keys as { p256dh?: unknown; auth?: unknown } | undefined
+  if (!keys || !validB64(keys.p256dh, 40, 512) || !validB64(keys.auth, 8, 512)) {
+    return NextResponse.json({ ok: false, error: 'کلیدهای اشتراک نامعتبر است' }, { status: 400 })
+  }
+  const userAgent = req.headers.get('user-agent')?.slice(0, 250) ?? null
+  await db.pushSubscription.upsert({
+    where: { endpoint: body.endpoint },
+    update: { p256dh: keys.p256dh, auth: keys.auth, userAgent, lastSeenAt: new Date() },
+    create: { endpoint: body.endpoint, p256dh: keys.p256dh, auth: keys.auth, userAgent },
+  })
+  const total = await db.pushSubscription.count()
+  return NextResponse.json({ ok: true, subscriptions: total })
+}
+
+export async function DELETE(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const body = (await req.json().catch(() => null)) as SubBody | null
+  if (!body || typeof body.endpoint !== 'string' || body.endpoint.length < 16) {
+    return NextResponse.json({ ok: false, error: 'آدرس اشتراک نامعتبر است' }, { status: 400 })
+  }
+  await db.pushSubscription.deleteMany({ where: { endpoint: body.endpoint } })
+  const total = await db.pushSubscription.count()
+  return NextResponse.json({ ok: true, subscriptions: total })
+}
