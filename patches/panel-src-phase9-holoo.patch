diff -ruN a/src/components/panel/HolooTab.tsx src/src/components/panel/HolooTab.tsx
--- a/src/components/panel/HolooTab.tsx	1970-01-01 00:00:00.000000000 +0000
+++ src/src/components/panel/HolooTab.tsx	2026-11-10 09:27:35.000000000 +0000
@@ -0,0 +1,488 @@
+'use client'
+
+/**
+ * Holoo integration (phase 1) — the panel's «هلو» tab.
+ *
+ * Everything the owner's §8 mandated surface: enable/disable switch,
+ * connection settings (password write-only + masked), REAL connection
+ * test with the read-only endpoint probe results, manual sync trigger,
+ * counts, per-run logs with SAFE error strings, and the synced product
+ * list. The tab polls /api/admin/holoo/status so a running sync's
+ * progress appears live.
+ */
+
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
+import { Input } from '@/components/ui/input'
+import { Label } from '@/components/ui/label'
+import { Switch } from '@/components/ui/switch'
+import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'
+import { useToast } from '@/hooks/use-toast'
+import { faDateTime } from '@/lib/realtime'
+import { AlertTriangle, Database, Loader2, Plug, RefreshCw, Save, Search } from 'lucide-react'
+
+interface HolooSettingsPublic {
+  enabled: boolean
+  baseUrl: string
+  dbname: string
+  username: string
+  syncIntervalMin: number
+  hasPassword: boolean
+  configured: boolean
+  isHttp: boolean
+}
+
+interface SyncLogView {
+  id: string
+  kind: string
+  status: string
+  startedAt: string
+  finishedAt: string | null
+  checked: number
+  created: number
+  updated: number
+  unchanged: number
+  deactivated: number
+  errors: string[]
+}
+
+interface SyncState {
+  running: boolean
+  lastRun: SyncLogView | null
+  recentLogs: SyncLogView[]
+  counts: {
+    erpCustomers: number
+    erpProducts: number
+    erpPayments: number
+    holooPurchases: number
+    linkedCustomers: number
+  }
+  nextRunInSec: number | null
+}
+
+interface EndpointProbe {
+  path: string
+  ok: boolean
+  status: number
+  shape: string
+  count?: number
+  sampleKeys?: string[]
+  error?: string
+}
+
+interface ProductRow {
+  erpCode: string
+  code: string | null
+  name: string
+  few: string | null
+  buyPrice: number | null
+  sellPrice: number | null
+  group: string | null
+  active: boolean
+  lastSyncedAt: string
+}
+
+const KIND_FA: Record<string, string> = { initial: 'اولیه', incremental: 'افزایشی', manual: 'دستی' }
+
+function faNum(n: number | null | undefined): string {
+  if (n === null || n === undefined) return '—'
+  return new Intl.NumberFormat('fa-IR').format(n)
+}
+
+export default function HolooTab() {
+  const { toast } = useToast()
+  const [settings, setSettings] = useState<HolooSettingsPublic | null>(null)
+  const [sync, setSync] = useState<SyncState | null>(null)
+  const [form, setForm] = useState({ baseUrl: '', dbname: '', username: '', password: '', syncIntervalMin: 3, enabled: false })
+  const [saving, setSaving] = useState(false)
+  const [testing, setTesting] = useState(false)
+  const [syncing, setSyncing] = useState(false)
+  const [probes, setProbes] = useState<EndpointProbe[] | null>(null)
+  const [testError, setTestError] = useState<string | null>(null)
+  const [products, setProducts] = useState<ProductRow[] | null>(null)
+  const [productQuery, setProductQuery] = useState('')
+  const [productsLoading, setProductsLoading] = useState(false)
+  const pollRef = useRef<ReturnType<typeof setInterval> | null>(null)
+
+  const loadStatus = useCallback(async () => {
+    try {
+      const r = await fetch('/api/admin/holoo/status')
+      if (!r.ok) return
+      const j = await r.json()
+      if (j.ok) {
+        setSettings(j.settings)
+        setSync(j.sync)
+        setForm((f) =>
+          f.baseUrl === '' && f.dbname === '' && f.username === '' && f.password === ''
+            ? {
+                baseUrl: j.settings.baseUrl,
+                dbname: j.settings.dbname,
+                username: j.settings.username,
+                password: '',
+                syncIntervalMin: j.settings.syncIntervalMin,
+                enabled: j.settings.enabled,
+              }
+            : f,
+        )
+      }
+    } catch {
+      /* polling must never crash the tab */
+    }
+  }, [])
+
+  useEffect(() => {
+    void loadStatus()
+    pollRef.current = setInterval(() => void loadStatus(), 10_000)
+    return () => {
+      if (pollRef.current) clearInterval(pollRef.current)
+    }
+  }, [loadStatus])
+
+  const save = async () => {
+    setSaving(true)
+    try {
+      const body: Record<string, unknown> = {
+        enabled: form.enabled,
+        baseUrl: form.baseUrl,
+        dbname: form.dbname,
+        username: form.username,
+        syncIntervalMin: form.syncIntervalMin,
+      }
+      if (form.password) body.password = form.password
+      const r = await fetch('/api/admin/holoo/settings', {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body),
+      })
+      const j = await r.json()
+      if (!r.ok || !j.ok) throw new Error(j.error || 'ذخیره ناموفق بود')
+      toast({ title: 'تنظیمات هلو ذخیره شد' })
+      setForm((f) => ({ ...f, password: '' }))
+      await loadStatus()
+    } catch (e) {
+      toast({ title: 'خطا در ذخیرهٔ تنظیمات', description: e instanceof Error ? e.message : String(e), variant: 'destructive' })
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  const test = async () => {
+    setTesting(true)
+    setProbes(null)
+    setTestError(null)
+    try {
+      const r = await fetch('/api/admin/holoo/test', { method: 'POST' })
+      const j = await r.json()
+      if (!r.ok || !j.ok) {
+        setTestError(j.error || 'تست اتصال ناموفق بود')
+        toast({ title: 'اتصال به هلو برقرار نشد', description: j.error || '', variant: 'destructive' })
+        return
+      }
+      setProbes(j.endpoints || [])
+      toast({ title: 'اتصال به هلو برقرار شد', description: 'نتیجهٔ کاوش Endpointها را ببینید' })
+    } catch (e) {
+      setTestError(e instanceof Error ? e.message : String(e))
+    } finally {
+      setTesting(false)
+    }
+  }
+
+  const runSync = async () => {
+    setSyncing(true)
+    try {
+      const r = await fetch('/api/admin/holoo/sync', { method: 'POST' })
+      const j = await r.json()
+      if (!r.ok || !j.ok) {
+        toast({ title: 'شروع سینک ممکن نشد', description: j.error || '', variant: 'destructive' })
+        return
+      }
+      toast({ title: 'سینک دستی آغاز شد', description: 'پیشرفت را از همین صفحه دنبال کنید' })
+      setTimeout(() => void loadStatus(), 1000)
+    } finally {
+      setSyncing(false)
+    }
+  }
+
+  const loadProducts = async () => {
+    if (products !== null) {
+      setProducts(null)
+      return
+    }
+    setProductsLoading(true)
+    try {
+      const r = await fetch(`/api/admin/holoo/products?q=${encodeURIComponent(productQuery)}`)
+      const j = await r.json()
+      if (j.ok) setProducts(j.items)
+      else setProducts([])
+    } catch {
+      setProducts([])
+    } finally {
+      setProductsLoading(false)
+    }
+  }
+
+  if (!settings) {
+    return (
+      <div className="flex items-center justify-center py-20 text-muted-foreground">
+        <Loader2 className="ml-2 h-4 w-4 animate-spin" /> در حال بارگذاری وضعیت هلو…
+      </div>
+    )
+  }
+
+  return (
+    <div className="space-y-4">
+      {/* ── connection settings ─────────────────────────────────────── */}
+      <Card>
+        <CardHeader className="pb-3">
+          <CardTitle className="flex items-center gap-2 text-base">
+            <Database className="h-4 w-4" /> اتصال به هلو
+            <Badge variant={settings.configured ? 'default' : 'secondary'}>
+              {settings.configured ? 'تنظیمات کامل است' : 'تنظیمات ناقص'}
+            </Badge>
+            {settings.enabled && <Badge>سینک خودکار روشن</Badge>}
+          </CardTitle>
+        </CardHeader>
+        <CardContent className="space-y-3">
+          {settings.isHttp && (
+            <div className="flex items-start gap-2 rounded-lg border border-amber-300 bg-amber-50 p-3 text-xs text-amber-900 dark:border-amber-700 dark:bg-amber-950 dark:text-amber-200">
+              <AlertTriangle className="mt-0.5 h-4 w-4 shrink-0" />
+              <span>
+                آدرس فعلی HTTP (بدون رمزنگاری TLS) است — طبق دستور یکپارچه‌سازی، سرویس هلو باید فقط در شبکهٔ داخلی در دسترس باشد و
+                این آدرس هرگز از بیرون فاش/منتشر نشود.
+              </span>
+            </div>
+          )}
+          <div className="grid gap-3 sm:grid-cols-2">
+            <div className="space-y-1.5">
+              <Label htmlFor="holoo-baseurl">آدرس سرویس (مثال: http://192.168.1.10:8080/TncHoloo/api)</Label>
+              <Input
+                id="holoo-baseurl"
+                dir="ltr"
+                value={form.baseUrl}
+                onChange={(e) => setForm((f) => ({ ...f, baseUrl: e.target.value }))}
+                placeholder="http://IP:8080/TncHoloo/api"
+              />
+            </div>
+            <div className="space-y-1.5">
+              <Label htmlFor="holoo-dbname">نام پایگاه داده</Label>
+              <Input id="holoo-dbname" dir="ltr" value={form.dbname} onChange={(e) => setForm((f) => ({ ...f, dbname: e.target.value }))} placeholder="Holoo1" />
+            </div>
+            <div className="space-y-1.5">
+              <Label htmlFor="holoo-username">نام کاربری</Label>
+              <Input id="holoo-username" dir="ltr" value={form.username} onChange={(e) => setForm((f) => ({ ...f, username: e.target.value }))} />
+            </div>
+            <div className="space-y-1.5">
+              <Label htmlFor="holoo-password">
+                رمز {settings.hasPassword ? '(ذخیره شده — خالی بگذارید تا بدون تغییر بماند)' : ''}
+              </Label>
+              <Input
+                id="holoo-password"
+                type="password"
+                dir="ltr"
+                value={form.password}
+                onChange={(e) => setForm((f) => ({ ...f, password: e.target.value }))}
+                placeholder={settings.hasPassword ? '••••••••' : 'رمز هلو'}
+              />
+            </div>
+            <div className="space-y-1.5">
+              <Label htmlFor="holoo-interval">بازهٔ سینک خودکار (دقیقه، ۱ تا ۱۴۴۰)</Label>
+              <Input
+                id="holoo-interval"
+                type="number"
+                min={1}
+                max={1440}
+                value={form.syncIntervalMin}
+                onChange={(e) => setForm((f) => ({ ...f, syncIntervalMin: Number(e.target.value) }))}
+              />
+            </div>
+            <div className="flex items-center justify-between rounded-lg border p-3">
+              <div className="space-y-0.5">
+                <Label htmlFor="holoo-enabled">سینک خودکار</Label>
+                <p className="text-xs text-muted-foreground">هر {faNum(form.syncIntervalMin)} دقیقه (پیش‌فرض ۳)</p>
+              </div>
+              <Switch id="holoo-enabled" checked={form.enabled} onCheckedChange={(v) => setForm((f) => ({ ...f, enabled: v }))} />
+            </div>
+          </div>
+          <div className="flex flex-wrap gap-2">
+            <Button onClick={save} disabled={saving}>
+              {saving ? <Loader2 className="ml-2 h-4 w-4 animate-spin" /> : <Save className="ml-2 h-4 w-4" />} ذخیرهٔ تنظیمات
+            </Button>
+            <Button variant="outline" onClick={test} disabled={testing || !settings.configured}>
+              {testing ? <Loader2 className="ml-2 h-4 w-4 animate-spin" /> : <Plug className="ml-2 h-4 w-4" />} تست اتصال واقعی
+            </Button>
+            <Button variant="outline" onClick={runSync} disabled={syncing || !settings.configured || sync?.running}>
+              {sync?.running ? <Loader2 className="ml-2 h-4 w-4 animate-spin" /> : <RefreshCw className="ml-2 h-4 w-4" />} سینک دستی
+            </Button>
+          </div>
+          {testError && (
+            <div className="rounded-lg border border-red-300 bg-red-50 p-3 text-xs text-red-800 dark:border-red-800 dark:bg-red-950 dark:text-red-200" dir="rtl">
+              {testError}
+            </div>
+          )}
+          {probes && (
+            <div className="space-y-1.5">
+              <p className="text-xs font-medium text-muted-foreground">کاوش فقط-خواندنی Endpointها (وضعیت واقعی سرویس شما):</p>
+              <Table>
+                <TableHeader>
+                  <TableRow>
+                    <TableHead>Endpoint</TableHead>
+                    <TableHead>وضعیت</TableHead>
+                    <TableHead>شکل پاسخ</TableHead>
+                    <TableHead>نمونه فیلدها</TableHead>
+                  </TableRow>
+                </TableHeader>
