+
+// ═══════════════════════════════════════════════════════════════════
+// ── Holoo integration (phase 1, Nov 2026) ─────────────────────────
+// ═══════════════════════════════════════════════════════════════════
+// DATA OWNERSHIP (per the owner's integration instruction):
+//  * Holoo owns the ACCOUNTING truth — balances (Mandeh), credit, prices,
+//    invoices, payments. Those live HERE, in the Erp* tables, and are
+//    ONLY ever written by the sync adapter (lib/holoo-sync.ts).
+//  * MedPad owns the OPERATIONAL truth — visits, notes, assignments,
+//    check-ins, CRM fields. The sync NEVER writes those.
+//  * Customer.erpCode is the single bridge: a Holoo customer linked to a
+//    MedPad customer. Linking (or creating an unlinked MedPad row) never
+//    assigns the customer to any rep (no auto-assignment, §10).
+//
+// NO-DELETE POLICY: absence from an API response is NEVER a delete (the
+// Holoo API does not report deletions). Rows stay; deactivation is only
+// recorded when the API explicitly reports an inactive flag.
+
+/// Holoo-side customer (طرف‌حساب) accounting mirror. erpCode is Holoo's
+/// stable external id (base64-ish string) — the sync's idempotency key.
+model ErpCustomer {
+  id           String   @id @default(cuid())
+  erpCode      String   @unique
+  code         String?  // human-facing Holoo code (e.g. 00027)
+  name         String
+  mandeh       Float    @default(0) // مانده حساب (Holoo-owned)
+  credit       Float    @default(0) // اعتبار (Holoo-owned)
+  nationalId   String?  // کد ملی
+  economicId   String?  // کد اقتصادی
+  tel          String?
+  mobile       String?
+  city         String?
+  ostan        String?  // استان
+  mantagheh    String?  // محدوده/منطقه
+  zipCode      String?
+  address      String?
+  job          String?
+  email        String?
+  // Holoo-reported inactivity ONLY (absence from a response never flips
+  // this — see the no-delete policy above). MedPad's Customer.active is a
+  // SEPARATE operational flag the sync never touches.
+  active       Boolean  @default(true)
+  contentHash  String
+  lastSyncedAt DateTime @updatedAt
+  createdAt    DateTime @default(now())
+
+  @@index([active])
+}
+
+/// Holoo-side product (کالا) mirror.
+model ErpProduct {
+  id           String   @id @default(cuid())
+  erpCode      String   @unique
+  code         String?
+  name         String
+  few          String?  // واحد شمارش (unit of measure)
+  buyPrice     Float?
+  sellPrice    Float?
+  group        String?  // main/side group name
+  active       Boolean  @default(true)
+  contentHash  String
+  lastSyncedAt DateTime @updatedAt
+  createdAt    DateTime @default(now())
+}
+
+/// Holoo-side payment (دریافت از مشتری) mirror — from Report/GetCustPay.
+model ErpPayment {
+  id              String   @id @default(cuid())
+  customerErpCode String
+  code            String?  // Holoo document code (sync synthesizes one when the API returns none — see holoo-sync)
+  name            String?
+  price           Float    @default(0)
+  date            DateTime
+  mandeh          Float?
+  contentHash     String
+  lastSyncedAt    DateTime @updatedAt
+  createdAt       DateTime @default(now())
+
+  @@unique([customerErpCode, code])
+  @@index([customerErpCode])
+}
+
+/// One row per sync run (initial | incremental | manual) — the panel's
+/// «وضعیت سینک» view and the scheduler's watermark. `errors` is a JSON
+/// array of SAFE strings (classified error kinds + counts — NEVER
+/// credentials, tokens or raw password material).
+model HolooSyncLog {
+  id          String    @id @default(cuid())
+  kind        String
+  status      String    // running | success | error
+  startedAt   DateTime  @default(now())
+  finishedAt  DateTime?
+  checked     Int       @default(0)
+  created     Int       @default(0)
+  updated     Int       @default(0)
+  unchanged   Int       @default(0)
+  deactivated Int       @default(0)
+  errors      String?
+  checkpoint  String?   // JSON watermark (last success time etc.)
+
+  @@index([startedAt])
+}
diff -ruN a/src/app/api/admin/holoo/products/route.ts src/src/app/api/admin/holoo/products/route.ts
--- a/src/app/api/admin/holoo/products/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ src/src/app/api/admin/holoo/products/route.ts	2026-11-10 09:24:30.000000000 +0000
@@ -0,0 +1,51 @@
+import { NextResponse } from 'next/server'
+import { isAdmin } from '@/lib/auth'
+import { db } from '@/lib/db'
+import type { Prisma } from '@prisma/client'
+
+/**
+ * Holoo integration (phase 1) — the synced product list for the panel
+ * (GET ?q=&page=&pageSize=). Read-only view over ErpProduct (Holoo-owned
+ * accounting data: prices etc.). Search matches name/code/group.
+ */
+export async function GET(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const url = new URL(req.url)
+  const q = (url.searchParams.get('q') || '').trim()
+  const page = Math.max(1, Number(url.searchParams.get('page')) || 1)
+  const pageSize = Math.min(100, Math.max(10, Number(url.searchParams.get('pageSize')) || 25))
+
+  const where: Prisma.ErpProductWhereInput = q
+    ? {
+        OR: [
+          { name: { contains: q } },
+          { code: { contains: q } },
+          { group: { contains: q } },
+        ],
+      }
+    : {}
+
+  const [items, total] = await Promise.all([
+    db.erpProduct.findMany({
+      where,
+      orderBy: { name: 'asc' },
+      skip: (page - 1) * pageSize,
+      take: pageSize,
+      select: {
+        erpCode: true,
+        code: true,
+        name: true,
+        few: true,
+        buyPrice: true,
+        sellPrice: true,
+        group: true,
+        active: true,
+        lastSyncedAt: true,
+      },
+    }),
+    db.erpProduct.count({ where }),
+  ])
+  return NextResponse.json({ ok: true, items, total, page, pageSize })
+}
diff -ruN a/src/app/api/admin/holoo/settings/route.ts src/src/app/api/admin/holoo/settings/route.ts
--- a/src/app/api/admin/holoo/settings/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ src/src/app/api/admin/holoo/settings/route.ts	2026-11-10 09:24:29.000000000 +0000
@@ -0,0 +1,46 @@
+import { NextResponse } from 'next/server'
+import { isAdmin } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+import { getHolooConfig, sanitizeHolooConfig, saveHolooConfig } from '@/lib/holoo-config'
+
+/**
+ * Holoo integration (phase 1) — connection settings.
+ *   GET /api/admin/holoo/settings → sanitized config (hasPassword, NEVER the value)
+ *   PUT /api/admin/holoo/settings → validate + persist {enabled, baseUrl,
+ *        dbname, username, password (write-only, empty = keep), syncIntervalMin}
+ * Admin-session only; every change is audited (without secrets);
+ * credential changes drop the cached login token.
+ */
+export async function GET() {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const cfg = await getHolooConfig()
+  return NextResponse.json({ ok: true, settings: sanitizeHolooConfig(cfg) })
+}
+
+export async function PUT(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  let body: Record<string, unknown>
+  try {
+    body = (await req.json()) as Record<string, unknown>
+  } catch {
+    return NextResponse.json({ ok: false, error: 'bad-json' }, { status: 400 })
+  }
+  try {
+    const cfg = await saveHolooConfig(body)
+    // audit WITHOUT the password (only the fact that it changed)
+    const passwordChanged =
+      body.password !== undefined && body.password !== null && body.password !== ''
+    await writeAudit({
+      action: 'holoo.settings.update',
+      targetType: 'holoo',
+      detail: `تنظیمات هلو ذخیره شد (baseUrl=${cfg.baseUrl ? 'تنظیم‌شده' : 'خالی'}، dbname=${cfg.dbname || '—'}، interval=${cfg.syncIntervalMin}دق، enabled=${cfg.enabled ? 'روشن' : 'خاموش'}${passwordChanged ? '، رمز تغییر کرد' : ''})`,
+    })
+    return NextResponse.json({ ok: true, settings: sanitizeHolooConfig(cfg) })
+  } catch (e) {
+    return NextResponse.json({ ok: false, error: e instanceof Error ? e.message : 'خطای ناشناخته' }, { status: 400 })
+  }
+}
