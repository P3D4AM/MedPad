+  /** Cached token or a fresh login. `force` skips the cache. */
+  private async ensureAuth(force = false): Promise<string> {
+    if (!force) {
+      const cached = await getHolooToken()
+      if (cached?.token) return cached.token
+    }
+    return this.login()
+  }
