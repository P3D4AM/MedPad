+      if (e instanceof HolooError) throw e
+      throw new HolooError('network', 'ارتباط با سرویس هلو برقرار نشد')
+    }
+    if (res.status === 401 || res.status === 403) {
+      throw new HolooError('auth', 'هلو اعتبارنامه را نپذیرفت (کاربر/رمز/پایگاه داده)', res.status)
+    }
+    if (!res.ok) {
+      throw new HolooError('http', `خطای HTTP ${res.status} در ورود به هلو`, res.status)
+    }
+    const text = await res.text()
+    let body: unknown = text
+    try {
+      body = JSON.parse(text)
+    } catch {
+      /* keep raw text — extractLogin tolerates it */
+    }
+    const parsed = extractLogin(body)
+    if (!parsed.ok || !parsed.token) {
+      await clearHolooToken()
+      throw new HolooError('auth', parsed.error ?? 'ورود به هلو ناموفق بود')
+    }
+    const header = authHeaderValue(parsed.token)
