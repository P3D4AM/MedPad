diff -ruN a/src/lib/holoo-config.ts src/src/lib/holoo-config.ts
--- a/src/lib/holoo-config.ts	1970-01-01 00:00:00.000000000 +0000
+++ src/src/lib/holoo-config.ts	2026-11-10 09:18:27.000000000 +0000
@@ -0,0 +1,221 @@
+import { db } from '@/lib/db'
+
+/**
+ * Holoo integration (phase 1) — connection settings.
+ *
+ * Storage: the EXISTING Config KV table (the project's single server-side
+ * settings store — no new infrastructure). All values live server-side
+ * only; the password NEVER crosses to the browser/APK (the API returns
+ * `hasPassword` instead — see sanitizeHolooConfig).
+ *
+ * Security notes (per the owner's integration instruction):
+ *  * the Holoo web service speaks plain HTTP (`http://{IPSystem}:8080/...`)
+ *    → the panel warns that the service MUST stay on the internal network;
+ *  * the Holoo password must be RECOVERABLE (unlike the admin's bcrypt) to
+ *    be replayed on every login — it is stored BASE64-encoded in Config,
+ *    which is OBFUSCATION, not encryption (documented openly). The SQLite
+ *    file carries the OS-level perms of the panel's db directory; the value
+ *    is never logged, never returned by any API and never shipped to the
+ *    client bundle;
+ *  * the login token is cached in Config (`holoo.token`) and invalidated
+ *    whenever ANY credential field changes.
+ */
+
+const KEYS = {
+  enabled: 'holoo.enabled',
+  baseUrl: 'holoo.baseUrl',
+  dbname: 'holoo.dbname',
+  username: 'holoo.username',
+  password: 'holoo.password', // base64 of the plain password (server-only)
+  intervalMin: 'holoo.syncIntervalMin',
+  token: 'holoo.token',
+  tokenAt: 'holoo.tokenAt',
+} as const
+
+export const HOLOO_INTERVAL_MIN = 1
+export const HOLOO_INTERVAL_MAX = 1440
+export const HOLOO_INTERVAL_DEFAULT = 3
+
+/** Full server-side config (includes the recoverable password). */
+export interface HolooConfig {
+  enabled: boolean
+  baseUrl: string // normalized — no trailing slash
+  dbname: string
+  username: string
+  passwordB64: string
+  syncIntervalMin: number
+  /** informational: the configured URL is plain HTTP (no TLS) */
+  isHttp: boolean
+}
+
+/** What an API may return — secrets stripped, booleans summarized. */
+export interface HolooConfigPublic {
+  enabled: boolean
+  baseUrl: string
+  dbname: string
+  username: string
+  syncIntervalMin: number
+  hasPassword: boolean
+  configured: boolean
+  isHttp: boolean
+}
+
+async function readKey(key: string): Promise<string> {
+  const row = await db.config.findUnique({ where: { key } })
+  return row?.value ?? ''
+}
+
+async function writeKey(key: string, value: string): Promise<void> {
+  await db.config.upsert({ where: { key }, update: { value }, create: { key, value } })
+}
+
+/** Normalize + validate a base URL. Throws a Persian error when invalid. */
+export function normalizeBaseUrl(input: unknown): string {
+  if (typeof input !== 'string') throw new Error('آدرس سرویس هلو نامعتبر است')
+  let s = input.trim()
+  if (!s) throw new Error('آدرس سرویس هلو لازم است')
+  if (s.length > 300) throw new Error('آدرس سرویس هلو بیش از حد طولانی است')
+  if (!/^https?:\/\//i.test(s)) {
+    throw new Error('آدرس باید با http:// یا https:// شروع شود (مثال: http://192.168.1.10:8080/TncHoloo/api)')
+  }
+  try {
+    // will throw on nonsense like http://...
+    new URL(s)
+  } catch {
+    throw new Error('آدرس سرویس هلو قابل تجزیه نیست — آن را بررسی کنید')
+  }
+  while (s.endsWith('/')) s = s.slice(0, -1)
+  return s
+}
+
+function toBase64(plain: string): string {
+  return Buffer.from(plain, 'utf8').toString('base64')
+}
+
+/** Read the full config (safe defaults for missing/corrupt rows). */
+export async function getHolooConfig(): Promise<HolooConfig> {
+  const [enabled, baseUrl, dbname, username, passwordB64, intervalMin] = await Promise.all([
+    readKey(KEYS.enabled),
+    readKey(KEYS.baseUrl),
+    readKey(KEYS.dbname),
+    readKey(KEYS.username),
+    readKey(KEYS.password),
+    readKey(KEYS.intervalMin),
+  ])
+  const rawInterval = Number(intervalMin)
+  const syncIntervalMin =
+    Number.isFinite(rawInterval) && rawInterval >= HOLOO_INTERVAL_MIN && rawInterval <= HOLOO_INTERVAL_MAX
+      ? Math.trunc(rawInterval)
+      : HOLOO_INTERVAL_DEFAULT
+  const normalizedBase = baseUrl.trim().replace(/\/+$/, '')
+  return {
+    enabled: enabled === '1',
+    baseUrl: normalizedBase,
+    dbname: dbname.trim(),
+    username: username.trim(),
+    passwordB64,
+    syncIntervalMin,
+    isHttp: /^http:\/\//i.test(normalizedBase),
+  }
+}
+
+/** true when every credential field is present (a login attempt is possible). */
+export function isConfigured(c: HolooConfig): boolean {
+  return !!(c.baseUrl && c.dbname && c.username && c.passwordB64)
+}
+
+/** Strip secrets for API responses. */
+export function sanitizeHolooConfig(c: HolooConfig): HolooConfigPublic {
+  return {
+    enabled: c.enabled,
+    baseUrl: c.baseUrl,
+    dbname: c.dbname,
+    username: c.username,
+    syncIntervalMin: c.syncIntervalMin,
+    hasPassword: !!c.passwordB64,
+    configured: isConfigured(c),
+    isHttp: c.isHttp,
+  }
+}
+
+export interface HolooConfigPatch {
+  enabled?: unknown
+  baseUrl?: unknown
+  dbname?: unknown
+  username?: unknown
+  /** PLAIN password from the admin (write-only). Empty/undefined = keep current. */
+  password?: unknown
+  syncIntervalMin?: unknown
+}
+
+/** Validate + persist a settings patch. Throws Persian errors; returns the
+ *  NEW full config. Changing any credential field drops the cached token. */
+export async function saveHolooConfig(patch: HolooConfigPatch): Promise<HolooConfig> {
+  const current = await getHolooConfig()
+  let next: HolooConfig = { ...current }
+  let credentialsChanged = false
+
+  if (patch.enabled !== undefined) {
+    const v = patch.enabled === true || patch.enabled === 1 || patch.enabled === '1' || patch.enabled === 'true'
+    next.enabled = v
+  }
+  if (patch.baseUrl !== undefined) {
+    const url = normalizeBaseUrl(patch.baseUrl)
+    if (url !== current.baseUrl) credentialsChanged = true
+    next.baseUrl = url
+    next.isHttp = /^http:\/\//i.test(url)
+  }
+  if (patch.dbname !== undefined) {
+    if (typeof patch.dbname !== 'string' || !patch.dbname.trim()) throw new Error('نام پایگاه دادهٔ هلو لازم است')
+    const v = patch.dbname.trim().slice(0, 200)
+    if (v !== current.dbname) credentialsChanged = true
+    next.dbname = v
+  }
+  if (patch.username !== undefined) {
+    if (typeof patch.username !== 'string' || !patch.username.trim()) throw new Error('نام کاربری هلو لازم است')
+    const v = patch.username.trim().slice(0, 100)
+    if (v !== current.username) credentialsChanged = true
+    next.username = v
+  }
+  if (patch.password !== undefined && patch.password !== null && patch.password !== '') {
+    if (typeof patch.password !== 'string') throw new Error('رمز هلو نامعتبر است')
+    if (patch.password.length > 200) throw new Error('رمز هلو بیش از حد طولانی است')
+    next.passwordB64 = toBase64(patch.password)
+    credentialsChanged = true
+  }
+  if (patch.syncIntervalMin !== undefined) {
+    const n = typeof patch.syncIntervalMin === 'string' ? Number(patch.syncIntervalMin.trim()) : Number(patch.syncIntervalMin)
+    if (!Number.isFinite(n) || Math.trunc(n) !== n || n < HOLOO_INTERVAL_MIN || n > HOLOO_INTERVAL_MAX) {
+      throw new Error(`بازهٔ سینک باید عددی صحیح بین ${HOLOO_INTERVAL_MIN} و ${HOLOO_INTERVAL_MAX} دقیقه باشد`)
+    }
+    next.syncIntervalMin = n
+  }
+
+  await writeKey(KEYS.enabled, next.enabled ? '1' : '0')
+  await writeKey(KEYS.baseUrl, next.baseUrl)
+  await writeKey(KEYS.dbname, next.dbname)
+  await writeKey(KEYS.username, next.username)
+  await writeKey(KEYS.password, next.passwordB64)
+  await writeKey(KEYS.intervalMin, String(next.syncIntervalMin))
+  if (credentialsChanged) await clearHolooToken()
+  return next
+}
+
+// ── token cache (Config KV; never logged, never returned by any API) ──
+
+export async function getHolooToken(): Promise<{ token: string; at: number } | null> {
+  const [token, at] = await Promise.all([readKey(KEYS.token), readKey(KEYS.tokenAt)])
+  if (!token) return null
+  const ts = Number(at)
+  return { token, at: Number.isFinite(ts) ? ts : 0 }
+}
+
+export async function setHolooToken(token: string): Promise<void> {
+  await writeKey(KEYS.token, token)
+  await writeKey(KEYS.tokenAt, String(Date.now()))
+}
+
+export async function clearHolooToken(): Promise<void> {
+  await writeKey(KEYS.token, '')
+  await writeKey(KEYS.tokenAt, '')
+}
