+import { createHash } from 'crypto'
+import {
+  type HolooConfig,
+  isConfigured,
+  getHolooToken,
+  setHolooToken,
+  clearHolooToken,
+} from './holoo-config'
+
+/**
+ * Holoo integration (phase 1) — the HTTP client for the Holoo web service.
+ *
+ * Wire format (per the owner's integration instruction, cross-checked with
+ * the public TncHoloo docs; every uncertain point is marked ASSUMPTION and
+ * is verified by the read-only /api/admin/holoo/test probe):
+ *   base:      http://{IPSystem}:8080/TncHoloo/api        (config value)
+ *   login:     POST {base}/Login  body {"userinfo":{"username","userpass","dbname"}}
+ *              — userpass is the BASE64 of the plain password (Base64 is
+ *              transport encoding, NOT encryption; documented openly).
+ *   response:  {"Login":{"State":"True","Token":"Bearer …","ErrorCode":0,"Error":""}}
+ *              — parsed tolerantly (token may or may not carry the Bearer
+ *              prefix; State may be string/bool).
+ *   requests:  GET {base}/{path}  with header  Authorization: <token>
+ *   401/audit: exactly ONE automatic re-login + retry per request.
+ *
+ * ZERO new dependencies — Node 24's global fetch + AbortController.
+ * Credentials and tokens are NEVER included in errors or logs.
+ */
+
+export type HolooErrorKind =
+  | 'not-configured'
+  | 'network'
+  | 'timeout'
+  | 'auth'
+  | 'http'
+  | 'invalid-response'
+  | 'unknown'
+
+export class HolooError extends Error {
+  kind: HolooErrorKind
+  status?: number
+  constructor(kind: HolooErrorKind, message: string, status?: number) {
+    super(message)
+    this.name = 'HolooError'
+    this.kind = kind
+    this.status = status
+  }
+}
+
+/** Safe message for logs/audit — guaranteed free of credential material. */
+export function holooSafeError(e: unknown): string {
+  if (e instanceof HolooError) return `[${e.kind}] ${e.message}`
+  if (e instanceof Error) return `[unknown] ${e.message.slice(0, 200)}`
+  return '[unknown] خطای ناشناخته'
+}
+
+const DEFAULT_TIMEOUT_MS = 30_000
+const PROBE_TIMEOUT_MS = 10_000
+
+/** Authorization header value: exactly what Holoo's login returned. Some
+ *  deployments return the bare token, others the prefixed "Bearer <tok>" —
+ *  normalize so the header is always exactly one "Bearer " + token. */
+function authHeaderValue(token: string): string {
+  return /^bearer\s+/i.test(token) ? token : `Bearer ${token}`
+}
+
+function pick(obj: Record<string, unknown>, keys: string[]): unknown {
+  for (const k of keys) {
+    if (obj[k] !== undefined && obj[k] !== null && obj[k] !== '') return obj[k]
+  }
+  return undefined
+}
+
+/** Login response tolerance: the documented shape is {"Login":{...}} but a
+ *  flat {"Token":...} is accepted too (ASSUMPTION — verified by /test). */
+function extractLogin(body: unknown): { ok: boolean; token?: string; error?: string } {
+  if (typeof body === 'string') {
+    const s = body.trim()
+    // a raw token string body — accept it (ASSUMPTION)
+    if (s && !s.startsWith('{') && !s.startsWith('<')) return { ok: true, token: s }
+    return { ok: false, error: 'پاسخ لاگین قابل تجزیه نیست' }
+  }
+  if (!body || typeof body !== 'object') return { ok: false, error: 'پاسخ لاگین قابل تجزیه نیست' }
+  const o = body as Record<string, unknown>
+  const inner = (o.Login ?? o.login ?? o.result ?? o.Result) as Record<string, unknown> | undefined
+  const src = inner && typeof inner === 'object' ? inner : o
+  const token = pick(src, ['Token', 'token', 'access_token', 'accessToken', 'Token1'])
+  const state = pick(src, ['State', 'state', 'Success', 'success', 'Ok', 'ok'])
+  const errCode = pick(src, ['ErrorCode', 'errorCode', 'Code', 'code'])
+  const errMsg = pick(src, ['Error', 'error', 'Message', 'message'])
+  const stateOk =
+    state === undefined ? true : state === true || state === 1 || String(state).toLowerCase() === 'true' || String(state).toLowerCase() === 'ok'
+  if (typeof token === 'string' && token.trim() && stateOk) return { ok: true, token: token.trim() }
+  if (errMsg) return { ok: false, error: `ورود به هلو ناموفق بود: ${String(errMsg).slice(0, 150)}` }
+  if (errCode !== undefined && Number(errCode) !== 0) return { ok: false, error: `ورود به هلو ناموفق بود (کد ${Number(errCode)})` }
+  return { ok: false, error: 'پاسخ لاگین هلو فاقد توکن است' }
+}
+
+export interface HolooListResult {
+  /** the parsed JSON body as-is (for holooJson provenance) */
+  raw: unknown
+  /** extracted record list (arrays, {data:[...]}, single objects, …) */
+  items: Record<string, unknown>[]
+}
+
+export interface HolooEndpointProbe {
+  path: string
+  ok: boolean
+  status: number
+  shape: string
+  count?: number
+  sampleKeys?: string[]
+  error?: string
+}
+
+export class HolooClient {
+  private cfg: HolooConfig
+  private timeoutMs: number
+
+  constructor(cfg: HolooConfig, opts?: { timeoutMs?: number }) {
+    this.cfg = cfg
+    this.timeoutMs = opts?.timeoutMs ?? DEFAULT_TIMEOUT_MS
+  }
+
+  private assertConfigured(): void {
+    if (!isConfigured(this.cfg)) {
+      throw new HolooError('not-configured', 'تنظیمات اتصال هلو کامل نیست (آدرس، پایگاه داده، کاربر یا رمز)')
+    }
+  }
+
+  private url(path: string, params?: Record<string, string | number | undefined>): string {
+    const u = new URL(`${this.cfg.baseUrl}/${path.replace(/^\/+/, '')}`)
+    if (params) {
+      for (const [k, v] of Object.entries(params)) {
+        if (v !== undefined && v !== null && v !== '') u.searchParams.set(k, String(v))
+      }
+    }
+    return u.toString()
+  }
+
+  private async fetchWithTimeout(url: string, init: RequestInit): Promise<Response> {
+    const ac = new AbortController()
+    const t = setTimeout(() => ac.abort(), this.timeoutMs)
+    try {
+      return await fetch(url, { ...init, signal: ac.signal })
+    } catch (e) {
+      if (e instanceof Error && (e.name === 'AbortError' || e.message.includes('aborted'))) {
+        throw new HolooError('timeout', 'مهلت پاسخ سرویس هلو به پایان رسید')
+      }
+      throw new HolooError('network', 'ارتباط با سرویس هلو برقرار نشد')
+    } finally {
+      clearTimeout(t)
+    }
+  }
