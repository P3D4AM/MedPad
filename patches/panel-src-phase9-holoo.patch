+  /** POST {base}/Login — returns the Authorization header value. */
+  async login(): Promise<string> {
+    this.assertConfigured()
+    let res: Response
+    try {
+      res = await this.fetchWithTimeout(`${this.cfg.baseUrl}/Login`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          userinfo: {
+            username: this.cfg.username,
+            // stored base64 is exactly what the wire expects (spec §3)
+            userpass: this.cfg.passwordB64,
+            dbname: this.cfg.dbname,
+          },
+        }),
+      })
