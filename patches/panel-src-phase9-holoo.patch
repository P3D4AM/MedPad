+  /** GET a JSON endpoint with ONE automatic re-login+retry on 401. */
+  async get(path: string, params?: Record<string, string | number | undefined>): Promise<HolooListResult> {
+    this.assertConfigured()
+    const attempt = async (auth: string): Promise<Response> =>
+      this.fetchWithTimeout(this.url(path, params), {
+        method: 'GET',
+        headers: { Authorization: auth, Accept: 'application/json' },
+      })
+    let res = await attempt(await this.ensureAuth())
+    if (res.status === 401 || res.status === 403) {
+      // exactly ONE re-login (spec: token freshness without loops)
+      const fresh = await this.login()
+      res = await attempt(fresh)
+    }
+    if (!res.ok) {
+      throw new HolooError('http', `خطای HTTP ${res.status} از هلو برای ${path}`, res.status)
+    }
+    const text = await res.text()
+    try {
+      const raw = JSON.parse(text)
+      return { raw, items: extractItems(raw) }
+    } catch {
+      throw new HolooError('invalid-response', `پاسخ غیر JSON از هلو برای ${path}`)
+    }
+  }
+
+  /** Read-only probe for the connection-test endpoint (never throws). */
+  async probe(path: string, params?: Record<string, string | number | undefined>): Promise<HolooEndpointProbe> {
+    const shortClient = new HolooClient(this.cfg, { timeoutMs: PROBE_TIMEOUT_MS })
+    try {
+      const { raw, items } = await shortClient.get(path, params)
+      let shape = 'object'
+      let count: number | undefined
+      let sampleKeys: string[] | undefined
+      if (Array.isArray(raw)) {
+        shape = `array(${raw.length})`
+        count = raw.length
+      } else if (typeof raw === 'number') {
+        shape = 'number'
+      } else if (raw && typeof raw === 'object') {
+        const keys = Object.keys(raw as Record<string, unknown>)
+        shape = `object(${keys.length} keys)`
+        const first = items[0]
+        if (first) sampleKeys = Object.keys(first).slice(0, 12)
+      }
+      return { path, ok: true, status: 200, shape, count, sampleKeys }
+    } catch (e) {
+      const he = e instanceof HolooError ? e : null
+      return {
+        path,
+        ok: false,
+        status: he?.status ?? 0,
+        shape: '-',
+        error: holooSafeError(e),
+      }
+    }
+  }
+}
+
+/** Tolerant record-list extraction: direct arrays, wrapped lists
+ *  ({data:[…]} / {List:[…]} / …) or a single record object. */
+export function extractItems(raw: unknown): Record<string, unknown>[] {
+  if (Array.isArray(raw)) return raw.filter((r): r is Record<string, unknown> => !!r && typeof r === 'object')
+  if (raw && typeof raw === 'object') {
+    const o = raw as Record<string, unknown>
+    for (const k of ['data', 'Data', 'list', 'List', 'items', 'Items', 'records', 'Records', 'Result', 'result']) {
+      const v = o[k]
+      if (Array.isArray(v)) return v.filter((r): r is Record<string, unknown> => !!r && typeof r === 'object')
+    }
+    // a single record (e.g. get-by-code style endpoints)
+    return [o]
+  }
+  return []
+}
+
+// ── tolerant field mappers (multi-casing; every candidate documented) ──
+
+export function fStr(rec: Record<string, unknown>, keys: string[]): string | null {
+  const v = pick(rec, keys)
+  if (v === undefined) return null
+  const s = String(v).trim()
+  return s === '' ? null : s
+}
+
+export function fNum(rec: Record<string, unknown>, keys: string[]): number | null {
+  const v = pick(rec, keys)
+  if (v === undefined || v === null || v === '') return null
+  const n = typeof v === 'number' ? v : Number(String(v).replace(/,/g, ''))
+  return Number.isFinite(n) ? n : null
+}
+
+export function fBool(rec: Record<string, unknown>, keys: string[], def: boolean): boolean {
+  const v = pick(rec, keys)
+  if (v === undefined || v === null || v === '') return def
+  if (typeof v === 'boolean') return v
+  const s = String(v).toLowerCase()
+  if (s === 'true' || s === '1' || s === 'yes') return true
+  if (s === 'false' || s === '0' || s === 'no') return false
+  return def
+}
+
+/** Stable content hash of a Holoo record — the change-detection key.
+ *  Canonical JSON (recursively sorted keys) → sha256. */
+export function holooContentHash(rec: Record<string, unknown>): string {
+  const canonical = (v: unknown): unknown => {
+    if (Array.isArray(v)) return v.map(canonical)
+    if (v && typeof v === 'object') {
+      const o: Record<string, unknown> = {}
+      for (const k of Object.keys(v as Record<string, unknown>).sort()) {
+        o[k] = canonical((v as Record<string, unknown>)[k])
+      }
+      return o
+    }
+    return v
+  }
+  return createHash('sha256').update(JSON.stringify(canonical(rec))).digest('hex')
+}
