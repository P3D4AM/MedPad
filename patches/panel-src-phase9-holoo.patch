diff -ruN a/src/app/api/admin/holoo/sync/route.ts src/src/app/api/admin/holoo/sync/route.ts
--- a/src/app/api/admin/holoo/sync/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ src/src/app/api/admin/holoo/sync/route.ts	2026-11-10 09:24:30.000000000 +0000
@@ -0,0 +1,38 @@
+import { NextResponse } from 'next/server'
+import { isAdmin } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+import { getHolooConfig, isConfigured } from '@/lib/holoo-config'
+import { isSyncRunning, runHolooSync } from '@/lib/holoo-sync'
+
+/**
+ * Holoo integration (phase 1) — manual sync trigger (POST).
+ *
+ * Runs EVEN WHEN the scheduler switch is off (first-time setup flow:
+ * test → save → «سینک دستی»), but still requires complete credentials.
+ * The run itself is fire-and-forget: this answers {started:true} and the
+ * panel (and the audit test) follow progress via /api/admin/holoo/status
+ * — a long initial sync must never hold an HTTP request open.
+ */
+export async function POST() {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const cfg = await getHolooConfig()
+  if (!isConfigured(cfg)) {
+    return NextResponse.json(
+      { ok: false, error: 'تنظیمات اتصال هلو کامل نیست — ابتدا آدرس، پایگاه داده، کاربر و رمز را ذخیره کنید' },
+      { status: 400 },
+    )
+  }
+  if (isSyncRunning()) {
+    return NextResponse.json({ ok: false, error: 'یک اجرای سینک هم‌اکنون در جریان است — وضعیت را از همین صفحه دنبال کنید' }, { status: 409 })
+  }
+  await writeAudit({
+    action: 'holoo.sync.manual',
+    targetType: 'holoo',
+    detail: 'سینک دستی هلو آغاز شد',
+  })
+  // fire-and-forget: the promise resolves into the HolooSyncLog row
+  void runHolooSync('manual').catch(() => {})
+  return NextResponse.json({ ok: true, started: true })
+}
diff -ruN a/src/app/api/admin/holoo/test/route.ts src/src/app/api/admin/holoo/test/route.ts
--- a/src/app/api/admin/holoo/test/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ src/src/app/api/admin/holoo/test/route.ts	2026-11-10 09:24:30.000000000 +0000
@@ -0,0 +1,61 @@
+import { NextResponse } from 'next/server'
+import { isAdmin } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+import { getHolooConfig, isConfigured, clearHolooToken } from '@/lib/holoo-config'
+import { HolooClient, holooSafeError } from '@/lib/holoo'
+
+/**
+ * Holoo integration (phase 1) — REAL connection test (POST).
+ *
+ * 1. performs an actual Login against the configured service (never a
+ *    cached token — a fresh login proves the CURRENT credentials work);
+ * 2. on success, explores the READ-ONLY endpoints the sync needs
+ *    (Customer / Product / Invoice / Invoice/Invoice / Report/GetCustPay)
+ *    with short timeouts and reports each one's status + response shape +
+ *    sample field names — the owner's §14 mandate to OBSERVE uncertain
+ *    endpoints before trusting them (e.g. whether invoice LINE ITEMS are
+ *    available anywhere);
+ * 3. answers honestly: ok=false + the classified error when anything fails.
+ *
+ * NEVER returns or logs credentials/tokens. No write endpoint is touched.
+ */
+export async function POST() {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const cfg = await getHolooConfig()
+  if (!isConfigured(cfg)) {
+    return NextResponse.json(
+      { ok: false, error: 'تنظیمات اتصال هلو کامل نیست — ابتدا آدرس، پایگاه داده، کاربر و رمز را ذخیره کنید' },
+      { status: 400 },
+    )
+  }
+  // force a FRESH login (drop the cache first)
+  await clearHolooToken()
+  const client = new HolooClient(cfg, { timeoutMs: 15_000 })
+  try {
+    await client.login()
+  } catch (e) {
+    await writeAudit({
+      action: 'holoo.test',
+      outcome: 'failure',
+      targetType: 'holoo',
+      detail: `تست اتصال ناموفق: ${holooSafeError(e)}`,
+    })
+    return NextResponse.json({ ok: false, error: holooSafeError(e), login: { ok: false }, endpoints: [] })
+  }
+  // read-only exploration (each probe has its own short timeout + never throws)
+  const probes = await Promise.all([
+    client.probe('Customer'),
+    client.probe('Product'),
+    client.probe('Invoice'),
+    client.probe('Invoice/Invoice'),
+    client.probe('Report/GetCustPay'),
+  ])
+  await writeAudit({
+    action: 'holoo.test',
+    targetType: 'holoo',
+    detail: `تست اتصال موفق؛ کاوش فقط-خواندنی: ${probes.map((p) => `${p.path}=${p.ok ? 'OK' : 'ناموفق'}`).join('، ')}`,
+  })
+  return NextResponse.json({ ok: true, login: { ok: true }, endpoints: probes })
+}
