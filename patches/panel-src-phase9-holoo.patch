+
+/**
+ * Holoo integration (phase 1) — the sync orchestrator + scheduler.
+ *
+ * MODE (per the phase-0 risk decision, sanctioned by the owner's
+ * instruction): PERIODIC FULL COMPARISON with contentHash. Every run pulls
+ * the complete Customer / Product / Invoice lists and upserts idempotently
+ * by the stable external key (ErpCode). The API's date.from/date.to
+ * filters are NOT trusted for change detection (they may filter by
+ * document date, not last-modified) — they stay unused until their
+ * semantics are verified against the real service (the /test probe
+ * reports what the service actually returns).
+ *
+ * OWNERSHIP: only the Erp* tables (Holoo-owned accounting data) and the
+ * bridging fields (Customer.erpCode on link/create, Purchase/PurchaseItem
+ * rows with source='holoo') are ever written. No operational MedPad field
+ * (assignments, visits, notes, active, …) is touched by the sync.
+ *
+ * NO-DELETE: absence from a response is NEVER a delete. `active=false` is
+ * only recorded when the API explicitly reports an inactive/blacklist flag.
+ *
+ * CONCURRENCY: a single in-process guard (globalThis) — one run at a time,
+ * shared by the scheduler AND the manual trigger. Crashed runs leave a
+ * 'running' row that boot-migration marks as error after 30 minutes.
+ */
+
+// ── tolerant field-name candidates (documented ASSUMPTIONs; the /test
+//    probe's sampleKeys shows what the REAL service returns) ──────────
+const K_ERP = ['ErpCode', 'erpCode', 'Erpcode', 'ERPCODE', 'erp_code']
+const K_CODE = ['Code', 'code', 'c_Code', 'C_Code', 'fac_Code']
+const K_NAME = ['Name', 'name', 'c_Name', 'C_Name', 'FullName', 'fullName']
+const K_MANDEH = ['Mandeh', 'mandeh', 'Mande', 'Balance', 'balance']
+const K_CREDIT = ['Credit', 'credit', 'Credite', 'credite']
+const K_NATIONAL = ['NationalId', 'nationalid', 'NationalID', 'nationalId', 'NationalCode', 'nationalCode']
+const K_ECONOMIC = ['EconomicId', 'economicId', 'economic_Code', 'EconomicCode', 'economiccode']
+const K_TEL = ['Tel', 'tel', 'c_Tel', 'C_Tel', 'Phone', 'phone']
+const K_MOBILE = ['Mobile', 'mobile', 'c_Mobile', 'C_Mobile', 'Mob', 'mob']
+const K_CITY = ['City', 'city', 'CityName', 'cityName']
+const K_OSTAN = ['Ostan', 'ostan', 'State', 'Province', 'province']
+const K_MANTAGHEH = ['Mantagheh', 'mantagheh', 'Region', 'Area', 'region']
+const K_ZIP = ['ZipCode', 'zipCode', 'Zip', 'PostalCode', 'postalCode']
+const K_ADDRESS = ['Address', 'address', 'c_Address', 'C_Address', 'cBillingAddress']
+const K_JOB = ['Job', 'job', 'JobName', 'jobName']
+const K_EMAIL = ['Email', 'email', 'EMail', 'eMail']
+const K_ACTIVE = ['IsActive', 'isActive', 'Active', 'active']
+const K_BLACKLIST = ['IsBlackList', 'isblacklist', 'IsBlacklist', 'BlackList']
+
+const P_ERP = ['ErpCode', 'erpCode', 'Erpcode']
+const P_CODE = ['Code', 'code', 'a_Code']
+const P_NAME = ['Name', 'name', 'a_Name', 'ProductName']
+const P_FEW = ['Few', 'few', 'Unit', 'unit', 'uniterpcode']
+const P_BUY = ['BuyPrice', 'buyprice', 'buyPrice']
+const P_SELL = ['SellPrice', 'sellprice', 'sellPrice', 'sel_Price', 'SelPrice']
+const P_GROUP = ['m_groupname', 'MainGroupName', 'mainGroupName', 'GroupName', 'groupName', 's_groupname']
+
+const I_ERP = ['ErpCode', 'erpCode', 'Erpcode']
+const I_CODE = ['Code', 'code', 'fac_Code', 'InvoiceNo', 'invoiceNo']
+const I_CUST_ERP = ['CustomerErpCode', 'customerErpCode', 'C_ErpCode', 'ErpCode_C', 'CustErpCode', 'custErpCode']
+const I_DATE = ['Date', 'date', 'FacDate', 'InvDate', 'invDate']
+const I_TOTAL = ['SumPrice', 'sumPrice', 'Sum', 'Total', 'total', 'Price']
+const I_DISCOUNT = ['SumDiscount', 'sumDiscount', 'Scot', 'scot', 'Discount', 'discount']
+const I_TYPE = ['Type', 'type', 'fac_Type']
+
+const PAY_CODE = ['Code', 'code', 'SanadCode', 'sanadCode', 'DocCode']
+const PAY_NAME = ['Name', 'name', 'Comment', 'comment', 'Description']
+const PAY_PRICE = ['Price', 'price', 'Amount', 'amount']
+const PAY_DATE = ['Date', 'date', 'DocDate', 'docDate']
+const PAY_MANDEH = ['Mandeh', 'mandeh', 'Mande', 'Balance']
+
+/** Payment requests are PER-CUSTOMER — be polite between them. */
+const PAYMENT_DELAY_MS = 200
+/** Hard cap of per-customer payment fetches in ONE run (initial sync of a
+ *  very large book must not hammer the service for hours). */
+const PAYMENT_MAX_CUSTOMERS = 5000
+
+// ── Jalali/Gregorian/epoch tolerant date parsing ─────────────────────
+export function parseHolooDate(v: unknown, fallback: Date): Date {
+  if (v === null || v === undefined) return fallback
+  if (typeof v === 'number' && Number.isFinite(v)) {
+    return new Date(v > 1e12 ? v : v * 1000) // ms vs s
+  }
+  const s = String(v).trim()
+  if (!s) return fallback
+  const m = s.match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/)
+  if (m) {
+    const y = Number(m[1])
+    const mo = Number(m[2])
+    const d = Number(m[3])
+    if (y > 1500) {
+      const t = Date.parse(s.includes('T') ? s : s.replace(' ', 'T') + 'Z')
+      return Number.isNaN(t) ? new Date(Date.UTC(y, mo - 1, d)) : new Date(t)
+    }
+    if (y >= 1200 && y <= 1500) {
+      // Jalali string like 1403/08/15 → Gregorian (existing lib/jalali)
+      try {
+        const [gy, gm, gd] = toGregorian(y, mo, d)
+        return new Date(Date.UTC(gy, gm - 1, gd))
+      } catch {
+        return fallback
+      }
+    }
+  }
+  const t = Date.parse(s)
+  return Number.isNaN(t) ? fallback : new Date(t)
+}
+
+/** Persian-aware name normalization for the one-time link heuristic. */
+function normalizeName(s: string): string {
+  return s
+    .trim()
+    .replace(/\s+/g, ' ')
+    .replace(/ي/g, 'ی')
+    .replace(/ك/g, 'ک')
+    .replace(/أ/g, 'ا')
+    .replace(/إ/g, 'ا')
+    .replace(/آ/g, 'ا')
+    .replace(/ة/g, 'ه')
+    .toLowerCase()
+}
+
+// ── run state (single process — the Next.js standalone server) ───────
+interface HolooRunGuard {
+  __medpadHolooRunning?: boolean
+  __medpadHolooTimer?: ReturnType<typeof setInterval>
+}
+const guard = globalThis as unknown as HolooRunGuard
+
+export function isSyncRunning(): boolean {
+  return guard.__medpadHolooRunning === true
+}
+
+export interface HolooSyncSummary {
+  ok: boolean
+  skipped?: 'busy' | 'not-configured' | 'disabled'
+  logId?: string
+  checked?: number
+  created?: number
+  updated?: number
+  unchanged?: number
+  deactivated?: number
+  errors?: string[]
+  detail?: Record<string, { checked: number; created: number; updated: number; unchanged: number; deactivated: number; skipped: number }>
+}
+
+/** The sync itself. Never throws — failures land in the HolooSyncLog row. */
+export async function runHolooSync(kind: 'initial' | 'incremental' | 'manual'): Promise<HolooSyncSummary> {
+  if (isSyncRunning()) return { ok: false, skipped: 'busy' }
+  const cfg = await getHolooConfig()
+  // manual runs work even when the scheduler switch is OFF (first-time
+  // setup: test → save → «سینک دستی» without enabling the timer);
+  // scheduled runs require enabled=1 — enforced by the caller (tick).
+  if (!isConfigured(cfg)) return { ok: false, skipped: 'not-configured' }
+
+  guard.__medpadHolooRunning = true
+  const errors: string[] = []
+  const addError = (e: unknown) => {
+    if (errors.length < 20) errors.push(holooSafeError(e))
+  }
+  const log = await db.holooSyncLog.create({
+    data: { kind, status: 'running', startedAt: new Date() },
+  })
+  const detail: Record<string, { checked: number; created: number; updated: number; unchanged: number; deactivated: number; skipped: number }> = {
+    customers: z(), products: z(), invoices: z(), payments: z(),
+  }
+  const startedAt = Date.now()
+
+  try {
+    await doSync(cfg, kind, detail, addError)
+    const checked = sum(detail, 'checked')
+    const created = sum(detail, 'created')
+    const updated = sum(detail, 'updated')
+    const unchanged = sum(detail, 'unchanged')
+    const deactivated = sum(detail, 'deactivated')
+    await db.holooSyncLog.update({
+      where: { id: log.id },
+      data: {
+        status: 'success',
+        finishedAt: new Date(),
+        checked, created, updated, unchanged, deactivated,
+        errors: errors.length ? JSON.stringify(errors) : null,
+        checkpoint: JSON.stringify({
+          lastSuccessAt: new Date().toISOString(),
+          durationMs: Date.now() - startedAt,
+          detail,
+        }),
+      },
+    })
+    return { ok: true, logId: log.id, checked, created, updated, unchanged, deactivated, errors, detail }
+  } catch (e) {
+    addError(e)
+    await db.holooSyncLog
+      .update({
+        where: { id: log.id },
+        data: {
+          status: 'error',
+          finishedAt: new Date(),
+          checked: sum(detail, 'checked'),
+          created: sum(detail, 'created'),
+          updated: sum(detail, 'updated'),
+          unchanged: sum(detail, 'unchanged'),
+          deactivated: sum(detail, 'deactivated'),
+          errors: JSON.stringify(errors.length ? errors : [holooSafeError(e)]),
+          checkpoint: JSON.stringify({ failedAt: new Date().toISOString(), detail }),
+        },
+      })
+      .catch(() => {})
+    return { ok: false, logId: log.id, errors, detail }
+  } finally {
+    guard.__medpadHolooRunning = false
+  }
+}
+
+function z() {
+  return { checked: 0, created: 0, updated: 0, unchanged: 0, deactivated: 0, skipped: 0 }
+}
+function sum(detail: Record<string, ReturnType<typeof z>>, k: 'checked' | 'created' | 'updated' | 'unchanged' | 'deactivated'): number {
+  return Object.values(detail).reduce((a, v) => a + v[k], 0)
+}
+
+// ── the actual work ───────────────────────────────────────────────────
+
+async function doSync(
+  cfg: HolooConfig,
+  kind: 'initial' | 'incremental' | 'manual',
+  detail: Record<string, ReturnType<typeof z>>,
+  addError: (e: unknown) => void,
+): Promise<void> {
+  const client = new HolooClient(cfg)
+
+  // 1) CUSTOMERS (طرف‌حساب) — full pull, idempotent upsert by ErpCode.
+  //    Sets of erpCodes whose MedPad Customer must be (re)examined for
+  //    linking feed steps 3-4.
+  const customersRaw = await client.get('Customer')
+  const unlinkedMedpad = await db.customer.findMany({
+    where: { erpCode: null },
+    select: { id: true, name: true },
+  })
+  const byNormName = new Map<string, string[]>()
+  for (const c of unlinkedMedpad) {
+    const n = normalizeName(c.name)
+    const arr = byNormName.get(n) ?? []
+    arr.push(c.id)
+    byNormName.set(n, arr)
+  }
+  const customerErpToMedpadId = new Map<string, string>()
+  for (const rec of customersRaw.items) {
+    try {
+      const erpCode = fStr(rec, K_ERP)
+      if (!erpCode) {
+        detail.customers.skipped++
+        continue
+      }
+      detail.customers.checked++
+      const hash = holooContentHash(rec)
+      const existing = await db.erpCustomer.findUnique({ where: { erpCode } })
+      const now = new Date()
+      // explicit inactivity only (no-delete policy)
+      const reportedActive = (() => {
+        const act = fBool(rec, K_ACTIVE, true)
+        const black = fBool(rec, K_BLACKLIST, false)
+        return act && !black
+      })()
+      const mandeh = fNum(rec, K_MANDEH) ?? 0
+      const credit = fNum(rec, K_CREDIT) ?? 0
+      const data = {
+        erpCode,
+        code: fStr(rec, K_CODE),
+        name: fStr(rec, K_NAME) ?? erpCode,
+        mandeh,
+        credit,
+        nationalId: fStr(rec, K_NATIONAL),
+        economicId: fStr(rec, K_ECONOMIC),
+        tel: fStr(rec, K_TEL),
+        mobile: fStr(rec, K_MOBILE),
+        city: fStr(rec, K_CITY),
+        ostan: fStr(rec, K_OSTAN),
+        mantagheh: fStr(rec, K_MANTAGHEH),
+        zipCode: fStr(rec, K_ZIP),
+        address: fStr(rec, K_ADDRESS),
+        job: fStr(rec, K_JOB),
+        email: fStr(rec, K_EMAIL),
+        active: reportedActive,
+        contentHash: hash,
+        lastSyncedAt: now,
+      }
+      if (!existing) {
+        await db.erpCustomer.create({ data })
+        detail.customers.created++
+      } else if (existing.contentHash !== hash) {
+        await db.erpCustomer.update({ where: { erpCode }, data })
+        detail.customers.updated++
+        if (existing.active && !reportedActive) detail.customers.deactivated++
+      } else {
+        // touch lastSyncedAt only (cheap, keeps the app-sync trigger honest)
+        await db.erpCustomer.update({ where: { erpCode }, data: { lastSyncedAt: now } })
+        detail.customers.unchanged++
+      }
+
+      // ── MedPad bridge: link by erpCode, else by UNIQUE normalized name,
+      //    else create an UNASSIGNED MedPad customer (no auto-assignment).
+      let medpadId = customerErpToMedpadId.get(erpCode) ?? null
+      if (!medpadId) {
+        const linked = await db.customer.findFirst({ where: { erpCode }, select: { id: true } })
+        if (linked) {
+          medpadId = linked.id
+        } else if (existing === null || existing.contentHash !== hash || kind !== 'incremental') {
+          // name-match only for NEW records / non-incremental runs (stable,
+          // cheap; avoids re-matching the whole book every 3 minutes)
+          const norm = normalizeName(data.name)
+          const candidates = byNormName.get(norm)
+          if (candidates && candidates.length === 1) {
+            await db.customer.update({ where: { id: candidates[0] }, data: { erpCode } })
+            medpadId = candidates[0]
+          } else {
+            const created = await createMedpadCustomerFromErp(erpCode, data)
+            medpadId = created
+          }
+        }
+      }
+      if (medpadId) customerErpToMedpadId.set(erpCode, medpadId)
+    } catch (e) {
+      addError(e)
+      detail.customers.skipped++
+    }
+  }
+
+  // 2) PRODUCTS (کالا) — full pull, idempotent upsert by ErpCode.
+  try {
+    const productsRaw = await client.get('Product')
+    for (const rec of productsRaw.items) {
+      try {
+        const erpCode = fStr(rec, P_ERP)
+        if (!erpCode) {
+          detail.products.skipped++
+          continue
+        }
+        detail.products.checked++
+        const hash = holooContentHash(rec)
+        const existing = await db.erpProduct.findUnique({ where: { erpCode } })
+        const reportedActive = fBool(rec, K_ACTIVE, true) && !fBool(rec, K_BLACKLIST, false)
+        const data = {
+          erpCode,
+          code: fStr(rec, P_CODE),
+          name: fStr(rec, P_NAME) ?? erpCode,
+          few: fStr(rec, P_FEW),
+          buyPrice: fNum(rec, P_BUY),
+          sellPrice: fNum(rec, P_SELL),
+          group: fStr(rec, P_GROUP),
+          active: reportedActive,
+          contentHash: hash,
+          lastSyncedAt: new Date(),
+        }
+        if (!existing) {
+          await db.erpProduct.create({ data })
+          detail.products.created++
+        } else if (existing.contentHash !== hash) {
+          await db.erpProduct.update({ where: { erpCode }, data })
+          detail.products.updated++
+          if (existing.active && !reportedActive) detail.products.deactivated++
+        } else {
+          await db.erpProduct.update({ where: { erpCode }, data: { lastSyncedAt: new Date() } })
+          detail.products.unchanged++
+        }
+      } catch (e) {
+        addError(e)
+        detail.products.skipped++
+      }
+    }
+  } catch (e) {
+    addError(e)
+  }
+
+  // 3) INVOICES (فاکتور) → Purchase(source='holoo') + one total line in
+  //    PurchaseItem + holooJson provenance (the documented Customer-360
+  //    adapter contract). Line items are NOT claimed until a per-item
+  //    endpoint is proven on the real service (see /test probe).
+  const customersWithInvoiceChange = new Set<string>()
+  try {
+    let invoicesRaw
+    try {
+      invoicesRaw = await client.get('Invoice')
+    } catch (e) {
+      if (e instanceof HolooError && e.kind === 'http' && e.status === 404) {
+        invoicesRaw = await client.get('Invoice/Invoice') // documented fallback path
+      } else {
+        throw e
+      }
+    }
+    const fallbackDate = new Date()
+    for (const rec of invoicesRaw.items) {
+      try {
+        const erpCode = fStr(rec, I_ERP)
+        const invoiceNo = fStr(rec, I_CODE)
+        if (!erpCode && !invoiceNo) {
+          detail.invoices.skipped++
+          continue
+        }
+        const externalId = erpCode ?? `holoo-no-${invoiceNo}`
+        const custErp = fStr(rec, I_CUST_ERP)
+        const medpadId = custErp ? customerErpToMedpadId.get(custErp) : null
+        if (!medpadId) {
+          detail.invoices.skipped++
+          addError(`فاکتور ${invoiceNo ?? externalId} مشتری مرتبط در MedPad ندارد — نادیده گرفته شد`)
+          continue
+        }
+        detail.invoices.checked++
+        const holooJson = JSON.stringify(rec)
+        const date = parseHolooDate(fStr(rec, I_DATE) ?? rec['Date'], fallbackDate)
+        const discount = fNum(rec, I_DISCOUNT)
+        const total = fNum(rec, I_TOTAL) ?? 0
+        const existing = await db.purchase.findUnique({ where: { externalId } })
+        if (
+          existing &&
+          existing.source === 'holoo' &&
+          existing.holooJson === holooJson &&
+          existing.invoiceNo === (invoiceNo ?? null) &&
+          existing.discount === discount
+        ) {
+          await db.purchase.update({ where: { id: existing.id }, data: { syncedAt: new Date() } })
+          detail.invoices.unchanged++
+          continue
+        }
+        const upsert = {
+          customerId: medpadId,
+          source: 'holoo' as const,
+          externalId,
+          invoiceNo,
+          date,
+          paymentStatus: null, // unknown until Holoo provides a derivable status — never fabricated
+          discount,
+          notes: null,
+          syncedAt: new Date(),
+          holooJson,
+        }
+        let purchaseId: string
+        if (existing) {
+          await db.purchase.update({ where: { id: existing.id }, data: upsert })
+          purchaseId = existing.id
+          detail.invoices.updated++
+        } else {
+          const created = await db.purchase.create({ data: upsert })
+          purchaseId = created.id
+          detail.invoices.created++
+        }
+        // one TOTAL line (per the documented adapter contract)
+        const items = await db.purchaseItem.findMany({ where: { purchaseId } })
+        const totalItem = {
+          purchaseId,
+          productId: null,
+          productName: 'جمع کل فاکتور هلو',
+          productCode: null,
+          brand: null,
+          qty: 1,
+          unitPrice: total,
+          total,
+          discount: null,
+        }
+        if (items.length === 1) {
+          await db.purchaseItem.update({ where: { id: items[0].id }, data: totalItem })
+        } else if (items.length === 0) {
+          await db.purchaseItem.create({ data: totalItem })
+        } else {
+          // legacy manual items on a holoo-source row should not exist;
+          // replace with the single total line (source='holoo' rows are
+          // fully owned by the adapter)
+          await db.purchaseItem.deleteMany({ where: { purchaseId } })
+          await db.purchaseItem.create({ data: totalItem })
+        }
+        if (custErp) customersWithInvoiceChange.add(custErp)
+      } catch (e) {
+        addError(e)
+        detail.invoices.skipped++
+      }
+    }
+  } catch (e) {
+    addError(e)
+  }
+
+  // 4) PAYMENTS (Report/GetCustPay — PER-CUSTOMER requests) + balance
+  //    refresh. Initial/manual: every customer (polite pacing, capped).
+  //    Incremental: only customers whose invoices changed in THIS run.
+  try {
+    let targets: string[]
+    if (kind === 'incremental') {
+      targets = [...customersWithInvoiceChange]
+    } else {
+      const all = await db.erpCustomer.findMany({
+        select: { erpCode: true },
+        orderBy: { createdAt: 'asc' },
+        take: PAYMENT_MAX_CUSTOMERS,
+      })
+      targets = all.map((a) => a.erpCode)
+    }
+    for (const erpCode of targets) {
+      try {
+        const pay = await client.get('Report/GetCustPay', { customerErpCode: erpCode })
+        const fallbackDate = new Date()
+        let latestMandeh: number | null = null
+        for (const rec of pay.items) {
+          const code =
+            fStr(rec, PAY_CODE) ??
+            `pay-${holooContentHash({ c: erpCode, r: rec }).slice(0, 16)}`
+          detail.payments.checked++
+          const hash = holooContentHash(rec)
+          const price = fNum(rec, PAY_PRICE) ?? 0
+          const date = parseHolooDate(fStr(rec, PAY_DATE) ?? rec['Date'], fallbackDate)
+          const mandeh = fNum(rec, PAY_MANDEH)
+          if (mandeh !== null) latestMandeh = mandeh
+          const data = {
+            customerErpCode: erpCode,
+            code,
+            name: fStr(rec, PAY_NAME),
+            price,
+            date,
+            mandeh,
+            contentHash: hash,
+            lastSyncedAt: new Date(),
+          }
+          const existing = await db.erpPayment.findUnique({
+            where: { customerErpCode_code: { customerErpCode: erpCode, code } },
+          })
+          if (!existing) {
+            await db.erpPayment.create({ data })
+            detail.payments.created++
+          } else if (existing.contentHash !== hash) {
+            await db.erpPayment.update({ where: { id: existing.id }, data })
+            detail.payments.updated++
+          } else {
+            await db.erpPayment.update({ where: { id: existing.id }, data: { lastSyncedAt: new Date() } })
+            detail.payments.unchanged++
+          }
+        }
+        // refresh the customer's balance from the report (authoritative)
+        if (latestMandeh !== null) {
+          await db.erpCustomer.update({
+            where: { erpCode },
+            data: { mandeh: latestMandeh, lastSyncedAt: new Date() },
+          })
+        }
+      } catch (e) {
+        addError(e)
+        detail.payments.skipped++
+      }
+      await new Promise((r) => setTimeout(r, PAYMENT_DELAY_MS))
+    }
+  } catch (e) {
+    addError(e)
+  }
+}
+
+/** City lookup for Holoo-imported customers: the (province, city) pair
+ *  is the dataset's unique key, but Holoo's province may be absent — fall
+ *  back to a UNIQUE city-name match (several names repeat across provinces
+ *  by design; an ambiguous name matches NOTHING, the fields stay null). */
+function matchIranCity(
+  city: string | null,
+  ostan: string | null,
+): { province: string; city: string; lat: number; lng: number } | null {
+  if (!city) return null
+  if (ostan) {
+    const pair = IRAN_CITIES.find(
+      (c) => normalizeFa(c.province) === normalizeFa(ostan) && normalizeFa(c.city) === normalizeFa(city),
+    )
+    if (pair) return pair
+  }
+  const byName = IRAN_CITIES.filter((c) => normalizeFa(c.city) === normalizeFa(city))
+  return byName.length === 1 ? byName[0] : null
+}
+
+/** Create an UNASSIGNED MedPad customer bridged to a Holoo record.
+ *  Only bridging/identity fields are pre-filled; city is set ONLY when it
+ *  matches the offline Iran dataset (same validation as every other
+ *  customer write); coordinates default to the matched city center or
+ *  0/0 (the schema requires values — 0/0 means «unknown», rendered as
+ *  such everywhere). Operational fields stay untouched for the admin. */
+async function createMedpadCustomerFromErp(
+  erpCode: string,
+  data: { name: string; mobile: string | null; tel: string | null; city: string | null; ostan: string | null },
+): Promise<string> {
+  const hit = matchIranCity(data.city, data.ostan)
+  const created = await db.customer.create({
+    data: {
+      name: data.name,
+      type: 'other', // honest default — the admin re-classifies (doctor/pharmacy/clinic)
+      phone: data.mobile ?? data.tel,
+      province: hit?.province ?? null,
+      city: hit?.city ?? null,
+      lat: hit?.lat ?? 0,
+      lng: hit?.lng ?? 0,
+      erpCode,
+    },
+    select: { id: true },
+  })
+  return created.id
+}
+
+// ── the scheduler (no new infrastructure — a timer in this process) ──
+
+export function startHolooScheduler(): void {
+  if (guard.__medpadHolooTimer) return
+  const timer = setInterval(() => {
+    void tick().catch(() => {})
+  }, 30_000)
+  if (typeof timer.unref === 'function') timer.unref()
+  guard.__medpadHolooTimer = timer
+  console.log('[medpad][holoo] scheduler armed (30s tick, config re-read every tick)')
+}
+
+async function tick(): Promise<void> {
+  try {
+    const cfg = await getHolooConfig()
+    if (!cfg.enabled || !isConfigured(cfg)) return
+    if (isSyncRunning()) return
+    const last = await db.holooSyncLog.findFirst({
+      where: { status: { not: 'running' } },
+      orderBy: { startedAt: 'desc' },
+      select: { startedAt: true },
+    })
+    if (last) {
+      const elapsed = Date.now() - last.startedAt.getTime()
+      if (elapsed < cfg.syncIntervalMin * 60_000) return
+    }
+    await runHolooSync('incremental')
+  } catch (e) {
+    console.error('[medpad][holoo] scheduler tick failed:', holooSafeError(e))
+  }
+}
+
+// ── status aggregation (for /api/admin/holoo/status) ─────────────────
+
+export interface HolooSyncStatusView {
+  running: boolean
+  lastRun: {
+    id: string
+    kind: string
+    status: string
+    startedAt: string
+    finishedAt: string | null
+    checked: number
+    created: number
+    updated: number
+    unchanged: number
+    deactivated: number
+    errors: string[]
+  } | null
+  recentLogs: Array<{
+    id: string
+    kind: string
+    status: string
+    startedAt: string
+    finishedAt: string | null
+    checked: number
+    created: number
+    updated: number
+    unchanged: number
+    deactivated: number
+    errors: string[]
+  }>
+  counts: {
+    erpCustomers: number
+    erpProducts: number
+    erpPayments: number
+    holooPurchases: number
+    linkedCustomers: number
+  }
+  nextRunInSec: number | null
+}
+
+export async function holooSyncState(cfg: HolooConfig): Promise<HolooSyncStatusView> {
+  const [lastRow, recent, erpCustomers, erpProducts, erpPayments, holooPurchases, linkedCustomers] = await Promise.all([
+    db.holooSyncLog.findFirst({ orderBy: { startedAt: 'desc' } }),
+    db.holooSyncLog.findMany({ orderBy: { startedAt: 'desc' }, take: 10 }),
+    db.erpCustomer.count(),
+    db.erpProduct.count(),
+    db.erpPayment.count(),
+    db.purchase.count({ where: { source: 'holoo' } }),
+    db.customer.count({ where: { NOT: { erpCode: null } } }),
+  ])
+  let nextRunInSec: number | null = null
+  if (cfg.enabled && isConfigured(cfg) && !isSyncRunning() && lastRow) {
+    const elapsedSec = Math.floor((Date.now() - lastRow.startedAt.getTime()) / 1000)
+    nextRunInSec = Math.max(0, cfg.syncIntervalMin * 60 - elapsedSec)
+  }
+  const view = (r: NonNullable<typeof lastRow>) => ({
+    id: r.id,
+    kind: r.kind,
+    status: r.status,
+    startedAt: r.startedAt.toISOString(),
+    finishedAt: r.finishedAt ? r.finishedAt.toISOString() : null,
+    checked: r.checked,
+    created: r.created,
+    updated: r.updated,
+    unchanged: r.unchanged,
+    deactivated: r.deactivated,
+    errors: safeParseErrors(r.errors),
+  })
+  return {
+    running: isSyncRunning(),
+    lastRun: lastRow ? view(lastRow) : null,
+    recentLogs: recent.map(view),
+    counts: { erpCustomers, erpProducts, erpPayments, holooPurchases, linkedCustomers },
+    nextRunInSec,
+  }
+}
+
+function safeParseErrors(s: string | null): string[] {
+  if (!s) return []
+  try {
+    const v = JSON.parse(s)
+    return Array.isArray(v) ? v.map((x) => String(x).slice(0, 200)).slice(0, 20) : []
+  } catch {
+    return []
+  }
+}
+
+// ── read-side blocks shared by the panel + app profile routes ─────────
+
+export interface HolooErpAccount {
+  erpCode: string
+  code: string | null
+  name: string
+  mandeh: number
+  credit: number
+  active: boolean
+  city: string | null
+  ostan: string | null
+  syncedAt: string
+}
+
+export interface HolooErpPaymentView {
+  code: string | null
+  name: string | null
+  price: number
+  date: string
+  mandeh: number | null
+}
+
+/** The Holoo accounting blocks for a MedPad customer's 360 profile:
+ *  erpAccount (the ErpCustomer mirror) + the latest ErpPayment rows.
+ *  Null/empty when the customer is not linked — the UI renders an explicit
+ *  «اتصال هلو برقرار نیست» state, never fabricated numbers. */
+export async function erpBlocksFor(
+  erpCode: string | null,
+): Promise<{ erpAccount: HolooErpAccount | null; erpPayments: HolooErpPaymentView[] }> {
+  if (!erpCode) return { erpAccount: null, erpPayments: [] }
+  const account = await db.erpCustomer.findUnique({ where: { erpCode } })
+  if (!account) return { erpAccount: null, erpPayments: [] }
+  const payments = await db.erpPayment.findMany({
+    where: { customerErpCode: erpCode },
+    orderBy: { date: 'desc' },
+    take: 50,
+  })
+  return {
+    erpAccount: {
+      erpCode: account.erpCode,
+      code: account.code,
+      name: account.name,
+      mandeh: account.mandeh,
+      credit: account.credit,
+      active: account.active,
+      city: account.city,
+      ostan: account.ostan,
+      syncedAt: account.lastSyncedAt.toISOString(),
+    },
+    erpPayments: payments.map((p) => ({
+      code: p.code,
+      name: p.name,
+      price: p.price,
+      date: p.date.toISOString(),
+      mandeh: p.mandeh,
+    })),
+  }
+}
