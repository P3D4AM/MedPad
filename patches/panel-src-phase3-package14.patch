diff -ruN a/src/lib/tracking.ts b/src/lib/tracking.ts
--- a/src/lib/tracking.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/tracking.ts	2026-10-29 17:49:17.420227426 +0000
@@ -0,0 +1,82 @@
+import { db } from '@/lib/db'
+import { getAdminSettings, type AdminSettings } from '@/lib/settings'
+
+/**
+ * phase 3 — tracking domain helpers (server side).
+ *
+ * The tracking POLICY lives in the numeric settings machinery
+ * (SETTING_DEFS in lib/settings.ts: trackEnabled / trackMoveIntervalSec /
+ * trackStillIntervalSec / trackMotionThresholdM / trackMaxAgeSec /
+ * trackRetentionDays) — admin-editable, range-validated both on write and
+ * on read, with a safe fallback so a corrupt stored value never widens
+ * policy. This module exposes:
+ *
+ *   getTrackingConfig()  — the config object the APP consumes (a fresh
+ *                          read per call: the app re-fetches periodically
+ *                          and after reconnects, so a panel change reaches
+ *                          running devices without a restart).
+ *   isFresh(recordedAt)  — freshness test for the panel (a location is
+ *                          "live" only within trackMaxAgeSec; older ones
+ *                          are rendered as stale, never as current).
+ *   pruneOldPings()      — retention: delete RECEIVED pings older than
+ *                          trackRetentionDays. Runs at boot and at most
+ *                          once every 6h (time-gated through a Config row)
+ *                          piggy-backed on uploads. Only rows already
+ *                          accepted by the server are ever pruned — the
+ *                          app keeps UNSENT pings locally until confirmed,
+ *                          so this is a documented retention policy, not
+ *                          silent data loss.
+ */
+
+export interface TrackingConfig {
+  enabled: boolean
+  moveIntervalSec: number
+  stillIntervalSec: number
+  motionThresholdM: number
+  maxAgeSec: number
+  /** upload batch size the app may send in ONE request */
+  batchSize: number
+}
+
+/** Batch-size constant — validated against the same limit in the upload
+ *  route; kept here so the config payload and the validator share it. */
+export const TRACK_BATCH_MAX = 200
+
+export async function getTrackingConfig(): Promise<TrackingConfig> {
+  const s: AdminSettings = await getAdminSettings()
+  return {
+    enabled: s.trackEnabled === 1,
+    moveIntervalSec: s.trackMoveIntervalSec,
+    stillIntervalSec: s.trackStillIntervalSec,
+    motionThresholdM: s.trackMotionThresholdM,
+    maxAgeSec: s.trackMaxAgeSec,
+    batchSize: TRACK_BATCH_MAX,
+  }
+}
+
+export function isFresh(recordedAt: Date, maxAgeSec: number): boolean {
+  return Date.now() - recordedAt.getTime() <= maxAgeSec * 1000
+}
+
+const PRUNE_GATE_KEY = 'trackLastPruneAt'
+const PRUNE_GATE_MS = 6 * 3600 * 1000
+
+/** Retention prune — time-gated. `force` skips the gate (used at boot).
+ *  Returns the number of deleted rows (0 when the gate closed). */
+export async function pruneOldPings(force = false): Promise<number> {
+  const gate = await db.config.findUnique({ where: { key: PRUNE_GATE_KEY } })
+  const last = gate ? Number(gate.value) : 0
+  const now = Date.now()
+  if (!force && Number.isFinite(last) && now - last < PRUNE_GATE_MS) return 0
+  const s: AdminSettings = await getAdminSettings()
+  const cutoff = new Date(now - s.trackRetentionDays * 24 * 3600 * 1000)
+  // NOTE: retention is judged by receivedAt (server clock) — device clocks
+  // are untrusted and must never be able to protect a row from pruning.
+  const deleted = await db.locationPing.deleteMany({ where: { receivedAt: { lt: cutoff } } })
+  await db.config.upsert({
+    where: { key: PRUNE_GATE_KEY },
+    update: { value: String(now) },
+    create: { key: PRUNE_GATE_KEY, value: String(now) },
+  })
+  return deleted.count
+}
