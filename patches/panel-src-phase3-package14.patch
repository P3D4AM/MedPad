+} from '@/components/ui/select'
+import { BatteryCharging, MapPin, Navigation, RefreshCw, Route, ShieldCheck, Signal } from 'lucide-react'
+import { useToast } from '@/hooks/use-toast'
+import { faDateTime } from '@/lib/realtime'
+// Leaflet must stay client-only (window at import time) — RouteMapClient
+// is the dynamic ssr:false wrapper, same pattern as MapViewClient
+import RouteMap from './RouteMapClient'
+
+/**
+ * phase 3 — «وضعیت زندهٔ» tracking tab.
+ *
+ * Three panels:
+ *  1. LIVE STATUS (per marketer): last valid coordinates + record time,
+ *     fresh/stale badge (a location older than trackMaxAgeSec is NEVER
+ *     shown as live), connection/receipt status, the app's self-reported
+ *     permission/service/battery snapshot, ping counts. Polled every 30s.
+ *  2. ROUTE HISTORY dialog: tracked route (polyline) + check-in markers
+ *     (distinct layer) + last-known marker (distinct) + legend — the three
+ *     coordinate kinds stay visually separated by design.
+ *  3. TRACKING POLICY form: the six admin settings (enabled, move/still
+ *     intervals, motion threshold, stale age, retention) — saved through
+ *     the SAME /api/admin/settings route (range-validated server side and
+ *     written to the audit log there).
+ *
+ * Honest-display rules baked into this file:
+ *  - intervals are TARGETS: the header says so; the badge column shows
+ *    actual receipt times, never promised rates.
+ *  - tracking disabled → connection column says «خاموش (سیاست)» instead
+ *    of pretending the device is offline.
+ */
+
+interface Ping {
+  lat: number
+  lng: number
+  accuracy: number | null
+  recordedAt: string
+  receivedAt?: string
+}
+
+interface TrackStatusRow {
+  employeeId: string
+  locationPermission: string
+  backgroundLocation: string
+  serviceRunning: boolean
+  batteryUnrestricted: boolean
+  appVersion: string | null
+  lastReportAt: string
+}
+
+interface LiveRow {
+  employee: { id: string; username: string; name: string; phone: string | null; active: boolean }
+  lastPing: Ping | null
+  fresh: boolean
+  connection: 'disabled' | 'no-report' | 'sending' | 'stale-report'
+  status: TrackStatusRow | null
+  last24h: number
+  total: number
+}
+
+interface Policy {
+  enabled: boolean
+  maxAgeSec: number
+  moveIntervalSec: number
+  stillIntervalSec: number
+  motionThresholdM: number
+  retentionDays: number
+}
+
+const PERM_LABEL: Record<string, string> = {
+  fine: 'دقیق',
+  coarse: 'تقریبی',
+  denied: 'ردشده',
+  unknown: 'نامشخص',
+}
+const BG_LABEL: Record<string, string> = {
+  granted: 'داده‌شده',
+  denied: 'ردشده',
+  unavailable: 'ناموجود',
+  unknown: 'نامشخص',
+}
+
+
+export default function TrackingTab({ refreshKey }: { refreshKey: number }) {
+  const { toast } = useToast()
+  const [rows, setRows] = useState<LiveRow[] | null>(null)
+  const [policy, setPolicy] = useState<Policy | null>(null)
+  const [serverTime, setServerTime] = useState<string>('')
+  // policy form state
+  const [form, setForm] = useState({
+    trackEnabled: '1',
+    trackMoveIntervalSec: '45',
+    trackStillIntervalSec: '240',
+    trackMotionThresholdM: '40',
+    trackMaxAgeSec: '900',
+    trackRetentionDays: '30',
+  })
+  const [saving, setSaving] = useState(false)
+  const [policyOpen, setPolicyOpen] = useState(false)
+  // route dialog state
+  const [routeFor, setRouteFor] = useState<LiveRow | null>(null)
+  const [routeHours, setRouteHours] = useState('24')
+  const [routeData, setRouteData] = useState<{
+    points: { lat: number; lng: number; recordedAt: string }[]
+    capped: boolean
+    checkins: { id: string; kind: string; lat: number | null; lng: number | null; createdAt: string; customer?: { name: string } | null }[]
+    lastPing: Ping | null
+  } | null>(null)
+  const [routeLoading, setRouteLoading] = useState(false)
+  const timer = useRef<ReturnType<typeof setInterval> | null>(null)
+
+  const loadStatus = useCallback(() => {
+    fetch('/api/panel/tracking', { cache: 'no-store' })
+      .then((r) => r.json())
+      .then((d) => {
+        if (d.ok) {
+          setRows(d.rows)
+          setPolicy(d.policy)
+          setServerTime(d.serverTime)
+        }
+      })
+      .catch(() => {})
+  }, [])
+
+  // initial + on refresh + 30s poll («وضعیت اتصال و دریافت داده»)
+  useEffect(() => {
+    loadStatus()
+    if (timer.current) clearInterval(timer.current)
+    timer.current = setInterval(loadStatus, 30_000)
+    return () => {
+      if (timer.current) clearInterval(timer.current)
+    }
+  }, [refreshKey, loadStatus])
+
+  // open policy form with the CURRENT values (from /api/admin/settings —
+  // the same source the save writes to)
