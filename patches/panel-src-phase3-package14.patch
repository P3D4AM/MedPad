+          setForm({
+            trackEnabled: String(d.settings.trackEnabled ?? 1),
+            trackMoveIntervalSec: String(d.settings.trackMoveIntervalSec ?? 45),
+            trackStillIntervalSec: String(d.settings.trackStillIntervalSec ?? 240),
+            trackMotionThresholdM: String(d.settings.trackMotionThresholdM ?? 40),
+            trackMaxAgeSec: String(d.settings.trackMaxAgeSec ?? 900),
+            trackRetentionDays: String(d.settings.trackRetentionDays ?? 30),
+          })
+        }
+      })
+      .catch(() => {})
+  }, [policyOpen])
+
+  const savePolicy = async () => {
+    setSaving(true)
