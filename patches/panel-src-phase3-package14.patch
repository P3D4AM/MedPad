@@ -0,0 +1,85 @@
+'use client'
+
+import { MapContainer, TileLayer, Polyline, CircleMarker, Popup } from 'react-leaflet'
+import 'leaflet/dist/leaflet.css'
+
+/**
+ * phase 3 — route history map (client-only; mounted through
+ * RouteMapClient because Leaflet touches `window` at import time).
+ *
+ * THREE visually distinct layers, by design («موقعیت آخر، تاریخچهٔ مسیر و
+ * مختصات ثبت ویزیت باید از یکدیگر متمایز باشند»):
+ *   - teal polyline      = the tracked route
+ *   - amber/purple dots  = check-in / check-out coordinates
+ *   - red dot            = last known position (never labelled "live"
+ *                          when stale — the dialog header carries the age)
+ */
+export default function RouteMap({ points, checkins, lastPing }: {
+  points: { lat: number; lng: number; recordedAt: string }[]
+  checkins: { id: string; kind: string; lat: number | null; lng: number | null; createdAt: string; customer?: { name: string } | null }[]
+  lastPing: { lat: number; lng: number; recordedAt: string } | null
+}) {
+  const all = points.map((p) => [p.lat, p.lng] as [number, number])
+  if (lastPing) all.push([lastPing.lat, lastPing.lng])
+  const center: [number, number] = lastPing
+    ? [lastPing.lat, lastPing.lng]
+    : all.length > 0
+      ? all[Math.floor(all.length / 2)]
+      : [35.6892, 51.389]
+  return (
+    <div className="space-y-2">
+      {/* plain wrapper carries the testid — react-leaflet 5's MapContainer
+          only forwards className/id/style to the DOM div, so a data-testid
+          prop on it would silently vanish (verified against the shipped
+          react-leaflet 5.0.0 source) */}
+      <div data-testid="route-map">
+        <MapContainer center={center} zoom={13} className="h-[360px] w-full rounded-lg border">
+          <TileLayer
+            attribution='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
+            url="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
+          />
+          {points.length > 1 && (
+            <Polyline positions={points.map((p) => [p.lat, p.lng] as [number, number])} pathOptions={{ color: '#0d9488', weight: 3, opacity: 0.8 }} />
+          )}
+          {checkins.map((c) => (
+            <CircleMarker
+              key={c.id}
+              center={[c.lat as number, c.lng as number]}
+              radius={7}
+              pathOptions={{ color: '#ffffff', weight: 2, fillColor: c.kind === 'checkout' ? '#9333ea' : '#b45309', fillOpacity: 1 }}
+            >
+              <Popup>
+                <div className="text-xs" dir="rtl">
+                  <b>{c.kind === 'checkout' ? 'پایان ویزیت' : 'شروع ویزیت'}</b>
+                  {c.customer?.name ? ` — ${c.customer.name}` : ''}
+                  <br />
+                  {new Date(c.createdAt).toLocaleString('fa-IR')}
+                </div>
+              </Popup>
+            </CircleMarker>
+          ))}
+          {lastPing && (
+            <CircleMarker
+              center={[lastPing.lat, lastPing.lng]}
+              radius={9}
+              pathOptions={{ color: '#ffffff', weight: 2, fillColor: '#dc2626', fillOpacity: 1 }}
+            >
+              <Popup>
+                <div className="text-xs" dir="rtl">
+                  <b>آخرین موقعیت ثبت‌شده</b>
+                  <br />
+                  {new Date(lastPing.recordedAt).toLocaleString('fa-IR')}
+                </div>
+              </Popup>
+            </CircleMarker>
+          )}
+        </MapContainer>
+      </div>
+      <div className="flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
+        <span className="flex items-center gap-1"><span className="inline-block h-1 w-4 rounded bg-teal-600" /> مسیر ثبت‌شده</span>
+        <span className="flex items-center gap-1"><span className="inline-block h-2.5 w-2.5 rounded-full border-2 border-white bg-amber-700" /> چک‌این / پایان</span>
+        <span className="flex items-center gap-1"><span className="inline-block h-3 w-3 rounded-full border-2 border-white bg-red-600" /> آخرین موقعیت</span>
+      </div>
+    </div>
+  )
+}
