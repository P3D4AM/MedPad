+      setPolicyOpen(false)
+      loadStatus()
+    } catch (e) {
+      toast({ title: 'ذخیره نشد', description: e instanceof Error ? e.message : 'خطای نامشخص', variant: 'destructive' })
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  // route history fetch (re-runs when the dialog target or range changes)
+  useEffect(() => {
+    if (!routeFor) return
+    setRouteLoading(true)
+    setRouteData(null)
+    const from = new Date(Date.now() - Number(routeHours) * 3600 * 1000).toISOString()
+    fetch(`/api/panel/tracking/history?employeeId=${encodeURIComponent(routeFor.employee.id)}&from=${encodeURIComponent(from)}`, { cache: 'no-store' })
+      .then((r) => r.json())
+      .then((d) => {
+        if (d.ok) setRouteData({ points: d.points, capped: d.capped, checkins: d.checkins, lastPing: d.lastPing })
+      })
+      .catch(() => {})
+      .finally(() => setRouteLoading(false))
+  }, [routeFor, routeHours])
+
+  const connBadge = (c: LiveRow['connection']) => {
+    switch (c) {
+      case 'sending': return <Badge className="bg-emerald-100 text-emerald-800 hover:bg-emerald-100">در حال ارسال</Badge>
+      case 'stale-report': return <Badge className="bg-amber-100 text-amber-800 hover:bg-amber-100">گزارش نمی‌رسد</Badge>
+      case 'disabled': return <Badge className="bg-muted text-muted-foreground hover:bg-muted">خاموش (سیاست)</Badge>
+      default: return <Badge className="bg-muted text-muted-foreground hover:bg-muted">بی‌گزارش</Badge>
+    }
+  }
+
+  return (
+    <div className="space-y-4" data-testid="tracking-tab">
+      {/* policy summary strip */}
+      <Card>
+        <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
+          <CardTitle className="flex items-center gap-2 text-base">
+            <Navigation className="h-4 w-4 text-teal-600" />
+            وضعیت زندهٔ ردیابی
+          </CardTitle>
+          <div className="flex items-center gap-2">
+            <Button variant="outline" size="sm" onClick={() => setPolicyOpen(true)} data-testid="tracking-policy-btn">
+              <ShieldCheck className="ml-1 h-4 w-4" />
+              تنظیمات ردیابی
+            </Button>
+            <Button variant="outline" size="sm" onClick={loadStatus}>
+              <RefreshCw className="ml-1 h-4 w-4" />
+              به‌روزرسانی
+            </Button>
+          </div>
+        </CardHeader>
+        <CardContent className="space-y-2">
+          <div className="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
+            {policy ? (
+              <>
+                <span>وضعیت: {policy.enabled ? <b className="text-emerald-700">فعال</b> : <b className="text-muted-foreground">خاموش</b>}</span>
+                <span>هدف هنگام حرکت: هر {policy.moveIntervalSec.toLocaleString('fa-IR')} ثانیه</span>
+                <span>هدف هنگام سکون: هر {policy.stillIntervalSec.toLocaleString('fa-IR')} ثانیه</span>
+                <span>آستانهٔ تشخیص حرکت: {policy.motionThresholdM.toLocaleString('fa-IR')} متر</span>
+                <span>حداکثر عمر موقعیت: {Math.round(policy.maxAgeSec / 60).toLocaleString('fa-IR')} دقیقه</span>
+                <span>نگهداری داده: {policy.retentionDays.toLocaleString('fa-IR')} روز</span>
+              </>
+            ) : (
+              <span>…</span>
+            )}
+          </div>
+          <p className="text-xs text-muted-foreground">
+            این زمان‌بندی‌ها هدف اپ هستند، نه تضمین نرخ واقعی GPS — محدودیت‌های اندروید (ذخیرهٔ باتری، Doze) ممکن است فاصله‌ها را بیشتر کند؛ ستون زمان‌ها زمان واقعی دریافت است.
+            {serverTime ? ` آخرین به‌روزرسانی: ${faDateTime(serverTime)}` : ''}
+          </p>
+        </CardContent>
+      </Card>
+
+      {/* live table */}
+      <Card>
+        <CardContent className="p-0">
+          <div className="overflow-x-auto">
+            <table className="w-full text-sm" data-testid="tracking-table">
+              <thead>
+                <tr className="border-b bg-muted/50 text-right text-xs text-muted-foreground">
+                  <th className="p-3 font-medium">بازاریاب</th>
+                  <th className="p-3 font-medium">آخرین مختصات معتبر</th>
+                  <th className="p-3 font-medium">زمان ثبت</th>
+                  <th className="p-3 font-medium">وضعیت موقعیت</th>
+                  <th className="p-3 font-medium">وضعیت اتصال</th>
+                  <th className="p-3 font-medium">مجوز / سرویس / باتری</th>
+                  <th className="p-3 font-medium">۲۴ ساعت</th>
+                  <th className="p-3 font-medium">مسیر</th>
+                </tr>
+              </thead>
+              <tbody>
+                {(rows ?? []).map((r) => (
+                  <tr key={r.employee.id} className="border-b last:border-0">
+                    <td className="p-3">
+                      <div className="font-medium">
+                        {r.employee.name}
+                        {!r.employee.active && <Badge className="mr-1 bg-muted text-muted-foreground hover:bg-muted">غیرفعال</Badge>}
+                      </div>
+                      <div className="text-xs text-muted-foreground">@{r.employee.username}</div>
+                    </td>
+                    <td className="p-3 font-mono text-xs" data-testid={`coords-${r.employee.id}`}>
+                      {r.lastPing
+                        ? `${r.lastPing.lat.toFixed(5)}، ${r.lastPing.lng.toFixed(5)}`
+                        : <span className="text-muted-foreground">—</span>}
+                    </td>
+                    <td className="p-3 text-xs">
+                      {r.lastPing ? faDateTime(r.lastPing.recordedAt) : <span className="text-muted-foreground">—</span>}
+                    </td>
+                    <td className="p-3">
+                      {r.lastPing ? (
+                        r.fresh
+                          ? <Badge className="bg-emerald-100 text-emerald-800 hover:bg-emerald-100">تازه</Badge>
+                          : <Badge className="bg-slate-200 text-slate-700 hover:bg-slate-200">قدیمی</Badge>
+                      ) : (
+                        <Badge className="bg-muted text-muted-foreground hover:bg-muted">بدون موقعیت</Badge>
+                      )}
+                    </td>
+                    <td className="p-3">{connBadge(r.connection)}</td>
+                    <td className="p-3">
+                      <div className="flex flex-wrap gap-1">
+                        <Badge variant="outline" title="مجوز موقعیت اپ">
+                          <MapPin className="ml-1 h-3 w-3" />
+                          {r.status ? PERM_LABEL[r.status.locationPermission] ?? r.status.locationPermission : '—'}
+                        </Badge>
+                        <Badge variant="outline" title="مجوز موقعیت پس‌زمینه">
+                          {r.status ? BG_LABEL[r.status.backgroundLocation] ?? r.status.backgroundLocation : '—'}
+                        </Badge>
+                        <Badge variant="outline" title="سرویس ردیابی روی گوشی">
+                          <Signal className="ml-1 h-3 w-3" />
+                          {r.status ? (r.status.serviceRunning ? 'روشن' : 'خاموش') : '—'}
+                        </Badge>
+                        <Badge variant="outline" title="محدودیت باتری">
+                          <BatteryCharging className="ml-1 h-3 w-3" />
+                          {r.status ? (r.status.batteryUnrestricted ? 'آزاد' : 'محدود') : '—'}
+                        </Badge>
+                      </div>
+                      {r.status?.appVersion && (
+                        <div className="mt-1 text-xs text-muted-foreground">اپ {r.status.appVersion}</div>
+                      )}
+                    </td>
+                    <td className="p-3 text-center">{r.last24h.toLocaleString('fa-IR')}</td>
+                    <td className="p-3">
+                      <Button
+                        variant="outline"
+                        size="sm"
+                        onClick={() => {
+                          setRouteHours('24')
+                          setRouteFor(r)
+                        }}
+                        data-testid={`route-btn-${r.employee.id}`}
+                      >
+                        <Route className="ml-1 h-4 w-4" />
+                        نمایش مسیر
+                      </Button>
+                    </td>
+                  </tr>
+                ))}
+                {rows !== null && rows.length === 0 && (
+                  <tr>
+                    <td colSpan={8} className="p-6 text-center text-muted-foreground">
+                      کارمندی ثبت نشده است.
+                    </td>
+                  </tr>
+                )}
+                {rows === null && (
+                  <tr>
+                    <td colSpan={8} className="p-6 text-center text-muted-foreground">
+                      در حال دریافت…
+                    </td>
+                  </tr>
+                )}
+              </tbody>
+            </table>
+          </div>
+        </CardContent>
+      </Card>
+
+      {/* route history dialog */}
+      <Dialog open={!!routeFor} onOpenChange={(o) => !o && setRouteFor(null)}>
+        <DialogContent className="max-w-3xl" data-testid="route-dialog">
+          <DialogHeader>
+            <DialogTitle>مسیر {routeFor?.employee.name}</DialogTitle>
+            <DialogDescription>
+              مسیر ثبت‌شده، مختصات چک‌این‌ها و آخرین موقعیت — سه لایهٔ مجزا.
+            </DialogDescription>
+          </DialogHeader>
+          <div className="flex items-center gap-2">
+            <Select value={routeHours} onValueChange={setRouteHours}>
+              <SelectTrigger className="w-32">
+                <SelectValue />
+              </SelectTrigger>
+              <SelectContent>
+                <SelectItem value="24">۲۴ ساعت اخیر</SelectItem>
+                <SelectItem value="48">۴۸ ساعت اخیر</SelectItem>
+                <SelectItem value="168">۷ روز اخیر</SelectItem>
+              </SelectContent>
+            </Select>
+            {routeLoading && <span className="text-xs text-muted-foreground">در حال دریافت…</span>}
+            {routeData?.capped && (
+              <span className="text-xs text-amber-700">نمایش به ۲٬۰۰۰ نقطهٔ آخر محدود شد</span>
+            )}
+            {routeData && routeData.points.length === 0 && !routeLoading && (
+              <span className="text-xs text-muted-foreground">در این بازه موقعیتی ثبت نشده است.</span>
+            )}
+          </div>
+          {routeData && <RouteMap points={routeData.points} checkins={routeData.checkins} lastPing={routeData.lastPing} />}
+        </DialogContent>
+      </Dialog>
+
+      {/* policy form dialog */}
+      <Dialog open={policyOpen} onOpenChange={setPolicyOpen}>
+        <DialogContent className="max-w-lg" data-testid="tracking-policy-dialog">
+          <DialogHeader>
+            <DialogTitle>تنظیمات ردیابی</DialogTitle>
+            <DialogDescription>
+              سیاست ردیابی همهٔ اپ‌ها. اپ آخرین تنظیم معتبر را آفلاین نگه می‌دارد و با اتصال دوباره آن را دریافت می‌کند.
+            </DialogDescription>
+          </DialogHeader>
+          <div className="space-y-3">
+            <div className="flex items-center justify-between rounded-lg border p-3">
