+      const res = await fetch('/api/admin/settings', {
+        method: 'PUT',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({
+          trackEnabled: Number(form.trackEnabled),
+          trackMoveIntervalSec: Number(form.trackMoveIntervalSec),
+          trackStillIntervalSec: Number(form.trackStillIntervalSec),
+          trackMotionThresholdM: Number(form.trackMotionThresholdM),
+          trackMaxAgeSec: Number(form.trackMaxAgeSec),
+          trackRetentionDays: Number(form.trackRetentionDays),
+        }),
+      })
+      const d = await res.json()
+      if (!res.ok || !d.ok) throw new Error(d.error || 'خطا در ذخیرهٔ تنظیمات')
