+// ── phase 3: background location tracking ─────────────────────────
+//
+// LocationPing — ONE row per location fix the app successfully uploaded.
+//  * localId (device-generated UUID) is the idempotency key: the app keeps
+//    unsent pings locally until the server CONFIRMS them (no silent loss on
+//    internet cut), so a replay after a crash mid-upload cannot create a
+//    second row — the conflicting insert is counted as a duplicate instead.
+//  * recordedAt = device clock when the fix was measured (authoritative for
+//    freshness/route order); receivedAt = server clock at insert (device
+//    clocks are untrusted for storage decisions like pruning).
+//  * retention: rows older than trackRetentionDays are pruned (time-gated,
+//    at boot and at most once per 6h on upload) — a documented policy, never
+//    a silent loss (only RECEIVED rows are ever pruned).
+//  * employeeId FK ON DELETE CASCADE: deactivating is the MedPad lifecycle;
+//    truly deleting an employee cleans their track history with them.
+model LocationPing {
+  id         String   @id @default(cuid())
+  employeeId String
+  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
+  localId    String   @unique
+  lat        Float
+  lng        Float
+  accuracy   Float?
+  recordedAt DateTime
+  receivedAt DateTime  @default(now())
+
+  @@index([employeeId, recordedAt])
+}
+
+// TrackStatus — the app's LAST self-reported health snapshot, upserted with
+// every successful upload batch (phase 3 §1: "وضعیت مجوز و ردیابی در حدی که
+// اپ بتواند گزارش دهد"). One row per employee (1:1). Plain strings as the
+// app reports them; the panel renders them as-is with Persian labels.
+model TrackStatus {
+  employeeId          String   @id
+  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
+  locationPermission  String   @default("unknown") // fine | coarse | denied | unknown
+  backgroundLocation  String   @default("unknown") // granted | denied | unavailable | unknown
+  serviceRunning      Boolean  @default(false)
+  batteryUnrestricted Boolean  @default(false)
+  appVersion          String?
+  lastReportAt        DateTime @default(now())
+}
diff -ruN a/src/app/api/app/locations/route.ts b/src/app/api/app/locations/route.ts
--- a/src/app/api/app/locations/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/app/locations/route.ts	2026-10-29 17:51:58.728170753 +0000
@@ -0,0 +1,144 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { appEmployee } from '@/lib/auth'
+import { getTrackingConfig, pruneOldPings, TRACK_BATCH_MAX } from '@/lib/tracking'
+
+/**
+ * phase 3 — bulk location upload from the app.
+ *
+ * POST /api/app/locations (employee token)
+ *   { locations: [{ localId, lat, lng, accuracy?, recordedAt }],
+ *     status?: { locationPermission, backgroundLocation, serviceRunning,
+ *                batteryUnrestricted, appVersion } }
+ *
+ * Protocol requirements honoured here:
+ *  - «قطع اینترنت نباید باعث از بین رفتن بی‌صدای داده‌های موقعیت شود»: the
+ *    app keeps every unsent ping locally and re-sends it in later batches;
+ *    only rows the server CONFIRMED are ever deleted on the device.
+ *  - «ارسال مجدد ... از نظر تکراری‌شدن امن باشد»: localId is the
+ *    idempotency key (UNIQUE index). A replay after a crash mid-upload hits
+ *    P2002 and is counted as `duplicated` — never a second row.
+ *  - the response carries the current tracking config so a running device
+ *    picks up panel changes without a separate round trip; piggy-backed
+ *    retention prune (time-gated, at most once per 6h) keeps old RECEIVED
+ *    pings from accumulating (never un-received data).
+ *
+ * Validation is strict per item (bad items are rejected with a Persian
+ * message naming the index), coordinates range-checked, structurally
+ * impossible accuracy (<=0 / NaN / >100000) discarded like G-6, recordedAt
+ * may not lie in the future (device clock skew) beyond a 5-minute
+ * tolerance. Permanently invalid items return 400 — the app marks them
+ * failed and does NOT re-send them (same policy as the check-in queue).
+ */
+
+interface PingIn {
+  localId?: unknown
+  lat?: unknown
+  lng?: unknown
+  accuracy?: unknown
+  recordedAt?: unknown
+}
+
+const LOCALID_RE = /^[A-Za-z0-9_-]{8,64}$/
+
+function parsePing(i: number, raw: PingIn): { localId: string; lat: number; lng: number; accuracy: number | null; recordedAt: Date } | string {
+  const localId = typeof raw.localId === 'string' ? raw.localId.trim() : ''
+  if (!LOCALID_RE.test(localId)) return `موقعیت ${i + 1}: شناسهٔ محلی نامعتبر است`
+  const lat = Number(raw.lat)
+  const lng = Number(raw.lng)
+  if (!Number.isFinite(lat) || lat < -90 || lat > 90) return `موقعیت ${i + 1}: عرض جغرافیایی نامعتبر است`
+  if (!Number.isFinite(lng) || lng < -180 || lng > 180) return `موقعیت ${i + 1}: طول جغرافیایی نامعتبر است`
+  let accuracy: number | null = null
+  if (raw.accuracy !== undefined && raw.accuracy !== null) {
+    const a = Number(raw.accuracy)
+    if (Number.isFinite(a) && a > 0 && a <= 100000) accuracy = a
+    // structurally impossible accuracy is discarded, not fatal (G-6 rule)
+  }
+  const t = new Date(typeof raw.recordedAt === 'string' ? raw.recordedAt : '')
+  if (isNaN(t.getTime())) return `موقعیت ${i + 1}: زمان ثبت نامعتبر است`
+  if (t.getTime() - Date.now() > 5 * 60 * 1000) return `موقعیت ${i + 1}: زمان ثبت در آینده است`
+  return { localId, lat, lng, accuracy, recordedAt: t }
+}
+
+const PERM_VALUES = new Set(['fine', 'coarse', 'denied', 'unknown'])
+const BG_VALUES = new Set(['granted', 'denied', 'unavailable', 'unknown'])
+
+export async function POST(req: Request) {
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  const body = await req.json().catch(() => null) as { locations?: unknown; status?: unknown } | null
+  if (!body || typeof body !== 'object' || !Array.isArray(body.locations)) {
+    return NextResponse.json({ ok: false, error: 'بدنهٔ درخواست نامعتبر است' }, { status: 400 })
+  }
+  if (body.locations.length === 0) {
+    return NextResponse.json({ ok: false, error: 'فهرست موقعیت‌ها خالی است' }, { status: 400 })
+  }
+  if (body.locations.length > TRACK_BATCH_MAX) {
+    return NextResponse.json(
+      { ok: false, error: `هر بستهٔ ارسال حداکثر ${TRACK_BATCH_MAX} موقعیت می‌تواند داشته باشد` },
+      { status: 400 },
+    )
+  }
+
+  let accepted = 0
+  let duplicated = 0
+  // validate the WHOLE batch first — a 400 then means NOTHING was stored
+  // and the app can safely drop permanently-invalid pings (same policy as
+  // the check-in queue: transient failures keep data, permanent rejections
+  // do not retry forever).
+  const parsedAll: { localId: string; lat: number; lng: number; accuracy: number | null; recordedAt: Date }[] = []
+  for (let i = 0; i < body.locations.length; i++) {
+    const parsed = parsePing(i, body.locations[i] as PingIn)
+    if (typeof parsed === 'string') {
+      return NextResponse.json({ ok: false, error: parsed }, { status: 400 })
+    }
+    parsedAll.push(parsed)
+  }
+  for (const p of parsedAll) {
+    try {
+      await db.locationPing.create({
+        data: {
+          employeeId: emp.id,
+          localId: p.localId,
+          lat: p.lat,
+          lng: p.lng,
+          accuracy: p.accuracy,
+          recordedAt: p.recordedAt,
+        },
+      })
+      accepted++
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e)
+      if (/Unique constraint/i.test(msg)) {
+        duplicated++ // idempotent replay — the row already exists
+        continue
+      }
+      throw e
+    }
+  }
+
+  // device health snapshot (phase 3 §3: "وضعیت مجوز و ردیابی در حدی که اپ
+  // بتواند گزارش دهد") — upserted with every confirmed batch
+  if (body.status && typeof body.status === 'object') {
+    const st = body.status as Record<string, unknown>
+    const locationPermission = typeof st.locationPermission === 'string' && PERM_VALUES.has(st.locationPermission)
+      ? st.locationPermission : 'unknown'
+    const backgroundLocation = typeof st.backgroundLocation === 'string' && BG_VALUES.has(st.backgroundLocation)
+      ? st.backgroundLocation : 'unknown'
+    const serviceRunning = st.serviceRunning === true
+    const batteryUnrestricted = st.batteryUnrestricted === true
+    const appVersion = typeof st.appVersion === 'string' ? st.appVersion.slice(0, 40) : null
+    await db.trackStatus.upsert({
+      where: { employeeId: emp.id },
+      update: { locationPermission, backgroundLocation, serviceRunning, batteryUnrestricted, appVersion, lastReportAt: new Date() },
+      create: { employeeId: emp.id, locationPermission, backgroundLocation, serviceRunning, batteryUnrestricted, appVersion, lastReportAt: new Date() },
+    })
+  }
+
+  // piggy-backed retention prune (time-gated; failure must not fail the
+  // upload — the pings are already safely stored)
+  pruneOldPings().catch(() => {})
+
+  const config = await getTrackingConfig()
+  return NextResponse.json({ ok: true, accepted, duplicated, config })
+}
diff -ruN a/src/app/api/app/tracking-config/route.ts b/src/app/api/app/tracking-config/route.ts
--- a/src/app/api/app/tracking-config/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/app/tracking-config/route.ts	2026-10-29 17:49:44.474384157 +0000
@@ -0,0 +1,23 @@
+import { NextResponse } from 'next/server'
+import { appEmployee } from '@/lib/auth'
+import { getTrackingConfig } from '@/lib/tracking'
+
+/**
+ * phase 3 — tracking policy for the app.
+ *
+ * GET /api/app/tracking-config (employee token)
+ *
+ * The app calls this at service start and periodically (and every upload
+ * response carries the same object), so a panel change reaches running
+ * devices without an app restart or reinstall. Values are TARGETS, never a
+ * guarantee of the real GPS rate (Android doze / battery savers may stretch
+ * intervals — the panel renders actual receipt times, not promises).
+ * The app caches the last VALID response locally and keeps using it while
+ * offline («آخرین تنظیمات معتبر را برای حالت آفلاین حفظ کند»).
+ */
+export async function GET(req: Request) {
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  const config = await getTrackingConfig()
+  return NextResponse.json({ ok: true, config, serverTime: new Date().toISOString() })
+}
diff -ruN a/src/app/api/panel/tracking/history/route.ts b/src/app/api/panel/tracking/history/route.ts
--- a/src/app/api/panel/tracking/history/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/panel/tracking/history/route.ts	2026-10-29 17:50:19.764588202 +0000
@@ -0,0 +1,101 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+
+/**
+ * phase 3 — route history for ONE marketer (admin session).
+ *
+ * GET /api/panel/tracking/history?employeeId=...&from=ISO&to=ISO
+ *
+ * Returns, for the requested window (default: last 24h, max span 31 days):
+ *  - `points`: the tracked route, OLDEST FIRST (ready for a polyline),
+ *    capped at the newest 2000 pings (honest `capped: true` flag — the
+ *    panel tells the admin the view was truncated instead of hiding it)
+ *  - `checkins`: check-in/check-out coordinates in the SAME window —
+ *    displayed as a distinct layer so «موقعیت آخر، تاریخچه مسیر و مختصات
+ *    ثبت ویزیت باید از یکدیگر متمایز باشند»
+ *  - `lastPing`: the newest ping overall (the "live" marker), also when it
+ *    falls OUTSIDE the window — the panel must always be able to show the
+ *    last known position clearly separated from the route on screen
+ *
+ * Unknown employee → 404 with a Persian error; bad dates → 400.
+ */
+const MAX_POINTS = 2000
+const MAX_SPAN_MS = 31 * 24 * 3600 * 1000
+
+export async function GET(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const url = new URL(req.url)
+  const employeeId = url.searchParams.get('employeeId') || ''
+  if (!employeeId) {
+    return NextResponse.json({ ok: false, error: 'شناسهٔ کارمند لازم است' }, { status: 400 })
+  }
+  const emp = await db.employee.findUnique({
+    where: { id: employeeId },
+    select: { id: true, name: true, username: true, active: true },
+  })
+  if (!emp) {
+    return NextResponse.json({ ok: false, error: 'کارمند یافت نشد' }, { status: 404 })
+  }
+  const now = Date.now()
+  let fromMs = now - 24 * 3600 * 1000
+  let toMs = now
+  const from = url.searchParams.get('from')
+  const to = url.searchParams.get('to')
+  if (from) {
+    const t = new Date(from).getTime()
+    if (isNaN(t)) return NextResponse.json({ ok: false, error: 'زمان شروع نامعتبر است' }, { status: 400 })
+    fromMs = t
+  }
+  if (to) {
+    const t = new Date(to).getTime()
+    if (isNaN(t)) return NextResponse.json({ ok: false, error: 'زمان پایان نامعتبر است' }, { status: 400 })
+    toMs = t
+  }
+  if (toMs <= fromMs) {
+    return NextResponse.json({ ok: false, error: 'بازهٔ زمانی نامعتبر است' }, { status: 400 })
+  }
+  if (toMs - fromMs > MAX_SPAN_MS) {
+    return NextResponse.json({ ok: false, error: 'بازهٔ حداکثر ۳۱ روز است' }, { status: 400 })
+  }
+  const from_ = new Date(fromMs)
+  const to_ = new Date(toMs)
+
+  // newest MAX_POINTS in the window, then reversed -> oldest first for the polyline
+  const windowPoints = await db.locationPing.findMany({
+    where: { employeeId, recordedAt: { gte: from_, lte: to_ } },
+    orderBy: { recordedAt: 'desc' },
+    take: MAX_POINTS,
+    select: { lat: true, lng: true, accuracy: true, recordedAt: true },
+  })
+  const points = windowPoints.reverse()
+  const capped = windowPoints.length === MAX_POINTS
+
+  const checkins = await db.checkin.findMany({
+    where: { employeeId, createdAt: { gte: from_, lte: to_ }, lat: { not: null }, lng: { not: null } },
+    orderBy: { createdAt: 'asc' },
+    take: 500,
+    select: {
+      id: true, kind: true, lat: true, lng: true, createdAt: true, note: true,
+      customer: { select: { name: true } },
+    },
+  })
+
+  const lastPing = await db.locationPing.findFirst({
+    where: { employeeId },
+    orderBy: { recordedAt: 'desc' },
+    select: { lat: true, lng: true, accuracy: true, recordedAt: true, receivedAt: true },
+  })
+
+  return NextResponse.json({
+    ok: true,
+    employee: emp,
+    window: { from: from_.toISOString(), to: to_.toISOString() },
+    points,
+    capped,
+    checkins,
+    lastPing,
+  })
+}
