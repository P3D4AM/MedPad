--- a/src/app/api/panel/tracking/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/panel/tracking/route.ts	2026-10-29 17:50:09.024526122 +0000
@@ -0,0 +1,80 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { getAdminSettings } from '@/lib/settings'
+
+/**
+ * phase 3 — live tracking status for the panel (admin session).
+ *
+ * GET /api/panel/tracking
+ *
+ * Per marketer (every employee, active ones first):
+ *  - last VALID coordinates + their record time («آخرین مختصات معتبر»)
+ *  - fresh/stale verdict — a location older than trackMaxAgeSec is NEVER
+ *    presented as live («مختصات قدیمی نباید به‌عنوان موقعیت زنده معرفی شود»)
+ *  - connection/receipt status — derived from the app's last health report
+ *    (TrackStatus.lastReportAt), NOT from the location age, and taking the
+ *    enabled/disabled policy into account (a disabled tracker has no duty
+ *    to report; the panel says so instead of showing a false "قطع")
+ *  - the app's self-reported permission/service/battery snapshot
+ *  - ping counts (last 24h + total retained)
+ *
+ * Deliberately a plain JSON snapshot the UI polls (30s) — no websocket
+ * push for pings (the realtime layer stays reserved for check-in events).
+ */
+export async function GET() {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const settings = await getAdminSettings()
+  const maxAgeMs = settings.trackMaxAgeSec * 1000
+  const enabled = settings.trackEnabled === 1
+  const dayAgo = new Date(Date.now() - 24 * 3600 * 1000)
+
+  const employees = await db.employee.findMany({
+    select: { id: true, username: true, name: true, phone: true, active: true },
+    orderBy: [{ active: 'desc' }, { name: 'asc' }],
+  })
+
+  const rows = await Promise.all(employees.map(async (e) => {
+    const [lastPing, status, last24h, total] = await Promise.all([
+      db.locationPing.findFirst({
+        where: { employeeId: e.id },
+        orderBy: { recordedAt: 'desc' },
+        select: { lat: true, lng: true, accuracy: true, recordedAt: true, receivedAt: true },
+      }),
+      db.trackStatus.findUnique({ where: { employeeId: e.id } }),
+      db.locationPing.count({ where: { employeeId: e.id, recordedAt: { gte: dayAgo } } }),
+      db.locationPing.count({ where: { employeeId: e.id } }),
+    ])
+    const now = Date.now()
+    const fresh = lastPing ? (now - lastPing.recordedAt.getTime() <= maxAgeMs) : false
+    let connection: 'disabled' | 'no-report' | 'sending' | 'stale-report' = 'no-report'
+    if (!enabled) connection = 'disabled'
+    else if (status && now - status.lastReportAt.getTime() <= maxAgeMs) connection = 'sending'
+    else if (status) connection = 'stale-report'
+    return {
+      employee: e,
+      lastPing,
+      fresh,
+      connection,
+      status,
+      last24h,
+      total,
+    }
+  }))
+
+  return NextResponse.json({
+    ok: true,
+    rows,
+    policy: {
+      enabled,
+      maxAgeSec: settings.trackMaxAgeSec,
+      moveIntervalSec: settings.trackMoveIntervalSec,
+      stillIntervalSec: settings.trackStillIntervalSec,
+      motionThresholdM: settings.trackMotionThresholdM,
+      retentionDays: settings.trackRetentionDays,
+    },
+    serverTime: new Date().toISOString(),
+  })
+}
