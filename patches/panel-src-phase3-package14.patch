+                <Input id="retention" inputMode="numeric" value={form.trackRetentionDays}
+                  onChange={(e) => setForm((f) => ({ ...f, trackRetentionDays: e.target.value }))} data-testid="track-retention-input" />
+                <p className="text-xs text-muted-foreground">۷ تا ۳۶۵ روز — قدیمی‌تر از این، موقعیت‌های دریافت‌شده پاک می‌شوند (دادهٔ ارسال‌نشدهٔ اپ هرگز پاک نمی‌شود)</p>
+              </div>
+            </div>
+          </div>
+          <div className="flex justify-end gap-2">
+            <Button variant="outline" onClick={() => setPolicyOpen(false)}>انصراف</Button>
+            <Button onClick={savePolicy} disabled={saving} data-testid="track-save-btn">
+              {saving ? 'در حال ذخیره…' : 'ذخیره'}
+            </Button>
+          </div>
+        </DialogContent>
+      </Dialog>
+    </div>
+  )
+}
