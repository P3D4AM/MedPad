+'use client'
+
+/**
+ * Client-only wrapper — Leaflet touches `window` at import time,
+ * so it must never be evaluated during SSR (same pattern as MapViewClient).
+ */
+import dynamic from 'next/dynamic'
+
+const RouteMap = dynamic(() => import('./RouteMap'), {
+  ssr: false,
+  loading: () => (
+    <div className="flex h-[360px] w-full items-center justify-center rounded-lg border bg-muted/40 text-sm text-muted-foreground">
+      در حال بارگذاری نقشه…
+    </div>
+  ),
+})
+
+export default RouteMap
diff -ruN a/src/components/panel/TrackingTab.tsx b/src/components/panel/TrackingTab.tsx
--- a/src/components/panel/TrackingTab.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/panel/TrackingTab.tsx	2026-10-29 18:16:58.794051889 +0000
@@ -0,0 +1,470 @@
+'use client'
+
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
+import { Input } from '@/components/ui/input'
+import { Label } from '@/components/ui/label'
+import { Switch } from '@/components/ui/switch'
+import {
+  Dialog,
+  DialogContent,
