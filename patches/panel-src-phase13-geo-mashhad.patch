@@ -0,0 +1,615 @@
+'use client'
+
+/**
+ * Phase 5 (geo / فاز پنج) — the panel's «جغرافیا و محلات» tab.
+ *
+ * Four surfaces, one tab (all admin session, all real data):
+ *  1. خلاصه — zone/neighborhood/street counts + «ثبت موقت» (geo
+ *     incomplete) and unassigned counters.
+ *  2. در انتظار تکمیل — the «نیازمند تکمیل اطلاعات جغرافیایی» worklist:
+ *     every customer with geoStatus='incomplete'. The completion dialog
+ *     preselects the nearest neighborhood from the customer's own map
+ *     coordinates («تشخیص خودکار از مختصات» — labeled an APPROXIMATION),
+ *     the admin confirms neighborhood + street, and the save lifts the
+ *     assignment gate (PUT /api/customers/[id]).
+ *  3. گزارش‌های جغرافیایی — customers per zone/neighborhood, unassigned,
+ *     per-rep workload & density, and 30-day coverage comparison.
+ *  4. مرور دادهٔ جغرافیایی — the zone→neighborhood tree with per-node
+ *     customer counts and provenance (source + date on every node), plus
+ *     add-neighborhood/add-street with server-side dedup (normalized
+ *     names — «کوي سلمان» can never become a second node).
+ */
+
+import { useCallback, useEffect, useMemo, useState } from 'react'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
+import {
+  Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle,
+} from '@/components/ui/dialog'
+import { Input } from '@/components/ui/input'
+import { Label } from '@/components/ui/label'
+import {
+  Select, SelectContent, SelectItem, SelectTrigger, SelectValue,
+} from '@/components/ui/select'
+import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'
+import { useToast } from '@/hooks/use-toast'
+import {
+  AlertTriangle, CheckCircle2, ChevronDown, ChevronLeft, Loader2, MapPin, Plus,
+} from 'lucide-react'
+
+interface GeoHood {
+  id: string; name: string; zoneId: string | null
+  lat: number | null; lng: number | null
+  source: string | null; sourceDate: string | null
+  customerCount: number; incompleteCount: number; unassignedCount: number
+}
+interface GeoZone {
+  id: string; name: string; code: string | null
+  source: string | null; sourceDate: string | null
+  neighborhoods: GeoHood[]
+}
+interface GeoTree {
+  ok: true
+  city: { id: string; name: string; code: string | null; source: string | null; sourceDate: string | null } | null
+  zones: GeoZone[]
+  cityLess: GeoHood[]
+  streets: { id: string; name: string; code: string | null; source: string | null; sourceDate: string | null }[]
+  totals: { total: number; incomplete: number; unassigned: number; neighborhoods: number; streets: number } | null
+}
+interface ReportZone {
+  id: string | null; name: string; code: string | null
+  total: number; assigned: number; unassigned: number; incomplete: number
+  coverage: number | null
+  neighborhoods: { id: string; name: string; total: number; assigned: number; unassigned: number; incomplete: number; coverage: number | null }[]
+}
+interface GeoReport {
+  ok: true
+  city: { id: string; name: string } | null
+  zones: ReportZone[]
+  unassigned: { id: string; name: string; neighborhood: string | null; zone: string | null; geoStatus: string | null }[]
+  workload: { id: string; name: string; username: string; customers: number; zones: number; neighborhoods: number; density: number | null }[]
+  streets: { id: string; name: string; count: number }[]
+}
+interface CustomerRowLite {
+  id: string; name: string; type: string; city: string | null
+  lat: number; lng: number
+  geoNeighborhoodId: string | null; geoStreetId: string | null
+  geoStatus: string | null; geoSource: string | null
+}
+
+export default function GeoTab({ refreshKey, onNavigate }: { refreshKey: number; onNavigate?: (k: string) => void }) {
+  const { toast } = useToast()
+  const [tree, setTree] = useState<GeoTree | null>(null)
+  const [report, setReport] = useState<GeoReport | null>(null)
+  const [customers, setCustomers] = useState<CustomerRowLite[]>([])
+  const [busy, setBusy] = useState(false)
+  const [expandedZone, setExpandedZone] = useState<string | null>(null)
+  // completion dialog state
+  const [completing, setCompleting] = useState<CustomerRowLite | null>(null)
+  const [pickZone, setPickZone] = useState('')
+  const [pickHood, setPickHood] = useState('')
+  const [pickStreet, setPickStreet] = useState('')
+  const [autoHint, setAutoHint] = useState<string | null>(null)
+  const [saving, setSaving] = useState(false)
+  // add-node dialog state
+  const [adding, setAdding] = useState<{ type: 'neighborhood' | 'street'; parentId: string; parentName: string } | null>(null)
+  const [newName, setNewName] = useState('')
+  const [view, setView] = useState<'reports' | 'browse'>('reports')
+
+  const load = useCallback(async () => {
+    setBusy(true)
+    try {
+      const [t, r, c] = await Promise.all([
