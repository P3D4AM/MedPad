@@ -0,0 +1,103 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { normalizeFa } from '@/lib/iran-cities'
+
+/**
+ * Phase 5 (geo) — GET /api/panel/geo/tree?city=مشهد
+ *
+ * The structured geography tree for a city (admin session), with the
+ * customer count per node — the backbone of the «جغرافیا» tab:
+ *  zones[] → each { id, name, code, neighborhoods[] }
+ *  cityLess[] → neighborhoods parented directly to the city (OSM-only
+ *               entries with no official zone mapping — «بدون محدوده»)
+ *  streets[] → city-level main streets (flat; a street spans neighborhoods)
+ *
+ * Everything is ACTIVE nodes only; provenance (source/sourceDate) is
+ * included per node so the admin can always see WHERE the data came from.
+ */
+export async function GET(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const url = new URL(req.url)
+  const cityName = (url.searchParams.get('city') ?? 'مشهد').trim()
+  const cityKey = normalizeFa(cityName)
+
+  const cities = await db.geoArea.findMany({ where: { type: 'city', active: true } })
+  const city = cities.find((c) => normalizeFa(c.name) === cityKey)
+  if (!city) {
+    // honest empty tree — a city without structured geo data
+    return NextResponse.json({ ok: true, city: null, zones: [], cityLess: [], streets: [], totals: null })
+  }
+
+  const [zones, hoods, streets, customers] = await Promise.all([
+    db.geoArea.findMany({
+      where: { type: 'zone', parentId: city.id, active: true },
+      orderBy: [{ sortOrder: 'asc' }, { name: 'asc' }],
+    }),
+    db.geoArea.findMany({
+      where: { type: 'neighborhood', active: true },
+      orderBy: [{ sortOrder: 'asc' }, { name: 'asc' }],
+    }),
+    db.geoArea.findMany({
+      where: { type: 'street', active: true },
+      orderBy: [{ name: 'asc' }],
+      select: { id: true, name: true, code: true, source: true, sourceDate: true },
+    }),
+    db.customer.findMany({
+      where: { active: true },
+      select: {
+        id: true,
+        geoNeighborhoodId: true,
+        geoStatus: true,
+        assignments: { select: { id: true } }, // unassign deletes the row — every row IS an active assignment
+      },
+    }),
+  ])
+
+  const zoneIds = new Set(zones.map((z) => z.id))
+  const inCity = hoods.filter((h) => h.parentId === city.id || zoneIds.has(h.parentId ?? ''))
+
+  // customer aggregation per neighborhood
+  const agg = new Map<string, { total: number; incomplete: number; unassigned: number }>()
+  const totals = { total: 0, incomplete: 0, unassigned: 0 }
+  for (const c of customers) {
+    const bucket = c.geoNeighborhoodId
+      ? (agg.get(c.geoNeighborhoodId) ?? { total: 0, incomplete: 0, unassigned: 0 })
+      : totals
+    bucket.total++
+    if (c.geoStatus === 'incomplete') bucket.incomplete++
+    if (c.assignments.length === 0) bucket.unassigned++
+    if (c.geoNeighborhoodId) agg.set(c.geoNeighborhoodId, bucket)
+  }
+
+  const hoodJson = (h: (typeof hoods)[number]) => ({
+    id: h.id,
+    name: h.name,
+    zoneId: h.parentId && zoneIds.has(h.parentId) ? h.parentId : null,
+    lat: h.lat,
+    lng: h.lng,
+    source: h.source,
+    sourceDate: h.sourceDate,
+    customerCount: agg.get(h.id)?.total ?? 0,
+    incompleteCount: agg.get(h.id)?.incomplete ?? 0,
+    unassignedCount: agg.get(h.id)?.unassigned ?? 0,
+  })
+
+  return NextResponse.json({
+    ok: true,
+    city: { id: city.id, name: city.name, code: city.code, source: city.source, sourceDate: city.sourceDate },
+    zones: zones.map((z) => ({
+      id: z.id,
+      name: z.name,
+      code: z.code,
+      source: z.source,
+      sourceDate: z.sourceDate,
+      neighborhoods: inCity.filter((h) => h.parentId === z.id).map(hoodJson),
+    })),
+    cityLess: inCity.filter((h) => h.parentId === city.id).map(hoodJson),
+    streets,
+    totals: { ...totals, neighborhoods: inCity.length, streets: streets.length },
+  })
+}
