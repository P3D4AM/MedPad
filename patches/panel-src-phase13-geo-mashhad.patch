+++ b/src/app/api/panel/geo/nodes/[id]/route.ts	2026-11-18 07:18:20.811238207 +0000
@@ -0,0 +1,123 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { normalizeFa } from '@/lib/iran-cities'
+import { writeAudit } from '@/lib/audit'
+
+/**
+ * Phase 5 (geo) — PATCH /api/panel/geo/nodes/[id] (admin session)
+ *                      DELETE /api/panel/geo/nodes/[id]
+ *
+ * PATCH  — rename (the normalized key is recomputed; a collision with a
+ *          sibling → 409 with the existing name), set/clear coordinates,
+ *          activate/deactivate. Renaming NEVER breaks the customer links:
+ *          customers reference the node id, not the name.
+ *
+ * DELETE — guarded, both ways:
+ *            a node with children        → 409 with the child count
+ *            a node referenced by customers → 409 with the customer count
+ *          (provinces and cities are seed-owned → 400.) The packaged
+ *          dataset's NO-DELETE policy is unaffected: re-seeding never
+ *          removes, and this endpoint only removes admin-confirmable
+ *          leaves. Audit rows record every outcome.
+ */
+export async function PATCH(req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const node = await db.geoArea.findUnique({ where: { id } })
+  if (!node) return NextResponse.json({ ok: false, error: 'گره پیدا نشد' }, { status: 404 })
+
+  let b: Record<string, unknown>
+  try {
+    b = (await req.json()) as Record<string, unknown>
+  } catch {
+    return NextResponse.json({ ok: false, error: 'بدنهٔ درخواست نامعتبر است' }, { status: 400 })
+  }
+
+  const data: Record<string, unknown> = {}
+  const changes: string[] = []
+
+  if (typeof b.name === 'string') {
+    const name = b.name.trim()
+    if (!name || name.length > 120) {
+      return NextResponse.json({ ok: false, error: 'نام گره نامعتبر است (۱ تا ۱۲۰ نویسه)' }, { status: 400 })
+    }
+    const normalizedName = normalizeFa(name)
+    if (normalizedName !== node.normalizedName) {
+      const dup = await db.geoArea.findFirst({
+        where: { parentId: node.parentId, type: node.type, normalizedName, id: { not: node.id } },
+      })
+      if (dup) {
+        return NextResponse.json(
+          { ok: false, error: `گره‌ای با همین نام در همین والد از قبل وجود دارد: «${dup.name}»` },
+          { status: 409 },
+        )
+      }
+    }
+    data.name = name
+    data.normalizedName = normalizedName
+    changes.push('name')
+  }
+  if ('lat' in b || 'lng' in b) {
+    const lat = b.lat as number | null
+    const lng = b.lng as number | null
+    if (lat === null || lng === null) {
+      data.lat = null
+      data.lng = null
+    } else if (typeof lat === 'number' && typeof lng === 'number' && Math.abs(lat) <= 90 && Math.abs(lng) <= 180) {
+      data.lat = lat
+      data.lng = lng
+    } else {
+      return NextResponse.json({ ok: false, error: 'مختصات نامعتبر است' }, { status: 400 })
+    }
+    changes.push('coords')
+  }
+  if (typeof b.active === 'boolean') {
+    data.active = b.active
+    changes.push(b.active ? 'activate' : 'deactivate')
+  }
+  if (!changes.length) {
+    return NextResponse.json({ ok: false, error: 'تغییری ارسال نشده است' }, { status: 400 })
+  }
+
+  const updated = await db.geoArea.update({ where: { id }, data })
+  await writeAudit({
+    action: 'geo.node.update',
+    targetType: 'GeoArea',
+    targetId: id,
+    detail: `ویرایش گرهٔ جغرافیایی «${updated.name}» (${changes.join('، ')})`,
+  })
+  return NextResponse.json({ ok: true, node: { id: updated.id, name: updated.name, active: updated.active } })
+}
+
+export async function DELETE(_req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const node = await db.geoArea.findUnique({ where: { id } })
+  if (!node) return NextResponse.json({ ok: false, error: 'گره پیدا نشد' }, { status: 404 })
+  if (node.type === 'province' || node.type === 'city') {
+    return NextResponse.json({ ok: false, error: 'استان و شهر متعلق به دادهٔ بستهٔ نصب هستند و حذف نمی‌شوند' }, { status: 400 })
+  }
+  const childCount = await db.geoArea.count({ where: { parentId: id } })
+  if (childCount > 0) {
+    return NextResponse.json({ ok: false, error: `این گره ${childCount} گرهٔ فرزند دارد — ابتدا فرزندها را منتقل یا حذف کنید` }, { status: 409 })
+  }
+  const refCount = await db.customer.count({
+    where: { OR: [{ geoNeighborhoodId: id }, { geoStreetId: id }] },
+  })
+  if (refCount > 0) {
+    return NextResponse.json({ ok: false, error: `${refCount} مشتری به این گره ارجاع دارد — ابتدا ارجاع‌ها را تغییر دهید` }, { status: 409 })
+  }
+  await db.geoArea.delete({ where: { id } })
+  await writeAudit({
+    action: 'geo.node.delete',
+    targetType: 'GeoArea',
+    targetId: id,
+    detail: `حذف گرهٔ جغرافیایی «${node.name}» (${node.type})`,
+  })
+  return NextResponse.json({ ok: true })
+}
