+import { db } from '@/lib/db'
+import { normalizeFa } from './iran-cities'
+import { distanceMeters, isValidLatLng } from './geo'
+
+/**
+ * Phase 5 (geo / فاز پنج) — structured geography helpers.
+ *
+ * The GeoArea tree (province←city←zone←neighborhood←street) is seeded at
+ * boot from the packaged Mashhad dataset (lib/geo-mashhad.ts via
+ * lib/geo-seed.ts) and managed through /api/panel/geo/*. This module holds
+ * the logic SHARED by the customer write paths and the assignment gates:
+ *
+ *  - resolveGeoRefs(): validates optional geoNeighborhoodId / geoStreetId
+ *    bodies against ACTIVE nodes of the right type — the single
+ *    gatekeeper, exactly like resolveCustomerCity for (city, province).
+ *  - nearestNeighborhood(): «تشخیص خودکار از مختصات» — nearest ACTIVE
+ *    neighborhood CENTROID of the same city within GEO_DETECT_RADIUS_M.
+ *    Centroids, not boundaries: an APPROXIMATION, labeled as such in the
+ *    UI («تقریب نقطهٔ نزدیک»), never presented as a boundary decision.
+ *  - assertCustomersGeoComplete(): the «جلوگیری از تخصیص نهایی تا تکمیل»
+ *    gate — customers with geoStatus='incomplete' (and ONLY those; NULL
+ *    = legacy rows that must keep working) block final assignment with a
+ *    specific Persian error.
+ */
+
+export type GeoAreaType = 'province' | 'city' | 'zone' | 'neighborhood' | 'street'
+
+/** Nearest-centroid detection radius (meters). Documented approximation. */
+export const GEO_DETECT_RADIUS_M = 3000
+
+/** Allowed parent types per child type (API-level hierarchy rule). */
+export const GEO_PARENT_RULES: Record<Exclude<GeoAreaType, 'province'>, GeoAreaType[]> = {
+  city: ['province'],
+  zone: ['city'],
+  neighborhood: ['city', 'zone'],
+  street: ['city', 'neighborhood'],
+}
+
+export function isGeoAreaType(v: string): v is GeoAreaType {
+  return v === 'province' || v === 'city' || v === 'zone' || v === 'neighborhood' || v === 'street'
+}
+
+/** Partial-update semantics for the geo fields (mirrors resolveCustomerCity). */
+export type GeoRefsResolution =
+  | { skip: true }
+  | { error: string }
+  | { geoNeighborhoodId: string | null; geoStreetId: string | null; explicit: boolean }
+
+/**
+ * Validate the geo reference fields of a customer write.
+ *
+ *  - neither field sent            → { skip } (caller leaves values alone)
+ *  - any field present             → both are resolved:
+ *      null/''  → explicit clear
+ *      id       → must exist, be ACTIVE, and be of type neighborhood /
+ *                 street respectively (a zone id is NOT accepted as a
+ *                 neighborhood — the admin UI picks leaf nodes only)
+ *  - a street, when set, may belong to any city (no cross-check against
+ *    the neighborhood — streets are city-level in the seed, and the
+ *    reverse geocoder's street suggestions are best-effort labels).
+ */
+export async function resolveGeoRefs(
+  body: Record<string, unknown> | null | undefined,
+): Promise<GeoRefsResolution> {
+  const b = body ?? {}
+  const hasNeighborhood = 'geoNeighborhoodId' in b
+  const hasStreet = 'geoStreetId' in b
+  if (!hasNeighborhood && !hasStreet) return { skip: true }
+
+  const parse = (v: unknown): string | null | 'invalid' => {
+    if (v === null || v === undefined || v === '') return null
+    if (typeof v !== 'string' || !v.trim()) return 'invalid'
+    return v.trim()
+  }
+  const nh = parse(b.geoNeighborhoodId)
+  const st = parse(b.geoStreetId)
+  if (nh === 'invalid') return { error: 'شناسهٔ محله نامعتبر است' }
+  if (st === 'invalid') return { error: 'شناسهٔ خیابان نامعتبر است' }
+
+  if (nh) {
+    const node = await db.geoArea.findUnique({ where: { id: nh } })
+    if (!node || !node.active) return { error: 'محلهٔ انتخابی موجود یا فعال نیست' }
+    if (node.type !== 'neighborhood') return { error: 'گرهٔ انتخاب‌شده محله نیست' }
+  }
+  if (st) {
+    const node = await db.geoArea.findUnique({ where: { id: st } })
+    if (!node || !node.active) return { error: 'خیابان انتخابی موجود یا فعال نیست' }
+    if (node.type !== 'street') return { error: 'گرهٔ انتخاب‌شده خیابان نیست' }
+  }
+  return { geoNeighborhoodId: nh, geoStreetId: st, explicit: true }
+}
+
+export interface NearestHit {
+  id: string
+  name: string
+  zoneId: string | null
+  zoneName: string | null
+  distanceM: number
+}
+
+/**
+ * «تشخیص خودکار از مختصات» — nearest ACTIVE neighborhood centroid of the
+ * SAME city within GEO_DETECT_RADIUS_M. Loads only that city's
+ * neighborhoods-with-coords (a few hundred rows, cached per call).
+ */
+export async function nearestNeighborhood(
+  cityName: string,
+  lat: number,
+  lng: number,
+): Promise<NearestHit | null> {
+  if (!isValidLatLng(lat, lng)) return null
+  // find the city node (active) whose name matches the customer's city
+  const cityKey = normalizeFa(cityName)
+  const cities = await db.geoArea.findMany({ where: { type: 'city', active: true } })
+  const cityNode = cities.find((c) => normalizeFa(c.name) === cityKey)
+  if (!cityNode) return null
+  const nodes = await db.geoArea.findMany({
+    where: { type: 'neighborhood', active: true, lat: { not: null }, lng: { not: null } },
+    select: { id: true, name: true, parentId: true, lat: true, lng: true },
+  })
+  // only neighborhoods of THIS city's subtree: zone children of the city,
+  // or neighborhoods parented directly to the city
+  const zoneIds = new Set(
+    (
+      await db.geoArea.findMany({
+        where: { type: 'zone', parentId: cityNode.id },
+        select: { id: true },
+      })
+    ).map((z) => z.id),
+  )
+  let best: NearestHit | null = null
+  for (const n of nodes) {
+    if (n.parentId !== cityNode.id && !zoneIds.has(n.parentId ?? '')) continue
+    const d = distanceMeters(lat, lng, n.lat as number, n.lng as number)
+    if (d > GEO_DETECT_RADIUS_M) continue
+    if (!best || d < best.distanceM) best = { id: n.id, name: n.name, zoneId: n.parentId && zoneIds.has(n.parentId) ? n.parentId : null, zoneName: null, distanceM: Math.round(d) }
+  }
+  if (best?.zoneId) {
+    const z = await db.geoArea.findUnique({ where: { id: best.zoneId }, select: { name: true } })
+    best.zoneName = z?.name ?? null
+  }
+  return best
+}
+
+/** The assignment gate. Returns the Persian error for the FIRST incomplete customer, else null. */
+export function geoIncompleteError(names: string[]): string | null {
+  if (!names.length) return null
+  const shown = names.slice(0, 3).join('، ')
+  const more = names.length > 3 ? ` و ${names.length - 3} مورد دیگر` : ''
+  return `اطلاعات جغرافیایی این مشتری ناقص ثبت شده است (ثبت موقت در انتظار تکمیل): ${shown}${more} — ابتدا از تب «جغرافیا» بخش «در انتظار تکمیل»، محله و خیابان را تأیید کنید`
+}
+
+/**
+ * Gate: every customer id must NOT be geoStatus='incomplete' (NULL/complete
+ * pass). Legacy rows (NULL) are deliberately exempt — the phase must never
+ * retroactively block existing customers.
+ */
+export async function assertCustomersGeoComplete(customerIds: string[]): Promise<string | null> {
+  if (!customerIds.length) return null
+  const blocked = await db.customer.findMany({
+    where: { id: { in: customerIds }, geoStatus: 'incomplete' },
+    select: { name: true },
+  })
+  return geoIncompleteError(blocked.map((c) => c.name))
+}
+
+/**
+ * Create-time geo resolution (shared by the panel POST and the app create
+ * path — the SAME server-side policy, no UI trust):
+ *
+ *  - explicit refs (panel form pick)        → complete / admin
+ *  - no refs, city HAS structured geo data  → «ثبت موقت نیازمند تکمیل»:
+ *      nearest centroid attached when within GEO_DETECT_RADIUS_M, status
+ *      incomplete / source auto — final assignment stays blocked until an
+ *      admin completes the record
+ *  - no refs, city has NO geo data          → untouched (null) — a city
+ *      outside the dataset keeps 100% legacy behavior (no gating)
+ */
+export async function geoOnCreate(
+  cityName: string | null,
+  lat: number,
+  lng: number,
+  explicit: { geoNeighborhoodId: string | null; geoStreetId: string | null } | null,
+): Promise<{ geoNeighborhoodId?: string | null; geoStreetId?: string | null; geoStatus?: string | null; geoSource?: string | null }> {
+  if (explicit) {
+    return { ...explicit, geoStatus: 'complete', geoSource: 'admin' }
+  }
+  if (!cityName) return {}
+  const cityHasGeo = await cityHasNeighborhoods(cityName)
+  if (!cityHasGeo) return {}
+  const hit = await nearestNeighborhood(cityName, lat, lng)
+  return {
+    geoNeighborhoodId: hit?.id ?? null,
+    geoStreetId: null,
+    geoStatus: 'incomplete',
+    geoSource: 'auto',
+  }
+}
+
+/** Does this city have structured neighborhood data (active)? */
+export async function cityHasNeighborhoods(cityName: string): Promise<boolean> {
+  const cityKey = normalizeFa(cityName)
+  const cities = await db.geoArea.findMany({ where: { type: 'city', active: true }, select: { id: true, name: true } })
+  const city = cities.find((c) => normalizeFa(c.name) === cityKey)
+  if (!city) return false
+  const zones = await db.geoArea.findMany({ where: { type: 'zone', parentId: city.id, active: true }, select: { id: true } })
+  const zoneIds = zones.map((z) => z.id)
+  const direct = await db.geoArea.count({ where: { type: 'neighborhood', parentId: city.id, active: true } })
+  if (direct > 0) return true
+  if (!zoneIds.length) return false
+  const underZones = await db.geoArea.count({ where: { type: 'neighborhood', parentId: { in: zoneIds }, active: true } })
+  return underZones > 0
+}
