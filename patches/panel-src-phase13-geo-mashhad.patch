@@ -0,0 +1,92 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { normalizeFa } from '@/lib/iran-cities'
+import { GEO_PARENT_RULES, isGeoAreaType } from '@/lib/geo-areas'
+import { writeAudit } from '@/lib/audit'
+
+/**
+ * Phase 5 (geo) — POST /api/panel/geo/nodes (admin session)
+ *
+ * Create a geo node (zone | neighborhood | street — provinces and cities
+ * are SEED-ONLY, the packaged dataset owns them). This is the structured
+ * path the roadmap asks for: adding a neighborhood or street through the
+ * API always NORMALIZES the name, so «کوی سلمان» / «کوي سلمان» / «کوی
+ * سلمان» can never become three nodes («جلوگیری از رکورد تکراری با املای
+ * متفاوت»).
+ *
+ * Body: { type, parentId, name, code?, lat?, lng? }
+ *  - type must be zone|neighborhood|street with a parent allowed by
+ *    GEO_PARENT_RULES (zone→city, neighborhood→zone|city, street→city|neighborhood)
+ *  - the (parentId, normalizedName) pair must not already exist → 409 with
+ *    the existing node's name so the admin sees the duplicate
+ *  - code, when given, must be unique → 409
+ */
+export async function POST(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  let b: Record<string, unknown>
+  try {
+    b = (await req.json()) as Record<string, unknown>
+  } catch {
+    return NextResponse.json({ ok: false, error: 'بدنهٔ درخواست نامعتبر است' }, { status: 400 })
+  }
+  const type = typeof b.type === 'string' ? b.type : ''
+  if (!isGeoAreaType(type) || type === 'province' || type === 'city') {
+    return NextResponse.json({ ok: false, error: 'نوع گره فقط محدوده، محله یا خیابان می‌تواند باشد (استان و شهر فقط از طریق دادهٔ بستهٔ نصب)' }, { status: 400 })
+  }
+  const parentId = typeof b.parentId === 'string' ? b.parentId.trim() : ''
+  if (!parentId) return NextResponse.json({ ok: false, error: 'گرهٔ والد مشخص نیست' }, { status: 400 })
+  const name = typeof b.name === 'string' ? b.name.trim() : ''
+  if (!name || name.length > 120) {
+    return NextResponse.json({ ok: false, error: 'نام گره نامعتبر است (۱ تا ۱۲۰ نویسه)' }, { status: 400 })
+  }
+  const parent = await db.geoArea.findUnique({ where: { id: parentId } })
+  if (!parent || !parent.active) {
+    return NextResponse.json({ ok: false, error: 'گرهٔ والد موجود یا فعال نیست' }, { status: 400 })
+  }
+  if (!GEO_PARENT_RULES[type].includes(parent.type as never)) {
+    return NextResponse.json(
+      { ok: false, error: `والد مجاز برای «${type === 'zone' ? 'محدوده' : type === 'neighborhood' ? 'محله' : 'خیابان'}» در این ساختار نیست (والد فعلی: ${parent.type})` },
+      { status: 400 },
+    )
+  }
+
+  const normalizedName = normalizeFa(name)
+  const dup = await db.geoArea.findFirst({ where: { parentId, type, normalizedName } })
+  if (dup) {
+    return NextResponse.json(
+      { ok: false, error: `گره‌ای با همین نام در همین والد از قبل وجود دارد: «${dup.name}» — برای جلوگیری از رکورد تکراری، همان گره را ویرایش کنید` },
+      { status: 409 },
+    )
+  }
+  const code = typeof b.code === 'string' && b.code.trim() ? b.code.trim() : undefined
+  if (code) {
+    const dupCode = await db.geoArea.findUnique({ where: { code } })
+    if (dupCode) return NextResponse.json({ ok: false, error: `کد «${code}» تکراری است` }, { status: 409 })
+  }
+  const lat = typeof b.lat === 'number' ? b.lat : undefined
+  const lng = typeof b.lng === 'number' ? b.lng : undefined
+  const hasCoords = typeof lat === 'number' && typeof lng === 'number' && Math.abs(lat) <= 90 && Math.abs(lng) <= 180
+
+  const row = await db.geoArea.create({
+    data: {
+      type,
+      parentId,
+      name,
+      normalizedName,
+      code,
+      ...(hasCoords ? { lat, lng } : {}),
+      source: 'ایجاد دستی توسط مدیر',
+      sourceDate: new Date().toISOString().slice(0, 10),
+    },
+  })
+  await writeAudit({
+    action: 'geo.node.create',
+    targetType: 'GeoArea',
+    targetId: row.id,
+    detail: `ایجاد گرهٔ جغرافیایی (${type}) «${name}» زیر «${parent.name}»`,
+  })
+  return NextResponse.json({ ok: true, node: { id: row.id, name: row.name, type: row.type, parentId: row.parentId } }, { status: 201 })
+}
diff -ruN '--exclude=node_modules' '--exclude=dev.db' '--exclude=build-time.db' '--exclude=.next' '--exclude=x.db' /tmp/pristine/src/app/api/panel/geo/report/route.ts panel-build/src/src/app/api/panel/geo/report/route.ts
--- a/src/app/api/panel/geo/report/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/panel/geo/report/route.ts	2026-11-18 07:22:58.658124415 +0000
@@ -0,0 +1,167 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { normalizeFa } from '@/lib/iran-cities'
+
+/**
+ * Phase 5 (geo) — GET /api/panel/geo/report?city=مشهد
+ *
+ * گزارش‌های جغرافیایی (admin session) — the roadmap's four reports, one
+ * honest snapshot:
+ *
+ *  1. تعداد مشتری به تفکیک محدوده/محله — per zone AND per neighborhood:
+ *     total customers, assigned, unassigned, incomplete («ثبت موقت»).
+ *  2. تخصیص‌نیافته‌ها — the unassigned customers list grouped by
+ *     neighborhood (with name/id so the UI can link to assignment).
+ *  3. بار کاری و تراکم — per active marketer: customers in this city,
+ *     spread across how many zones (concentration), avg customers per
+ *     zone.
+ *  4. مقایسهٔ پوشش — per zone: coverage% = customers with ≥1 check-in in
+ *     the last 30 days / total customers of the zone.
+ *
+ * All counts are over ACTIVE customers of the requested city only
+ * (Customer.city matched by normalized name). A neighborhood with 0
+ * customers still appears (the tree is the axis, not the customers).
+ */
+export async function GET(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const url = new URL(req.url)
+  const cityName = (url.searchParams.get('city') ?? 'مشهد').trim()
+  const cityKey = normalizeFa(cityName)
+
+  const cities = await db.geoArea.findMany({ where: { type: 'city', active: true } })
+  const city = cities.find((c) => normalizeFa(c.name) === cityKey)
+  if (!city) {
+    return NextResponse.json({ ok: true, city: null, zones: [], unassigned: [], workload: [], streets: [] })
+  }
+
+  const monthAgo = new Date(Date.now() - 30 * 24 * 3600 * 1000)
+  const [zones, hoods, streets, customers, employees] = await Promise.all([
+    db.geoArea.findMany({
+      where: { type: 'zone', parentId: city.id, active: true },
+      orderBy: [{ sortOrder: 'asc' }, { name: 'asc' }],
+    }),
+    db.geoArea.findMany({ where: { type: 'neighborhood', active: true } }),
+    db.geoArea.findMany({ where: { type: 'street', active: true } }),
+    db.customer.findMany({
+      where: { active: true, city: { not: null } },
+      select: {
+        id: true, name: true, city: true, geoNeighborhoodId: true, geoStreetId: true, geoStatus: true,
+        assignments: { select: { employeeId: true } }, // unassign deletes the row — every row IS an active assignment
+        checkins: { where: { createdAt: { gte: monthAgo } }, select: { id: true } },
+      },
+    }),
+    db.employee.findMany({ where: { active: true }, select: { id: true, name: true, username: true } }),
+  ])
+
+  // only customers of THIS city (normalized compare — same rule as the tree)
+  const cityCustomers = customers.filter((c) => normalizeFa(c.city ?? '') === cityKey)
+  const zoneIds = new Set(zones.map((z) => z.id))
+  const inCity = hoods.filter((h) => h.parentId === city.id || zoneIds.has(h.parentId ?? ''))
+  const hoodById = new Map(inCity.map((h) => [h.id, h]))
+  const streetById = new Map(streets.map((s) => [s.id, s.name]))
+
+  // neighborhood → zone id (for customers whose neighborhood hangs directly
+  // on the city, the zone is null → counted under «بدون محدوده»)
+  const zoneOfHood = new Map<string, string | null>()
+  for (const h of inCity) zoneOfHood.set(h.id, zoneIds.has(h.parentId ?? '') ? h.parentId : null)
+
+  interface ZoneAgg {
+    total: number; assigned: number; unassigned: number; incomplete: number; visited30d: number
+  }
+  const emptyAgg = (): ZoneAgg => ({ total: 0, assigned: 0, unassigned: 0, incomplete: 0, visited30d: 0 })
+  const zoneAgg = new Map<string | '__none__', ZoneAgg>()
+  for (const z of zones) zoneAgg.set(z.id, emptyAgg())
+  zoneAgg.set('__none__', emptyAgg())
+  const hoodAgg = new Map<string, ZoneAgg>()
+  const streetAgg = new Map<string, number>()
+  const unassigned: { id: string; name: string; neighborhood: string | null; zone: string | null; geoStatus: string | null }[] = []
+  // workload: employee → { customers, zones set, neighborhoods set }
+  const workloadMap = new Map<string, { customers: number; zones: Set<string>; hoods: Set<string> }>()
+
+  for (const c of cityCustomers) {
+    const nhId: string | null = c.geoNeighborhoodId
+    const zid = nhId ? (zoneOfHood.get(nhId) ?? '__none__') : '__none__'
+    const bucket = zoneAgg.get(zid as string) ?? emptyAgg()
+    const hb = nhId ? (hoodAgg.get(nhId) ?? emptyAgg()) : null
+    const bump = (k: 'total' | 'assigned' | 'unassigned' | 'incomplete' | 'visited30d') => {
+      bucket[k]++
+      if (hb && nhId) { hb[k]++; hoodAgg.set(nhId, hb) }
+    }
+    bump('total')
+    if (c.assignments.length > 0) {
+      bump('assigned')
+    } else {
+      bump('unassigned')
+      unassigned.push({
+        id: c.id, name: c.name,
+        neighborhood: nhId ? (hoodById.get(nhId)?.name ?? null) : null,
+        zone: zid !== '__none__' ? (zones.find((z) => z.id === zid)?.name ?? null) : null,
+        geoStatus: c.geoStatus,
+      })
+    }
+    if (c.geoStatus === 'incomplete') bump('incomplete')
+    if (c.checkins.length > 0) bump('visited30d')
+    if (c.geoStreetId) streetAgg.set(c.geoStreetId, (streetAgg.get(c.geoStreetId) ?? 0) + 1)
+    for (const a of c.assignments) {
+      const w = workloadMap.get(a.employeeId) ?? { customers: 0, zones: new Set<string>(), hoods: new Set<string>() }
+      w.customers++
+      if (zid !== '__none__') w.zones.add(zid)
+      if (nhId) w.hoods.add(nhId)
+      workloadMap.set(a.employeeId, w)
+    }
+  }
+
+  const zoneJson = (id: string | '__none__', name: string | null, code: string | null) => {
+    const a = zoneAgg.get(id) ?? emptyAgg()
+    return {
+      id: id === '__none__' ? null : id,
+      name: name ?? 'بدون محدوده',
+      code,
+      total: a.total, assigned: a.assigned, unassigned: a.unassigned,
+      incomplete: a.incomplete,
+      coverage: a.total > 0 ? Math.round((a.visited30d / a.total) * 100) : null,
+      neighborhoods: inCity
+        .filter((h) => (zoneOfHood.get(h.id) ?? '__none__') === id)
+        .map((h) => {
+          const ha = hoodAgg.get(h.id) ?? emptyAgg()
+          return {
+            id: h.id, name: h.name,
+            total: ha.total, assigned: ha.assigned, unassigned: ha.unassigned,
+            incomplete: ha.incomplete,
+            coverage: ha.total > 0 ? Math.round((ha.visited30d / ha.total) * 100) : null,
+          }
+        }),
+    }
+  }
+
+  const workload = employees
+    .map((e) => {
+      const w = workloadMap.get(e.id)
+      return {
+        id: e.id, name: e.name, username: e.username,
+        customers: w?.customers ?? 0,
+        zones: w?.zones.size ?? 0,
+        neighborhoods: w?.hoods.size ?? 0,
+        density: w && w.zones.size > 0 ? Math.round((w.customers / w.zones.size) * 10) / 10 : null,
+      }
+    })
+    .filter((e) => e.customers > 0)
+    .sort((a, b) => b.customers - a.customers)
+
+  const streetReport = [...streetAgg.entries()]
+    .map(([id, count]) => ({ id, name: streetById.get(id) ?? '؟', count }))
+    .filter((s) => streetById.has(s.id))
+    .sort((a, b) => b.count - a.count)
+
+  return NextResponse.json({
+    ok: true,
+    city: { id: city.id, name: city.name },
+    zones: [...zones.map((z) => zoneJson(z.id, z.name, z.code)), zoneJson('__none__', null, null)],
+    unassigned: unassigned.sort((a, b) => (a.zone ?? '').localeCompare(b.zone ?? '') || (a.neighborhood ?? '').localeCompare(b.neighborhood ?? '')),
+    workload,
+    streets: streetReport,
+  })
+}
diff -ruN '--exclude=node_modules' '--exclude=dev.db' '--exclude=build-time.db' '--exclude=.next' '--exclude=x.db' /tmp/pristine/src/app/api/panel/geo/resolve/route.ts panel-build/src/src/app/api/panel/geo/resolve/route.ts
--- a/src/app/api/panel/geo/resolve/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/panel/geo/resolve/route.ts	2026-11-18 07:00:16.657977376 +0000
@@ -0,0 +1,60 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { normalizeFa } from '@/lib/iran-cities'
+import { distanceMeters, isValidLatLng } from '@/lib/geo'
+
+/**
+ * Phase 5 (geo) — GET /api/panel/geo/resolve?city=مشهد&lat=&lng=
+ *
+ * «تشخیص خودکار از مختصات» (admin session): the K nearest neighborhood
+ * CENTROIDS of the city, with distances in meters. An APPROXIMATION —
+ * place centroids, not boundaries — and the response says so
+ * (approx: true) so no client can present it as a boundary decision.
+ *
+ * Used by the customer form («تشخیص از موقعیت نقشه») and by the
+ * completion worklist to preselect the likely neighborhood.
+ */
+export async function GET(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const url = new URL(req.url)
+  const cityName = (url.searchParams.get('city') ?? '').trim()
+  const lat = Number(url.searchParams.get('lat'))
+  const lng = Number(url.searchParams.get('lng'))
+  if (!cityName) return NextResponse.json({ ok: false, error: 'شهر مشخص نیست' }, { status: 400 })
+  if (!isValidLatLng(lat, lng)) {
+    return NextResponse.json({ ok: false, error: 'مختصات نامعتبر است' }, { status: 400 })
+  }
+
+  const cityKey = normalizeFa(cityName)
+  const cities = await db.geoArea.findMany({ where: { type: 'city', active: true } })
+  const city = cities.find((c) => normalizeFa(c.name) === cityKey)
+  if (!city) return NextResponse.json({ ok: true, approx: true, city: null, hits: [] })
+
+  const zones = await db.geoArea.findMany({
+    where: { type: 'zone', parentId: city.id, active: true },
+    select: { id: true, name: true },
+  })
+  const zoneById = new Map(zones.map((z) => [z.id, z.name]))
+  const hoods = await db.geoArea.findMany({
+    where: { type: 'neighborhood', active: true, lat: { not: null }, lng: { not: null } },
+    select: { id: true, name: true, parentId: true, lat: true, lng: true },
+  })
+  const zoneIds = new Set(zoneById.keys())
+  const hits = hoods
+    .filter((h) => h.parentId === city.id || zoneIds.has(h.parentId ?? ''))
+    .map((h) => ({
+      id: h.id,
+      name: h.name,
+      zoneId: zoneIds.has(h.parentId ?? '') ? (h.parentId as string) : null,
+      zoneName: zoneIds.has(h.parentId ?? '') ? (zoneById.get(h.parentId as string) as string) : null,
+      distanceM: Math.round(distanceMeters(lat, lng, h.lat as number, h.lng as number)),
+    }))
+    .filter((h) => h.distanceM <= 6000)
+    .sort((a, b) => a.distanceM - b.distanceM)
+    .slice(0, 5)
+
+  return NextResponse.json({ ok: true, approx: true, city: { id: city.id, name: city.name }, hits })
+}
