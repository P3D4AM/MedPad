diff -ruN '--exclude=node_modules' '--exclude=dev.db' '--exclude=build-time.db' '--exclude=.next' '--exclude=x.db' /tmp/pristine/src/lib/geo-seed.ts panel-build/src/src/lib/geo-seed.ts
--- a/src/lib/geo-seed.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/geo-seed.ts	2026-11-18 07:18:20.811238207 +0000
@@ -0,0 +1,147 @@
+import { db } from '@/lib/db'
+import { normalizeFa } from './iran-cities'
+import { MASHHAD_GEO } from './geo-mashhad'
+
+/**
+ * Phase 5 (geo) — boot seeder for the GeoArea tree.
+ *
+ * Idempotent UPSERT by (parentId, normalizedName): provinces/city/zones/
+ * neighborhoods/streets from the packaged dataset (see lib/geo-mashhad.ts
+ * for sources & dates — every node records WHERE its data came from).
+ *
+ * Policies (documented in schema.prisma, enforced here):
+ *  - NO-DELETE: absence from the dataset is NEVER a delete. Re-seeding
+ *    refreshes coordinates / source / sortOrder and reactivates nodes the
+ *    dataset still knows; admin-created or admin-renamed nodes are never
+ *    touched by a re-seed unless their (parent, normalized name) collides
+ *    with a dataset entry (in which case the dataset refreshes only the
+ *    seed-owned attributes: coords/source/order/active — never the admin's
+ *    display name).
+ *  - The whole seed runs in ONE boot pass wrapped by the caller's
+ *    try/catch — a failure must never block the server (geo features
+ *    degrade to "no data" honestly, exactly like the Holoo integration).
+ */
+
+export interface SeedStats {
+  created: number
+  updated: number
+  unchanged: number
+  total: number
+}
+
+async function upsertNode(opts: {
+  type: string
+  parentId: string | null
+  name: string
+  code?: string
+  lat?: number
+  lng?: number
+  source: string
+  sourceDate: string
+  sortOrder?: number
+  stats: SeedStats
+}): Promise<string> {
+  const normalizedName = normalizeFa(opts.name)
+  // find by (parent, normalized name); provinces (parentId NULL) are
+  // seed-only and unique by construction — matched by (type, normalized)
+  const existing = opts.parentId
+    ? await db.geoArea.findFirst({
+        where: { parentId: opts.parentId, type: opts.type, normalizedName },
+        select: { id: true, lat: true, lng: true, source: true, sourceDate: true, active: true, sortOrder: true },
+      })
+    : await db.geoArea.findFirst({
+        where: { type: opts.type, normalizedName, parentId: null },
+        select: { id: true, lat: true, lng: true, source: true, sourceDate: true, active: true, sortOrder: true },
+      })
+  const coords: { lat?: number; lng?: number } = {}
+  if (typeof opts.lat === 'number' && typeof opts.lng === 'number') {
+    coords.lat = opts.lat
+    coords.lng = opts.lng
+  }
+  if (existing) {
+    const changed =
+      existing.lat !== (coords.lat ?? null) ||
+      existing.lng !== (coords.lng ?? null) ||
+      existing.sourceDate !== opts.sourceDate ||
+      existing.active === false ||
+      existing.sortOrder !== (opts.sortOrder ?? null)
+    if (changed) {
+      await db.geoArea.update({
+        where: { id: existing.id },
+        data: { ...coords, source: opts.source, sourceDate: opts.sourceDate, active: true, sortOrder: opts.sortOrder ?? null },
+      })
+      opts.stats.updated++
+    } else {
+      opts.stats.unchanged++
+    }
+    return existing.id
+  }
+  const row = await db.geoArea.create({
+    data: {
+      type: opts.type,
+      parentId: opts.parentId,
+      name: opts.name,
+      normalizedName,
+      code: opts.code,
+      ...coords,
+      source: opts.source,
+      sourceDate: opts.sourceDate,
+      sortOrder: opts.sortOrder ?? null,
+    },
+    select: { id: true },
+  })
+  opts.stats.created++
+  return row.id
+}
+
+export async function seedGeoAreas(): Promise<SeedStats> {
+  const stats: SeedStats = { created: 0, updated: 0, unchanged: 0, total: 0 }
+  const { city, province, officialSource, osmSource, zones, neighborhoods, streets } = MASHHAD_GEO
+  const osmDate = '2026-11-18'
+
+  const provinceId = await upsertNode({
+    type: 'province', parentId: null, name: province,
+    source: 'Iran cities offline dataset (package 8)', sourceDate: osmDate, stats,
+  })
+  const cityId = await upsertNode({
+    type: 'city', parentId: provinceId, name: city, code: 'MHD',
+    source: officialSource, sourceDate: osmDate, sortOrder: 0, stats,
+  })
+
+  const zoneIds = new Map<string, string>()
+  let z = 0
+  for (const zone of zones) {
+    const id = await upsertNode({
+      type: 'zone', parentId: cityId, name: zone.name, code: zone.code,
+      source: officialSource, sourceDate: osmDate, sortOrder: ++z, stats,
+    })
+    zoneIds.set(zone.name, id)
+  }
+
+  let n = 0
+  for (const nh of neighborhoods) {
+    const parent = nh.zone ? (zoneIds.get(nh.zone) ?? cityId) : cityId
+    const source =
+      nh.src === 'both'
+        ? `${officialSource} + ${osmSource}`
+        : nh.src === 'osm'
+          ? osmSource
+          : officialSource
+    await upsertNode({
+      type: 'neighborhood', parentId: parent, name: nh.name,
+      lat: nh.lat, lng: nh.lng,
+      source, sourceDate: osmDate, sortOrder: ++n, stats,
+    })
+  }
+
+  let s = 0
+  for (const st of streets) {
+    await upsertNode({
+      type: 'street', parentId: cityId, name: st.name,
+      source: osmSource, sourceDate: osmDate, sortOrder: ++s, stats,
+    })
+  }
+
+  stats.total = 1 + 1 + zones.length + neighborhoods.length + streets.length
+  return stats
+}
