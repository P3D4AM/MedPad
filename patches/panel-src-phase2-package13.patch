--- orig/src/app/api/app/report-edit/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/app/report-edit/route.ts	2026-10-29 14:16:31.924469550 +0000
@@ -0,0 +1,78 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { appEmployee } from '@/lib/auth'
+
+export const dynamic = 'force-dynamic'
+
+/**
+ * phase 2 / §2 (daily app capabilities) — report text edit + append-only
+ * version history.
+ *
+ * POST /api/app/report-edit   body: { checkinId, note }
+ *
+ * The marketer can correct the TEXT of their own check-in/checkout report.
+ * Every real change is recorded as a NEW CheckinNoteVersion row containing
+ * the PREVIOUS text (oldNote), the NEW text (newNote), the timestamp and
+ * the acting employee (editorId) — history is APPEND-ONLY: a normal edit
+ * never rewrites or deletes earlier versions, and adding a brand-new
+ * report (a fresh check-in) creates a Checkin row with NO versions, which
+ * is exactly how "new note" stays distinguishable from "edited note"
+ * (versionCount 0 vs >= 1).
+ *
+ * Rules:
+ *   - only the report's OWN author may edit it (other employees get a
+ *     plain 404 — no existence leak, consistent with the media route)
+ *   - note is trimmed; empty string clears the note (oldNote keeps what
+ *     was there); hard cap 5000 characters (the check-in route stores the
+ *     note as free TEXT — this cap protects the history table)
+ *   - submitting the CURRENT text unchanged is an idempotent no-op:
+ *     200 { changed:false } and NO version row is written
+ *   - check-in and check-out rows are both editable (both are "reports"
+ *     in the app's گزارش‌های من screen)
+ */
+export async function POST(req: Request) {
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+
+  const body = await req.json().catch(() => ({ checkinId: '', note: '' }))
+  const { checkinId, note } = body as Record<string, unknown>
+  if (typeof checkinId !== 'string' || !checkinId || typeof note !== 'string') {
+    return NextResponse.json({ ok: false, error: 'فرم نامعتبر است' }, { status: 400 })
+  }
+  const trimmed = note.trim()
+  if (trimmed.length > 5000) {
+    return NextResponse.json(
+      { ok: false, error: 'متن گزارش خیلی طولانی است (حداکثر ۵۰۰۰ نویسه)' },
+      { status: 400 },
+    )
+  }
+
+  const row = await db.checkin.findUnique({ where: { id: checkinId } })
+  if (!row || row.employeeId !== emp.id) {
+    // same answer for "missing" and "someone else's" — no existence leak
+    return NextResponse.json({ ok: false, error: 'گزارش پیدا نشد' }, { status: 404 })
+  }
+
+  const newNote = trimmed === '' ? null : trimmed
+  if ((row.note ?? '') === (newNote ?? '')) {
+    return NextResponse.json({ ok: true, changed: false, versionCount: await countVersions(checkinId) })
+  }
+
+  const [, version] = await db.$transaction([
+    db.checkin.update({ where: { id: checkinId }, data: { note: newNote } }),
+    db.checkinNoteVersion.create({
+      data: { checkinId, oldNote: row.note, newNote, editorId: emp.id },
+    }),
+  ])
+
+  return NextResponse.json({
+    ok: true,
+    changed: true,
+    versionCount: await countVersions(checkinId),
+    version: { id: version.id, createdAt: version.createdAt },
+  })
+}
+
+async function countVersions(checkinId: string): Promise<number> {
+  return db.checkinNoteVersion.count({ where: { checkinId } })
+}
