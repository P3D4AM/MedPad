diff -ruN -x node_modules -x .next -x 'dev.db*' -x 'build-time.db*' orig/src/app/api/checkins/versions/route.ts b/src/app/api/checkins/versions/route.ts
--- orig/src/app/api/checkins/versions/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/checkins/versions/route.ts	2026-10-29 14:16:31.926469565 +0000
@@ -0,0 +1,46 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+
+export const dynamic = 'force-dynamic'
+
+/**
+ * phase 2 / §2 (daily app capabilities) — report version history (PANEL).
+ *
+ * GET /api/checkins/versions?id=<checkinId>
+ *
+ * ADMIN-ONLY (the panel's check-in list is admin-facing; the employee app
+ * never calls this). Returns the append-only edit history of one report:
+ * every row carries the previous text (oldNote), the new text (newNote),
+ * the acting employee and the timestamp, newest first.
+ */
+export async function GET(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const url = new URL(req.url)
+  const id = url.searchParams.get('id') || ''
+  if (!id) {
+    return NextResponse.json({ ok: false, error: 'شناسه گزارش لازم است' }, { status: 400 })
+  }
+  const row = await db.checkin.findUnique({ where: { id } })
+  if (!row) {
+    return NextResponse.json({ ok: false, error: 'گزارش پیدا نشد' }, { status: 404 })
+  }
+  const versions = await db.checkinNoteVersion.findMany({
+    where: { checkinId: id },
+    include: { editor: { select: { id: true, name: true, username: true } } },
+    orderBy: { createdAt: 'desc' },
+    take: 200,
+  })
+  return NextResponse.json({
+    ok: true,
+    versions: versions.map((v) => ({
+      id: v.id,
+      oldNote: v.oldNote,
+      newNote: v.newNote,
+      editor: v.editor,
+      createdAt: v.createdAt,
+    })),
+  })
+}
diff -ruN -x node_modules -x .next -x 'dev.db*' -x 'build-time.db*' orig/src/components/panel/AudioPlayer.tsx b/src/components/panel/AudioPlayer.tsx
--- orig/src/components/panel/AudioPlayer.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/panel/AudioPlayer.tsx	2026-10-29 14:16:31.940469673 +0000
@@ -0,0 +1,266 @@
+'use client'
+
+import { useCallback, useEffect, useRef, useState } from 'react'
+import { Play, Pause, Square, Gauge, AlertTriangle, RotateCw } from 'lucide-react'
+
+/**
+ * phase 2 / §3 (daily app capabilities) — panel voice-note player.
+ *
+ * Replaces the bare <audio controls> element in CheckinsTab. Requirements
+ * it implements (دستورالعمل جامع، فاز دو، §۳):
+ *   - play / pause / RESUME-from-pause-position / stop
+ *   - NO unintended simultaneous playback: a module-level registry keeps
+ *     exactly ONE active HTMLAudioElement — starting player B pauses
+ *     player A (and vice versa), on any number of rows
+ *   - duration + current-time display (fa-IR digits, m:ss)
+ *   - playback SPEED control (0.75× / 1× / 1.25× / 1.5× / 2× cycle)
+ *   - clear error state for missing/unplayable files (the media route
+ *     404s orphans and authorization misses — the player surfaces the
+ *     failure instead of failing silently) + retry
+ *   - seek bar
+ *
+ * All interactive elements carry stable data-testid hooks (the H2 lesson
+ * from 5-A): Persian strings are visual labels only.
+ */
+
+// module-level single-flight registry (surives re-renders; one tab = one
+// audible player at a time)
+const g = globalThis as unknown as { __medpadActiveAudio?: HTMLAudioElement | null }
+function stopActiveAudio(except?: HTMLAudioElement) {
+  const cur = g.__medpadActiveAudio
+  if (cur && cur !== except) {
+    try {
+      cur.pause()
+    } catch {
+      /* ignore */
+    }
+  }
+}
+
+const RATES = [1, 1.25, 1.5, 2, 0.75] as const
+const RATE_LABELS = ['×۱', '×۱٫۲۵', '×۱٫۵', '×۲', '×۰٫۷۵'] as const
+
+const FA_DIGITS = '۰۱۲۳۴۵۶۷۸۹'
+function faClock(sec: number): string {
+  if (!isFinite(sec) || sec < 0) sec = 0
+  const m = Math.floor(sec / 60)
+  const s = Math.floor(sec % 60)
+  const two = String(s).padStart(2, '0').replace(/\d/g, (d) => FA_DIGITS[+d])
+  return `${FA_DIGITS[m]}:${two}`
+}
+
+type Status = 'idle' | 'loading' | 'playing' | 'paused' | 'ended' | 'error'
+const STATUS_LABEL: Record<Status, string> = {
+  idle: '',
+  loading: 'در حال بارگذاری',
+  playing: 'در حال پخش',
+  paused: 'مکث',
+  ended: 'پایان',
+  error: 'خطا',
+}
+
+export default function AudioPlayer({ src, tid }: { src: string; tid: string }) {
+  const audioRef = useRef<HTMLAudioElement | null>(null)
+  const loadedSrcRef = useRef<string>('')
+  const [status, setStatus] = useState<Status>('idle')
+  const [time, setTime] = useState(0)
+  const [duration, setDuration] = useState(0)
+  const [rateIdx, setRateIdx] = useState(0) // RATES[0] = 1× default
+
+  const ensureAudio = useCallback(() => {
+    if (audioRef.current) return audioRef.current
+    const a = new Audio()
+    a.preload = 'none'
+    a.addEventListener('loadedmetadata', () => setDuration(a.duration || 0))
+    a.addEventListener('timeupdate', () => setTime(a.currentTime))
+    a.addEventListener('play', () => setStatus('playing'))
+    a.addEventListener('pause', () => {
+      // programmatic stop() also fires 'pause' — keep its explicit state
+      setStatus((s) => (s === 'playing' || s === 'loading' ? 'paused' : s))
+    })
+    a.addEventListener('ended', () => {
+      try {
+        a.currentTime = 0
+      } catch {
+        /* ignore */
+      }
+      setTime(0)
+      setStatus('ended')
+    })
+    a.addEventListener('error', () => {
+      setStatus('error')
+    })
+    audioRef.current = a
+    return a
+  }, [])
+
+  // unmount: pause + release
+  useEffect(() => {
+    return () => {
+      const a = audioRef.current
+      if (a) {
+        try {
+          a.pause()
+          a.removeAttribute('src')
+        } catch {
+          /* ignore */
+        }
+      }
+      if (g.__medpadActiveAudio === a) g.__medpadActiveAudio = null
+    }
+  }, [])
+
+  const play = useCallback(() => {
+    const a = ensureAudio()
+    if (loadedSrcRef.current !== src) {
+      a.src = src
+      loadedSrcRef.current = src
+      setDuration(0)
+      setTime(0)
+    }
+    // single-flight: stop whatever else is playing first
+    stopActiveAudio(a)
+    g.__medpadActiveAudio = a
+    a.playbackRate = RATES[rateIdx]
+    setStatus('loading')
+    a.play().catch(() => setStatus('error'))
+  }, [ensureAudio, rateIdx, src])
+
+  const pause = useCallback(() => {
+    audioRef.current?.pause()
+  }, [])
+
+  const stop = useCallback(() => {
+    const a = audioRef.current
+    if (!a) return
+    a.pause()
+    try {
+      a.currentTime = 0
+    } catch {
+      /* ignore */
+    }
+    setTime(0)
+    setStatus('idle')
+    if (g.__medpadActiveAudio === a) g.__medpadActiveAudio = null
+  }, [])
+
+  const retry = useCallback(() => {
+    const a = audioRef.current
+    if (a) {
+      try {
+        a.pause()
+        a.removeAttribute('src')
+      } catch {
+        /* ignore */
+      }
+    }
+    loadedSrcRef.current = ''
+    setStatus('idle')
+    // next tick: play() re-sets the src from scratch
+    setTimeout(() => play(), 0)
+  }, [play])
+
+  const cycleRate = useCallback(() => {
+    const next = (rateIdx + 1) % RATES.length
+    setRateIdx(next)
+    if (audioRef.current) audioRef.current.playbackRate = RATES[next]
+  }, [rateIdx])
+
+  const seek = useCallback((v: number) => {
+    const a = audioRef.current
+    if (!a || !isFinite(v)) return
+    try {
+      a.currentTime = v
+      setTime(v)
+    } catch {
+      /* ignore */
+    }
+  }, [])
+
+  const playing = status === 'playing' || status === 'loading'
+
+  return (
+    <div
+      className="flex flex-wrap items-center gap-1.5 rounded-lg border bg-muted/40 px-2 py-1"
+      data-testid={`audio-player-${tid}`}
+    >
+      {playing ? (
+        <button
+          onClick={pause}
+          title="مکث"
+          data-testid={`audio-pause-${tid}`}
+          className="rounded p-1 hover:bg-muted"
+        >
+          <Pause className="h-4 w-4 text-teal-700" />
+        </button>
+      ) : (
+        <button
+          onClick={play}
+          title={status === 'paused' ? 'ادامه از محل مکث' : 'پخش'}
+          data-testid={`audio-play-${tid}`}
+          className="rounded p-1 hover:bg-muted"
+        >
+          <Play className="h-4 w-4 text-teal-700" />
+        </button>
+      )}
+      <button
+        onClick={stop}
+        title="توقف"
+        data-testid={`audio-stop-${tid}`}
+        className="rounded p-1 hover:bg-muted"
+      >
+        <Square className="h-3.5 w-3.5 text-muted-foreground" />
+      </button>
+      <button
+        onClick={cycleRate}
+        title="سرعت پخش"
+        data-testid={`audio-speed-${tid}`}
+        className="rounded px-1 py-0.5 text-xs font-medium text-teal-700 hover:bg-muted"
+      >
+        {RATE_LABELS[rateIdx]}
+      </button>
+      <input
+        type="range"
+        min={0}
+        max={duration || 0}
+        step={0.1}
+        value={time}
+        onChange={(e) => seek(parseFloat(e.target.value))}
+        title="جابه‌جایی"
+        data-testid={`audio-seek-${tid}`}
+        className="h-1 w-20 accent-teal-600"
+        disabled={!duration}
+      />
+      <span
+        className="text-xs tabular-nums text-muted-foreground"
+        data-testid={`audio-time-${tid}`}
+      >
+        {faClock(time)} / {duration ? faClock(duration) : '−:−−'}
+      </span>
+      <span
+        className="text-xs text-muted-foreground"
+        data-testid={`audio-status-${tid}`}
+        data-state={status}
+      >
+        {STATUS_LABEL[status]}
+      </span>
+      {status === 'error' && (
+        <span
+          className="flex items-center gap-1 text-xs text-destructive"
+          data-testid={`audio-error-${tid}`}
+        >
+          <AlertTriangle className="h-3.5 w-3.5" />
+          فایل صوتی موجود نیست یا قابل پخش نیست
+          <button
+            onClick={retry}
+            title="تلاش مجدد"
+            data-testid={`audio-retry-${tid}`}
+            className="rounded p-0.5 hover:bg-muted"
+          >
+            <RotateCw className="h-3.5 w-3.5" />
