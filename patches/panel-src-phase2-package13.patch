diff -ruN -x node_modules -x .next -x 'dev.db*' -x 'build-time.db*' orig/src/app/api/app/change-password/route.ts b/src/app/api/app/change-password/route.ts
--- orig/src/app/api/app/change-password/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/app/change-password/route.ts	2026-10-29 14:16:31.923469542 +0000
@@ -0,0 +1,114 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { APP_TOKEN_HEADER, appEmployee, hashPassword, verifyPassword } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+import { clientIp, lockoutRemaining, recordFailure, recordSuccess, sweep } from '@/lib/rate-limit'
+
+export const dynamic = 'force-dynamic'
+
+/**
+ * phase 2 / §6 (daily app capabilities) — self-service password change
+ * from the Android app.
+ *
+ * POST /api/app/change-password   body: { currentPassword, newPassword,
+ *                                        confirmPassword }
+ *
+ * Validation is SERVER-SIDE (the app UI repeats it for UX only):
+ *   - all three fields present, non-empty strings
+ *   - newPassword === confirmPassword
+ *   - newPassword length >= 8
+ *   - newPassword !== currentPassword
+ *   - currentPassword verifies against the stored hash (bcrypt, with the
+ *     transparent legacy-SHA-256 path — after this call the stored hash is
+ *     ALWAYS bcrypt)
+ *
+ * Rate limiting: wrong CURRENT passwords are brute-forceable exactly like
+ * the login route, so the same policy applies — 5 failures per
+ * IP+username per 15 min locks the pair out for 15 min. Keys and counters
+ * never contain passwords.
+ *
+ * SESSION-INVALIDATION POLICY (documented, per the §6 requirement):
+ * a successful change revokes EVERY OTHER app token of this employee
+ * (revokedAt=now, effective immediately on the next request — G-2 checks
+ * revocation per request) but keeps the token used for THIS request alive,
+ * so the device that just changed the password is not logged out mid-flow.
+ * All other devices must log in again with the new password.
+ *
+ * The password itself is NEVER written to the audit log, the console or
+ * any response (audit `detail` only records the fact and the count of
+ * revoked sessions).
+ */
+export async function POST(req: Request) {
+  sweep()
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+
+  const rlKey = `appcp|${clientIp(req)}|${emp.username.toLowerCase()}`
+  const waitMs = lockoutRemaining(rlKey)
+  if (waitMs > 0) {
+    return NextResponse.json(
+      { ok: false, error: 'تلاش‌های ناموفق زیاد — بعداً دوباره امتحان کنید' },
+      { status: 429, headers: { 'retry-after': String(Math.ceil(waitMs / 1000)) } },
+    )
+  }
+
+  const body = await req.json().catch(() => ({ currentPassword: '', newPassword: '', confirmPassword: '' }))
+  const { currentPassword, newPassword, confirmPassword } = body as Record<string, unknown>
+  if (
+    typeof currentPassword !== 'string' || !currentPassword ||
+    typeof newPassword !== 'string' || !newPassword ||
+    typeof confirmPassword !== 'string' || !confirmPassword
+  ) {
+    return NextResponse.json({ ok: false, error: 'فرم نامعتبر است' }, { status: 400 })
+  }
+  if (newPassword !== confirmPassword) {
+    return NextResponse.json({ ok: false, error: 'تکرار رمز جدید مطابقت ندارد' }, { status: 400 })
+  }
+  if (newPassword.length < 8) {
+    return NextResponse.json({ ok: false, error: 'رمز جدید باید حداقل ۸ نویسه باشد' }, { status: 400 })
+  }
+  if (newPassword === currentPassword) {
+    return NextResponse.json({ ok: false, error: 'رمز جدید نباید با رمز فعلی یکسان باشد' }, { status: 400 })
+  }
+
+  const v = await verifyPassword(currentPassword, emp.password)
+  if (!v.ok) {
+    recordFailure(rlKey)
+    await writeAudit({
+      action: 'employee.password-change',
+      actorType: 'employee',
+      actorId: emp.id,
+      targetType: 'employee',
+      targetId: emp.id,
+      outcome: 'failure',
+      detail: 'wrong current password (self-service change from the app)',
+    })
+    return NextResponse.json({ ok: false, error: 'رمز فعلی نادرست است' }, { status: 403 })
+  }
+  recordSuccess(rlKey)
+
+  // the token of THIS request stays valid; every other session is revoked
+  const url = new URL(req.url)
+  let currentToken = req.headers.get(APP_TOKEN_HEADER) || ''
+  if (!currentToken) currentToken = url.searchParams.get('token') || ''
+
+  const [, revoked] = await db.$transaction([
+    db.employee.update({ where: { id: emp.id }, data: { password: hashPassword(newPassword) } }),
+    db.appToken.updateMany({
+      where: { employeeId: emp.id, token: { not: currentToken }, revokedAt: null },
+      data: { revokedAt: new Date() },
+    }),
+  ])
+
+  await writeAudit({
+    action: 'employee.password-change',
+    actorType: 'employee',
+    actorId: emp.id,
+    targetType: 'employee',
+    targetId: emp.id,
+    outcome: 'success',
+    detail: `self-service password change from the app; ${revoked.count} other session(s) revoked`,
+  })
+
+  return NextResponse.json({ ok: true, revokedSessions: revoked.count })
+}
