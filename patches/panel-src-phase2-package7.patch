--- orig/src/app/api/assignments/bulk/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/assignments/bulk/route.ts	2026-10-28 13:00:05.000000000 +0000
@@ -0,0 +1,232 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { notifyAdmin, notifyEmployee } from '@/lib/notify'
+import { writeAudit } from '@/lib/audit'
+import { emitEvent } from '@/lib/emit'
+import { createHash } from 'crypto'
+
+/**
+ * package 7 (phase 2 / task 5) — BULK assignment / unassignment.
+ *
+ * POST /api/assignments/bulk   (admin session only)
+ *   { action: 'assign' | 'unassign',
+ *     customerIds: string[],            // 1..200 distinct
+ *     employeeIds: string[],            // 1..100 distinct (assign: active only)
+ *     allEmployees?: boolean }          // unassign only: drop EVERY assignment
+ *                                       // of the selected customers
+ *
+ * Semantics follow the app's current model exactly: Assignment is a
+ * (employee, customer) pair with @@unique([employeeId, customerId]) — the
+ * bulk operation is the cross product of the two selections, evaluated
+ * pair by pair INSIDE ONE TRANSACTION so the outcome is consistent:
+ *
+ *   assign:    missing pair -> created (with the same per-pair rep
+ *              notification the single-assign route sends, eventKey
+ *              assignment:<rowId>); existing pair -> counted as "already"
+ *              (NOT an error, not duplicated); unknown/deactivated/inactive
+ *              -> per-pair failed entry with a Persian reason.
+ *   unassign:  existing pair -> removed; missing pair -> counted as
+ *              "missing" (not an error). History (visits/checkins/voice)
+ *              is never touched — only the Assignment rows go.
+ *
+ * PARTIAL FAILURES ARE NEVER REPORTED AS SUCCESS: the response carries
+ * exact counters and a failed[] list; ok:true only means the request was
+ * processed — the UI shows every counter. One admin bell notification
+ * summarizes the batch (eventKey = deterministic hash of the inputs, so
+ * retrying the same bulk never duplicates the bell entry; per-pair rep
+ * notifications are keyed on the created rows themselves).
+ */
+
+const MAX_CUSTOMERS = 200
+const MAX_EMPLOYEES = 100
+const MAX_PAIRS = 2000
+
+const fail = (msg: string, status: number) => NextResponse.json({ ok: false, error: msg }, { status })
+
+export async function POST(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+
+  const body = await req.json().catch(() => null) as {
+    action?: string; customerIds?: unknown; employeeIds?: unknown; allEmployees?: boolean
+  } | null
+
+  const action = body?.action
+  if (action !== 'assign' && action !== 'unassign') {
+    return fail('نوع عملیات نامعتبر است (assign یا unassign)', 400)
+  }
+  if (!Array.isArray(body?.customerIds) || body.customerIds.length === 0) {
+    return fail('فهرست مشتریان خالی است', 400)
+  }
+  const customerIds = [...new Set(body.customerIds.filter((x): x is string => typeof x === 'string' && x.length > 0))]
+  if (customerIds.length === 0) return fail('شناسهٔ مشتری نامعتبر است', 400)
+  if (customerIds.length > MAX_CUSTOMERS) {
+    return fail(`حداکثر ${MAX_CUSTOMERS} مشتری در هر عملیات گروهی`, 400)
+  }
+
+  const allEmployees = action === 'unassign' && body?.allEmployees === true
+  let employeeIds: string[] = []
+  if (!allEmployees) {
+    if (!Array.isArray(body?.employeeIds) || body.employeeIds.length === 0) {
+      return fail('فهرست مدرپ‌ها خالی است', 400)
+    }
+    employeeIds = [...new Set(body.employeeIds.filter((x): x is string => typeof x === 'string' && x.length > 0))]
+    if (employeeIds.length === 0) return fail('شناسهٔ مدرپ نامعتبر است', 400)
+    if (employeeIds.length > MAX_EMPLOYEES) {
+      return fail(`حداکثر ${MAX_EMPLOYEES} مدرپ در هر عملیات گروهی`, 400)
+    }
+  }
+
+  const pairCount = allEmployees ? customerIds.length : customerIds.length * employeeIds.length
+  if (pairCount > MAX_PAIRS) {
+    return fail(`حجم عملیات بیش از حد مجاز است (${pairCount} > ${MAX_PAIRS})`, 400)
+  }
+
+  // resolve names up front (unknown ids become per-pair failures)
+  const [employees, customers] = await Promise.all([
+    allEmployees ? Promise.resolve([]) : db.employee.findMany({
+      where: { id: { in: employeeIds } },
+      select: { id: true, name: true, username: true, active: true },
+    }),
+    db.customer.findMany({ where: { id: { in: customerIds } }, select: { id: true, name: true } }),
+  ])
+  const empById = new Map(employees.map((e) => [e.id, e]))
+  const cusById = new Map(customers.map((c) => [c.id, c]))
+
+  const failed: { employeeId: string | null; customerId: string; employeeName?: string; customerName?: string; reason: string }[] = []
+  let created = 0
+  let already = 0
+  let removed = 0
+  let missing = 0
+  const createdRows: { employeeId: string; customerId: string; id: string }[] = []
+
+  if (action === 'assign') {
+    // one transaction, pair by pair — consistent snapshot, honest counters
+    await db.$transaction(async (tx) => {
+      for (const cusId of customerIds) {
+        const cus = cusById.get(cusId)
+        for (const empId of employeeIds) {
+          const emp = empById.get(empId)
+          if (!cus) {
+            failed.push({ employeeId: empId, customerId: cusId, reason: 'مشتری پیدا نشد (حذف‌شده)' })
+            continue
+          }
+          if (!emp) {
+            failed.push({ employeeId: empId, customerId: cusId, customerName: cus.name, reason: 'مدرپ پیدا نشد (حذف‌شده)' })
+            continue
+          }
+          if (!emp.active) {
+            failed.push({ employeeId: empId, customerId: cusId, employeeName: emp.name, customerName: cus.name, reason: 'مدرپ غیرفعال است' })
+            continue
+          }
+          const exists = await tx.assignment.findFirst({ where: { employeeId: empId, customerId: cusId } })
+          if (exists) {
+            already++
+            continue
+          }
+          const row = await tx.assignment.create({ data: { employeeId: empId, customerId: cusId } })
+          created++
+          createdRows.push({ id: row.id, employeeId: empId, customerId: cusId })
+        }
+      }
+    })
+
+    // per-pair rep notifications (same contract as the single-assign route;
+    // eventKey on the row id makes a retried bulk a no-op for notifications)
+    for (const r of createdRows) {
+      const emp = empById.get(r.employeeId)
+      const cus = cusById.get(r.customerId)
+      await notifyEmployee({
+        employeeId: r.employeeId,
+        kind: 'assignment',
+        title: 'مشتری جدید اختصاص یافت',
+        body: `«${cus?.name ?? ''}» توسط مدیر به شما اختصاص داده شد.`,
+        customerId: r.customerId,
+        eventKey: `assignment:${r.id}`,
+      })
+      if (emp) {
+        await emitEvent('notification', {
+          employeeId: r.employeeId,
+          employeeName: emp.name,
+          title: 'مشتری جدید اختصاص یافت',
+          body: `«${cus?.name ?? ''}» توسط مدیر به شما اختصاص داده شد.`,
+        })
+      }
+    }
+  } else {
+    // unassign — either from the selected employees or from everyone
+    if (allEmployees) {
+      // exact per-customer counts before deleting (honest "missing" number)
+      const groups = await db.assignment.groupBy({
+        by: ['customerId'],
+        where: { customerId: { in: customerIds } },
+        _count: { _all: true },
+      })
+      const withAssignments = new Set(groups.map((g) => g.customerId))
+      const res = await db.assignment.deleteMany({ where: { customerId: { in: customerIds } } })
+      removed = res.count
+      missing = customerIds.filter((c) => !withAssignments.has(c)).length
+      for (const cusId of customerIds) {
+        if (!cusById.get(cusId)) {
+          failed.push({ employeeId: null, customerId: cusId, reason: 'مشتری پیدا نشد (حذف‌شده)' })
+        }
+      }
+    } else {
+      for (const cusId of customerIds) {
+        const cus = cusById.get(cusId)
+        for (const empId of employeeIds) {
+          const emp = empById.get(empId)
+          if (!cus) {
+            failed.push({ employeeId: empId, customerId: cusId, reason: 'مشتری پیدا نشد (حذف‌شده)' })
+            continue
+          }
+          if (!emp) {
+            failed.push({ employeeId: empId, customerId: cusId, customerName: cus.name, reason: 'مدرپ پیدا نشد (حذف‌شده)' })
+            continue
+          }
+          const res = await db.assignment.deleteMany({ where: { employeeId: empId, customerId: cusId } })
+          if (res.count > 0) removed++
+          else missing++
+        }
+      }
+    }
+  }
+
+  // one admin bell entry per batch (deterministic eventKey: retrying the
+  // exact same bulk never rings twice)
+  const batchKey = createHash('sha256')
+    .update(`${action}|${allEmployees ? 'all' : [...employeeIds].sort().join(',')}|${[...customerIds].sort().join(',')}`)
+    .digest('hex')
+    .slice(0, 24)
+  if ((action === 'assign' && created > 0) || (action === 'unassign' && removed > 0)) {
+    await notifyAdmin({
+      kind: 'assignment',
+      title: action === 'assign' ? 'انتساب گروهی انجام شد' : 'لغو انتساب گروهی انجام شد',
+      body: action === 'assign'
+        ? `${created} انتساب جدید برای ${customerIds.length} مشتری ایجاد شد${already > 0 ? ` (${already} مورد از قبل موجود بود)` : ''}.`
+        : `${removed} انتساب حذف شد${missing > 0 ? ` (${missing} مورد وجود نداشت)` : ''}.`,
+      eventKey: `bulk-${action}:${batchKey}`,
+    })
+  }
+
+  await writeAudit({
+    action: action === 'assign' ? 'assignment.bulk' : 'assignment.bulk-unassign',
+    targetType: 'assignment',
+    targetId: null,
+    detail: `${action}: ${customerIds.length} customers × ${allEmployees ? 'ALL' : employeeIds.length} employees -> created=${created} already=${already} removed=${removed} missing=${missing} failed=${failed.length}`,
+  })
+
+  return NextResponse.json({
+    ok: true,
+    action,
+    allEmployees: allEmployees || undefined,
+    requestedPairs: pairCount,
+    created,
+    already,
+    removed,
+    missing,
+    failed,
+  })
+}
