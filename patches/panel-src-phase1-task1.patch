diff -ruN orig/src/lib/client-time.ts fixed/src/lib/client-time.ts
--- orig/src/lib/client-time.ts	1970-01-01 00:00:00.000000000 +0000
+++ fixed/src/lib/client-time.ts	2026-10-25 22:04:27.646036108 +0000
@@ -0,0 +1,35 @@
+/**
+ * v1.9.12 (phase 1 / task 1): offline-queue event time.
+ *
+ * The Android app queues check-in/check-out locally while offline and flushes
+ * the queue when connectivity returns. Before this fix the server stamped
+ * `createdAt = now()` at SYNC time, so an offline check-in made at 09:00 and
+ * flushed at 11:00 was recorded as 11:00 — attendance history was silently
+ * wrong (reports, visit durations and the panel list all showed sync time).
+ *
+ * The app now sends the device-local event time as `clientAt` (ISO 8601,
+ * i.e. an absolute UTC instant — no timezone ambiguity). The server accepts
+ * it only within a sane window and otherwise falls back to the server clock:
+ * old app versions send nothing and keep the previous behavior exactly.
+ *
+ * Bounds (documented, deliberately generous):
+ *   - not more than 2 minutes in the future  (device clock skew tolerance)
+ *   - not older than 7 days                  (a queue cannot realistically
+ *                                             be older; also blocks forging
+ *                                             ancient history)
+ */
+const MAX_FUTURE_MS = 2 * 60 * 1000
+const MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000
+
+export function resolveEventTime(
+  raw: string | null | undefined,
+  fallback: Date = new Date(),
+): Date {
+  if (!raw) return fallback
+  const t = Date.parse(String(raw))
+  if (!Number.isFinite(t)) return fallback
+  const now = Date.now()
+  if (t > now + MAX_FUTURE_MS) return fallback
+  if (t < now - MAX_AGE_MS) return fallback
+  return new Date(t)
+}
