+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+
+/**
+ * phase 1 / task 2 (G-3): reactivate a previously deactivated employee.
+ *
+ * The employee may log in again through the normal authentication flow
+ * (POST /api/app/login — bcrypt + rate limiting) and receives a FRESH
+ * token. Previously revoked tokens are NOT restored: revocation is
+ * one-way by design (a stolen-phone token must stay dead across a
+ * deactivate/reactivate cycle).
+ */
+export async function POST(_req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const emp = await db.employee.findUnique({ where: { id } })
+  if (!emp) return NextResponse.json({ ok: false, error: 'پیدا نشد' }, { status: 404 })
+  if (emp.active) {
+    return NextResponse.json({ ok: false, error: 'این کارمند از قبل فعال است' }, { status: 409 })
+  }
+  await db.employee.update({ where: { id }, data: { active: true } })
+  await writeAudit({
+    action: 'employee.reactivate',
+    targetType: 'Employee',
+    targetId: id,
+    detail: `فعال‌سازی مجدد ${emp.username} — نشست‌های قبلی باطل‌شده باقی می‌مانند`,
+  })
+  return NextResponse.json({ ok: true })
+}
