--- orig/src/app/api/admin/media-orphans/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/admin/media-orphans/route.ts	2026-10-26 08:20:37.000000000 +0000
@@ -0,0 +1,48 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { VOICE_DIR, safeName } from '@/lib/media'
+import { readdir, stat } from 'fs/promises'
+
+/**
+ * phase 1 / task 2 (G-4): ADMIN-ONLY review path for orphaned audio files —
+ * files on disk under uploads/voice/ that no Checkin row references anymore
+ * (e.g. a crash between file write and row insert).
+ *
+ * Read-only by policy: orphaned files are NEVER deleted automatically. The
+ * admin can download any of them via /api/media/voice/<name> (admins bypass
+ * the employee authorization matrix) and decide case by case.
+ */
+export async function GET() {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  let files: string[] = []
+  try {
+    files = await readdir(VOICE_DIR)
+  } catch {
+    return NextResponse.json({ ok: true, orphans: [] })
+  }
+  // every referenced voice path (just the strings — LAN scale)
+  const rows = await db.checkin.findMany({
+    where: { voicePath: { not: null } },
+    select: { voicePath: true },
+  })
+  const referenced = new Set(rows.map((r) => r.voicePath as string))
+
+  const orphans: { name: string; size: number; modifiedAt: string }[] = []
+  for (const f of files) {
+    const safe = safeName(f)
+    if (!safe) continue // junk/impossible names are skipped, not served
+    if (referenced.has(`voice/${safe}`)) continue
+    try {
+      const st = await stat(VOICE_DIR + '/' + safe)
+      if (!st.isFile()) continue
+      orphans.push({ name: safe, size: st.size, modifiedAt: st.mtime.toISOString() })
+    } catch {
+      /* raced away — skip */
+    }
+  }
+  orphans.sort((a, b) => b.modifiedAt.localeCompare(a.modifiedAt))
+  return NextResponse.json({ ok: true, orphans })
+}
