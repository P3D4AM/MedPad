diff -ruN orig/src/lib/settings.ts b/src/lib/settings.ts
--- orig/src/lib/settings.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/settings.ts	2026-10-26 08:25:27.000000000 +0000
@@ -0,0 +1,97 @@
+import { db } from '@/lib/db'
+
+/**
+ * phase 1 / task 2: admin-configurable server settings.
+ *
+ * Stored in the existing Config KV table (single source of truth, survives
+ * restarts, no new infrastructure). Every setting has:
+ *   - a server-side default (used when the row is missing/corrupt),
+ *   - a permitted range enforced on write AND defensively on read,
+ *   - a "safe" failure mode: an invalid stored value NEVER widens policy,
+ *     it falls back to the default.
+ *
+ * appTokenTtlHours (G-2) — how long a newly issued app token lives:
+ *   0        = tokens never expire (pre-remediation behavior, opt-in)
+ *   1..8760  = 1 hour .. 1 year
+ *   default  = 720 (30 days)
+ * The TTL applies at ISSUANCE time only; changing it never retroactively
+ * expires existing tokens (no silent mass-logout on deployment).
+ *
+ * gpsMaxAccuracyM (G-6) — GPS accuracy tolerance in meters. A reported
+ * accuracy worse than this tolerance makes the location UNAVAILABLE (the
+ * event is still recorded, explicitly marked as missing its location).
+ *   0        = accuracy filtering disabled (record any fix + its accuracy)
+ *   10..500  = tolerance window
+ *   default  = 50 (typical urban GPS fixes are 10–30 m; 50 m is lenient
+ *   enough to keep valid fixes, strict enough to drop garbage). This is a
+ *   NEW threshold — the app had no accuracy concept before G-6 (documented
+ *   decision; the admin can change it at any time).
+ * Structurally IMPOSSIBLE accuracy values (<= 0, NaN, > 100000 m) are
+ * ALWAYS discarded regardless of this setting.
+ *
+ * gpsStrictRadius (G-6) — what happens when a check-in is outside the
+ * customer's permitted radius (per-customer `radius` field, default 150 m —
+ * the existing admin-configurable mechanism; no new global radius invented):
+ *   0 (off)  = record the event WITH an explicit outOfRadius flag +
+ *              distance (default — field reality: GPS drift, offline queue;
+ *              attendance data must not be lost, but the violation is
+ *              surfaced in the API, UI and realtime event)
+ *   1 (on)   = REJECT with 422 (strict mode)
+ */
+
+export interface AdminSettings {
+  appTokenTtlHours: number
+  gpsMaxAccuracyM: number
+  gpsStrictRadius: number
+}
+
+export const SETTING_DEFS = {
+  appTokenTtlHours: { def: 720, min: 0, max: 8760 },
+  gpsMaxAccuracyM: { def: 50, min: 0, max: 500 },
+  gpsStrictRadius: { def: 0, min: 0, max: 1 },
+} as const
+
+export type SettingKey = keyof typeof SETTING_DEFS
+
+function clampToRange(key: SettingKey, value: number): number {
+  const { min, max } = SETTING_DEFS[key]
+  if (!Number.isFinite(value)) return SETTING_DEFS[key].def
+  return Math.min(max, Math.max(min, Math.trunc(value)))
+}
+
+/** Read all settings with range validation (invalid stored value -> default). */
+export async function getAdminSettings(): Promise<AdminSettings> {
+  const rows = await db.config.findMany({
+    where: { key: { in: Object.keys(SETTING_DEFS) } },
+  })
+  const out: Record<string, number> = {}
+  for (const k of Object.keys(SETTING_DEFS) as SettingKey[]) {
+    const row = rows.find((r) => r.key === k)
+    const raw = row ? Number(row.value) : NaN
+    out[k] = Number.isFinite(raw) ? clampToRange(k, raw) : SETTING_DEFS[k].def
+  }
+  return out as unknown as AdminSettings
+}
+
+/** Validate + persist one or more settings. Throws Error with a Persian
+ *  message on invalid input (the route maps it to HTTP 400). */
+export async function saveAdminSettings(patch: Partial<Record<SettingKey, unknown>>): Promise<AdminSettings> {
+  for (const [key, value] of Object.entries(patch)) {
+    if (!(key in SETTING_DEFS)) {
+      throw new Error(`تنظیمات ناشناخته: ${key}`)
+    }
+    const num = typeof value === 'string' ? Number(value.trim()) : Number(value)
+    const { min, max } = SETTING_DEFS[key as SettingKey]
+    if (!Number.isFinite(num) || Math.trunc(num) !== num || num < min || num > max) {
+      throw new Error(`مقدار ${key} باید عددی صحیح بین ${min} و ${max} باشد`)
+    }
+  }
+  for (const [key, value] of Object.entries(patch)) {
+    await db.config.upsert({
+      where: { key },
+      update: { value: String(value) },
+      create: { key, value: String(value) },
+    })
+  }
+  return getAdminSettings()
+}
