+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+
+/**
+ * phase 1 / task 2 (G-2): revoke ALL active app tokens of an employee
+ * (admin only). Takes effect IMMEDIATELY for subsequent requests —
+ * appEmployee() checks revokedAt on every call (no cache in between).
+ * Deleting a token on the Android device is NOT server-side revocation;
+ * this endpoint is. Revocation is one-way: reactivation never restores
+ * revoked tokens — the employee simply logs in again (new token).
+ * G-3: the operation is recorded in the admin audit trail.
+ */
+export async function POST(_req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const emp = await db.employee.findUnique({ where: { id }, select: { id: true, name: true, username: true } })
+  if (!emp) return NextResponse.json({ ok: false, error: 'پیدا نشد' }, { status: 404 })
+  const now = new Date()
+  // only tokens that are currently usable get stamped — historical revoked
+  // rows keep their original revocation timestamp
+  const res = await db.appToken.updateMany({
+    where: { employeeId: id, revokedAt: null },
+    data: { revokedAt: now },
+  })
+  await writeAudit({
+    action: 'employee.revoke-tokens',
+    targetType: 'Employee',
+    targetId: id,
+    detail: `ابطال دسترسی اپ ${emp.username} — ${res.count} نشست باطل شد`,
+  })
+  return NextResponse.json({ ok: true, revoked: res.count })
+}
