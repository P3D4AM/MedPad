@@ -0,0 +1,724 @@
+'use client'
+
+import { useCallback, useEffect, useMemo, useState } from 'react'
+import { Badge } from '@/components/ui/badge'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import { Label } from '@/components/ui/label'
+import { Textarea } from '@/components/ui/textarea'
+import { ScrollArea } from '@/components/ui/scroll-area'
+import {
+  Dialog,
+  DialogContent,
+  DialogFooter,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog'
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from '@/components/ui/select'
+import { useToast } from '@/hooks/use-toast'
+import {
+  CalendarClock,
+  CalendarPlus,
+  Check,
+  ChevronLeft,
+  ChevronRight,
+  Clock,
+  Pencil,
+  RefreshCw,
+  X,
+} from 'lucide-react'
+import type { Customer, Employee, PlanPriority, PlanStatus, PlannedVisit } from '@/lib/types'
+import { faDate, faTime } from '@/lib/realtime'
+
+/**
+ * phase 2 / task 1 — planned-visit management (Persian, RTL).
+ *
+ * Day view: one server-local day at a time (prev / next / today + a native
+ * date box; the selected day is labelled in Jalali through the SAME fa-IR
+ * Intl path the rest of the panel uses). Filters: employee, customer,
+ * status. Summary chips give the done / remaining / overdue / cancelled
+ * counts of the current view — the numbers the feature exists for. Rows
+ * clearly separate plan states; overdue scheduled plans are highlighted
+ * and every completed plan shows the REAL visit time that completed it.
+ * All mutations go through the admin API; the server re-validates
+ * everything (this UI never assumes trust).
+ */
+
+const STATUS_META: Record<PlanStatus, { label: string; cls: string }> = {
+  scheduled: { label: 'برنامه‌ریزی‌شده', cls: 'bg-teal-600 hover:bg-teal-700' },
+  done: { label: 'انجام‌شده', cls: 'bg-emerald-600 hover:bg-emerald-700' },
+  cancelled: { label: 'لغوشده', cls: 'bg-gray-400 hover:bg-gray-500' },
+  needs_reschedule: { label: 'نیازمند برنامه‌ریزی مجدد', cls: 'bg-amber-500 hover:bg-amber-600' },
+}
+
+const PRIORITY_META: Record<PlanPriority, { label: string; cls: string }> = {
+  low: { label: 'اولویت کم', cls: 'bg-gray-100 text-gray-600' },
+  normal: { label: 'اولویت معمولی', cls: 'bg-sky-100 text-sky-700' },
+  high: { label: 'اولویت مهم', cls: 'bg-rose-100 text-rose-700' },
+}
+
+const CUSTOMER_TYPE_LABEL: Record<string, string> = {
+  doctor: 'پزشک',
+  pharmacy: 'داروخانه',
+  clinic: 'کلینیک',
+  other: 'سایر',
+}
+
+function shiftDay(dayKey: string, days: number): string {
+  const d = new Date(`${dayKey}T12:00:00Z`) // noon-UTC keeps the civil date stable
+  d.setUTCDate(d.getUTCDate() + days)
+  return d.toISOString().slice(0, 10)
+}
+
+function isOverdue(p: PlannedVisit, now: number): boolean {
+  if (p.status !== 'scheduled') return false
+  const end = new Date(p.scheduledAt).getTime() + p.durationMin * 60_000
+  return end < now
+}
+
+interface FormState {
+  employeeId: string
+  customerId: string
+  scheduledAtLocal: string
+  durationMin: string
+  priority: PlanPriority
+  note: string
+}
+
+const EMPTY_FORM: FormState = {
+  employeeId: '',
+  customerId: '',
+  scheduledAtLocal: '',
+  durationMin: '30',
+  priority: 'normal',
+  note: '',
+}
+
+export default function PlansTab({ refreshKey }: { refreshKey: number }) {
+  const { toast } = useToast()
+  const [plans, setPlans] = useState<PlannedVisit[]>([])
+  const [loading, setLoading] = useState(true)
+  const [loadError, setLoadError] = useState<string | null>(null)
+  const [truncated, setTruncated] = useState(false)
+  const [serverToday, setServerToday] = useState<string | null>(null)
+
+  // day view + filters
+  const [dayKey, setDayKey] = useState<string>('') // '' = let the server pick today
+  const [fEmployee, setFEmployee] = useState('all')
+  const [fCustomer, setFCustomer] = useState('all')
+  const [fStatus, setFStatus] = useState<'all' | PlanStatus>('all')
+
+  const [employees, setEmployees] = useState<Employee[]>([])
+  const [customers, setCustomers] = useState<Customer[]>([])
+
+  // dialogs
+  const [formOpen, setFormOpen] = useState(false)
+  const [editing, setEditing] = useState<PlannedVisit | null>(null)
+  const [form, setForm] = useState<FormState>(EMPTY_FORM)
+  const [saving, setSaving] = useState(false)
+  const [reschedPlan, setReschedPlan] = useState<PlannedVisit | null>(null)
+  const [reschedAt, setReschedAt] = useState('')
+  const [cancelPlan, setCancelPlan] = useState<PlannedVisit | null>(null)
+  const [cancelReason, setCancelReason] = useState('')
+
+  const load = useCallback(async () => {
+    setLoading(true)
+    setLoadError(null)
+    try {
+      const params = new URLSearchParams()
+      if (dayKey) params.set('date', dayKey)
+      if (fEmployee !== 'all') params.set('employeeId', fEmployee)
+      if (fCustomer !== 'all') params.set('customerId', fCustomer)
+      if (fStatus !== 'all') params.set('status', fStatus)
+      const res = await fetch(`/api/planned-visits?${params.toString()}`, { cache: 'no-store' })
+      const data = await res.json().catch(() => null)
+      if (!data) throw new Error('پاسخ نامعتبر از سرور')
+      if (!data.ok) throw new Error(data.error || 'خطا در دریافت برنامه‌ها')
+      setPlans(data.plans)
+      setTruncated(!!data.truncated)
+      if (data.window?.dayKey) {
+        setServerToday(data.window.dayKey)
+        if (!dayKey) setDayKey(data.window.dayKey) // first load: adopt the server's today
+      }
+    } catch (e) {
+      setLoadError(e instanceof Error ? e.message : 'خطا در دریافت برنامه‌ها')
+    } finally {
+      setLoading(false)
+    }
+  }, [dayKey, fEmployee, fCustomer, fStatus])
+
+  useEffect(() => {
+    load()
+  }, [load, refreshKey])
+
+  // dropdown data (admin lists — one fetch, cached in state)
+  useEffect(() => {
+    Promise.all([
+      fetch('/api/employees', { cache: 'no-store' }).then((r) => r.json()).catch(() => null),
+      fetch('/api/customers', { cache: 'no-store' }).then((r) => r.json()).catch(() => null),
+    ]).then(([e, c]) => {
+      if (e?.ok) setEmployees(e.employees)
+      if (c?.ok) setCustomers(c.customers)
+    })
+  }, [refreshKey])
+
+  const now = Date.now()
+  const summary = useMemo(() => {
+    const s = { total: plans.length, done: 0, remaining: 0, overdue: 0, cancelled: 0, needsResched: 0 }
+    for (const p of plans) {
+      if (p.status === 'done') s.done++
+      else if (p.status === 'cancelled') s.cancelled++
+      else if (p.status === 'needs_reschedule') s.needsResched++
+      else {
+        s.remaining++
+        if (isOverdue(p, now)) s.overdue++
+      }
+    }
+    return s
+  }, [plans, now])
+
+  function openCreate() {
+    const active = employees.filter((e) => e.active)
+    setEditing(null)
+    const hh = String(new Date().getHours()).padStart(2, '0')
+    const mm = String(new Date().getMinutes()).padStart(2, '0')
+    setForm({
+      ...EMPTY_FORM,
+      employeeId: active.length === 1 ? active[0].id : '',
+      scheduledAtLocal: `${dayKey || serverToday || ''}T${hh}:${mm}`,
+      durationMin: '30',
+      priority: 'normal',
+    })
+    setFormOpen(true)
+  }
+
+  function openEdit(p: PlannedVisit) {
+    setEditing(p)
+    setForm({
+      employeeId: p.employeeId,
+      customerId: p.customerId,
+      scheduledAtLocal: p.scheduledAtLocal || p.scheduledAt.slice(0, 16),
+      durationMin: String(p.durationMin),
+      priority: p.priority,
+      note: p.note || '',
+    })
+    setFormOpen(true)
+  }
+
+  function selectedEmployeeAssigned(): boolean | null {
+    if (!form.employeeId || !form.customerId) return null
+    const emp = employees.find((e) => e.id === form.employeeId)
+    return !!emp?.assignments?.some((a) => a.customer.id === form.customerId)
+  }
+
+  async function saveForm() {
+    if (!form.employeeId || !form.customerId || !form.scheduledAtLocal) {
+      toast({ title: 'خطا', description: 'کارمند، مشتری و زمان برنامه لازم است', variant: 'destructive' })
+      return
+    }
+    setSaving(true)
+    try {
+      const payload = {
+        employeeId: form.employeeId,
+        customerId: form.customerId,
+        scheduledAt: form.scheduledAtLocal, // server-local naive — parsed server-side
+        durationMin: Number(form.durationMin) || 30,
+        priority: form.priority,
+        note: form.note.trim() || null,
+      }
+      const res = await fetch(editing ? `/api/planned-visits/${editing.id}` : '/api/planned-visits', {
+        method: editing ? 'PUT' : 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify(payload),
+      })
+      const data = await res.json().catch(() => null)
+      if (data?.ok) {
+        setFormOpen(false)
+        toast({ title: editing ? 'برنامه ویرایش شد' : 'برنامه ثبت شد' })
+        // keep the view on the plan's new day after an edit/reschedule
+        if (data.plan?.scheduledAtLocal) setDayKey(data.plan.scheduledAtLocal.slice(0, 10))
+        await load()
+      } else {
+        toast({ title: 'خطا', description: data?.error || 'ثبت برنامه ممکن نشد', variant: 'destructive' })
+      }
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  async function saveReschedule() {
+    if (!reschedPlan || !reschedAt) return
+    setSaving(true)
+    try {
+      const res = await fetch(`/api/planned-visits/${reschedPlan.id}/reschedule`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ scheduledAt: reschedAt }),
+      })
+      const data = await res.json().catch(() => null)
+      if (data?.ok) {
+        setReschedPlan(null)
+        toast({ title: 'برنامه به زمان جدید منتقل شد' })
+        if (data.plan?.scheduledAtLocal) setDayKey(data.plan.scheduledAtLocal.slice(0, 10))
+        await load()
+      } else {
+        toast({ title: 'خطا', description: data?.error || 'برنامه‌ریزی مجدد ممکن نشد', variant: 'destructive' })
+      }
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  async function saveCancel() {
+    if (!cancelPlan) return
+    setSaving(true)
+    try {
+      const res = await fetch(`/api/planned-visits/${cancelPlan.id}/cancel`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ reason: cancelReason.trim() || undefined }),
+      })
+      const data = await res.json().catch(() => null)
+      if (data?.ok) {
+        setCancelPlan(null)
+        setCancelReason('')
+        toast({ title: 'برنامه لغو شد' })
+        await load()
+      } else {
+        toast({ title: 'خطا', description: data?.error || 'لغو برنامه ممکن نشد', variant: 'destructive' })
+      }
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  const activeEmployees = employees.filter((e) => e.active)
+  const jalaliLabel = dayKey ? faDate(`${dayKey}T12:00:00Z`) : ''
+  const isToday = !!serverToday && dayKey === serverToday
+
+  return (
+    <div className="space-y-4">
+      {/* ── day navigation + filters ── */}
+      <div className="flex flex-wrap items-center gap-2">
+        <div className="flex items-center gap-1">
+          <Button
+            variant="outline"
+            size="icon"
+            title="روز قبل"
+            disabled={!dayKey}
+            onClick={() => setDayKey(shiftDay(dayKey, -1))}
+          >
+            <ChevronRight className="h-4 w-4" />
+          </Button>
+          <Input
+            dir="ltr"
+            type="date"
+            className="w-[150px] text-left"
+            value={dayKey}
+            onChange={(e) => e.target.value && setDayKey(e.target.value)}
+          />
+          <Button
+            variant="outline"
+            size="icon"
+            title="روز بعد"
+            disabled={!dayKey}
+            onClick={() => setDayKey(shiftDay(dayKey, 1))}
+          >
+            <ChevronLeft className="h-4 w-4" />
+          </Button>
+          <Button variant="outline" size="sm" onClick={() => setDayKey(serverToday || dayKey)}>
+            امروز
+          </Button>
+        </div>
+        <div className="text-sm font-medium text-muted-foreground">
+          {jalaliLabel}
+          {isToday && <span className="mr-1 text-teal-600">(امروز)</span>}
+        </div>
+
+        <div className="flex flex-wrap items-center gap-2 mr-auto">
+          <Select value={fEmployee} onValueChange={setFEmployee}>
+            <SelectTrigger className="w-[150px]">
+              <SelectValue placeholder="کارمند" />
+            </SelectTrigger>
+            <SelectContent>
+              <SelectItem value="all">همهٔ کارمندان</SelectItem>
+              {employees.map((e) => (
+                <SelectItem key={e.id} value={e.id}>
+                  {e.name}
+                </SelectItem>
+              ))}
+            </SelectContent>
+          </Select>
+          <Select value={fCustomer} onValueChange={setFCustomer}>
+            <SelectTrigger className="w-[150px]">
+              <SelectValue placeholder="مشتری" />
+            </SelectTrigger>
+            <SelectContent>
+              <SelectItem value="all">همهٔ مشتریان</SelectItem>
+              {customers.map((c) => (
+                <SelectItem key={c.id} value={c.id}>
+                  {c.name}
+                </SelectItem>
+              ))}
+            </SelectContent>
+          </Select>
+          <Select value={fStatus} onValueChange={(v) => setFStatus(v as 'all' | PlanStatus)}>
+            <SelectTrigger className="w-[160px]">
+              <SelectValue placeholder="وضعیت" />
+            </SelectTrigger>
+            <SelectContent>
+              <SelectItem value="all">همهٔ وضعیت‌ها</SelectItem>
+              <SelectItem value="scheduled">برنامه‌ریزی‌شده</SelectItem>
+              <SelectItem value="done">انجام‌شده</SelectItem>
+              <SelectItem value="cancelled">لغوشده</SelectItem>
+              <SelectItem value="needs_reschedule">نیازمند برنامه‌ریزی مجدد</SelectItem>
+            </SelectContent>
+          </Select>
+          <Button variant="outline" size="sm" onClick={load} disabled={loading}>
+            <RefreshCw className={`h-4 w-4 ${loading ? 'animate-spin' : ''}`} />
+            به‌روزرسانی
+          </Button>
+          <Button size="sm" className="bg-teal-600 hover:bg-teal-700" onClick={openCreate}>
+            <CalendarPlus className="h-4 w-4" />
+            برنامهٔ جدید
+          </Button>
+        </div>
+      </div>
+
+      {/* ── day summary (plain numbers — no decorative charts) ── */}
+      <div className="flex flex-wrap items-center gap-x-4 gap-y-1 rounded-xl border bg-muted/30 px-4 py-2 text-sm">
+        <span className="font-medium">{summary.total.toLocaleString('fa-IR')} برنامه</span>
+        <span className="text-emerald-700">انجام‌شده: {summary.done.toLocaleString('fa-IR')}</span>
+        <span className="text-teal-700">باقی‌مانده: {summary.remaining.toLocaleString('fa-IR')}</span>
+        <span className={summary.overdue > 0 ? 'font-medium text-rose-700' : 'text-muted-foreground'}>
+          عقب‌افتاده: {summary.overdue.toLocaleString('fa-IR')}
+        </span>
+        <span className="text-amber-700">نیازمند برنامه‌ریزی مجدد: {summary.needsResched.toLocaleString('fa-IR')}</span>
+        <span className="text-muted-foreground">لغوشده: {summary.cancelled.toLocaleString('fa-IR')}</span>
+        {truncated && (
+          <span className="text-rose-700">(نمایش ۵۰۰ برنامهٔ اول — برای دیدن همه، فیلتر دقیق‌تری بزنید)</span>
+        )}
+      </div>
+
+      {loadError && (
+        <div className="rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-800">
+          <p className="font-medium">خطا در بارگذاری برنامه‌ها:</p>
+          <p className="mt-1">{loadError}</p>
+        </div>
+      )}
+
+      {/* ── plans list ── */}
+      <ScrollArea className="h-[56vh] rounded-xl border">
+        <div className="divide-y mp-scroll">
