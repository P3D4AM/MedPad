diff -ruN orig/src/instrumentation.ts b/src/instrumentation.ts
--- orig/src/instrumentation.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/instrumentation.ts	2026-10-26 09:51:04.000000000 +0000
@@ -0,0 +1,97 @@
+/**
+ * phase 1 / task 2 — runtime database migration (Next.js instrumentation).
+ *
+ * MedPad ships a prebuilt standalone bundle; existing installs keep their
+ * SQLite database (panel/db/custom.db) across updates. New columns are
+ * therefore added with idempotent `ALTER TABLE ... ADD COLUMN` statements
+ * here, executed ONCE at server boot before any request is handled.
+ * Fresh installs get the full schema from db/template.db (regenerated from
+ * prisma/schema.prisma at build time), so the ALTERs are no-ops there.
+ *
+ * Every statement is wrapped in try/catch: "duplicate column name" (or
+ * "table already exists") means the migration already ran — anything else
+ * is logged loudly and the boot CONTINUES only when the missing column is
+ * non-critical... no: a failed ALTER means the new code will hit "no such
+ * column" at query time, so failures are logged as FATAL warnings. They
+ * are not thrown to avoid bricking an otherwise-working panel; the
+ * operator sees the message and can restore a backup or re-run install.
+ *
+ * G-2: AppToken.expiresAt / AppToken.revokedAt
+ * (later findings append their statements below — see git history)
+ *
+ * phase 2 / task 1: PlannedVisit table (planned field visits). A brand-new
+ * table — `CREATE TABLE IF NOT EXISTS` is fully idempotent and touches NO
+ * existing table (the plan→visit FK lives ON PlannedVisit, so Visit gets no
+ * new column). The DDL below is byte-identical to what `prisma db push`
+ * generates from prisma/schema.prisma (verified against a probe database at
+ * build time) so fresh installs (template.db) and upgraded installs end up
+ * with the exact same table. The unique index on visitId enforces the 1:1
+ * plan↔visit link at the database level even under concurrent check-ins.
+ */
+
+const MIGRATIONS: string[] = [
+  // G-2 — token expiry + revocation
+  'ALTER TABLE "AppToken" ADD COLUMN "expiresAt" DATETIME',
+  'ALTER TABLE "AppToken" ADD COLUMN "revokedAt" DATETIME',
+  // G-6 — GPS validation columns (nullable / defaulted -> safe on old rows:
+  // legacy rows keep their stored coordinates; locationMissing defaults to
+  // false which correctly describes them — they were recorded as located)
+  'ALTER TABLE "Checkin" ADD COLUMN "accuracy" REAL',
+  'ALTER TABLE "Checkin" ADD COLUMN "distanceM" REAL',
+  'ALTER TABLE "Checkin" ADD COLUMN "outOfRadius" BOOLEAN NOT NULL DEFAULT 0',
+  'ALTER TABLE "Checkin" ADD COLUMN "locationMissing" BOOLEAN NOT NULL DEFAULT 0',
+]
+
+// G-3 — admin audit trail (new table; Prisma column layout, DateTime =
+// epoch-ms INTEGER like every other MedPad table)
+const AUDIT_TABLE_DDL = `CREATE TABLE IF NOT EXISTS "AuditLog" (
+  "id" TEXT NOT NULL PRIMARY KEY,
+  "actorType" TEXT NOT NULL DEFAULT 'admin',
+  "actorId" TEXT NOT NULL,
+  "action" TEXT NOT NULL,
+  "targetType" TEXT,
+  "targetId" TEXT,
+  "detail" TEXT,
+  "outcome" TEXT NOT NULL DEFAULT 'success',
+  "createdAt" DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
+)`
+
+// phase 2 / task 1 — planned visits (new table; layout = prisma db push output)
+const PLANNED_VISIT_DDL = `CREATE TABLE IF NOT EXISTS "PlannedVisit" (
+  "id" TEXT NOT NULL PRIMARY KEY,
+  "employeeId" TEXT NOT NULL,
+  "customerId" TEXT NOT NULL,
+  "scheduledAt" DATETIME NOT NULL,
+  "durationMin" INTEGER NOT NULL DEFAULT 30,
+  "priority" TEXT NOT NULL DEFAULT 'normal',
+  "status" TEXT NOT NULL DEFAULT 'scheduled',
+  "note" TEXT,
+  "visitId" TEXT,
+  "createdById" TEXT,
+  "createdAt" DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  "updatedAt" DATETIME NOT NULL,
+  CONSTRAINT "PlannedVisit_employeeId_fkey" FOREIGN KEY ("employeeId") REFERENCES "Employee" ("id") ON DELETE RESTRICT ON UPDATE CASCADE,
+  CONSTRAINT "PlannedVisit_customerId_fkey" FOREIGN KEY ("customerId") REFERENCES "Customer" ("id") ON DELETE RESTRICT ON UPDATE CASCADE,
+  CONSTRAINT "PlannedVisit_visitId_fkey" FOREIGN KEY ("visitId") REFERENCES "Visit" ("id") ON DELETE SET NULL ON UPDATE CASCADE
+)`
+const PLANNED_VISIT_INDEX_DDL =
+  'CREATE UNIQUE INDEX IF NOT EXISTS "PlannedVisit_visitId_key" ON "PlannedVisit"("visitId")'
+
+export async function register() {
+  if (process.env.NEXT_RUNTIME !== 'nodejs') return
+  const { PrismaClient } = await import('@prisma/client')
+  const db = new PrismaClient()
+  let applied = 0
+  for (const sql of [...MIGRATIONS, AUDIT_TABLE_DDL, PLANNED_VISIT_DDL, PLANNED_VISIT_INDEX_DDL]) {
+    try {
+      await db.$executeRawUnsafe(sql)
+      applied++
+    } catch (e) {
+      const msg = e instanceof Error ? e.message : String(e)
+      if (/duplicate column name|already exists/i.test(msg)) continue // already migrated
+      console.error(`[medpad][migrate] FAILED: ${sql} -> ${msg}`)
+    }
+  }
+  await db.$disconnect()
+  if (applied > 0) console.log(`[medpad][migrate] applied ${applied} migration statement(s)`)
+}
diff -ruN orig/src/lib/audit.ts b/src/lib/audit.ts
--- orig/src/lib/audit.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/audit.ts	2026-10-26 08:16:01.000000000 +0000
@@ -0,0 +1,42 @@
+import { db } from '@/lib/db'
+import { getConfig } from '@/lib/auth'
+
+/**
+ * phase 1 / task 2 (G-3): administrative audit trail.
+ *
+ * Records WHO (the panel's single admin account — Config.adminUser), WHAT
+ * (action), on WHICH target, WHEN and with which outcome. `detail` is a
+ * short human-readable summary; it must NEVER contain passwords, token
+ * values or other secrets (tests assert this).
+ *
+ * Audit writes are best-effort by design: a failing audit row must not
+ * abort the security operation itself — but the failure is logged loudly
+ * to the server console so an operator notices.
+ */
+
+export interface AuditInput {
+  action: string
+  targetType?: string
+  targetId?: string
+  detail?: string
+  outcome?: 'success' | 'failure'
+}
+
+export async function writeAudit(input: AuditInput): Promise<void> {
+  try {
+    const actorId = await getConfig('adminUser', 'admin')
+    await db.auditLog.create({
+      data: {
+        actorType: 'admin',
+        actorId,
+        action: input.action,
+        targetType: input.targetType ?? null,
+        targetId: input.targetId ?? null,
+        detail: input.detail ?? null,
+        outcome: input.outcome ?? 'success',
+      },
+    })
+  } catch (e) {
+    console.error('[medpad][audit] failed to write audit row:', input.action, e)
+  }
+}
diff -ruN orig/src/lib/gps.ts b/src/lib/gps.ts
--- orig/src/lib/gps.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/gps.ts	2026-10-26 08:25:41.000000000 +0000
@@ -0,0 +1,49 @@
+import { isValidLatLng } from '@/lib/geo'
+import { getAdminSettings } from '@/lib/settings'
+
+/**
+ * phase 1 / task 2 (G-6): server-side GPS validation.
+ *
+ * Contract:
+ *  - lat/lng in the database are ONLY ever real device coordinates. When no
+ *    trustworthy fix exists they are NULL and locationMissing=true. The
+ *    customer's coordinates are NEVER substituted for the employee's GPS.
+ *  - accuracy (meters, optional) is kept separate from the distance policy.
+ *    Structurally impossible values (<= 0, non-finite, > 100000 m) always
+ *    make the location untrustworthy. When the admin sets a tolerance
+ *    (gpsMaxAccuracyM > 0), reported accuracy above it also discards the fix.
+ *  - Spoofing caveat: coordinate STRUCTURE is validated, physical presence
+ *    is NOT proven — a rooted device can emit arbitrary coordinates. This
+ *    is documented as an inherent limitation of client-provided GPS.
+ */
+
+const IMPOSSIBLE_ACCURACY_M = 100_000
+
+export interface ResolvedLocation {
+  lat: number | null
+  lng: number | null
+  accuracy: number | null
+  locationMissing: boolean
+}
+
+export async function resolveGpsLocation(
+  latRaw: number,
+  lngRaw: number,
+  accuracyRaw: number,
+): Promise<ResolvedLocation> {
+  const { gpsMaxAccuracyM } = await getAdminSettings()
+  const hasAccuracy = Number.isFinite(accuracyRaw)
+  const accuracyImpossible = hasAccuracy && (accuracyRaw <= 0 || accuracyRaw > IMPOSSIBLE_ACCURACY_M)
+  const accuracyOverTolerance = gpsMaxAccuracyM > 0 && hasAccuracy && accuracyRaw > gpsMaxAccuracyM
+
+  if (isValidLatLng(latRaw, lngRaw) && !accuracyImpossible && !accuracyOverTolerance) {
+    return {
+      lat: latRaw,
+      lng: lngRaw,
+      accuracy: hasAccuracy ? accuracyRaw : null,
+      locationMissing: false,
+    }
+  }
+  // no trustworthy fix -> explicitly missing, never fabricated
+  return { lat: null, lng: null, accuracy: null, locationMissing: true }
+}
diff -ruN orig/src/lib/planned-visit.ts b/src/lib/planned-visit.ts
--- orig/src/lib/planned-visit.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/lib/planned-visit.ts	2026-10-26 09:56:03.000000000 +0000
@@ -0,0 +1,223 @@
+import { db } from '@/lib/db'
+
+/**
+ * phase 2 / task 1 — planned field visits: shared constants + server-side
+ * validation. Every write path (create / edit / cancel / reschedule) and the
+ * automatic check-in linkage goes through this module so the rules exist in
+ * exactly ONE place — the API routes stay thin and cannot drift apart.
+ *
+ * STATUS MODEL (fixed, validated — no free-text):
+ *   scheduled        the plan is on the calendar
+ *   needs_reschedule admin marked it as needing a new time (not done, not lost)
+ *   done             a REAL visit was linked by the server on check-in.
+ *                    Only the server sets 'done' — an admin can never
+ *                    hand-mark a plan done, so the done-count always equals
+ *                    real, linked visits (the whole point of the feature).
+ *   cancelled        terminal; never counted as done.
+ *
+ * RESCHEDULE = the SAME row gets a new scheduledAt (identity + future visit
+ * link survive); CANCEL = terminal state. A rescheduled or cancelled plan is
+ * therefore never mistaken for a completed visit.
+ */
+
+export const PLAN_STATUSES = ['scheduled', 'done', 'cancelled', 'needs_reschedule'] as const
+export const PLAN_PRIORITIES = ['low', 'normal', 'high'] as const
+export type PlanStatus = (typeof PLAN_STATUSES)[number]
+export type PlanPriority = (typeof PLAN_PRIORITIES)[number]
+
+/** Statuses an admin may still act on (edit / cancel / reschedule). */
+export const PLAN_OPEN_STATUSES: PlanStatus[] = ['scheduled', 'needs_reschedule']
+
+/** The only transitions an admin may request through PUT {status}. */
+export const PLAN_PUT_STATUSES: PlanStatus[] = ['scheduled', 'needs_reschedule']
+
+export const PLAN_DEFAULT_DURATION_MIN = 30
+export const PLAN_MIN_DURATION_MIN = 5
+export const PLAN_MAX_DURATION_MIN = 480
+export const PLAN_NOTE_MAX = 1000
+
+/** scheduledAt sanity window: plans may be backfilled up to 365 days into the
+ *  past and created up to 730 days ahead. Anything outside is rejected as a
+ *  likely input error ( protects the day-view grouping from garbage dates). */
+export const PLAN_PAST_MS = 365 * 24 * 3600 * 1000
+export const PLAN_FUTURE_MS = 730 * 24 * 3600 * 1000
+
+/** List hard cap — protects the panel from unbounded responses; a real
+ *  deployment never approaches this for a day/range view. */
+export const PLAN_LIST_LIMIT = 500
+
+export interface PlanWriteInput {
+  employeeId?: string
+  customerId?: string
+  scheduledAt?: string
+  durationMin?: number
+  priority?: string
+  note?: string | null
+}
+
+export interface ValidatedPlanFields {
+  employeeId: string
+  customerId: string
+  scheduledAt: Date
+  durationMin: number
+  priority: PlanPriority
+  note: string | null
+}
+
+/** Parse + range-check an ISO 8601 timestamp. Returns null when invalid. */
+export function parsePlanDate(raw: unknown): Date | null {
+  if (typeof raw !== 'string' || !raw.trim()) return null
+  const d = new Date(raw.trim())
+  if (isNaN(d.getTime())) return null
+  return d
+}
+
+/** Validate a plan payload fragment. Returns { error } (Persian, ready for
+ *  the API response) or { fields } with ONLY the keys that were provided. */
+export async function validatePlanInput(
+  body: PlanWriteInput | null,
+  opts: { requireAll: boolean },
+): Promise<{ error?: string; fields?: Partial<ValidatedPlanFields> }> {
+  const f: Partial<ValidatedPlanFields> = {}
+
+  if (body?.employeeId !== undefined || opts.requireAll) {
+    const id = String(body?.employeeId ?? '')
+    if (!id) return { error: 'کارمند انتخاب نشده است' }
+    const emp = await db.employee.findUnique({ where: { id }, select: { id: true, active: true, name: true } })
+    if (!emp) return { error: 'کارمند پیدا نشد' }
+    if (!emp.active) return { error: 'این کارمند غیرفعال است — ابتدا او را فعال کنید' }
+    f.employeeId = emp.id
+  }
+
+  if (body?.customerId !== undefined || opts.requireAll) {
+    const id = String(body?.customerId ?? '')
+    if (!id) return { error: 'مشتری انتخاب نشده است' }
+    const cust = await db.customer.findUnique({ where: { id }, select: { id: true, name: true } })
+    if (!cust) return { error: 'مشتری پیدا نشد' }
+    f.customerId = cust.id
+  }
+
+  if (body?.scheduledAt !== undefined || opts.requireAll) {
+    const d = parsePlanDate(body?.scheduledAt)
+    if (!d) return { error: 'تاریخ و ساعت برنامه نامعتبر است (ISO 8601)' }
+    const now = Date.now()
+    if (d.getTime() < now - PLAN_PAST_MS) return { error: 'تاریخ برنامه بیش از یک سال در گذشته است' }
+    if (d.getTime() > now + PLAN_FUTURE_MS) return { error: 'تاریخ برنامه بیش از دو سال در آینده است' }
+    f.scheduledAt = d
+  }
+
+  if (body?.durationMin !== undefined) {
+    const n = Number(body.durationMin)
+    if (!Number.isFinite(n) || Math.trunc(n) !== n || n < PLAN_MIN_DURATION_MIN || n > PLAN_MAX_DURATION_MIN) {
+      return { error: `مدت بازدید باید عددی صحیح بین ${PLAN_MIN_DURATION_MIN} و ${PLAN_MAX_DURATION_MIN} دقیقه باشد` }
+    }
+    f.durationMin = n
+  } else if (opts.requireAll) {
+    f.durationMin = PLAN_DEFAULT_DURATION_MIN
+  }
+
+  if (body?.priority !== undefined) {
+    if (!PLAN_PRIORITIES.includes(body.priority as PlanPriority)) {
+      return { error: 'اولویت باید یکی از مقادیر کم / معمولی / مهم باشد' }
+    }
+    f.priority = body.priority as PlanPriority
+  } else if (opts.requireAll) {
+    f.priority = 'normal'
+  }
+
+  if (body?.note !== undefined) {
+    const note = typeof body.note === 'string' ? body.note.trim() : ''
+    if (note.length > PLAN_NOTE_MAX) {
+      return { error: `توضیحات حداکثر می‌تواند ${PLAN_NOTE_MAX} نویسه باشد` }
+    }
+    f.note = note || null
+  }
+
+  return { fields: f }
+}
+
+/** True when an existing 'scheduled' plan already covers the exact same
+ *  employee + customer + timestamp (double-click / duplicate submit guard). */
+export async function isDuplicatePlan(
+  employeeId: string,
+  customerId: string,
+  scheduledAt: Date,
+  excludeId?: string,
+): Promise<boolean> {
+  const dup = await db.plannedVisit.findFirst({
+    where: {
+      employeeId,
+      customerId,
+      scheduledAt,
+      status: 'scheduled',
+      ...(excludeId ? { id: { not: excludeId } } : {}),
+    },
+    select: { id: true },
+  })
+  return !!dup
+}
+
+/** Server-local-day range [start, end) around a moment. Day grouping follows
+ *  the SERVER's local timezone — the same clock MedPad already trusts for the
+ *  clientAt health window and every timestamp it stores. */
+export function localDayRange(at: Date): { start: Date; end: Date } {
+  const start = new Date(at)
+  start.setHours(0, 0, 0, 0)
+  const end = new Date(start)
+  end.setDate(end.getDate() + 1)
+  return { start, end }
+}
+
+/** Parse a YYYY-MM-DD string into a server-local day range. Null when the
+ *  string is not a real calendar date. */
+export function parseDayParam(raw: string | null): { start: Date; end: Date } | null {
+  if (!raw) return null
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(raw)) return null
+  const [y, m, d] = raw.split('-').map(Number)
+  const start = new Date(y, m - 1, d, 0, 0, 0, 0)
+  // reject e.g. 2026-02-31 (Date auto-rolls it)
+  if (start.getFullYear() !== y || start.getMonth() !== m - 1 || start.getDate() !== d) return null
+  const end = new Date(start)
+  end.setDate(end.getDate() + 1)
+  return { start, end }
+}
+
+/** Prisma select shared by list + detail so responses stay uniform. */
+export const PLAN_SELECT = {
+  id: true,
+  employeeId: true,
+  customerId: true,
+  scheduledAt: true,
+  durationMin: true,
+  priority: true,
+  status: true,
+  note: true,
+  visitId: true,
+  createdById: true,
+  createdAt: true,
+  updatedAt: true,
+  employee: { select: { id: true, name: true, username: true, active: true } },
+  customer: { select: { id: true, name: true, type: true } },
+  visit: { select: { id: true, startAt: true, endAt: true, open: true } },
+} as const
+
+/** Server-local "YYYY-MM-DDTHH:mm" mirror of scheduledAt — the exact format a
+ *  <input type="datetime-local"> expects and the exact format the server
+ *  parses back. Returning it precomputed keeps the BROWSER entirely out of
+ *  timezone arithmetic (the panel may run on a machine with a different
+ *  timezone than the server; plan times are defined in SERVER-local time,
+ *  consistent with the day grouping and the clientAt policy). */
+export function withScheduledAtLocal<T extends { scheduledAt: Date }>(plan: T): T & { scheduledAtLocal: string } {
+  const p = (n: number) => String(n).padStart(2, '0')
+  const d = plan.scheduledAt
+  return {
+    ...plan,
+    scheduledAtLocal: `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`,
+  }
+}
+
+/** Server-local "YYYY-MM-DD" of a moment (the API's canonical day key). */
+export function localDayKey(d: Date): string {
+  const p = (n: number) => String(n).padStart(2, '0')
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`
+}
