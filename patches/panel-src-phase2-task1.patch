+++ b/src/app/api/employees/[id]/tokens/route.ts	2026-10-26 08:05:29.000000000 +0000
@@ -0,0 +1,33 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+
+/**
+ * phase 1 / task 2 (G-2): list an employee's app tokens (admin only).
+ * The token SECRET is never included in the response — only metadata.
+ */
+export async function GET(_req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const emp = await db.employee.findUnique({ where: { id }, select: { id: true } })
+  if (!emp) return NextResponse.json({ ok: false, error: 'پیدا نشد' }, { status: 404 })
+  const tokens = await db.appToken.findMany({
+    where: { employeeId: id },
+    select: {
+      id: true,
+      createdAt: true,
+      lastUsedAt: true,
+      expiresAt: true,
+      revokedAt: true,
+    },
+    orderBy: { createdAt: 'desc' },
+    take: 200,
+  })
+  const now = Date.now()
+  const active = tokens.filter(
+    (t) => !t.revokedAt && (t.expiresAt === null || t.expiresAt.getTime() > now),
+  ).length
+  return NextResponse.json({ ok: true, tokens, active })
+}
