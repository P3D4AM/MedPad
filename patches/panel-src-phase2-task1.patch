@@ -0,0 +1,28 @@
+import { NextResponse } from 'next/server'
+import { ADMIN_COOKIE, isAdmin, setConfig } from '@/lib/auth'
+
+/**
+ * phase 1 / task 2 (G-5): log out ALL administrator sessions.
+ *
+ * Requires a valid admin session (identity + role + session validity are
+ * verified server-side by isAdmin()). Unauthenticated or non-admin callers
+ * get 401 — nobody can force the administrator out from outside.
+ *
+ * Single-session architecture: Config.adminSession holds THE one valid
+ * admin token, so "all sessions" = clearing that slot. The endpoint is
+ * kept separate from /api/logout (scope: 'current') so the two operations
+ * have clearly defined, independently testable scopes and the distinction
+ * survives a future multi-session/multi-admin extension unchanged.
+ * No untrusted request parameter can select another administrator's
+ * identity or session — the target is always the caller's own session
+ * storage.
+ */
+export async function POST(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  await setConfig('adminSession', '')
+  const res = NextResponse.json({ ok: true, scope: 'all' })
+  res.cookies.set(ADMIN_COOKIE, '', { httpOnly: true, path: '/', maxAge: 0 })
+  return res
+}
diff -ruN orig/src/app/api/planned-visits/[id]/cancel/route.ts b/src/app/api/planned-visits/[id]/cancel/route.ts
--- orig/src/app/api/planned-visits/[id]/cancel/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/planned-visits/[id]/cancel/route.ts	2026-10-26 09:56:23.000000000 +0000
@@ -0,0 +1,74 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+import { PLAN_OPEN_STATUSES, PLAN_SELECT, withScheduledAtLocal } from '@/lib/planned-visit'
+
+/**
+ * phase 2 / task 1 — cancel a planned visit (admin panel).
+ *
+ * POST /api/planned-visits/[id]/cancel   body: { reason?: string }
+ *
+ * Cancel is TERMINAL: a cancelled plan can never be edited, rescheduled or
+ * completed afterwards — and it is never counted as a done visit. Allowed
+ * only while the plan is still open ('scheduled' | 'needs_reschedule');
+ * cancelling a 'done' plan is refused (the visit really happened — the
+ * record must stay). The optional Persian reason is APPENDED to the plan's
+ * note (visible in the UI, never silently overwriting it) and recorded in
+ * the audit trail.
+ *
+ * Race safety: the transition runs as one conditional updateMany — a
+ * concurrent reschedule/cancel that wins first makes this one return 409.
+ */
+export async function POST(req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const body = await req.json().catch(() => null) as { reason?: string } | null
+
+  const existing = await db.plannedVisit.findUnique({ where: { id }, select: PLAN_SELECT })
+  if (!existing) return NextResponse.json({ ok: false, error: 'پیدا نشد' }, { status: 404 })
+
+  if (!PLAN_OPEN_STATUSES.includes(existing.status as (typeof PLAN_OPEN_STATUSES)[number])) {
+    return NextResponse.json(
+      {
+        ok: false,
+        error:
+          existing.status === 'done'
+            ? 'این برنامه انجام شده است و قابل لغو نیست — بازدید واقعی ثبت شده است'
+            : 'این برنامه قبلاً لغو شده است',
+      },
+      { status: 409 },
+    )
+  }
+
+  const reason = (body?.reason || '').trim().slice(0, 500)
+  const note = reason
+    ? existing.note
+      ? `${existing.note}\nدلیل لغو: ${reason}`
+      : `دلیل لغو: ${reason}`
+    : existing.note
+
+  const res = await db.plannedVisit.updateMany({
+    where: { id, status: { in: PLAN_OPEN_STATUSES } }, // atomic re-check
+    data: { status: 'cancelled', note },
+  })
+  if (res.count === 0) {
+    return NextResponse.json(
+      { ok: false, error: 'وضعیت برنامه هم‌اکنون تغییر کرده است — دوباره بارگذاری کنید' },
+      { status: 409 },
+    )
+  }
+
+  const planRow = await db.plannedVisit.findUnique({ where: { id }, select: PLAN_SELECT })
+  const plan = planRow ? withScheduledAtLocal(planRow) : null
+  await writeAudit({
+    action: 'plannedvisit.cancel',
+    targetType: 'PlannedVisit',
+    targetId: id,
+    detail: `لغو برنامهٔ ${plan?.employee.name ?? ''} → ${plan?.customer.name ?? ''}${reason ? ` — دلیل: ${reason}` : ''}`,
+  })
+
+  return NextResponse.json({ ok: true, plan })
+}
diff -ruN orig/src/app/api/planned-visits/[id]/reschedule/route.ts b/src/app/api/planned-visits/[id]/reschedule/route.ts
--- orig/src/app/api/planned-visits/[id]/reschedule/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/planned-visits/[id]/reschedule/route.ts	2026-10-26 09:56:23.000000000 +0000
@@ -0,0 +1,104 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+import {
+  PLAN_OPEN_STATUSES,
+  PLAN_SELECT,
+  isDuplicatePlan,
+  validatePlanInput,
+  withScheduledAtLocal,
+} from '@/lib/planned-visit'
+
+/**
+ * phase 2 / task 1 — reschedule a planned visit (admin panel).
+ *
+ * POST /api/planned-visits/[id]/reschedule
+ *   body: { scheduledAt: ISO-8601 (required), durationMin?, note? }
+ *
+ * Rescheduling keeps the SAME row (the plan keeps its identity, its audit
+ * trail and any future visit link) and moves it to a new time. The status
+ * always returns to 'scheduled' — including from 'needs_reschedule', which
+ * is exactly the workflow that flag exists for. Done/cancelled plans are
+ * refused: they are history, a NEW plan must be created instead. A
+ * rescheduled plan is never counted as done by itself.
+ *
+ * Race safety: conditional updateMany re-checks the open statuses atomically;
+ * the duplicate guard rejects colliding with another scheduled plan at the
+ * same exact employee+customer+time.
+ */
+export async function POST(req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const body = await req.json().catch(() => null) as {
+    scheduledAt?: string
+    durationMin?: number
+    note?: string
+  } | null
+
+  const existing = await db.plannedVisit.findUnique({ where: { id }, select: PLAN_SELECT })
+  if (!existing) return NextResponse.json({ ok: false, error: 'پیدا نشد' }, { status: 404 })
+
+  if (!PLAN_OPEN_STATUSES.includes(existing.status as (typeof PLAN_OPEN_STATUSES)[number])) {
+    return NextResponse.json(
+      {
+        ok: false,
+        error:
+          existing.status === 'done'
+            ? 'این برنامه انجام شده است — برای زمان جدید برنامهٔ جدید بسازید'
+            : 'این برنامه لغو شده است — برای زمان جدید برنامهٔ جدید بسازید',
+      },
+      { status: 409 },
+    )
+  }
+
+  if (!body?.scheduledAt) {
+    return NextResponse.json({ ok: false, error: 'زمان جدید برنامه لازم است' }, { status: 400 })
+  }
+
+  // reuse the shared validator: parses + range-checks the new timestamp,
+  // validates optional durationMin / note
+  const { error, fields } = await validatePlanInput(
+    { scheduledAt: body.scheduledAt, durationMin: body.durationMin, note: body.note },
+    { requireAll: false },
+  )
+  if (error || !fields?.scheduledAt) {
+    return NextResponse.json({ ok: false, error: error || 'زمان جدید برنامه نامعتبر است' }, { status: 400 })
+  }
+  const newTime = fields.scheduledAt
+
+  if (await isDuplicatePlan(existing.employeeId, existing.customerId, newTime, id)) {
+    return NextResponse.json(
+      { ok: false, error: 'برنامهٔ یکسان (کارمند، مشتری و زمان) از قبل برای این زمان ثبت شده است' },
+      { status: 409 },
+    )
+  }
+
+  const data: Record<string, unknown> = { scheduledAt: newTime, status: 'scheduled' }
+  if (fields.durationMin !== undefined) data.durationMin = fields.durationMin
+  if (fields.note !== undefined) data.note = fields.note
+
+  const res = await db.plannedVisit.updateMany({
+    where: { id, status: { in: PLAN_OPEN_STATUSES } }, // atomic re-check
+    data,
+  })
+  if (res.count === 0) {
+    return NextResponse.json(
+      { ok: false, error: 'وضعیت برنامه هم‌اکنون تغییر کرده است — دوباره بارگذاری کنید' },
+      { status: 409 },
+    )
+  }
+
+  const planRow = await db.plannedVisit.findUnique({ where: { id }, select: PLAN_SELECT })
+  const plan = planRow ? withScheduledAtLocal(planRow) : null
+  await writeAudit({
+    action: 'plannedvisit.reschedule',
+    targetType: 'PlannedVisit',
+    targetId: id,
+    detail: `برنامه‌ریزی مجدد ${plan?.employee.name ?? ''} → ${plan?.customer.name ?? ''}: ${existing.scheduledAt.toISOString()} ← ${newTime.toISOString()}`,
+  })
+
+  return NextResponse.json({ ok: true, plan })
+}
diff -ruN orig/src/app/api/planned-visits/[id]/route.ts b/src/app/api/planned-visits/[id]/route.ts
--- orig/src/app/api/planned-visits/[id]/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/planned-visits/[id]/route.ts	2026-10-26 09:56:23.000000000 +0000
@@ -0,0 +1,140 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+import {
+  PLAN_OPEN_STATUSES,
+  PLAN_PUT_STATUSES,
+  PLAN_SELECT,
+  isDuplicatePlan,
+  validatePlanInput,
+  withScheduledAtLocal,
+  type PlanStatus,
+} from '@/lib/planned-visit'
+
+/**
+ * phase 2 / task 1 — single planned visit (admin panel).
+ *
+ * GET  /api/planned-visits/[id] — full detail (employee, customer, linked
+ *      real visit). 404 when the id does not exist. Admin-only.
+ *
+ * PUT  /api/planned-visits/[id] — edit any plan field (employee, customer,
+ *      scheduledAt, durationMin, priority, note) while the plan is still
+ *      OPEN ('scheduled' | 'needs_reschedule'). Closed plans ('done' |
+ *      'cancelled') are immutable — the admin creates a NEW plan instead
+ *      (keeps the done-count and the audit trail honest).
+ *      PUT also accepts `status` restricted to the two open states, i.e. an
+ *      admin can flag 'needs_reschedule' from here; 'done'/'cancelled' can
+ *      ONLY be reached through the server linkage / the cancel endpoint.
+ *
+ * Race safety: the status guard is re-checked INSIDE the conditional update
+ * (`updateMany({ where: { id, status: { in: OPEN } } })`), so two concurrent
+ * edits cannot both pass a stale check — the loser gets 409, not corruption.
+ */
+export async function GET(_req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const plan = await db.plannedVisit.findUnique({ where: { id }, select: PLAN_SELECT })
+  if (!plan) return NextResponse.json({ ok: false, error: 'پیدا نشد' }, { status: 404 })
+  return NextResponse.json({ ok: true, plan: withScheduledAtLocal(plan) })
+}
+
+export async function PUT(req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const body = await req.json().catch(() => null) as {
+    employeeId?: string
+    customerId?: string
+    scheduledAt?: string
+    durationMin?: number
+    priority?: string
+    note?: string | null
+    status?: string
+  } | null
+
+  const existing = await db.plannedVisit.findUnique({ where: { id }, select: PLAN_SELECT })
+  if (!existing) return NextResponse.json({ ok: false, error: 'پیدا نشد' }, { status: 404 })
+
+  if (!PLAN_OPEN_STATUSES.includes(existing.status as (typeof PLAN_OPEN_STATUSES)[number])) {
+    return NextResponse.json(
+      {
+        ok: false,
+        error:
+          existing.status === 'done'
+            ? 'این برنامه انجام شده و قابل ویرایش نیست — برای بازدید بعدی برنامهٔ جدید بسازید'
+            : 'این برنامه لغو شده و قابل ویرایش نیست — برای بازدید بعدی برنامهٔ جدید بسازید',
+      },
+      { status: 409 },
+    )
+  }
+
+  // optional status transition (open <-> open only)
+  let newStatus: PlanStatus | undefined
+  if (body?.status !== undefined) {
+    if (!PLAN_PUT_STATUSES.includes(body.status as (typeof PLAN_PUT_STATUSES)[number])) {
+      return NextResponse.json(
+        { ok: false, error: 'وضعیت فقط می‌تواند «برنامه‌ریزی‌شده» یا «نیازمند برنامه‌ریزی مجدد» باشد' },
+        { status: 400 },
+      )
+    }
+    newStatus = body.status as PlanStatus
+  }
+
+  // shared field validation (only provided keys are touched)
+  const { error, fields } = await validatePlanInput(body, { requireAll: false })
+  if (error) return NextResponse.json({ ok: false, error }, { status: 400 })
+  const data: Record<string, unknown> = { ...fields }
+  if (newStatus) data.status = newStatus
+
+  // duplicate guard when the timestamp (or worker/target pair) changes
+  const empId = (fields?.employeeId as string) ?? existing.employeeId
+  const custId = (fields?.customerId as string) ?? existing.customerId
+  const when = (fields?.scheduledAt as Date | undefined) ?? existing.scheduledAt
+  if (fields?.scheduledAt || fields?.employeeId || fields?.customerId) {
+    if (await isDuplicatePlan(empId, custId, when, id)) {
+      return NextResponse.json(
+        { ok: false, error: 'برنامهٔ یکسان (کارمند، مشتری و زمان) از قبل برای این زمان ثبت شده است' },
+        { status: 409 },
+      )
+    }
+  }
+
+  if (Object.keys(data).length === 0) {
+    return NextResponse.json({ ok: true, plan: withScheduledAtLocal(existing) }) // nothing to change
+  }
+
+  // conditional update — re-checks openness atomically
+  const res = await db.plannedVisit.updateMany({
+    where: { id, status: { in: PLAN_OPEN_STATUSES } },
+    data,
+  })
+  if (res.count === 0) {
+    return NextResponse.json(
+      { ok: false, error: 'وضعیت برنامه هم‌اکنون تغییر کرده است — دوباره بارگذاری کنید' },
+      { status: 409 },
+    )
+  }
+
+  const planRow = await db.plannedVisit.findUnique({ where: { id }, select: PLAN_SELECT })
+  const plan = planRow ? withScheduledAtLocal(planRow) : null
+  const changed: string[] = []
+  if (fields?.employeeId) changed.push('کارمند')
+  if (fields?.customerId) changed.push('مشتری')
+  if (fields?.scheduledAt) changed.push('زمان')
+  if (fields?.durationMin !== undefined) changed.push('مدت')
+  if (fields?.priority) changed.push('اولویت')
+  if (fields?.note !== undefined) changed.push('توضیحات')
+  if (newStatus) changed.push(`وضعیت→${newStatus === 'scheduled' ? 'برنامه‌ریزی‌شده' : 'نیازمند برنامه‌ریزی مجدد'}`)
+  await writeAudit({
+    action: 'plannedvisit.update',
+    targetType: 'PlannedVisit',
+    targetId: id,
+    detail: `ویرایش برنامهٔ ${plan?.employee.name ?? ''} → ${plan?.customer.name ?? ''}: ${changed.join('، ')}`,
+  })
+
+  return NextResponse.json({ ok: true, plan })
+}
diff -ruN orig/src/app/api/planned-visits/route.ts b/src/app/api/planned-visits/route.ts
--- orig/src/app/api/planned-visits/route.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/app/api/planned-visits/route.ts	2026-10-26 09:56:23.000000000 +0000
@@ -0,0 +1,175 @@
+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin, getConfig } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+import {
+  PLAN_LIST_LIMIT,
+  PLAN_STATUSES,
+  PLAN_SELECT,
+  isDuplicatePlan,
+  localDayRange,
+  localDayKey,
+  parseDayParam,
+  validatePlanInput,
+  withScheduledAtLocal,
+} from '@/lib/planned-visit'
+
+/**
+ * phase 2 / task 1 — planned field visits (admin panel).
+ *
+ * GET /api/planned-visits
+ *   Filters (all optional, combinable):
+ *     date=YYYY-MM-DD        plans whose scheduledAt falls in that server-local
+ *                            day (default: TODAY)
+ *     from=YYYY-MM-DD&to=…   inclusive day range instead of a single day
+ *     employeeId=<id>         only this employee's plans
+ *     customerId=<id>         only this customer's plans
+ *     status=<status>         scheduled|done|cancelled|needs_reschedule
+ *   Each row carries employee/customer summaries, the linked real visit (if
+ *   any) and `actualVisit` — a same-day real visit for the same employee +
+ *   customer that is NOT linked to this plan (surfaces missed linkages to the
+ *   admin). Responses are capped at PLAN_LIST_LIMIT with `truncated:true`.
+ *
+ * POST /api/planned-visits
+ *   Creates a plan. Status always starts 'scheduled' (the client cannot
+ *   choose it). Duplicate-submit guard: an identical scheduled plan (same
+ *   employee+customer+exact timestamp) returns 409 instead of a second row.
+ *   Both endpoints are ADMIN-ONLY — server-side check, not a hidden button.
+ */
+export async function GET(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const url = new URL(req.url)
+  const employeeId = url.searchParams.get('employeeId')
+  const customerId = url.searchParams.get('customerId')
+  const status = url.searchParams.get('status')
+
+  // ── resolve the date window (single day by default) ──
+  let range = parseDayParam(url.searchParams.get('date'))
+  let rangeMode: 'day' | 'range' | 'today' = 'today'
+  if (!range) {
+    const from = parseDayParam(url.searchParams.get('from'))
+    const to = parseDayParam(url.searchParams.get('to'))
+    if (from && to) {
+      if (to.start < from.start) {
+        return NextResponse.json({ ok: false, error: 'تاریخ «از» باید قبل از تاریخ «تا» باشد' }, { status: 400 })
+      }
+      range = { start: from.start, end: to.end } // `to` day is inclusive
+      rangeMode = 'range'
+    } else if (from || to) {
+      return NextResponse.json(
+        { ok: false, error: 'بازهٔ تاریخ نامعتبر است — هر دو «از» و «تا» لازم است' },
+        { status: 400 },
+      )
+    } else {
+      range = localDayRange(new Date())
+    }
+  } else {
+    rangeMode = 'day'
+  }
+
+  // ── filters (validated server-side; unknown values are rejected) ──
+  const where: Record<string, unknown> = { scheduledAt: { gte: range.start, lt: range.end } }
+  if (employeeId) where.employeeId = employeeId
+  if (customerId) where.customerId = customerId
+  if (status) {
+    if (!PLAN_STATUSES.includes(status as (typeof PLAN_STATUSES)[number])) {
+      return NextResponse.json({ ok: false, error: 'وضعیت برنامه نامعتبر است' }, { status: 400 })
+    }
+    where.status = status
+  }
+
+  const [rows, total] = await Promise.all([
+    db.plannedVisit.findMany({
+      where,
+      select: PLAN_SELECT,
+      orderBy: [{ scheduledAt: 'asc' }, { createdAt: 'asc' }],
+      take: PLAN_LIST_LIMIT + 1,
+    }),
+    db.plannedVisit.count({ where }),
+  ])
+  const truncated = rows.length > PLAN_LIST_LIMIT
+  if (truncated) rows.pop()
+
+  // ── same-day UNLINKED real visits (context for missed linkages) ──
+  // Two queries for the whole window, matched in memory — no N+1.
+  const [visits, linked] = await Promise.all([
+    db.visit.findMany({
+      where: { startAt: { gte: range.start, lt: range.end } },
+      select: { id: true, employeeId: true, customerId: true, startAt: true, endAt: true, open: true },
+      orderBy: { startAt: 'asc' },
+    }),
+    db.plannedVisit.findMany({ where: { visitId: { not: null } }, select: { visitId: true } }),
+  ])
+  const linkedIds = new Set(linked.map((p) => p.visitId as string))
+  const unlinkedByKey = new Map<string, (typeof visits)[number]>()
+  for (const v of visits) {
+    if (linkedIds.has(v.id)) continue
+    const key = `${v.employeeId}|${v.customerId}`
+    if (!unlinkedByKey.has(key)) unlinkedByKey.set(key, v) // earliest first
+  }
+
+  const plans = rows.map((p) =>
+    withScheduledAtLocal({
+      ...p,
+      actualVisit: p.visitId ? null : (unlinkedByKey.get(`${p.employeeId}|${p.customerId}`) ?? null),
+    }),
+  )
+
+  return NextResponse.json({
+    ok: true,
+    plans,
+    total,
+    truncated,
+    window: {
+      mode: rangeMode,
+      dayKey: localDayKey(range.start),
+      start: range.start.toISOString(),
+      end: range.end.toISOString(),
+    },
+  })
+}
+
+export async function POST(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const body = await req.json().catch(() => null)
+  const { error, fields } = await validatePlanInput(body, { requireAll: true })
+  if (error || !fields?.employeeId || !fields.customerId || !fields.scheduledAt) {
+    return NextResponse.json({ ok: false, error: error || 'اطلاعات ناقص است' }, { status: 400 })
+  }
+
+  // duplicate-submit guard (same employee+customer+exact time, still scheduled)
+  if (await isDuplicatePlan(fields.employeeId, fields.customerId, fields.scheduledAt)) {
+    return NextResponse.json(
+      { ok: false, error: 'برنامهٔ یکسان (کارمند، مشتری و زمان) از قبل برای این زمان ثبت شده است' },
+      { status: 409 },
+    )
+  }
+
+  const planRow = await db.plannedVisit.create({
+    data: {
+      employeeId: fields.employeeId,
+      customerId: fields.customerId,
+      scheduledAt: fields.scheduledAt,
+      durationMin: fields.durationMin ?? 30,
+      priority: fields.priority ?? 'normal',
+      note: fields.note ?? null,
+      status: 'scheduled', // always starts scheduled — the client cannot pick a status
+      createdById: await getConfig('adminUser', 'admin'),
+    },
+    select: PLAN_SELECT,
+  })
+
+  const plan = withScheduledAtLocal(planRow)
+  await writeAudit({
+    action: 'plannedvisit.create',
+    targetType: 'PlannedVisit',
+    targetId: plan.id,
+    detail: `ایجاد برنامهٔ بازدید: ${plan.employee.name} → ${plan.customer.name} — ${plan.scheduledAt.toISOString()}`,
+  })
+
+  return NextResponse.json({ ok: true, plan }, { status: 201 })
+}
