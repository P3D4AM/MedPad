+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { writeAudit } from '@/lib/audit'
+
+/**
+ * phase 1 / task 2 (G-3): deactivate an employee.
+ *
+ * - takes effect IMMEDIATELY for subsequent protected requests (appEmployee
+ *   checks employee.active on every call)
+ * - revokes ALL of the employee's app tokens at the same moment
+ * - preserves ALL history (check-ins, visits, audio, audit rows) — nothing
+ *   is deleted or rewritten
+ * - reactivation never restores the revoked tokens (employee logs in again)
+ * - the panel admin account is Config-based, so this can never lock the
+ *   admin out; deactivating the last active employee is allowed and
+ *   reversible
+ */
+export async function POST(_req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const emp = await db.employee.findUnique({ where: { id } })
+  if (!emp) return NextResponse.json({ ok: false, error: 'پیدا نشد' }, { status: 404 })
+  if (!emp.active) {
+    return NextResponse.json({ ok: false, error: 'این کارمند از قبل غیرفعال است' }, { status: 409 })
+  }
+  const res = await db.appToken.updateMany({
+    where: { employeeId: id, revokedAt: null },
+    data: { revokedAt: new Date() },
+  })
+  await db.employee.update({ where: { id }, data: { active: false } })
+  await writeAudit({
+    action: 'employee.deactivate',
+    targetType: 'Employee',
+    targetId: id,
+    detail: `غیرفعال‌سازی ${emp.username} — ${res.count} نشست اپ فوراً باطل شد`,
+  })
+  return NextResponse.json({ ok: true, revokedTokens: res.count })
+}
