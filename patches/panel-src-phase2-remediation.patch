@@ -2,28 +2,34 @@
 import { db } from '@/lib/db'
 import { appEmployee } from '@/lib/auth'
 
-/** App customers sync — returns ALL active customers (app filters by assignment locally)
- *  plus the employee's assignments. LWW client compares updatedAt. */
+/**
+ * App customers sync — phase 1 / task 2 (G-1):
+ * returns ONLY the customers assigned to the authenticated employee.
+ * (Previously it returned every customer in the database and relied on the
+ * app to filter locally — a UI-only restriction that any direct API call
+ * could bypass.) The admin panel uses /api/customers, which is unaffected.
+ * LWW client compares updatedAt; `since` = incremental sync.
+ */
 export async function GET(req: Request) {
   const emp = await appEmployee(req)
   if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
   const url = new URL(req.url)
   const since = url.searchParams.get('since') // incremental sync
 
-  const where: Record<string, unknown> = {}
+  const assigned = await db.assignment.findMany({
+    where: { employeeId: emp.id },
+    select: { customerId: true },
+  })
+  const assignedIds = assigned.map((a) => a.customerId)
+
+  const where: Record<string, unknown> = { id: { in: assignedIds } }
   if (since) where.updatedAt = { gt: new Date(since) }
 
-  const [customers, assignments] = await Promise.all([
-    db.customer.findMany({ where }),
-    db.assignment.findMany({
-      where: { employeeId: emp.id },
-      select: { customerId: true },
-    }),
-  ])
+  const customers = await db.customer.findMany({ where })
   return NextResponse.json({
     ok: true,
     customers,
-    assignedIds: assignments.map((a) => a.customerId),
+    assignedIds,
     serverTime: new Date().toISOString(),
   })
 }
