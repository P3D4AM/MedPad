+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+
+/**
+ * Customer 360 (phase 1) — link lifecycle (ADMIN side).
+ *
+ *  PUT { note?, active? } — edit a link's note or toggle its active flag.
+ *  DELETE — remove the link row entirely (pure relation, no history is
+ *  attached to it; deactivation via PUT keeps it for the record instead).
+ */
+export async function PUT(req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  const b = await req.json().catch(() => null) as { note?: string; active?: boolean } | null
+  const data: Record<string, unknown> = {}
+  if (b?.note !== undefined) {
+    data.note = typeof b.note === 'string' && b.note.trim() ? b.note.trim().slice(0, 500) : null
+  }
+  if (typeof b?.active === 'boolean') data.active = b.active
+  if (!Object.keys(data).length) {
+    return NextResponse.json({ ok: false, error: 'چیزی برای تغییر داده نشد' }, { status: 400 })
+  }
+  try {
+    const row = await db.customerLink.update({
+      where: { id },
+      data,
+      include: { clinic: { select: { id: true, name: true } }, physician: { select: { id: true, name: true } } },
+    })
+    return NextResponse.json({ ok: true, link: row })
+  } catch {
+    return NextResponse.json({ ok: false, error: 'ارتباط پیدا نشد' }, { status: 404 })
+  }
+}
+
+export async function DELETE(_req: Request, ctx: { params: Promise<{ id: string }> }) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const { id } = await ctx.params
+  try {
+    await db.customerLink.delete({ where: { id } })
+    return NextResponse.json({ ok: true })
+  } catch {
+    return NextResponse.json({ ok: false, error: 'ارتباط پیدا نشد' }, { status: 404 })
+  }
+}
