+      // this customer IS the physician — clinics they practise at
+      clinics: linksAsPhysician.map((l) => ({
+        id: l.id, note: l.note, active: l.active, createdAt: l.createdAt,
+        counterpart: l.clinic,
+      })),
+    },
+    purchaseSummary: summary,
+    purchases,
+    visits,
+    // explicit provenance banner for the purchase tab (mission §4.3: the
+    // source of every record is visible; no real Holoo sync exists yet)
+    purchaseSourceNote: 'اتصال به سامانهٔ هلو در فاز بعدی برقرار می‌شود — هیچ دادهٔ فروش واقعی هم‌اکنون وارد نمی‌شود',
+  })
+}
