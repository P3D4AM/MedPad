+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { appEmployee } from '@/lib/auth'
+
+/**
+ * Customer 360 (phase 1) — a rep links a physician to a clinic (app side).
+ *
+ * ACCESS RULES (mission §9 — server-enforced):
+ *  * BOTH customers must be ASSIGNED to the authenticated rep. A link is a
+ *    relation BETWEEN two customers the rep can already legitimately see;
+ *    it can never be used to reach a customer outside the rep's scope.
+ *  * Type rules match the admin route: clinicId → type='clinic',
+ *    physicianId → type='doctor'.
+ *  * Idempotent by the unique (clinicId, physicianId): an existing row is
+ *    reactivated + its note updated — a replay of an OFFLINE-queued link op
+ *    (crash mid-sync, retry) can never create a duplicate.
+ */
+export async function POST(req: Request) {
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  const b = await req.json().catch(() => null) as {
+    clinicId?: string; physicianId?: string; note?: string; localId?: string
+  } | null
+  if (!b?.clinicId || !b?.physicianId) {
+    return NextResponse.json({ ok: false, error: 'کلینیک و پزشک هر دو لازم است' }, { status: 400 })
+  }
+  if (b.clinicId === b.physicianId) {
+    return NextResponse.json({ ok: false, error: 'یک مشتری نمی‌تواند با خودش مرتبط شود' }, { status: 400 })
+  }
+  const note = typeof b.note === 'string' && b.note.trim() ? b.note.trim().slice(0, 500) : null
+
+  const [clinic, physician, assignedCount] = await Promise.all([
+    db.customer.findUnique({ where: { id: b.clinicId }, select: { id: true, name: true, type: true } }),
+    db.customer.findUnique({ where: { id: b.physicianId }, select: { id: true, name: true, type: true } }),
+    db.assignment.count({
+      where: { employeeId: emp.id, customerId: { in: [b.clinicId, b.physicianId] } },
+    }),
+  ])
+  if (!clinic || clinic.type !== 'clinic') {
+    return NextResponse.json({ ok: false, error: 'طرف «کلینیک» باید از نوع کلینیک باشد' }, { status: 400 })
+  }
+  if (!physician || physician.type !== 'doctor') {
+    return NextResponse.json({ ok: false, error: 'طرف «پزشک» باید از نوع پزشک باشد' }, { status: 400 })
+  }
+  // BOTH sides must be in the rep's assigned set (count returns 2 only then)
+  if (assignedCount < 2) {
+    return NextResponse.json(
+      { ok: false, error: 'هر دو مشتری باید به شما اختصاص داده شده باشند' },
+      { status: 403 },
+    )
+  }
+
+  const row = await db.customerLink.upsert({
+    where: { clinicId_physicianId: { clinicId: b.clinicId, physicianId: b.physicianId } },
+    create: { clinicId: b.clinicId, physicianId: b.physicianId, note, active: true },
+    update: { note, active: true },
+    include: { clinic: { select: { id: true, name: true } }, physician: { select: { id: true, name: true } } },
+  })
+  return NextResponse.json({ ok: true, link: row })
+}
