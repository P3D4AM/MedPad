@@ -0,0 +1,145 @@
+import { db } from '@/lib/db'
+
+/**
+ * Customer 360 (phase 1) — shared helpers for the panel AND app paths.
+ *
+ * Everything here is deliberately conservative:
+ *  * unknown/absent fields are NEVER touched (partial update semantics —
+ *    an old app that does not know the new fields keeps syncing exactly
+ *    as before);
+ *  * strings are trimmed and empties collapse to NULL (one storage truth:
+ *    "no value" is NULL, never '');
+ *  * duplicate detection is advisory (the caller decides the status code)
+ *    and compares on NORMALIZED names so «دکتر احمدی» ≈ «دکتر  احمدی».
+ */
+
+export const CUSTOMER_TYPES = ['doctor', 'pharmacy', 'clinic', 'other'] as const
+export const PAYMENT_STATUSES = ['paid', 'unpaid', 'partial'] as const
+export const PURCHASE_SOURCES = ['manual', 'holoo'] as const
+
+function norm(s: unknown): string | null {
+  if (typeof s !== 'string') return null
+  const t = s.trim().replace(/\s+/g, ' ')
+  return t.length ? t : null
+}
+
+/** Extract + validate the Customer-360 profile fields from a request body.
+ *  Returns the partial Prisma `data` (only the keys present in the body). */
+export function pickCustomer360(b: Record<string, unknown> | null | undefined): Record<string, unknown> {
+  const data: Record<string, unknown> = {}
+  if (!b) return data
+  if ('lastName' in b) data.lastName = norm(b.lastName)
+  if ('title' in b) data.title = norm(b.title)
+  if ('specialty' in b) data.specialty = norm(b.specialty)
+  if ('managerName' in b) data.managerName = norm(b.managerName)
+  if ('phone2' in b) data.phone2 = norm(b.phone2)
+  if ('district' in b) data.district = norm(b.district)
+  if ('postalCode' in b) data.postalCode = norm(b.postalCode)
+  if ('notes' in b) data.notes = norm(b.notes)
+  if ('active' in b && typeof b.active === 'boolean') data.active = b.active
+  return data
+}
+
+/** The same fields, but the ones an APP client is allowed to write.
+ *  (`active` is panel-only: a rep must not be able to deactivate a customer
+ *  — that is an administrative lifecycle decision.) */
+export function pickCustomer360App(b: Record<string, unknown> | null | undefined): Record<string, unknown> {
+  const data = pickCustomer360(b)
+  delete data.active
+  return data
+}
+
+export interface DuplicateHit {
+  id: string
+  name: string
+  type: string
+  phone?: string | null
+}
+
+/**
+ * Duplicate prevention (mission §6.3: «جلوگیری از ثبت تصادفی رکوردهای تکراری»).
+ *
+ * A new/edited customer is a LIKELY duplicate of an existing row when:
+ *  - same type AND (normalized) same name, OR
+ *  - same type AND same non-empty phone.
+ *
+ * The check EXCLUDES the row being edited (`excludeId`) and is purely a
+ * WARNING: the caller decides whether to refuse (panel refuses with 409 +
+ * the existing row's identity; app path likewise) — the database itself has
+ * no unique constraint on name (legitimate same-name doctors in different
+ * cities exist, so hard-uniqueness would be wrong).
+ */
+export async function findCustomerDuplicate(opts: {
+  name: string
+  type: string
+  phone?: string | null
+  excludeId?: string
+}): Promise<DuplicateHit | null> {
+  const name = norm(opts.name) ?? ''
+  const phone = norm(opts.phone)
+  if (!name && !phone) return null
+  const OR: Record<string, unknown>[] = []
+  if (name) OR.push({ name, type: opts.type })
+  if (phone) OR.push({ phone, type: opts.type })
+  const hit = await db.customer.findFirst({
+    where: {
+      id: opts.excludeId ? { not: opts.excludeId } : undefined,
+      OR,
+    },
+    select: { id: true, name: true, type: true, phone: true },
+  })
+  return hit ?? null
+}
+
+/** The 360 financial summary — computed from REAL Purchase rows only.
+ *  An empty table yields all-zero/`null` values (the UI renders an explicit
+ *  «اطلاعاتی ثبت نشده» empty state — never a fabricated number). */
+export interface PurchaseSummary {
+  total: number
+  last30: number
+  last90: number
+  last365: number
+  orderCount: number
+  avgOrder: number | null
+  lastPurchaseAt: string | null
+  maxOrder: number | null
+}
+
+export async function purchaseSummary(customerId: string): Promise<PurchaseSummary> {
+  const now = Date.now()
+  // One fetch, exact math in JS (Prisma cannot sum a computed
+  // `gross - discount` in SQLite; per-customer purchase counts are small).
+  const rows = await db.purchase.findMany({
+    where: { customerId },
+    select: { date: true, discount: true, items: { select: { total: true } } },
+    orderBy: { date: 'desc' },
+  })
+  const net = rows.map((r) => {
+    const gross = r.items.reduce((s, it) => s + (it.total || 0), 0)
+    return { at: r.date.getTime(), value: gross - (r.discount || 0) }
+  })
+  const sum = (list: { value: number }[]) => list.reduce((s, x) => s + x.value, 0)
+  const w = (days: number) => sum(net.filter((x) => x.at >= now - days * 24 * 3600 * 1000))
+  const total = sum(net)
+  return {
+    total,
+    last30: w(30),
+    last90: w(90),
+    last365: w(365),
+    orderCount: rows.length,
+    avgOrder: rows.length ? total / rows.length : null,
+    lastPurchaseAt: rows.length ? rows[0].date.toISOString() : null,
+    maxOrder: net.length ? Math.max(...net.map((x) => x.value)) : null,
+  }
+}
+
+/** Persian label for a customer type — one source of truth for API error
+ *  messages and the link-type validation text. */
+export function customerTypeFa(t: string): string {
+  switch (t) {
+    case 'doctor': return 'پزشک'
+    case 'pharmacy': return 'داروخانه'
+    case 'clinic': return 'کلینیک'
+    default: return 'سایر'
+  }
+}
