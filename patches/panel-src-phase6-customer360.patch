+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { appEmployee } from '@/lib/auth'
+import { purchaseSummary } from '@/lib/customer360'
+
+/**
+ * Customer 360 (phase 1) — the REP's customer profile (app side).
+ *
+ * ACCESS CONTROL (mission §9, enforced SERVER-side, never by hiding UI):
+ *  * the customer must be ASSIGNED to the authenticated employee — any
+ *    other id answers 403 with the same Persian text as the edit route
+ *    (changing the id in the request must not reveal another rep's data);
+ *  * LINKED counterparts are surfaced ONLY when they are ALSO assigned to
+ *    this rep — a physician↔clinic link can never be used to bypass the
+ *    assignment-based access control (counterparts not assigned here are
+ *    counted but their identity is masked out).
+ *
+ * Content mirrors the admin profile minus admin-only context (assignment
+ * management, other reps' employee usernames):
+ *  * customer row (profile fields included);
+ *  * masked links (assigned-only counterparts);
+ *  * REAL purchase summary + purchase list (an empty history is explicit
+ *    zeros/nulls — never fabricated);
+ *  * visit history with rep names, notes, voice file ids/paths (audio
+ *    playback goes through the EXISTING token-authenticated media route).
+ */
+export async function GET(req: Request, ctx: { params: Promise<{ id: string }> }) {
+  const emp = await appEmployee(req)
+  if (!emp) return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  const { id } = await ctx.params
+
+  const customer = await db.customer.findUnique({ where: { id } })
+  if (!customer) return NextResponse.json({ ok: false, error: 'پیدا نشد' }, { status: 404 })
+
+  const assigned = await db.assignment.findFirst({ where: { employeeId: emp.id, customerId: id } })
+  if (!assigned) {
+    return NextResponse.json(
+      { ok: false, error: 'این مشتری به شما اختصاص داده نشده است' },
+      { status: 403 },
+    )
+  }
+
+  // the set of customers THIS rep may see through a link
+  const mine = new Set(
+    (await db.assignment.findMany({ where: { employeeId: emp.id }, select: { customerId: true } }))
+      .map((a) => a.customerId),
+  )
+  const mask = (c: { id: string; name: string; type: string; city: string | null; phone: string | null; active: boolean }) =>
+    mine.has(c.id)
+      ? { visible: true as const, id: c.id, name: c.name, type: c.type, city: c.city, phone: c.phone, active: c.active }
+      : { visible: false as const, id: c.id, name: null, type: c.type, city: null, phone: null, active: c.active }
+
+  const counterpartSelect = {
+    select: { id: true, name: true, type: true, city: true, phone: true, active: true },
+  }
+
+  const [linksAsClinic, linksAsPhysician, summary, purchases, visits] = await Promise.all([
+    db.customerLink.findMany({
+      where: { clinicId: id, active: true },
+      include: { physician: counterpartSelect },
+      orderBy: { createdAt: 'desc' },
+    }),
+    db.customerLink.findMany({
+      where: { physicianId: id, active: true },
+      include: { clinic: counterpartSelect },
+      orderBy: { createdAt: 'desc' },
+    }),
+    purchaseSummary(id),
+    db.purchase.findMany({
+      where: { customerId: id },
+      include: { items: true },
+      orderBy: { date: 'desc' },
+      take: 50,
+    }),
+    db.visit.findMany({
+      where: { customerId: id },
+      include: {
+        employee: { select: { id: true, name: true } },
+        checkin: {
+          select: {
+            id: true, note: true, createdAt: true,
+            _count: { select: { noteVersions: true } },
+            voiceFiles: { select: { id: true, path: true }, orderBy: { seq: 'asc' } },
+          },
+        },
+        checkout: {
+          select: {
+            id: true, note: true, createdAt: true,
+            _count: { select: { noteVersions: true } },
+            voiceFiles: { select: { id: true, path: true }, orderBy: { seq: 'asc' } },
+          },
+        },
+        plannedVisit: { select: { id: true, scheduledAt: true, priority: true, status: true } },
+      },
+      orderBy: { startAt: 'desc' },
+      take: 50,
+    }),
+  ])
+
+  return NextResponse.json({
+    ok: true,
+    customer,
+    links: {
+      physicians: linksAsClinic.map((l) => ({
+        id: l.id, note: l.note, createdAt: l.createdAt,
+        counterpart: mask(l.physician),
+      })),
+      clinics: linksAsPhysician.map((l) => ({
+        id: l.id, note: l.note, createdAt: l.createdAt,
+        counterpart: mask(l.clinic),
+      })),
+    },
+    purchaseSummary: summary,
+    purchases,
+    visits,
+    serverTime: new Date().toISOString(),
+    purchaseSourceNote: 'اطلاعات خرید پس از اتصال به سامانهٔ هلو نمایش داده می‌شود',
+  })
+}
