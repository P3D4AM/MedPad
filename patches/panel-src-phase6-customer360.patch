+            lat: true, lng: true, distanceM: true, outOfRadius: true, locationMissing: true,
+            _count: { select: { noteVersions: true } },
+            voiceFiles: { select: { id: true, path: true }, orderBy: { seq: 'asc' } },
+          },
+        },
+        checkout: {
