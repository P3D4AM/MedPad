+/**
+ * Theme switcher (UI/UX redesign §3.3): Light / Dark / System.
+ * The choice persists (localStorage) and 'system' follows the OS live.
+ * Rendered as a compact 3-segment control that fits the topbar and the
+ * mobile header alike.
+ */
+export default function ThemeToggle({ compact = false }: { compact?: boolean }) {
+  const [pref, setPref] = useState<ThemePref>('system')
+
+  useEffect(() => {
+    setPref(readThemePref())
