+      include: { physician: counterpart },
+      orderBy: { createdAt: 'desc' },
+    }),
+    db.customerLink.findMany({
+      where: { physicianId: id },
+      include: { clinic: counterpart },
+      orderBy: { createdAt: 'desc' },
