+import { NextResponse } from 'next/server'
+import { db } from '@/lib/db'
+import { isAdmin } from '@/lib/auth'
+import { customerTypeFa } from '@/lib/customer360'
+
+/**
+ * Customer 360 (phase 1) — physician↔clinic link management (ADMIN side).
+ *
+ * POST { clinicId, physicianId, note? }
+ *  * TYPE-CHECKED: clinicId must reference type='clinic' and physicianId
+ *    type='doctor' (mission §3.1-c: contact/address of a person and a
+ *    center must never be merged into one record — and a link must never
+ *    connect two entities of the same kind).
+ *  * Idempotent by the DB's unique (clinicId, physicianId): an existing
+ *    row (active or not) is REACTIVATED and its note updated — a replay
+ *    can never create a second link.
+ */
+export async function POST(req: Request) {
+  if (!(await isAdmin())) {
+    return NextResponse.json({ ok: false, error: 'unauthorized' }, { status: 401 })
+  }
+  const b = await req.json().catch(() => null) as {
+    clinicId?: string; physicianId?: string; note?: string
+  } | null
+  if (!b?.clinicId || !b?.physicianId) {
+    return NextResponse.json({ ok: false, error: 'کلینیک و پزشک هر دو لازم است' }, { status: 400 })
+  }
+  if (b.clinicId === b.physicianId) {
+    return NextResponse.json({ ok: false, error: 'یک مشتری نمی‌تواند با خودش مرتبط شود' }, { status: 400 })
+  }
+  const note = typeof b.note === 'string' && b.note.trim() ? b.note.trim().slice(0, 500) : null
+
+  const [clinic, physician] = await Promise.all([
+    db.customer.findUnique({ where: { id: b.clinicId }, select: { id: true, name: true, type: true } }),
+    db.customer.findUnique({ where: { id: b.physicianId }, select: { id: true, name: true, type: true } }),
+  ])
+  if (!clinic || clinic.type !== 'clinic') {
+    return NextResponse.json(
+      { ok: false, error: `طرف «کلینیک» باید از نوع کلینیک باشد${clinic ? ` — «${clinic.name}» ${customerTypeFa(clinic.type)} است` : ' — کلینیک پیدا نشد'}` },
+      { status: 400 },
+    )
+  }
