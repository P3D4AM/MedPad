+      where: { customerId: id },
+      include: { items: true },
+      orderBy: { date: 'desc' },
+      take: 200,
+    }),
+    db.visit.findMany({
+      where: { customerId: id },
+      include: {
+        employee: { select: { id: true, name: true, username: true } },
+        checkin: {
