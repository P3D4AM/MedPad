+/** Safe message for logs/audit — guaranteed free of credential material.
+ *  Plain strings pass through (they are OUR OWN internal safe messages,
+ *  e.g. the invoice-without-linked-customer notice) instead of collapsing
+ *  into an uninformative [unknown]. */
 export function holooSafeError(e: unknown): string {
   if (e instanceof HolooError) return `[${e.kind}] ${e.message}`
+  if (typeof e === 'string') return e.slice(0, 200)
   if (e instanceof Error) return `[unknown] ${e.message.slice(0, 200)}`
   return '[unknown] خطای ناشناخته'
 }
