# ─── MedPad repo hygiene (audit phase 2) ─────────────────────────────
# NOTE: vendored node_modules/ and the prebuilt .next/ inside the offline
# package are INTENTIONALLY tracked (the repo IS the offline bundle).
# These rules therefore only stop NEW junk from appearing; tracked files
# are unaffected by .gitignore.

# Databases — real user data must NEVER be committed.
# Exception: the EMPTY schema template shipped for fresh installs.
custom.db
*.db-journal
*.db-wal
*.db-shm

# Android signing keys — the old key is compromised (was public); the new
# key must NEVER enter git. Local signing config also stays out:
*.keystore
*.jks
Android/keystore/medpad-release.properties

# Secrets / env / tunnel credentials
.env
.env.*
!.env.example
tunnel-creds/
*.pem
*.key

# Stray build outputs & local junk (NOT the tracked vendored ones)
# The repo IS the offline bundle: the prebuilt .next/ at app/panel/.next
# and the vendored realtime node_modules are intentionally tracked.
__pycache__/
*.pyc
install.log
logs/
.stale-*
.keep-tmp/
*.apk.idsig
New Text Document.txt

# In-place install artifacts — running install.mjs from the repo root
# (install dir == repo root) generates these; they are machine-local state,
# never source. Root-anchored so they cannot shadow intentional files in
# subdirectories.
/medpad-config.json
/tunnel-state.json
/.medpad.pids
/.cloudflared.pid
/install.log-msi.txt
/start-server.bat
/start-server.sh
/stop-server.bat
/stop-server.sh
/start.bat
/stop.bat
/server-manager.bat
/server-manager.sh
/bin/

# OS junk
Thumbs.db
.DS_Store

# Android build outputs (phase 2 / task 2: APK builds now happen in-tree)
# — built locally or in CI, never source.
Android/.gradle/
Android/build/
Android/app/build/
Android/local.properties
