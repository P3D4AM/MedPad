<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:textDirection="firstStrong">

    <!-- header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/teal_700"
            android:contentDescription="@string/cancel" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/plans_title"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/teal_700" />

        <!-- owner fix — the extra PLUS button (in-app requests list) is
             removed from the header: «درخواست‌های من» now opens only from its
             notification, and the header icon no longer looks like a stray
             add/FAB button. -->
        <!-- owner fix — the calendar icon now OPENS the Jalali date picker
             (it used to be a refresh button — the icon promised a picker).
             Refresh still happens on every resume. -->
        <ImageButton
            android:id="@+id/btnPickDate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_calendar"
            app:tint="@color/teal_700"
            android:contentDescription="@string/plan_pick_date_title" />
    </LinearLayout>

    <!-- day navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnPrevDay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/teal_700"
            android:contentDescription="@string/plan_prev_day" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1C1917" />

            <TextView
                android:id="@+id/tvTodayChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_badge_green"
                android:text="@string/plan_today"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#166534" />
        </LinearLayout>

        <!-- owner request — «امروز» button: jump back to today from any day -->
        <Button
            android:id="@+id/btnToday"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plan_today" />

        <ImageButton
            android:id="@+id/btnNextDay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:rotation="180"
            android:src="@drawable/ic_back"
            app:tint="@color/teal_700"
            android:contentDescription="@string/plan_next_day" />
    </LinearLayout>

    <!-- sync state line -->
    <TextView
        android:id="@+id/tvSyncInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textSize="11sp"
        android:textColor="@color/gray_500" />

    <!-- owner request — view mode (روز / همه روزها) + status/customer
         filters, built programmatically like the customers screen. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/boxFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <!-- owner request — overdue warning banner (red, above the list) -->
    <TextView
        android:id="@+id/tvOverdueWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:padding="8dp"
        android:background="@drawable/bg_badge_red"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#7F1D1D"
        android:visibility="gone" />

    <!-- day summary -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/boxSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>

    <!-- status box: loading / error / empty -->
    <LinearLayout
        android:id="@+id/boxState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/gray_500" />

        <Button
            android:id="@+id/btnRetry"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/plan_refresh"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp" />
</LinearLayout>
