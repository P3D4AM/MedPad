<?xml version="1.0" encoding="utf-8"?>
<!--
  P10 backup policy — legacy Auto Backup (API 24–30, cloud-only path).

  Data map this policy is written against:
    database/          Room DB: customers (medical PHI), visits + GPS traces,
                       offline check-in queue (PendingCheckin), plans cache
    file/voice/        recorded visit voice memos (m4a) awaiting upload
    sharedpref/medpad_session.xml   server URL + Keystore-encrypted token blob
                       + employee identity

  Policy: NONE of the above may ever reach Google cloud backup. The token
  blob is excluded because its AndroidKeyStore key never leaves the device —
  a restored blob can never decrypt and would be dead weight (Session drops
  it honestly and requires a fresh login). Non-sensitive UX prefs
  (remembered username, map/notification/plan-sync settings) stay backed up.

  Everything NOT excluded is backed up — if a future prefs file holds
  sensitive data, add it here AND to data_extraction_rules.xml (guarded by
  BackupPolicyTest).
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="voice" />
    <exclude domain="sharedpref" path="medpad_session.xml" />
</full-backup-content>
