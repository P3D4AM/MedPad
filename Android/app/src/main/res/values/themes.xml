<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight parent: the same theme serves light AND dark — the actual
         colors come from values/colors.xml vs values-night/colors.xml, and
         AppCompatDelegate applies the user's Light/Dark/System choice. -->
    <style name="Theme.MedPad" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/teal_600</item>
        <item name="colorPrimaryDark">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/amber_600</item>
        <item name="android:statusBarColor">@color/teal_50</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="android:colorBackground">@color/screen_bg</item>
    </style>
</resources>
